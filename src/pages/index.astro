---
import { Picture } from 'astro:assets';
import { ArrowUpRightIcon as ArrowUpRight } from '@phosphor-icons/react';
import PapercraftLayout from '../layouts/PapercraftLayout.astro';
import heroRoute from '../assets/generated/hero-route-v1.png';
import systemEnvironment from '../assets/generated/system-environment-v1.png';

const works = [
  {
    name: 'Знамя Труда',
    type: 'Официальный сайт футбольного клуба',
    text: 'Новый сайт, короткий путь к заказу формы и CMS для новостей.',
    meta: 'Сайт / CMS / e-commerce',
    href: 'https://fczt1909.ru/',
    visual: 'znamya',
  },
  {
    name: 'GoalSphere',
    type: 'Сайт футбольного агентства',
    text: 'Концепция, структура, визуальная логика, интерактивные переходы и адаптив.',
    meta: 'Концепция / дизайн / разработка',
    href: 'https://goalsphere-agency.vercel.app/',
    visual: 'goalsphere',
  },
  {
    name: 'AI Project Manager',
    type: 'Закрытая рабочая система',
    text: 'Память проекта для четырёх чатов: звонки, саммари, договорённости, задачи и решения.',
    meta: '2 агентства / около 10 пользователей',
    visual: 'ai',
  },
];
---
<PapercraftLayout
  title="Кирилл Барыев: сайты, системы и AI"
  description="Проектирую и запускаю сайты, Telegram- и AI-системы для бизнеса. Сайты от 70 000 ₽."
>
  <div data-home>
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <Picture
          src={heroRoute}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 760px) 94vw, 58vw"
          alt=""
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__content">
        <p class="hero__kicker">Личная инженерная студия</p>
        <h1 aria-label="Сайты. Системы. AI.">
          <span class="hero__line"><span>САЙТЫ.</span></span>
          <span class="hero__line"><span>СИСТЕМЫ. <em>AI.</em></span></span>
        </h1>
        <div class="hero__bottom">
          <p>Проектирую и запускаю цифровые продукты для бизнеса.</p>
          <a class="button" href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">
            Обсудить проект <ArrowUpRight size={18} weight="regular" />
          </a>
        </div>
      </div>
    </section>

    <section class="work" id="work">
      <div class="work__intro">
        <h2>РАБОТЫ.</h2>
      </div>

      <div class="work__stack">
        {works.map((item, index) => (
          <article class:list={['work-panel', `work-panel--${item.visual}`]}>
            <div class="work-panel__surface">
              <div class="work-panel__media">
                {item.visual === 'znamya' && (
                  <img src="/screenshots/znamya-truda.jpg" alt="Главная страница сайта футбольного клуба Знамя Труда" loading="lazy" />
                )}
                {item.visual === 'goalsphere' && (
                  <Picture
                    src={heroRoute}
                    formats={['avif', 'webp']}
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 760px) 100vw, 54vw"
                    alt="Визуальный образ цифрового маршрута GoalSphere"
                    loading="lazy"
                  />
                )}
                {item.visual === 'ai' && (
                  <Picture
                    src={systemEnvironment}
                    formats={['avif', 'webp']}
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 760px) 100vw, 54vw"
                    alt="Визуализация связанной AI-системы"
                    loading="lazy"
                  />
                )}
              </div>

              <div class="work-panel__copy">
                <span class="work-panel__index">{String(index + 1).padStart(2, '0')}</span>
                <p class="work-panel__type">{item.type}</p>
                <h3>{item.name}</h3>
                <p class="work-panel__text">{item.text}</p>
                <div class="work-panel__foot">
                  <span>{item.meta}</span>
                  {item.href && (
                    <a href={item.href} target="_blank" rel="noopener">
                      Открыть сайт <ArrowUpRight size={18} weight="regular" />
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="services" id="services">
      <h2>ДЕЛАЮ.</h2>
      <div class="services__list">
        <article class="service-row">
          <h3>САЙТЫ</h3>
          <div><strong>от 70 000 ₽</strong><span>дизайн, разработка, запуск</span></div>
        </article>
        <article class="service-row">
          <h3>TELEGRAM + CRM</h3>
          <div><strong>под задачу</strong><span>боты, интеграции, автоматизация</span></div>
        </article>
        <article class="service-row">
          <h3>AI-СИСТЕМЫ</h3>
          <div><strong>под задачу</strong><span>память, анализ, рабочие процессы</span></div>
        </article>
      </div>
    </section>

    <section class="contact" id="contact">
      <p>Есть задача?</p>
      <a href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">
        <span>ОБСУДИТЬ ПРОЕКТ</span>
        <ArrowUpRight size={80} weight="regular" />
      </a>
    </section>
  </div>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const root = document.querySelector<HTMLElement>('[data-home]');
    if (root) {
      const mediaQuery = gsap.matchMedia();

      mediaQuery.add('(prefers-reduced-motion: no-preference)', () => {
        const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
        intro
          .from('.hero__line > span', { yPercent: 112, rotate: 2, duration: 1.15, stagger: .1 })
          .from('.hero__media', { clipPath: 'inset(100% 0 0 0)', scale: 1.08, duration: 1.25 }, .05)
          .from('.hero__kicker, .hero__bottom', { opacity: 0, y: 18, duration: .7, stagger: .08 }, .35);

        gsap.to('.hero__media img', {
          yPercent: 12,
          ease: 'none',
          scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1 },
        });

        gsap.from('.work__intro h2', {
          xPercent: -12,
          opacity: .25,
          ease: 'none',
          scrollTrigger: { trigger: '.work__intro', start: 'top bottom', end: 'bottom 45%', scrub: 1 },
        });

        gsap.utils.toArray<HTMLElement>('.service-row').forEach((row, index) => {
          const mobile = matchMedia('(max-width: 760px)').matches;
          gsap.from(row, {
            xPercent: mobile ? 0 : index % 2 === 0 ? -8 : 8,
            y: mobile ? 24 : 0,
            opacity: .35,
            ease: 'none',
            scrollTrigger: { trigger: row, start: 'top 88%', end: 'top 58%', scrub: .7 },
          });
        });

        gsap.from('.contact a span', {
          yPercent: 45,
          opacity: .2,
          ease: 'none',
          scrollTrigger: { trigger: '.contact', start: 'top 75%', end: 'center center', scrub: .8 },
        });
      });

      mediaQuery.add('(min-width: 761px) and (prefers-reduced-motion: no-preference)', () => {
        const panels = gsap.utils.toArray<HTMLElement>('.work-panel');
        panels.slice(0, -1).forEach((panel, index) => {
          const surface = panel.querySelector<HTMLElement>('.work-panel__surface');
          if (!surface) return;

          ScrollTrigger.create({
            trigger: panel,
            start: 'top top',
            endTrigger: panels[panels.length - 1],
            end: 'top top',
            pin: true,
            pinSpacing: false,
          });

          gsap.to(surface, {
            scale: .93,
            opacity: .32,
            filter: 'blur(3px)',
            ease: 'none',
            scrollTrigger: {
              trigger: panels[index + 1],
              start: 'top bottom',
              end: 'top top',
              scrub: true,
            },
          });
        });
      });

      document.fonts.ready.then(() => ScrollTrigger.refresh());
      document.addEventListener('astro:before-swap', () => mediaQuery.revert(), { once: true });
    }
  </script>

  <style>
    .hero { position: relative; min-height: 100dvh; overflow: hidden; padding-top: 68px; border-bottom: 1px solid var(--line-soft); }
    .hero::after { content: ''; position: absolute; inset: 68px 0 0; z-index: 0; pointer-events: none; background: linear-gradient(90deg, rgba(10,10,10,.98) 0%, rgba(10,10,10,.7) 49%, rgba(10,10,10,.06) 78%); }
    .hero__media { position: absolute; inset: 112px 2.2vw 32px 41%; overflow: hidden; transform-origin: bottom; background: var(--surface); }
    .hero__media :global(picture), .hero__media :global(img) { width: 100%; height: 112%; }
    .hero__media :global(img) { object-fit: cover; object-position: 59% center; filter: saturate(.78) contrast(1.08); }
    .hero__content { position: relative; z-index: 1; width: var(--container); min-height: calc(100dvh - 68px); margin: 0 auto; padding: clamp(42px, 7vh, 78px) 0 34px; display: flex; flex-direction: column; }
    .hero__kicker { margin: 0; color: var(--muted); font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
    .hero h1 { margin: auto 0; font-size: clamp(74px, 11.6vw, 184px); font-weight: 650; line-height: .78; letter-spacing: -.085em; }
    .hero__line { display: block; overflow: hidden; padding: .07em .1em .08em 0; }
    .hero__line > span { display: block; transform-origin: left center; }
    .hero__line em { color: var(--accent); font-style: normal; }
    .hero__bottom { width: min(760px, 66vw); display: flex; align-items: flex-end; gap: 34px; }
    .hero__bottom p { max-width: 420px; margin: 0; color: var(--muted); font-size: clamp(17px, 1.45vw, 21px); line-height: 1.42; }
    .hero__bottom .button { margin-left: auto; flex: 0 0 auto; }

    .work { position: relative; }
    .work__intro { width: var(--container); min-height: 70dvh; margin: 0 auto; display: flex; align-items: flex-end; overflow: hidden; }
    .work__intro h2, .services > h2 { margin: 0; font-size: clamp(92px, 17vw, 260px); font-weight: 650; line-height: .73; letter-spacing: -.09em; }
    .work__stack { position: relative; }
    .work-panel { min-height: 100dvh; padding-top: 68px; background: var(--bg); }
    .work-panel__surface { width: var(--container); min-height: calc(100dvh - 68px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(410px, .9fr); overflow: hidden; border-top: 1px solid var(--line); background: #101010; transform-origin: top center; }
    .work-panel--goalsphere .work-panel__surface { background: #12120f; }
    .work-panel--ai .work-panel__surface { background: #0e1210; }
    .work-panel__media { min-height: 620px; overflow: hidden; }
    .work-panel__media > img, .work-panel__media :global(picture), .work-panel__media :global(picture img) { width: 100%; height: 100%; }
    .work-panel__media > img, .work-panel__media :global(picture img) { object-fit: cover; filter: saturate(.68) contrast(1.05); transition: transform .8s cubic-bezier(.16, 1, .3, 1), filter .35s ease; }
    .work-panel--znamya .work-panel__media > img { object-position: 27% center; }
    .work-panel:hover .work-panel__media > img, .work-panel:hover .work-panel__media :global(picture img) { transform: scale(1.025); filter: saturate(.95) contrast(1.05); }
    .work-panel__copy { min-width: 0; padding: clamp(34px, 4vw, 64px); display: flex; flex-direction: column; border-left: 1px solid var(--line-soft); }
    .work-panel__index { color: var(--accent); font: 500 12px var(--font-mono); }
    .work-panel__type { max-width: 360px; margin: 8vh 0 0; color: var(--muted); font-size: 14px; }
    .work-panel h3 { max-width: 700px; margin: 20px 0 0; font-size: clamp(64px, 8vw, 128px); font-weight: 600; line-height: .84; letter-spacing: -.075em; }
    .work-panel--goalsphere h3 { font-size: clamp(58px, 5.6vw, 88px); white-space: nowrap; }
    .work-panel__text { max-width: 530px; margin: 28px 0 0; color: var(--muted); font-size: clamp(16px, 1.55vw, 21px); line-height: 1.46; }
    .work-panel__foot { margin-top: auto; padding-top: 30px; display: flex; align-items: flex-end; gap: 20px; border-top: 1px solid var(--line-soft); color: var(--faint); font: 11px var(--font-mono); }
    .work-panel__foot a { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; color: var(--text); font-family: var(--font-display); font-size: 13px; transition: color .2s ease, transform .2s ease; }
    .work-panel__foot a:hover { color: var(--accent); transform: translateY(-2px); }

    .services { width: var(--container); margin: 0 auto; padding: clamp(150px, 18vw, 280px) 0 190px; overflow: hidden; }
    .services > h2 { margin-bottom: 15vh; }
    .services__list { border-top: 1px solid var(--line); }
    .service-row { min-height: 250px; padding: 28px 0; display: grid; grid-template-columns: minmax(0, 1fr) 280px; align-items: center; gap: 32px; border-bottom: 1px solid var(--line); }
    .service-row h3 { margin: 0; font-size: clamp(52px, 8.4vw, 132px); font-weight: 550; line-height: .86; letter-spacing: -.07em; }
    .service-row div { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
    .service-row strong { color: var(--accent); font-size: 18px; font-weight: 600; }
    .service-row span { color: var(--muted); font-size: 13px; }

    .contact { min-height: 100dvh; padding: 120px max(32px, calc((100vw - min(1460px, calc(100vw - 64px))) / 2)); display: flex; flex-direction: column; justify-content: center; background: var(--accent); color: var(--accent-ink); overflow: hidden; }
    .contact p { margin: 0 0 44px; font: 500 12px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
    .contact a { display: flex; align-items: flex-end; gap: 28px; }
    .contact a span { font-size: clamp(72px, 14.4vw, 220px); font-weight: 650; line-height: .72; letter-spacing: -.09em; }
    .contact a :global(svg) { flex: 0 0 auto; margin-left: auto; transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
    .contact a:hover :global(svg) { transform: translate(10px, -10px); }

    @media (max-width: 980px) {
      .hero__media { left: 34%; }
      .hero__bottom { width: min(660px, 82vw); }
      .work-panel__surface { grid-template-columns: 1fr 1fr; }
      .work-panel h3 { font-size: clamp(56px, 8vw, 88px); }
    }

    @media (max-width: 760px) {
      .hero { padding-top: 62px; }
      .hero::after { inset: 62px 0 0; background: linear-gradient(180deg, rgba(10,10,10,.05) 20%, rgba(10,10,10,.74) 60%, rgba(10,10,10,.98) 100%); }
      .hero__media { inset: 82px 14px 38% 14px; }
      .hero__content { min-height: calc(100dvh - 62px); padding: 24px 0 20px; }
      .hero__kicker { font-size: 9px; }
      .hero h1 { margin: auto 0 26px; font-size: clamp(62px, 21vw, 92px); line-height: .8; }
      .hero__line:nth-child(2) { font-size: .71em; }
      .hero__bottom { width: 100%; align-items: stretch; gap: 18px; }
      .hero__bottom p { max-width: 190px; font-size: 14px; }
      .hero__bottom .button { min-height: 48px; margin-left: auto; padding-inline: 15px; font-size: 12px; }

      .work__intro { min-height: 52dvh; }
      .work__intro h2, .services > h2 { font-size: clamp(76px, 27vw, 118px); }
      .work-panel { min-height: auto; padding-top: 62px; }
      .work-panel__surface { min-height: calc(100dvh - 62px); grid-template-columns: 1fr; grid-template-rows: minmax(42dvh, 1fr) auto; }
      .work-panel__media { min-height: 42dvh; }
      .work-panel__copy { min-height: 50dvh; padding: 22px 0 26px; border-left: 0; border-top: 1px solid var(--line-soft); }
      .work-panel__type { margin-top: 28px; font-size: 12px; }
      .work-panel h3 { margin-top: 12px; font-size: clamp(52px, 17vw, 74px); }
      .work-panel--goalsphere h3 { font-size: clamp(50px, 15vw, 66px); white-space: normal; }
      .work-panel__text { margin-top: 20px; font-size: 15px; }
      .work-panel__foot { margin-top: 34px; font-size: 9px; }
      .work-panel__foot a { font-size: 12px; }

      .services { padding: 120px 0; }
      .services > h2 { margin-bottom: 80px; }
      .service-row { min-height: 190px; grid-template-columns: 1fr; align-content: center; gap: 26px; }
      .service-row h3 { font-size: clamp(48px, 16vw, 70px); }
      .service-row div { gap: 7px; }
      .service-row strong { font-size: 16px; }

      .contact { min-height: 82dvh; padding: 90px 14px; }
      .contact p { margin-bottom: 32px; }
      .contact a { display: grid; grid-template-columns: minmax(0, 1fr) 40px; align-items: end; gap: 12px; }
      .contact a span { max-width: 320px; font-size: clamp(54px, 16vw, 68px); line-height: .8; }
      .contact a :global(svg) { width: 40px; height: 40px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__media, .hero__line > span, .work-panel__surface, .service-row, .contact a span { opacity: 1; transform: none; filter: none; clip-path: none; }
    }
  </style>
</PapercraftLayout>

  <script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduce) {
      gsap.registerPlugin(ScrollTrigger);

      // Lenis (eased smooth scroll) ↔ ScrollTrigger
      const lenis = new Lenis({ lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // reveal: бумага «влетает» с лёгким поворотом
      gsap.utils.toArray<HTMLElement>('.pc-reveal').forEach((el) => {
        gsap.fromTo(el,
          { autoAlpha: 0, y: 34, rotate: gsap.utils.random(-2.5, 2.5) },
          { autoAlpha: 1, y: 0, rotate: 0, duration: 0.8, ease: 'back.out(1.5)',
            scrollTrigger: { trigger: el, start: 'top 88%' } });
      });
      // stagger-группы
      gsap.utils.toArray<HTMLElement>('[data-stagger]').forEach((group) => {
        gsap.fromTo(Array.from(group.children),
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, duration: 0.6, ease: 'back.out(1.4)', stagger: 0.08,
            scrollTrigger: { trigger: group, start: 'top 86%' } });
      });
      // штамп «впечатывается» при появлении
      const stampEl = document.querySelector('.pc-stamp');
      if (stampEl) {
        gsap.fromTo(stampEl,
          { scale: 1.7, rotate: -26, autoAlpha: 0 },
          { scale: 1, rotate: -3, autoAlpha: 1, duration: 0.45, ease: 'back.out(2.2)',
            scrollTrigger: { trigger: stampEl, start: 'top 82%' } });
      }

      // scroll-progress (лента сверху) — из событий Lenis
      const prog = document.getElementById('pc-progress');
      lenis.on('scroll', ({ scroll, limit }) => {
        if (prog) prog.style.transform = `scaleX(${limit ? scroll / limit : 0})`;
      });

      // parallax декоративных бумажек
      gsap.utils.toArray<HTMLElement>('[data-speed]').forEach((el) => {
        const sp = parseFloat(el.dataset.speed || '0');
        gsap.to(el, {
          y: () => sp * 70, ease: 'none',
          scrollTrigger: { trigger: el.closest('section') || el, start: 'top bottom', end: 'bottom top', scrub: 0.5 },
        });
      });

      // hero scroll-scrub: видео-сборка скрабится по скроллу, секция пинится (десктоп)
      ScrollTrigger.matchMedia({
        '(min-width: 901px)': () => {
          const hbuild = document.getElementById('hero-build') as HTMLVideoElement | null;
          const hsec = document.querySelector<HTMLElement>('.pc-hero');
          const hpin = document.querySelector<HTMLElement>('.pc-hero__pin');
          if (!hbuild || !hsec || !hpin) return;
          // грузим тяжёлое hero-видео только на десктопе (где есть scrub); на мобиле остаётся постер
          hbuild.preload = 'auto';
          hbuild.load();
          hbuild.pause();
          ScrollTrigger.create({
            trigger: hsec, start: 'top top', end: 'bottom bottom',
            pin: hpin, scrub: true, anticipatePin: 1, invalidateOnRefresh: true,
            onUpdate: (self) => { const d = hbuild.duration; if (d) hbuild.currentTime = Math.min(d - 0.04, self.progress * d); },
          });
          hbuild.addEventListener('loadedmetadata', () => ScrollTrigger.refresh());
        },
      });

      // pinned horizontal scroll пути заявки + «оживание» карточек (только десктоп)
      ScrollTrigger.matchMedia({
        '(min-width: 901px)': () => {
          const track = document.getElementById('flow-track');
          const section = document.querySelector<HTMLElement>('.pc-flow');
          if (!track || !section) return;
          const dist = () => Math.max(0, track.scrollWidth - window.innerWidth + 60);
          const horizontalTween = gsap.to(track, {
            x: () => -dist(), ease: 'none',
            scrollTrigger: {
              trigger: section, start: 'top top', end: () => '+=' + dist(),
              pin: true, scrub: 0.8, anticipatePin: 1, invalidateOnRefresh: true,
            },
          });
          // фон этапов едет ровно с карточками (1:1, та же дистанция и scrub)
          gsap.fromTo(section,
            { backgroundPositionX: '0px' },
            { backgroundPositionX: () => -dist() + 'px', ease: 'none',
              scrollTrigger: { trigger: section, start: 'top top', end: () => '+=' + dist(), scrub: 0.8, invalidateOnRefresh: true } });
          // карточки «оживают», проезжая центр (containerAnimation по горизонтальному тену)
          gsap.utils.toArray<HTMLElement>('.pc-jcard').forEach((card) => {
            gsap.fromTo(card,
              { scale: 0.92, autoAlpha: 0.55 },
              { scale: 1, autoAlpha: 1, ease: 'none',
                scrollTrigger: { trigger: card, containerAnimation: horizontalTween, start: 'left 88%', end: 'center 62%', scrub: true } });
          });
        },
      });

      // магнитные кнопки (курсор тянет)
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const mx = (e.clientX - (r.left + r.width / 2)) * 0.35;
            const my = (e.clientY - (r.top + r.height / 2)) * 0.35;
            el.style.transform = `translate(${mx}px, ${my}px)`;
          });
          el.addEventListener('mouseleave', () => { el.style.transform = ''; });
        });
      }

      // кастомный курсор: облачко-стейн + чернильная точка (кольцо убрано)
      if (window.matchMedia('(pointer: fine)').matches) {
        const cloud = document.getElementById('pc-cloud');
        const dot = document.getElementById('pc-cur');
        let tx = window.innerWidth / 2, ty = window.innerHeight / 2;
        let cx = tx, cy = ty;
        window.addEventListener('mousemove', (e) => {
          tx = e.clientX; ty = e.clientY;
          if (dot) dot.style.transform = `translate(${tx}px, ${ty}px) translate(-50%, -50%)`;
        });
        const loop = () => {
          cx += (tx - cx) * 0.12; cy += (ty - cy) * 0.12;
          if (cloud) cloud.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
        [cloud, dot].forEach((el) => { if (el) el.style.opacity = '1'; });
        document.documentElement.classList.add('pc-cursor-on');
      }
    }

    // hover-play записей кейсов — готово под реальное <video>
    document.querySelectorAll<HTMLElement>('.pc-case2[data-hover]').forEach((card) => {
      const v = card.querySelector('video');
      if (!v) return;
      card.addEventListener('mouseenter', () => v.play().catch(() => {}));
      card.addEventListener('mouseleave', () => v.pause());
    });

    // видео-петли играют по мере появления в кадре, пауза вне экрана (perf)
    if (!reduce) {
      const vio = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
        });
      }, { threshold: 0.15 });
      document.querySelectorAll<HTMLVideoElement>('video[data-vplay]').forEach((v) => vio.observe(v));

      // play-once: проигрывается один раз при появлении и замирает на последнем кадре (не перезапускается)
      const vonce = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { (e.target as HTMLVideoElement).play().catch(() => {}); vonce.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      document.querySelectorAll<HTMLVideoElement>('video[data-vonce]').forEach((v) => vonce.observe(v));
    }
  </script>
</PapercraftBase>

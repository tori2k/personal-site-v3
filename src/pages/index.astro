---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ManifestScreen from '../components/ManifestScreen.astro';
import Approach from '../components/Approach.astro';
import Portfolio from '../components/Portfolio.astro';
import FlowBlock from '../components/FlowBlock.astro';
import MethodBlock from '../components/MethodBlock.astro';
import Pricing from '../components/Pricing.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyGuide from '../components/StickyGuide.astro';
import { faqItems } from '../data/faq';

// JSON-LD: FAQPage из тех же вопросов (блок FAQ убран с главной, но разметка для SEO остаётся)
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout jsonLd={faqJsonLd}>
  <Nav />
  <main>
    <Hero />
    <ManifestScreen />
    <Approach />
    <Portfolio />
    <FlowBlock />
    <MethodBlock />
    <Pricing />
    <FinalCta />
  </main>
  <Footer />
  <StickyGuide />
</Layout>

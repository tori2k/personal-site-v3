---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Approach from '../components/Approach.astro';
import ForWhom from '../components/ForWhom.astro';
import FlowBlock from '../components/FlowBlock.astro';
import CalcPreview from '../components/CalcPreview.astro';
import Portfolio from '../components/Portfolio.astro';
import LeadMagnetPreview from '../components/LeadMagnetPreview.astro';
import MethodBlock from '../components/MethodBlock.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { faqItems } from '../data/faq';

// JSON-LD: FAQPage из тех же вопросов, что в блоке FAQ
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout jsonLd={faqJsonLd}>
  <Nav />
  <main>
    <Hero />
    <Approach />
    <FlowBlock />
    <CalcPreview />
    <ForWhom />
    <Portfolio />
    <Pricing />
    <LeadMagnetPreview />
    <MethodBlock />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Layout>

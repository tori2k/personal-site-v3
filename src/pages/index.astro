      .pc-flow__viewport { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
      .pc-flow__track { transform: none !important; padding: 0 24px 14px; }
      .pc-jcard { scroll-snap-align: start; flex-basis: 76vw; }

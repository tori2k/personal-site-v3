    /* галочки в кейсе «пристукивают» */
    .pc-case2__points li span { display: inline-block; transition: transform .2s ease; }
    .pc-case2__points li:hover span { transform: scale(1.45) rotate(-9deg); }
    /* цифры этапов подмигивают */
    .pc-jcard:hover .pc-jcard__n { animation: pc-wiggle .55s ease; }

    /* ═══ рэнсом-буквы — как вырезанные из газет ═══ */

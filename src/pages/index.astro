---
import { ArrowUpRightIcon as ArrowUpRight } from '@phosphor-icons/react';
import PapercraftLayout from '../layouts/PapercraftLayout.astro';
import { cases } from '../data/cases';

const znamya = cases.find((item) => item.slug === 'znamya-truda')!;
const goalsphere = cases.find((item) => item.slug === 'goalsphere')!;
const aiProjectManager = cases.find((item) => item.slug === 'ai-project-manager')!;
const manifik = cases.find((item) => item.slug === 'manifik')!;
const tsentsova = cases.find((item) => item.slug === 'tsentsova')!;
---
<PapercraftLayout
  title="Кирилл Барыев: сайты, системы и AI"
  description="Проектирую и запускаю сайты, Telegram- и AI-системы для бизнеса. Сайты от 70 000 ₽."
>
  <div class="portfolio" data-home>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__content">
        <p class="hero__kicker">Личная инженерная студия</p>
        <h1 id="hero-title">
          <span class="hero__line"><span>САЙТЫ.</span></span>
          <span class="hero__line"><span>СИСТЕМЫ <em>+ AI.</em></span></span>
        </h1>
        <div class="hero__action">
          <p>Проектирую и запускаю цифровые продукты для бизнеса.</p>
          <a class="button" href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">
            Обсудить проект <ArrowUpRight size={18} weight="regular" />
          </a>
        </div>
      </div>

      <div class="hero-gallery" aria-label="Фрагменты реализованных проектов">
        <figure class="hero-shot hero-shot--main" data-hero-depth="main">
          <img src={goalsphere.screenshots[0].src} width={goalsphere.screenshots[0].width} height={goalsphere.screenshots[0].height} alt={goalsphere.screenshots[0].alt} loading="eager" fetchpriority="high" />
          <figcaption>GoalSphere</figcaption>
        </figure>
        <figure class="hero-shot hero-shot--secondary" data-hero-depth="back">
          <img src={znamya.screenshots[0].src} width={znamya.screenshots[0].width} height={znamya.screenshots[0].height} alt={znamya.screenshots[0].alt} loading="eager" />
          <figcaption>Знамя Труда</figcaption>
        </figure>
        <figure class="hero-shot hero-shot--mobile" data-hero-depth="front">
          <img src={goalsphere.screenshots[1].src} width={goalsphere.screenshots[1].width} height={goalsphere.screenshots[1].height} alt={goalsphere.screenshots[1].alt} loading="eager" />
          <figcaption>GoalSphere, mobile</figcaption>
        </figure>
      </div>
    </section>

    <section class="showcase" id="work" aria-labelledby="work-title">
      <header class="section-title"><h2 id="work-title">КРУПНЫМ ПЛАНОМ.</h2></header>

      <article class="flagship flagship--znamya" id="case-znamya" data-case="znamya-truda">
        <div class="flagship__head">
          <p>{znamya.type}</p>
          <h3>{znamya.title}</h3>
          <ul>{znamya.confirmedFacts.map((fact) => <li>{fact}</li>)}</ul>
          <a href={znamya.publicUrl} target="_blank" rel="noopener">Открыть сайт <ArrowUpRight size={20} weight="regular" /></a>
        </div>
        <div class="znamya-sequence">
          <figure class="media-reveal media-reveal--wide" data-reveal>
            <img src={znamya.screenshots[0].src} width={znamya.screenshots[0].width} height={znamya.screenshots[0].height} alt={znamya.screenshots[0].alt} loading="lazy" />
          </figure>
          <div class="znamya-sequence__details">
            <figure class="media-reveal" data-reveal>
              <img src={znamya.screenshots[1].src} width={znamya.screenshots[1].width} height={znamya.screenshots[1].height} alt={znamya.screenshots[1].alt} loading="lazy" />
            </figure>
            <figure class="media-reveal" data-reveal>
              <img src={znamya.screenshots[2].src} width={znamya.screenshots[2].width} height={znamya.screenshots[2].height} alt={znamya.screenshots[2].alt} loading="lazy" />
            </figure>
          </div>
        </div>
      </article>

      <article class="flagship flagship--goalsphere" id="case-goalsphere" data-case="goalsphere">
        <header class="goalsphere-copy">
          <p>{goalsphere.type}</p>
          <h3>{goalsphere.title}</h3>
          <div>
            <span>{goalsphere.contribution.join(' / ')}</span>
            <a href={goalsphere.publicUrl} target="_blank" rel="noopener">Открыть сайт <ArrowUpRight size={20} weight="regular" /></a>
          </div>
        </header>
        <div class="goalsphere-diptych">
          <figure class="media-reveal goalsphere-diptych__desktop" data-reveal>
            <img src={goalsphere.screenshots[0].src} width={goalsphere.screenshots[0].width} height={goalsphere.screenshots[0].height} alt={goalsphere.screenshots[0].alt} loading="lazy" />
          </figure>
          <figure class="media-reveal goalsphere-diptych__mobile" data-reveal>
            <img src={goalsphere.screenshots[1].src} width={goalsphere.screenshots[1].width} height={goalsphere.screenshots[1].height} alt={goalsphere.screenshots[1].alt} loading="lazy" />
          </figure>
        </div>
        <div class="goalsphere-sequence">
          <figure class="media-reveal" data-reveal>
            <img src={goalsphere.screenshots[2].src} width={goalsphere.screenshots[2].width} height={goalsphere.screenshots[2].height} alt={goalsphere.screenshots[2].alt} loading="lazy" />
          </figure>
          <figure class="media-reveal" data-reveal>
            <img src={goalsphere.screenshots[3].src} width={goalsphere.screenshots[3].width} height={goalsphere.screenshots[3].height} alt={goalsphere.screenshots[3].alt} loading="lazy" />
          </figure>
        </div>
      </article>

      <article class="flagship flagship--ai" id="case-ai-project-manager" data-case="ai-project-manager">
        <div class="ai-copy">
          <p>{aiProjectManager.type}</p>
          <h3>AI Project<br />Manager</h3>
          <p class="ai-copy__summary">Рабочая память проекта, а не демонстрационный чат.</p>
        </div>
        <div class="ai-facts" aria-label="Подтверждённые факты о системе">
          <strong>2</strong><span>агентства</span>
          <strong>≈10</strong><span>пользователей</span>
          <strong>4</strong><span>рабочих чата</span>
          <p>Созвоны, саммари, анализ договорённостей, задачи, решения и длинная память.</p>
          <small>Реальные скриншоты не опубликованы. Перед показом нужна обезличенная версия.</small>
        </div>
      </article>
    </section>

    <section class="registry" id="registry" aria-labelledby="registry-title">
      <header class="registry__title">
        <p>Все клиентские проекты</p>
        <h2 id="registry-title">РЕЕСТР РАБОТ.</h2>
      </header>
      <div class="registry-list">
        {cases.map((item) => (
          <article class:list={['registry-row', `registry-row--${item.slug}`]} data-reveal>
            <div class="registry-row__name"><p>{item.type}</p><h3>{item.title}</h3></div>
            <div class="registry-row__facts">{item.confirmedFacts.slice(0, 2).map((fact) => <span>{fact}</span>)}</div>
            <div class="registry-row__status"><span>{item.statusLabel}</span><small>{item.permission}</small></div>
            <div class="registry-row__action">
              {item.publicUrl && item.status !== 'unavailable' ? (
                <a href={item.publicUrl} target="_blank" rel="noopener" aria-label={`Открыть сайт ${item.title}`}><ArrowUpRight size={24} weight="regular" /></a>
              ) : <span aria-hidden="true">Нет публичной ссылки</span>}
            </div>
            {item.slug === 'manifik' && (
              <div class="registry-preview registry-preview--manifik" aria-hidden="true">
                <img src={manifik.screenshots[0].src} width={manifik.screenshots[0].width} height={manifik.screenshots[0].height} alt="" loading="lazy" />
                <img src={manifik.screenshots[2].src} width={manifik.screenshots[2].width} height={manifik.screenshots[2].height} alt="" loading="lazy" />
              </div>
            )}
            {item.slug === 'tsentsova' && (
              <div class="registry-preview" aria-hidden="true"><img src={tsentsova.screenshots[0].src} width={tsentsova.screenshots[0].width} height={tsentsova.screenshots[0].height} alt="" loading="lazy" /></div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="services" id="services" aria-labelledby="services-title">
      <h2 id="services-title">ТРИ НАПРАВЛЕНИЯ.</h2>
      <div class="services__list">
        <article class="service-row" data-reveal><h3>САЙТЫ</h3><div><strong>от 70 000 ₽</strong><span>дизайн, разработка, запуск</span></div></article>
        <article class="service-row" data-reveal><h3>TELEGRAM + CRM</h3><div><strong>под задачу</strong><span>боты, интеграции, автоматизация</span></div></article>
        <article class="service-row" data-reveal><h3>AI-СИСТЕМЫ</h3><div><strong>под задачу</strong><span>память, анализ, рабочие процессы</span></div></article>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <p>Есть задача?</p>
      <a href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">
        <span id="contact-title">ОБСУДИТЬ ПРОЕКТ</span><ArrowUpRight size={80} weight="regular" />
      </a>
    </section>
  </div>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const root = document.querySelector<HTMLElement>('[data-home]');
    if (root) {
      const motion = gsap.matchMedia();
      motion.add('(prefers-reduced-motion: no-preference)', () => {
        const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
        intro
          .from('.hero__line > span', { yPercent: 108, rotate: 1.5, duration: 1.05, stagger: .08 })
          .from('.hero-shot--main', { clipPath: 'inset(100% 0 0 0)', scale: 1.04, duration: 1.1 }, .08)
          .from('.hero-shot--secondary, .hero-shot--mobile', { clipPath: 'inset(0 0 100% 0)', y: 24, duration: .85, stagger: .12 }, .28)
          .from('.hero__kicker, .hero__action', { opacity: 0, y: 16, duration: .65, stagger: .08 }, .35);

        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((element) => {
          gsap.from(element, {
            clipPath: 'inset(0 0 16% 0)', y: 32, opacity: .25, duration: .9, ease: 'power3.out',
            scrollTrigger: { trigger: element, start: 'top 88%', once: true },
          });
        });
        gsap.from('.ai-facts > *', {
          y: 24, opacity: 0, duration: .55, stagger: .07, ease: 'power2.out',
          scrollTrigger: { trigger: '.flagship--ai', start: 'top 68%', once: true },
        });
      });

      motion.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
        gsap.to('[data-hero-depth="main"] img', { yPercent: 8, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: .9 } });
        gsap.to('[data-hero-depth="back"]', { yPercent: -9, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1.1 } });
        gsap.to('[data-hero-depth="front"]', { yPercent: -15, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: .8 } });
        gsap.from('.goalsphere-diptych__mobile', { xPercent: 24, rotate: 2, opacity: .3, ease: 'none', scrollTrigger: { trigger: '.goalsphere-diptych', start: 'top 78%', end: 'center 48%', scrub: .8 } });
      });

      document.fonts.ready.then(() => ScrollTrigger.refresh());
      document.addEventListener('astro:before-swap', () => motion.revert(), { once: true });
    }
  </script>

  <style>
    .portfolio { overflow: clip; }
    .hero { width: var(--container); min-height: 100dvh; margin: 0 auto; padding: 122px 0 48px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto 1fr; gap: 32px 18px; border-bottom: 1px solid var(--line); }
    .hero__content { z-index: 2; grid-column: 1 / 8; align-self: start; }
    .hero__kicker { margin: 0 0 28px; color: var(--muted); font: 500 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
    .hero h1 { margin: 0; font-size: clamp(72px, 9.4vw, 148px); font-weight: 620; line-height: .82; letter-spacing: -.085em; }
    .hero__line { display: block; overflow: hidden; padding: .04em .08em .08em 0; }
    .hero__line > span { display: block; transform-origin: left center; }
    .hero__line em { color: var(--accent); font-style: normal; }
    .hero__action { max-width: 610px; margin-top: 32px; display: flex; align-items: center; gap: 24px; }
    .hero__action p { max-width: 350px; margin: 0; color: var(--muted); font-size: 17px; }
    .hero__action .button { margin-left: auto; flex: 0 0 auto; }
    .hero-gallery { grid-column: 5 / -1; min-height: 50vh; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); grid-template-rows: repeat(5, minmax(70px, 1fr)); gap: 14px; align-self: end; }
    .hero-shot { min-width: 0; margin: 0; overflow: hidden; background: var(--surface); }
    .hero-shot img { width: 100%; height: 100%; object-fit: cover; }
    .hero-shot figcaption { padding: 8px 0 0; color: var(--muted); background: var(--bg); font: 10px var(--font-mono); }
    .hero-shot--main { grid-column: 1 / 7; grid-row: 1 / 5; }
    .hero-shot--main img, .hero-shot--secondary img, .hero-shot--mobile img { height: calc(100% - 27px); }
    .hero-shot--secondary { grid-column: 1 / 5; grid-row: 4 / 6; z-index: 2; }
    .hero-shot--secondary img { object-position: top; }
    .hero-shot--mobile { grid-column: 7 / -1; grid-row: 2 / 6; z-index: 3; }
    .hero-shot--mobile img { object-position: top; }

    .showcase { padding-top: clamp(150px, 18vw, 260px); }
    .section-title { width: var(--container); margin: 0 auto 130px; }
    .section-title h2, .registry__title h2, .services > h2 { max-width: 1240px; margin: 0; font-size: clamp(70px, 12vw, 184px); font-weight: 620; line-height: .78; letter-spacing: -.085em; }
    .flagship { width: var(--container); margin: 0 auto; padding: 0 0 clamp(160px, 18vw, 280px); }
    .flagship__head { position: sticky; top: 96px; z-index: 3; width: min(460px, 34vw); margin-bottom: -260px; padding: 28px; background: rgba(10, 10, 10, .94); border: 1px solid var(--line); backdrop-filter: blur(16px); }
    .flagship__head > p, .goalsphere-copy > p, .ai-copy > p { margin: 0; color: var(--muted); font-size: 13px; }
    .flagship__head h3 { margin: 18px 0 0; font-size: clamp(52px, 6vw, 92px); font-weight: 580; line-height: .86; letter-spacing: -.07em; }
    .flagship__head ul { margin: 26px 0 34px; padding: 0; display: grid; gap: 10px; list-style: none; color: var(--muted); font-size: 14px; }
    .flagship__head li::before { content: '/'; margin-right: 9px; color: var(--accent); }
    .flagship__head a, .goalsphere-copy a { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
    .flagship__head a:hover, .goalsphere-copy a:hover { color: var(--accent); }
    .znamya-sequence { margin-left: 20%; display: grid; gap: 14px; }
    .znamya-sequence__details { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding-left: 18%; }
    .media-reveal { margin: 0; overflow: hidden; background: var(--surface); }
    .media-reveal img { width: 100%; height: 100%; object-fit: cover; transition: transform .75s cubic-bezier(.16, 1, .3, 1); }
    .media-reveal:hover img { transform: scale(1.018); }
    .media-reveal--wide { aspect-ratio: 16 / 10; }
    .znamya-sequence__details .media-reveal { aspect-ratio: 4 / 3; }

    .flagship--goalsphere { padding-top: 40px; }
    .goalsphere-copy { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; align-items: end; margin-bottom: 64px; }
    .goalsphere-copy > p { grid-column: 1 / 4; align-self: start; }
    .goalsphere-copy h3 { grid-column: 4 / -1; margin: 0; font-size: clamp(82px, 12vw, 180px); font-weight: 600; line-height: .75; letter-spacing: -.09em; }
    .goalsphere-copy > div { grid-column: 4 / -1; display: flex; align-items: center; gap: 24px; color: var(--muted); font: 11px var(--font-mono); }
    .goalsphere-copy a { margin-left: auto; color: var(--text); font-family: var(--font-display); }
    .goalsphere-diptych { display: grid; grid-template-columns: minmax(0, 3fr) minmax(220px, .72fr); align-items: end; gap: 16px; }
    .goalsphere-diptych__desktop { aspect-ratio: 16 / 9; }
    .goalsphere-diptych__mobile { aspect-ratio: 390 / 844; }
    .goalsphere-sequence { margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .goalsphere-sequence .media-reveal { aspect-ratio: 16 / 10; }

    .flagship--ai { min-height: 92dvh; padding: clamp(80px, 10vw, 150px); display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(60px, 8vw, 140px); align-items: center; background: var(--surface); }
    .ai-copy h3 { margin: 24px 0 0; font-size: clamp(82px, 10vw, 154px); font-weight: 600; line-height: .76; letter-spacing: -.09em; }
    .ai-copy__summary { max-width: 560px; margin: 52px 0 0 !important; color: var(--text) !important; font-size: clamp(20px, 2vw, 30px) !important; }
    .ai-facts { display: grid; grid-template-columns: auto 1fr; gap: 4px 22px; align-items: baseline; }
    .ai-facts strong { color: var(--accent); font-size: clamp(72px, 8vw, 120px); font-weight: 560; line-height: .86; letter-spacing: -.075em; }
    .ai-facts span { color: var(--muted); font-size: 16px; }
    .ai-facts p, .ai-facts small { grid-column: 1 / -1; }
    .ai-facts p { margin: 46px 0 0; font-size: 20px; line-height: 1.42; }
    .ai-facts small { margin-top: 24px; padding-top: 18px; color: var(--muted); border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; }

    .registry { width: var(--container); margin: 0 auto; padding: clamp(150px, 18vw, 260px) 0; }
    .registry__title { margin-bottom: 120px; }
    .registry__title > p { margin: 0 0 24px; color: var(--muted); font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
    .registry-list { border-top: 1px solid var(--line); }
    .registry-row { position: relative; min-height: 220px; padding: 32px 0; display: grid; grid-template-columns: 3.2fr 3fr 2.2fr 56px; gap: 32px; align-items: center; border-bottom: 1px solid var(--line); }
    .registry-row__name p { margin: 0 0 10px; color: var(--muted); font-size: 12px; }
    .registry-row__name h3 { margin: 0; font-size: clamp(42px, 5vw, 72px); font-weight: 560; line-height: .9; letter-spacing: -.065em; }
    .registry-row__facts { display: grid; gap: 9px; color: var(--muted); font-size: 13px; }
    .registry-row__facts span::before { content: '/'; margin-right: 8px; color: var(--accent); }
    .registry-row__status { display: grid; gap: 10px; font-size: 13px; }
    .registry-row__status small { color: var(--muted); line-height: 1.4; }
    .registry-row__action { justify-self: end; }
    .registry-row__action a { width: 52px; height: 52px; display: grid; place-items: center; border: 1px solid var(--line); transition: color .2s ease, border-color .2s ease, transform .2s ease; }
    .registry-row__action a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-3px); }
    .registry-row__action > span { display: none; }
    .registry-preview { position: absolute; z-index: 8; right: 7%; bottom: 72%; width: min(400px, 31vw); aspect-ratio: 16 / 10; overflow: hidden; pointer-events: none; opacity: 0; transform: translateY(16px) scale(.96); background: var(--surface); transition: opacity .28s ease, transform .38s cubic-bezier(.16, 1, .3, 1); }
    .registry-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .registry-preview--manifik img:last-child { opacity: 0; transition: opacity .35s ease; }
    .registry-row:hover .registry-preview { opacity: 1; transform: none; }
    .registry-row--manifik:hover .registry-preview img:last-child { opacity: 1; }

    .services { width: var(--container); margin: 0 auto; padding: 20px 0 clamp(150px, 16vw, 240px); }
    .services > h2 { margin-bottom: 120px; }
    .services__list { border-top: 1px solid var(--line); }
    .service-row { min-height: 240px; padding: 30px 0; display: grid; grid-template-columns: minmax(0, 1fr) 280px; align-items: center; gap: 32px; border-bottom: 1px solid var(--line); }
    .service-row h3 { margin: 0; font-size: clamp(52px, 8vw, 126px); font-weight: 550; line-height: .86; letter-spacing: -.075em; }
    .service-row div { display: grid; gap: 9px; }
    .service-row strong { color: var(--accent); font-size: 18px; font-weight: 600; }
    .service-row span { color: var(--muted); font-size: 13px; }

    .contact { min-height: 100dvh; padding: 120px max(32px, calc((100vw - min(1460px, calc(100vw - 64px))) / 2)); display: flex; flex-direction: column; justify-content: center; color: var(--accent-ink); background: var(--accent); overflow: hidden; }
    .contact p { margin: 0 0 44px; font: 500 12px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
    .contact a { display: flex; align-items: flex-end; gap: 28px; }
    .contact a span { font-size: clamp(72px, 14vw, 214px); font-weight: 650; line-height: .72; letter-spacing: -.09em; }
    .contact a :global(svg) { flex: 0 0 auto; margin-left: auto; transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
    .contact a:hover :global(svg) { transform: translate(10px, -10px); }

    @media (max-width: 980px) {
      .hero__content { grid-column: 1 / 10; }
      .hero-gallery { grid-column: 3 / -1; }
      .flagship__head { width: min(430px, 45vw); }
      .znamya-sequence { margin-left: 14%; }
      .flagship--ai { padding-inline: 48px; grid-template-columns: 1fr 1fr; }
      .registry-row { grid-template-columns: 2.5fr 2fr 2fr 48px; gap: 22px; }
    }

    @media (max-width: 760px) {
      .hero { min-height: auto; padding: 96px 0 26px; display: block; }
      .hero__kicker { margin-bottom: 18px; font-size: 9px; }
      .hero h1 { font-size: clamp(58px, 17.5vw, 76px); line-height: .82; }

---
import PapercraftLayout from '../layouts/PapercraftLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import CaseStories from '../components/CaseStories.astro';
import AIProcessDemo from '../components/AIProcessDemo.astro';
import WorkingJourney from '../components/WorkingJourney.astro';
import Arrow from '../components/Arrow.astro';
import { cases } from '../data/cases';
import { personId, siteUrl } from '../lib/structured-data';
const goal=cases.find(p=>p.slug==='goalsphere')!;
const znamya=cases.find(p=>p.slug==='znamya-truda')!;
const secondary=cases.filter(p=>['manifik','tsentsova'].includes(p.slug));
const descriptions:Record<string,string> = {
  manifik:'Сайт школы вокала: направления, преподаватели и переход к онлайн-записи. Дизайн, разработка и адаптив.',
  tsentsova:'Сайт арбитражного управляющего и интеграция с Битрикс24: заявки с сайта поступают в CRM.',
};
const services=[
  { slug:'websites', title:'Сайты', text:'От структуры и дизайна до работающего сайта. Адаптив, анимации, CMS и запуск.', topic:'Для вашего бизнеса', tags:['Дизайн','Разработка','Запуск'] },
  { slug:'telegram-crm', title:'Чат-боты + CRM', text:'Чат-боты любой сложности: от приёма заявок до AI-ассистентов и сложных интеграций с вашими системами.', topic:'Для ежедневных задач', tags:['Telegram','Битрикс24','AI-боты'] },
  { slug:'ai-systems', title:'AI-системы', text:'Ассистенты, саммари встреч, работа с контекстом и автоматизация рутины.', topic:'Для вашей команды', tags:['AI-ассистенты','Автоматизация'] },
];
const portfolioOrder = [goal, znamya, ...secondary, cases.find(p=>p.slug==='ai-project-manager')!, cases.find(p=>p.slug==='aesoqua')!];
const caseDescriptions:Record<string,string> = {
  ...descriptions,
  goalsphere:'Интерактивный сайт агентства. Концепция и разработка.',
  'znamya-truda':'Сайт клуба и CMS. Дизайн и разработка.',
  'ai-project-manager':'Из созвонов и переписки — в саммари, договорённости и задачи. С памятью о контексте проекта.',
  aesoqua:'Бартерный проект: концепция, дизайн и разработка сайта.',
};
const homeJsonLd = [
  ...services.map(service => ({
    '@type':'Service', '@id':`${siteUrl}#service-${service.slug}`,
    name:service.title, description:service.text,
    url:`${siteUrl}#service-${service.slug}`, provider:{'@id':personId},
  })),
  {
    '@type':'ItemList', '@id':`${siteUrl}#portfolio`, name:'Проекты Кирилла Барыева',
    numberOfItems:portfolioOrder.length, itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:portfolioOrder.map((project,index)=>({
      '@type':'ListItem', position:index+1,
      item:{
        '@type':'CreativeWork', '@id':`${siteUrl}#case-${project.slug}`,
        name:project.title, description:caseDescriptions[project.slug],
        url:project.publicUrl ?? `${siteUrl}#case-${project.slug}`,
        contributor:{'@id':personId},
        ...(project.screenshots[0] ? {image:new URL(project.screenshots[0].src,siteUrl).href} : {}),
      },
    })),
  },
];
---
<PapercraftLayout jsonLd={homeJsonLd} title="Кирилл Барыев — сайты, системы и AI" description="Проектирую и запускаю сайты, Telegram-ботов, CRM-интеграции и AI-системы для бизнеса. Реальные проекты и прямой контакт.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__intro">
      <h1 id="hero-title"><span class="title-line"><span>Сайты.</span></span><span class="title-line"><span>Системы + <em>AI.</em></span></span></h1>
      <div class="hero__aside">
        <p>Проектирую и запускаю<br class="desktop-break" /> цифровые продукты для бизнеса.</p>
        <a class="button" href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">Обсудить проект <Arrow /></a>
      </div>
    </div>
    <div class="project-stage" id="work">
      <div class="stage-crest" aria-hidden="true"><span></span></div>
      <div class="stage-surface" aria-hidden="true"></div>
      <div class="stage-note">Разные проекты.<br /> Один подход к деталям.</div>
      <article class="stage-project stage-project--goal" id="case-goalsphere" data-case="goalsphere">
        <ProjectPreview project={goal} eager />
        <div class="stage-caption"><a href={goal.publicUrl} target="_blank" rel="noopener" data-case-open="story-goalsphere" aria-controls="story-goalsphere"><span><h2>GoalSphere</h2><p>Интерактивный сайт агентства · Концепция и разработка</p><span class="stage-caption__action">Смотреть кейс</span></span><Arrow /></a></div>
      </article>
      <article class="stage-project stage-project--znamya" id="case-znamya-truda" data-case="znamya-truda">
        <ProjectPreview project={znamya} eager cropBottom={40} />
        <div class="stage-caption"><a href={znamya.publicUrl} target="_blank" rel="noopener" data-case-open="story-znamya-truda" aria-controls="story-znamya-truda"><span><h2>Знамя Труда</h2><p>Сайт клуба и CMS · Дизайн и разработка</p><span class="stage-caption__action">Смотреть кейс</span></span><Arrow /></a></div>
      </article>
      <a class="stage-next" href="#projects"><span>Ещё проекты</span><span class="stage-next__line"></span><span>Смотреть все проекты</span><Arrow size={18} /></a>
    </div>
  </section>
  <CaseStories />
  <section class="more-work" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><h2 id="projects-title" data-reveal>Другие проекты</h2><p>Сайты, интеграции и системы,<br />которыми пользуются в работе.</p></div>
    <div class="project-pair">
      {secondary.map((project)=>(
        <article class={`work-project work-project--${project.slug}`} id={`case-${project.slug}`} data-case={project.slug}>
          <div class="work-project__visual" data-image-reveal><ProjectPreview project={project} /></div>
          <a class="work-project__title" href={project.publicUrl} target="_blank" rel="noopener" data-track={`click_case_${project.slug}`}><h3>{project.title}</h3><Arrow size={28}/></a>
          <p>{descriptions[project.slug]}</p>
        </article>
      ))}
    </div>
    <div class="text-projects">
      <AIProcessDemo />
      <article class="text-project text-project--compact" id="case-aesoqua" data-case="aesoqua">
        <div><h3>Aesoqua</h3><span class="project-status">Сайт для автора</span></div>
        <div class="text-project__copy"><p>Бартерный проект: концепция, дизайн и разработка сайта.</p><span>Без публичной ссылки</span></div>
      </article>
    </div>
  </section>

  <section class="services" id="services" aria-labelledby="services-title">
    <div class="services__intro"><h2 id="services-title" data-reveal>Что могу<br /><span>сделать для вас</span></h2><p>Работаю лично — от первой идеи<br />до запуска и настройки.</p></div>
    <div class="service-list">
      {services.map(service=>(<a class="service" id={`service-${service.slug}`} href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram">
        <div class="service__name"><h3>{service.title}</h3><span>{service.topic}</span></div>
        <div class="service__body"><p>{service.text}</p><div class="service__tags">{service.tags.map(tag=><span>{tag}</span>)}</div></div>
        <Arrow size={38}/>
      </a>))}
    </div>
  </section>

  <WorkingJourney />
  <section class="contact" aria-labelledby="contact-title">
    <div class="contact__sheet" aria-hidden="true"></div>
    <div class="contact__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="contact__inner"><div><h2 id="contact-title">Есть задача?<br />Давайте <em>обсудим.</em></h2><p>Напишите в Telegram. Разберём, что нужно вашему проекту.</p></div><a class="contact__link" href="https://t.me/tori2k" target="_blank" rel="noopener" data-track="click_telegram"><span>Обсудить проект</span><Arrow size={54}/><span class="contact__handle">@tori2k</span></a></div>
  </section>
</PapercraftLayout>
<script>
  import '../scripts/home-motion';
  import '../scripts/home-interactions';
</script>
<style>
  .stage-caption__action { display:inline-block; font-size:12px; margin-top:9px; border-bottom:1px solid currentColor; padding-bottom:2px; color:#34345f; }
  .hero__intro { perspective:1400px; }
  .stage-crest { overflow:hidden; }.stage-crest span { position:absolute; width:80%; height:80%; border:1px solid #ffffff60; border-radius:inherit; left:18%; top:18%; }
  .contact__orbit { position:absolute; width:640px; height:640px; right:-230px; top:-140px; z-index:-1; pointer-events:none; }
  .contact__orbit i { position:absolute; inset:0; border:1px solid #ffffff24; border-radius:50%; }
  .contact__orbit i:nth-child(2) { inset:65px; }.contact__orbit i:nth-child(3) { inset:130px; }
  @media(max-width:700px) { .contact__orbit { width:440px; height:440px; right:-260px; top:-20px; } }

  .contact__link:focus-visible { outline-color:#fff; }
  .hero { overflow:clip; }.hero__intro { position:relative; z-index:2; width:var(--container); height:280px; margin:auto; display:grid; grid-template-columns:minmax(0,2.35fr) minmax(0,1fr); align-items:center; gap:64px; padding-bottom:20px; }
  h1 { font-size:clamp(72px,8.33vw,148px); font-weight:750; line-height:.86; letter-spacing:-.04em; margin-left:-8px; }.title-line { display:block; white-space:nowrap; overflow:clip; padding-bottom:.08em; margin-bottom:-.08em; }.title-line>span { display:block; }h1 em { font-style:normal; color:var(--accent); }
  .hero__aside { padding-top:18px; }.hero__aside p { font-size:clamp(17px,1.5vw,25px); line-height:1.35; letter-spacing:-.02em; margin-bottom:25px; }.desktop-break { display:none; }
  .project-stage { position:relative; height:658px; isolation:isolate; }.stage-surface { position:absolute; inset:0; background:var(--surface); border-radius:150px 80px 0 0; z-index:-1; }.stage-crest { position:absolute; width:220px; height:190px; right:-55px; top:-77px; border-radius:110px 0 0 0; background:var(--accent); z-index:-2; }
  .stage-note { position:absolute; left:5.6%; top:76px; color:#62627d; font-size:14px; line-height:1.5; }
  .stage-project { position:absolute; }.stage-project--goal { width:54%; right:10.2%; top:50px; }.stage-project--znamya { width:34.4%; left:5.6%; top:172px; z-index:2; }
  .stage-caption { margin-top:16px; }.stage-caption a { display:flex; align-items:center; gap:26px; width:fit-content; }.stage-caption h2 { font-size:20px; font-weight:600; letter-spacing:-.025em; }.stage-caption p { margin-top:3px; font-size:12px; color:#61617b; }.stage-caption svg { transition:transform .45s var(--ease); }.stage-caption a:hover svg { transform:translate(4px,-4px); }.stage-caption a:hover h2 { color:var(--accent); }.stage-project--goal .stage-caption { padding-left:88px; }
  .stage-next { position:absolute; left:5.6%; right:5%; bottom:29px; display:flex; align-items:center; gap:28px; font-size:12px; }.stage-next>span:first-child { color:#62627d; }.stage-next__line { height:1px; flex:1; background:#b9b9dc; transition:transform .6s var(--ease); }.stage-next:hover .stage-next__line { transform:scaleX(.96); }
  @media(min-width:1700px) { .project-stage { height:740px; }.hero__intro { height:320px; } }
  @media(max-width:1100px) { .hero__intro { height:250px; gap:24px; grid-template-columns:2fr 1fr; }h1 { font-size:8.6vw; }.hero__aside p { font-size:17px; }.hero__aside .button { font-size:16px; min-height:56px; padding:0 22px; }.project-stage { height:540px; }.stage-project--goal { right:7%; width:59%; }.stage-project--znamya { width:37%; top:150px; }.stage-note { font-size:12px; top:64px; }.stage-project--goal .stage-caption { padding-left:74px; }.stage-caption p { max-width:180px; } }
  @media(max-width:700px) { .hero__intro { height:auto; padding:30px 0 60px; display:block; }h1 { font-size:11.5vw; line-height:.98; margin-left:-3px; }.hero__aside { display:flex; align-items:center; gap:24px; padding-top:30px; }.hero__aside p { margin:0; font-size:17px; flex:1; }.hero__aside .button { font-size:14px; padding:0 16px; }.project-stage { height:720px; }.stage-surface { border-radius:64px 40px 0 0; }.stage-crest { top:-42px; height:150px; width:160px; }.stage-note { position:relative; top:auto; left:auto; padding:30px 28px 20px; font-size:13px; }.stage-note br { display:none; }.stage-project--goal { width:78%; right:6%; top:100px; }.stage-project--znamya { width:65%; left:6%; top:360px; }.stage-project--goal .stage-caption { padding-left:0; }.stage-caption { margin-top:12px; }.stage-caption h2 { font-size:18px; }.stage-caption p { font-size:11px; max-width:none; }.stage-next { left:6%; right:6%; font-size:11px; gap:14px; }.stage-next>span:first-child { display:none; } }
  @media(max-width:480px) { .hero__aside { align-items:flex-start; flex-direction:column; gap:22px; }.hero__aside p { max-width:280px; font-size:18px; }.hero__aside .button { font-size:16px; padding:0 24px; }.hero__intro { padding:22px 0 62px; }.project-stage { height:705px; }.stage-project--goal { width:84%; right:5%; top:98px; }.stage-project--znamya { width:76%; left:5%; top:368px; }.stage-caption a { gap:16px; }.stage-next { bottom:28px; } }
  .more-work,.services { width:var(--container); margin:auto; }
  .more-work { padding:112px 0 0; }.section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; margin-bottom:52px; }.section-heading h2,.services__intro h2 { font-size:clamp(42px,4.3vw,70px); line-height:1.06; letter-spacing:-.04em; font-weight:600; }.section-heading>p { color:var(--muted); font-size:16px; }
  .project-pair { display:grid; grid-template-columns:1.15fr 1fr; gap:9%; align-items:start; }.work-project--tsentsova { padding-top:104px; }.work-project__visual { border-radius:14px; }.work-project__title { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:24px; }.work-project__title h3 { font-size:30px; font-weight:550; letter-spacing:-.035em; }.work-project__title svg { transition:transform .5s var(--ease); }.work-project__title:hover { color:var(--accent); }.work-project__title:hover svg { transform:translate(4px,-4px); }.work-project>p { max-width:500px; margin-top:12px; font-size:15px; line-height:1.55; color:var(--muted); }
  .text-projects { margin-top:76px; }.text-project { position:relative; display:grid; grid-template-columns:1fr 1fr; gap:9%; padding:42px 10% 42px 0; border-top:1px solid var(--line); }.text-project h3 { font-size:clamp(28px,3vw,46px); line-height:1.08; font-weight:550; letter-spacing:-.04em; }.project-status { display:block; margin-top:16px; color:var(--muted); font-size:13px; }.text-project__copy { padding-top:2px; }.text-project__copy p { font-size:19px; line-height:1.5; }.text-project__copy>span { display:block; margin-top:18px; font-size:13px; color:var(--muted); }.text-project--compact { padding-block:32px; }.text-project--compact h3 { font-size:32px; }.text-project--compact p { font-size:16px; }
  .services { padding:85px 0 75px; }.services__intro { display:flex; align-items:flex-end; justify-content:space-between; gap:48px; margin-bottom:50px; }.services__intro h2>span { color:var(--accent); }.services__intro>p { color:var(--muted); font-size:16px; padding-bottom:5px; }
  .service { position:relative; isolation:isolate; display:grid; grid-template-columns:1fr 1fr 44px; align-items:center; gap:54px; padding:34px 0; border-top:1px solid var(--line); }.service:last-child { border-bottom:1px solid var(--line); }.service::before { content:''; position:absolute; z-index:-1; inset:0 -26px; background:var(--surface); border-radius:16px; transform:scaleY(0); transform-origin:bottom; transition:transform .6s var(--ease); }.service:hover::before,.service:focus-visible::before { transform:scaleY(1); }.service__name h3 { font-size:clamp(28px,3.4vw,52px); line-height:1.1; letter-spacing:-.04em; font-weight:500; transition:transform .6s var(--ease); }.service:hover h3 { transform:translateX(12px); }.service__name>span { display:block; font-size:12px; margin-top:13px; color:var(--muted); }.service__body p { font-size:15px; color:var(--muted); line-height:1.55; max-width:440px; }.service__tags { display:flex; flex-wrap:wrap; gap:14px; margin-top:15px; font-size:11px; color:#5b5b70; }.service>svg { transition:transform .6s var(--ease),color .3s; }.service:hover>svg { transform:rotate(45deg); color:var(--accent); }
  .contact { position:relative; isolation:isolate; overflow:clip; background:#dfdffd; }.contact__sheet { position:absolute; inset:0; border-radius:120px 0 0 0; background:var(--accent); z-index:-1; }.contact__inner { width:var(--container); margin:auto; padding:80px 0 78px; color:#fff; display:flex; align-items:flex-end; justify-content:space-between; gap:56px; }.contact h2 { font-size:clamp(52px,5.5vw,88px); line-height:1.02; font-weight:550; letter-spacing:-.04em; }.contact h2 em { font-style:normal; color:#dddfff; }.contact p { margin-top:25px; color:#e6e7ff; font-size:15px; }.contact__link { display:grid; grid-template-columns:1fr auto; align-items:center; gap:18px 28px; padding:18px 0; border-bottom:1px solid #ffffff70; min-width:280px; font-size:24px; }.contact__handle { grid-column:1/-1; font-size:14px; color:#e6e7ff; }.contact__link>svg { transition:transform .6s var(--ease); }.contact__link:hover>svg { transform:translate(8px,-8px); }
  @media(max-width:1000px) { .service { gap:28px; grid-template-columns:1fr 1.15fr 38px; }.contact__inner { gap:36px; }.contact__link { min-width:230px; font-size:20px; }.text-project__copy p { font-size:17px; } }
  @media(max-width:700px) {
    .more-work { padding-top:64px; }.section-heading { display:block; margin-bottom:34px; }.section-heading>p { margin-top:18px; font-size:14px; }.section-heading h2,.services__intro h2 { font-size:40px; }.project-pair { grid-template-columns:1fr; gap:38px; }.work-project--tsentsova { padding:0; width:90%; margin-left:auto; }.work-project__title { margin-top:18px; }.work-project__title h3 { font-size:26px; }.work-project>p { font-size:14px; }.text-projects { margin-top:48px; }.text-project { grid-template-columns:1fr; padding:30px 0; gap:24px; }.text-project h3 { font-size:32px; }.text-project h3 br { display:none; }.project-status { font-size:12px; margin-top:9px; }.text-project__copy p { font-size:16px; }.text-project__copy>span { font-size:12px; margin-top:12px; }
    .services { padding:55px 0 55px; }.services__intro { display:block; margin-bottom:30px; }.services__intro>p { margin-top:22px; font-size:15px; }.service { grid-template-columns:1fr 30px; gap:20px; padding:28px 0; }.service__name h3 { font-size:30px; }.service__name>span { display:none; }.service__body { grid-column:1/-1; grid-row:2; }.service>svg { grid-column:2; grid-row:1; width:28px; height:28px; }.service__tags { margin-top:12px; }.service::before { inset:0 -12px; }.service:hover h3 { transform:none; }
    .contact__sheet { border-radius:64px 0 0 0; }.contact__inner { display:block; padding:64px 0 40px; }.contact h2 { font-size:clamp(44px,10.5vw,64px); }.contact p { max-width:300px; font-size:14px; margin-top:22px; }.contact__link { margin-top:25px; font-size:20px; gap:10px; }.contact__link svg { width:38px; height:38px; }
  }
</style>

---
import PapercraftBase from '../layouts/PapercraftBase.astro';

// Структура 1:1 с главной kirillbaryev.ru, стиль — папиркрафт.
// Механики перенесены с боевого сайта/ТЕПЛЕЕ: pinned horizontal scroll (путь заявки),
// sticky-stack (кейсы), reveal/stagger, курсор-облачко, hero-артборд на cqw.
const offerCards = [
  { key: 'Оффер', desc: 'Формулируем услугу так, чтобы клиент понял ценность и следующий шаг.', icon: '/pc/offer-1.png' },
  { key: 'Заявка', desc: 'Форма или квиз отправляют обращение в Telegram / CRM.', icon: '/pc/offer-2.png' },
  { key: 'Система', desc: 'Сайт, таблица лидов, аналитика и follow-up работают вместе.', icon: '/pc/offer-3.png' },
];
const perks = [
  'Чистый код без конструкторов и подписок',
  'Первая версия за 3–5 дней',
  'Заявки приходят в Telegram',
  'Исходники остаются у вас',
];
const steps = [
  { n: '01', t: 'Контент-завод', d: 'Короткие видео гонят трафик из соцсетей.', img: '/pc/step-01.webp', vid: '/pc/video/step-01.mp4' },
  { n: '02', t: 'Сайт — точка входа', d: 'Лендинг объясняет ценность и ведёт к заявке.', site: true, img: '/pc/step-02.webp', vid: '/pc/video/step-02.mp4' },
  { n: '03', t: 'Заявка → Telegram', d: 'Обращение мгновенно прилетает в чат.', img: '/pc/step-03.webp', vid: '/pc/video/step-03.mp4' },
  { n: '04', t: 'Лид в CRM / таблице', d: 'Со статусом, источником и данными.', img: '/pc/step-04.webp', vid: '/pc/video/step-04.mp4' },
  { n: '05', t: 'AI-дожим', d: 'Бот доводит холодных до записи.', img: '/pc/step-05.webp', vid: '/pc/video/step-05.mp4' },
  { n: '06', t: 'Онлайн-оплата', d: 'Клиент платит прямо на сайте.', img: '/pc/step-06.webp', vid: '/pc/video/step-06.mp4' },
  { n: '07', t: 'Воронка / статусы', d: 'Видно, кто на какой стадии.', img: '/pc/step-07.webp', vid: '/pc/video/step-07.mp4' },
];
const cases = [
  {
    init: 'M', title: 'Manifik', niche: 'Школа вокала', status: 'В продакшене',
    url: 'https://manifik-school.ru', vid: '/pc/video/manifik.mp4', poster: '/pc/manifik.jpg',
    task: 'Сайт, через который родители находят педагогов и сразу записываются и оплачивают — без звонков.',
    points: ['Запись на пробный → Telegram', 'Оплата занятий прямо на сайте', 'Цены и расписание без разработчика', 'Путь «нашёл → записался» в три клика'],
    automated: 'Заявка → Telegram → таблица со статусом',
  },
  {
    init: 'Ф', title: 'ФК «Знамя Труда»', niche: 'Футбольный клуб · Орехово-Зуево', status: 'Запущен',
    url: 'https://fczt1909.ru', vid: '/pc/video/znamya.mp4', poster: '/pc/znamya.jpg',
    task: 'Официальный сайт старейшего клуба России: матч, состав и новости за 10 секунд.',
    points: ['Навигация под сценарий болельщика', 'Новости публикует редактор без программиста', 'Страница партнёров как предложение', 'Один источник вместо разрозненных пабликов'],
    automated: 'Публикация новостей через CMS',
  },
];

// рэнсом-буквы (как вырезанные из газет): каждая буква — свой шрифт, цвет, наклон, размер
const ransomFonts = ["'Unbounded',sans-serif", "'Special Elite',monospace", "'Caveat',cursive", "Georgia,'Times New Roman',serif", "'Courier New',monospace"];
const ransomSkins = [
  ['#f4ead2', '#2c2418'], ['#7b4cff', '#ffffff'], ['#d9694a', '#fff7ef'],
  ['#e9c45a', '#3a2c10'], ['#2c2418', '#f4ead2'], ['#cdb486', '#2c2418'],
];
function ransom(text) {
  let li = 0, prevSkin = -1;
  return Array.from(text).map((ch, i) => {
    if (ch === ' ') return { space: true };
    const seed = text.charCodeAt(i) * 7 + i * 13 + 3;
    let si = seed % ransomSkins.length;
    if (si === prevSkin) si = (si + 1) % ransomSkins.length;  // соседи не одного цвета
    prevSkin = si;
    const [bg, fg] = ransomSkins[si];
    return {
      ch,
      font: ransomFonts[(seed >> 1) % ransomFonts.length],
      bg, fg,
      rot: (seed % 15) - 7,
      sz: (0.82 + ((seed >> 2) % 6) * 0.06).toFixed(2),
      d: (li++ * 0.045).toFixed(2),
    };
  });
}

---
<PapercraftBase
  title="Кирилл Барыев — сайты и AI-воронки, которые ловят заявки"
  description="Собираю сайт, квиз, Telegram-заявки, CRM и AI-дожим, чтобы лиды не умирали после клика. Больше обработанных заявок без расширения штата. Первый разбор бесплатно."
  bodyClass="pc-body"
>
  <script is:inline>
    // FOUC-safe: прячем reveal-элементы только если включены анимации
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('pc-anim');
    }
  </script>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="torn"><feTurbulence type="fractalNoise" baseFrequency="0.013 0.022" numOctaves="3" seed="7" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="7"/></filter>
    <filter id="torn2"><feTurbulence type="fractalNoise" baseFrequency="0.016 0.02" numOctaves="3" seed="21" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="6"/></filter>
  </svg>

  <main class="pc">
    <div class="pc-grain" aria-hidden="true"></div>
    <div class="pc-cloud" id="pc-cloud" aria-hidden="true"></div>
    <div class="pc-progress" id="pc-progress" aria-hidden="true"></div>
    <div class="pc-cur" id="pc-cur" aria-hidden="true"></div>

    <!-- ════ NAV ════ -->
    <header class="pc-nav">
      <a href="#top" class="pc-nav__brand"><span class="pc-tape"></span>Кирилл<span class="pc-dot">.</span></a>
      <nav class="pc-nav__links">
        <a href="/services">Услуги</a><a href="/method">Метод</a><a href="/cases">Кейсы</a><a href="/razbor">Разбор</a>
      </nav>
      <span class="pc-nav__avail"><i></i>доступен</span>
      <a href="https://t.me/tori2k" data-track="click_telegram" class="pc-btn pc-btn--sm">в&nbsp;Telegram</a>
    </header>

    <!-- ════ HERO — cinematic scroll-build (pinned scrub) ════ -->
    <section class="pc-hero" id="top">
      <div class="pc-hero__pin">
        <video class="pc-hero__build" id="hero-build" src="/pc/video/hero-build.mp4" poster="/pc/hero-build.jpg" muted playsinline preload="none" aria-hidden="true"></video>
        <div class="pc-hero__scrim" aria-hidden="true"></div>
        <div class="pc-hero__content">
          <span class="pc-eyebrow"><i class="pc-bdot"></i>Клиники, салоны, эксперты, малый бизнес</span>
          <h1 class="pc-h1">больше обработанных<br/><span class="pc-ransom">{ransom('заявок').map((l) => l.space ? <span class="pc-ransom__sp"></span> : <span class="pc-ransom__l" style={`font-family:${l.font};background:${l.bg};color:${l.fg};--rot:${l.rot}deg;--d:${l.d}s;font-size:${l.sz}em`}>{l.ch}</span>)}</span> без расширения штата</h1>
          <p class="pc-lead">Собираю сайт/квиз, Telegram-заявки, CRM/таблицу и&nbsp;AI-дожим, чтобы лиды не&nbsp;умирали после клика.</p>
          <div class="pc-hero__actions">
            <a href="/razbor" class="pc-btn" data-magnetic><span class="pc-btn__plus">(+)</span>Найти 3 точки слива</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ MARQUEE — бумажная лента ════ -->
    <div class="pc-marquee" aria-hidden="true">
      <div class="pc-marquee__track">
        <span class="pc-marquee__row">сайты <i>✷</i> квизы <i>✷</i> Telegram-заявки <i>✷</i> CRM <i>✷</i> AI-дожим <i>✷</i> онлайн-оплата <i>✷</i> автоворонки <i>✷</i> сайты <i>✷</i> квизы <i>✷</i> Telegram-заявки <i>✷</i> CRM <i>✷</i> AI-дожим <i>✷</i> онлайн-оплата <i>✷</i> автоворонки <i>✷</i> </span>
        <span class="pc-marquee__row">сайты <i>✷</i> квизы <i>✷</i> Telegram-заявки <i>✷</i> CRM <i>✷</i> AI-дожим <i>✷</i> онлайн-оплата <i>✷</i> автоворонки <i>✷</i> сайты <i>✷</i> квизы <i>✷</i> Telegram-заявки <i>✷</i> CRM <i>✷</i> AI-дожим <i>✷</i> онлайн-оплата <i>✷</i> автоворонки <i>✷</i> </span>
      </div>
    </div>

    <!-- ════ APPROACH ════ -->
    <section class="pc-sec pc-about" id="about">
      <span class="pc-sticker pc-sticker--hand" style="--rot:-9deg; top:6px; right:18px">сделано вручную</span>
      <div class="pc-about__left pc-reveal">
        <div class="pc-polaroid pc-paper">
          <img class="pc-washi" src="/pc/washi.png" alt="" aria-hidden="true" />
          <video class="pc-photo" src="/pc/video/portrait.mp4" poster="/pc/portrait.webp" muted playsinline preload="none" data-vonce aria-label="Кирилл Барыев"></video>
          <div class="pc-polaroid__cap">это&nbsp;я</div>
        </div>
        <div class="pc-trust pc-paper">
          <div class="pc-trust__t">Один инженер. <span class="pc-hand">весь стек.</span></div>
          <p>Делаю сам — от&nbsp;структуры до&nbsp;деплоя. Без подрядчиков и&nbsp;передачи задач.</p>
        </div>
      </div>
      <div class="pc-about__right">
        <div class="pc-reveal">
          <span class="pc-eyebrow"><i class="pc-bdot"></i>Для экспертов, юристов и сервисного бизнеса</span>
          <h2 class="pc-h2">Сайты и AI-воронки <span class="pc-mark">под заявки</span></h2>
          <p class="pc-lead">Собираю систему, где клиент понимает ценность, а&nbsp;вы не&nbsp;теряете обращения.</p>
        </div>
        <div class="pc-offer" data-stagger>
          {offerCards.map((c) => (
            <div class="pc-offer__card pc-paper">
              <img class="pc-offer__icon" src={c.icon} alt="" aria-hidden="true" loading="lazy" />
              <div>
                <div class="pc-offer__k">{c.key}</div>
                <div class="pc-offer__d">{c.desc}</div>
              </div>
            </div>
          ))}
        </div>
        <ul class="pc-perks" data-stagger>
          {perks.map((p, i) => (<li><span class="pc-perks__n">{`0${i + 1}`}</span>{p}</li>))}
        </ul>
      </div>
    </section>

    <!-- ════ MANIFEST — бумажная карточка, наклеенная на картон ════ -->
    <section class="pc-manifest">
      <span class="pc-sticker pc-sticker--ai" style="--rot:12deg; top:-22px; right:40px">AI</span>
      <div class="pc-manifest__paper pc-paper pc-reveal">
        <img class="pc-manifest__tape" src="/pc/washi.png" alt="" aria-hidden="true" />
        <p>Заявка не&nbsp;должна <span class="pc-ransom">{ransom('умирать после клика').map((l) => l.space ? <span class="pc-ransom__sp"></span> : <span class="pc-ransom__l" style={`font-family:${l.font};background:${l.bg};color:${l.fg};--rot:${l.rot}deg;--d:${l.d}s;font-size:${l.sz}em`}>{l.ch}</span>)}</span>. Собираю систему, которая ловит каждый лид и&nbsp;доводит его до&nbsp;вас — в&nbsp;Telegram, в&nbsp;CRM, к&nbsp;продаже.</p>
      </div>
    </section>

    <!-- ════ LEAD JOURNEY — pinned horizontal scroll ════ -->
    <section class="pc-flow" id="flow">
      <div class="pc-flow__head pc-reveal">
        <span class="pc-eyebrow"><i class="pc-bdot"></i>Путь заявки</span>
        <h2 class="pc-h2">Как лид <span class="pc-mark">проходит</span> систему</h2>
        <p class="pc-lead">От&nbsp;касания до&nbsp;оплаты — каждый шаг автоматизирован.</p>
      </div>
      <div class="pc-flow__viewport">
        <ul class="pc-flow__track" id="flow-track">
          {steps.map((s, i) => (
            <>
              <li class="pc-jcard pc-paper">
                <div class="pc-jcard__media"><video src={s.vid} poster={s.img} muted loop playsinline preload="none" data-vplay aria-label={s.t}></video>{s.site && <span class="pc-jcard__tag">сайт</span>}</div>
                <span class="pc-jcard__n">{s.n}</span>
                <div class="pc-jcard__t">{s.t}</div>
                <div class="pc-jcard__d">{s.d}</div>
              </li>
              {i < steps.length - 1 && <li class="pc-thread" aria-hidden="true"></li>}
            </>
          ))}
        </ul>
      </div>
    </section>

    <!-- ════ PORTFOLIO — sticky-stack ════ -->
    <section class="pc-sec" id="work">
      <span class="pc-sticker pc-sticker--new" style="--rot:-11deg; top:18px; right:22px">NEW</span>
      <div class="pc-railhead pc-reveal">
        <span class="pc-eyebrow"><i class="pc-bdot"></i>Сайты-входы</span>
        <h2 class="pc-h2">А сайт — <span class="pc-mark">вход в систему</span></h2>
        <p class="pc-lead">Чем понятнее вход, тем больше заявок доходит до&nbsp;автоматизаций.</p>
      </div>
      <div class="pc-cases">
        {cases.map((c, i) => (
          <article class="pc-case2 pc-paper" data-hover style={`top: calc(96px + ${i * 26}px); z-index: ${i + 1}`}>
            <a href={c.url} target="_blank" rel="noopener" class="pc-case2__media">
              <img class="pc-case2__frame" src="/pc/caseframe.webp" alt="" aria-hidden="true" />
              <span class="pc-case2__screen" aria-hidden="true">
                <video class="pc-case2__vid" src={c.vid} poster={c.poster} muted loop playsinline preload="none"></video>
                <span class="pc-case2__tint"></span>
              </span>
              <span class="pc-case2__status">{c.status}</span>
              <span class="pc-case2__play">▶ запись</span>
            </a>
            <div class="pc-case2__body">
              <div class="pc-case2__niche">{c.niche}</div>
              <div class="pc-case2__title">{c.title}</div>
              <p class="pc-case2__task">{c.task}</p>
              <ul class="pc-case2__points">{c.points.map((p) => (<li><span>✓</span>{p}</li>))}</ul>
              <div class="pc-case2__auto"><b>Автоматизировано:</b> {c.automated}</div>
            </div>
          </article>
        ))}
        <article class="pc-case2 pc-case2--all pc-paper2" style={`top: calc(96px + ${cases.length * 26}px); z-index: ${cases.length + 1}`}>
          <div>Все кейсы<br/>с записями работы</div>
          <a href="/cases" class="pc-btn pc-btn--sm">Открыть →</a>
        </article>
      </div>
    </section>

    <!-- ════ FINAL CTA ════ -->
    <section class="pc-sec pc-ctasec" id="contact">
      <span class="pc-sticker pc-sticker--star" style="--rot:14deg; top:6px; left:34px">★</span>
      <div class="pc-ticket pc-paper pc-reveal">
        <img class="pc-stamp" src="/pc/stamp.png" alt="бесплатно" />
        <h2 class="pc-h2">Получите план <span class="pc-mark">роста конверсии бизнеса</span></h2>
        <p class="pc-lead pc-lead--c">Напишите нишу и&nbsp;что продаёте — покажу, где вы&nbsp;теряете заявки.</p>
        <a href="/razbor" class="pc-btn" data-magnetic><span class="pc-btn__plus">(+)</span>Получить разбор</a>
      </div>
    </section>

    <!-- ════ FOOTER ════ -->
    <footer class="pc-foot">
      <div class="pc-foot__inner">
        <div class="pc-foot__brand">Кирилл<span class="pc-dot">.</span></div>
        <div class="pc-foot__mid">Сайты на&nbsp;Astro&nbsp;+&nbsp;Tailwind · Москва · удалённо</div>
        <nav class="pc-foot__links"><a href="/services">Услуги</a><a href="/method">Метод</a><a href="/cases">Кейсы</a><a href="/articles">Блог</a><a href="/razbor">Разбор</a></nav>
        <div class="pc-foot__copy">© 2026 Кирилл Барыев</div>
      </div>
    </footer>
  </main>

  <a href="#contact" class="pc-guide pc-paper">(+)&nbsp;Разбор</a>

  <style is:global>
    .pc-body { background: #bd9457; }
    /* FOUC-safe pre-hide для reveal/stagger */
    html.pc-anim .pc-reveal,
    html.pc-anim [data-stagger] > * { opacity: 0; visibility: hidden; }
    /* системный курсор прячем только когда кастомный реально включился (JS отработал) */
    @media (pointer: fine) { html.pc-cursor-on, html.pc-cursor-on * { cursor: none; } }
  </style>

  <style>
    .pc {
      --paper: #f4ead2; --paper2: #ece0c0; --ink: #2c2418; --ink-soft: #6a5c44;
      --mark: #7b4cff; --mark-soft: #e7defb; --mark2: #d9694a;
      position: relative; font-family: 'Special Elite', 'Courier New', monospace; color: var(--ink);
      text-shadow: .42px 0 0 currentColor, -.42px 0 0 currentColor;  /* overstrike — плотнее/читаемее, как двойной удар машинки */
      background: #bd9457 url('/pc/kraft.webp') 0 0 / 760px repeat;  /* едет со скроллом — как длинная бумага */
      min-height: 100vh; overflow-x: clip;  /* clip, не hidden — чтобы sticky/pin работали */
    }
    .pc-grain { display: none; }   /* наложенное зерно убрано */
    /* курсор-облачко — тёплое «пятно от кофе» */
    .pc-cloud {
      position: fixed; top: 0; left: 0; z-index: 0; pointer-events: none;
      width: 360px; height: 360px; border-radius: 50%;
      background: radial-gradient(circle, rgba(120,76,28,0.18), rgba(120,76,28,0.06) 45%, transparent 70%);
      filter: blur(36px); mix-blend-mode: multiply; opacity: 0;
      transition: opacity 0.6s; will-change: transform;
    }
    @media (hover: none) { .pc-cloud { display: none; } }

    /* кастомный курсор: чернильная точка + бумажное кольцо */
    .pc-cur { position: fixed; top: 0; left: 0; pointer-events: none; transform: translate(-50%,-50%); will-change: transform; opacity: 0; z-index: 9999; width: 24px; height: 24px; background: url('/pc/cursor.png') center/contain no-repeat; }
    @media (hover: none) { .pc-cur { display: none; } }

    /* поверх облачка/зерна — контент */
    .pc-nav { z-index: 3; }
    .pc-hero, .pc-sec, .pc-flow, .pc-manifest, .pc-foot { position: relative; z-index: 2; }

    .pc-paper { background: var(--paper); filter: url(#torn) drop-shadow(0 14px 20px rgba(40,28,12,0.3)); }
    .pc-paper2 { background: var(--paper2); filter: url(#torn2) drop-shadow(0 10px 16px rgba(40,28,12,0.28)); }

    .pc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'Special Elite', monospace; font-size: 12px; letter-spacing: .5px; text-transform: uppercase; color: #5734b8; }
    .pc-bdot { width: 8px; height: 8px; border-radius: 50%; background: var(--mark2); }
    .pc-hand { font-family: 'Caveat', cursive; font-size: 1.3em; color: var(--mark); }
    .pc-dot { color: var(--mark); }
    .pc-mark { position: relative; color: var(--ink); background: var(--mark-soft); box-shadow: 0 0 0 4px var(--mark-soft); border-radius: 3px; }
    .pc-mark::after { content: ''; position: absolute; left: -2px; right: -2px; bottom: -3px; height: 4px; background: var(--mark); border-radius: 2px; opacity: .85; }
    .pc-h2 { font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: clamp(26px, 3.6vw, 42px); margin: 10px 0 0; }
    .pc-lead { margin: 20px 0 0; max-width: 540px; font-size: 17px; line-height: 1.65; color: var(--ink-soft); }
    .pc-lead--c { margin: 16px auto 0; text-align: center; }

    /* placeholders под AI */
    .pc-ph { position: relative; display: flex; align-items: center; justify-content: center; background: rgba(123,76,255,0.07); border: 2px dashed rgba(123,76,255,0.5); border-radius: 4px; }
    .pc-ph::before { content: attr(data-ai); font-family: 'Special Elite', monospace; font-size: 12px; color: var(--mark); text-align: center; padding: 8px; }
    .pc-ph--pill { display: inline-flex; width: 92px; height: 54px; vertical-align: middle; margin: 0 6px; }
    .pc-ph--pill::before { font-size: 9px; }
    .pc-ph--photo { aspect-ratio: 3/4; }
    .pc-ph--media { aspect-ratio: 4/3; margin-bottom: 14px; }

    /* кнопки */

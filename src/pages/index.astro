    .pc-sticker--ai { width: 60px; height: 60px; background: var(--mark); font-size: 19px; }
    .pc-sticker--new { width: 62px; height: 62px; background: var(--mark2); font-size: 15px; letter-spacing: .5px; }
    .pc-sticker--star { width: 56px; height: 56px; background: #e9c45a; color: var(--ink); font-size: 26px; }
    .pc-sticker--hand { width: 96px; height: 96px; background: #f4ead2; color: var(--ink); border-style: dashed; border-color: var(--ink); font-family: 'Caveat', cursive; font-weight: 700; font-size: 21px; padding: 8px; }

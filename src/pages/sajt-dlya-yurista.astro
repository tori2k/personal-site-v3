---
import Layout from '../layouts/Layout.astro';
import SeoLanding from '../components/SeoLanding.astro';

const title = 'Сайт для юриста и адвоката под заявки — лендинг с квизом и Telegram';
const description = 'Разработка сайта для юриста: оффер по специализации, кейсы практики, квиз для квалификации и заявки в Telegram. Первый разбор бесплатно, запуск от 3–5 дней.';

const forWhom = [
  'Юристы частной практики',
  'Адвокаты и адвокатские кабинеты',
  'Семейное и наследственное право',
  'Арбитраж и банкротство',
  'Корпоративные и налоговые юристы',
  'Юридические бюро 1–5 человек',
];

const pains = [
  {
    title: 'Клиент не видит специализацию',
    body: 'На сайте написано «юридические услуги» — и клиент уходит к тому, кто прямо сказал «банкротство физлиц под ключ». Оффер по нише объясняет, чем вы отличаетесь, за 5 секунд.',
  },
  {
    title: 'Заявки теряются в переписках',
    body: 'Звонок, директ, мессенджер, почта — обращения приходят в пять разных мест, часть забывается. Форма и квиз собирают заявку в одно русло и присылают её в Telegram.',
  },
  {
    title: 'Приходят нецелевые обращения',
    body: 'Без квалификации вы тратите время на консультации, которые не конвертируются. Квиз задаёт 3–5 вопросов и отсеивает тех, кому вы не подходите, до первого диалога.',
  },
];

const includes = [
  'Оффер по вашей специализации на первом экране',
  'Блок доверия: кейсы практики, опыт, регалии',
  'Квиз для квалификации обращения (тип дела, срочность, бюджет)',
  'Форма заявки → сообщение в Telegram в нужном формате',
  'Таблица лидов: имя, ниша дела, ссылка, статус, источник',
  'UTM-метки — видно, с какой рекламы пришёл клиент',
  'Адаптив под телефон и свой домен',
  'Чистый код без конструкторов, исходники остаются у вас',
];

const formats = [
  {
    name: 'Экспресс-лендинг',
    price: 'от 49 000 ₽',
    desc: 'Одна услуга или специализация, оффер, доверие, форма заявки в Telegram. Запуск за 3–5 дней.',
  },
  {
    name: 'Лендинг эксперта',
    price: '75 000–95 000 ₽',
    desc: 'Кейсы практики, цены, FAQ, квиз для квалификации, аналитика. Для юриста, которого выбирают внимательно.',
  },
  {
    name: 'Система заявок',
    price: '120 000–300 000 ₽',
    desc: 'Сайт + Telegram-бот + CRM/таблица + автоматизации. Каждое обращение фиксируется и не теряется.',
  },
];

const intro = [
  'Юриста выбирают по доверию и по понятности. Если на первом экране сайта написано «широкий спектр юридических услуг», клиент не понимает, ваше ли это дело, и идёт к тому, кто прямо назвал его проблему: «спишем долги через банкротство», «развод и раздел имущества без вашего присутствия в суде», «сопровождение сделок с недвижимостью». <strong>Сайт для юриста под заявки</strong> строится вокруг одной мысли: человек за пять секунд должен понять вашу специализацию и сделать следующий шаг.',
  'Я собираю не «сайт-визитку», а маршрут заявки. Первый экран объясняет услугу и для кого она. Дальше идёт блок доверия — кейсы практики, выигранные дела, опыт и регалии: то, что снимает страх «доверю ли я этому человеку своё дело». Затем квиз: 3–5 вопросов о типе дела, срочности и ситуации. Квиз делает две вещи — квалифицирует клиента и собирает контекст, чтобы вы пришли на первый разговор уже понимая суть.',
  'Заявка не остаётся на сайте. Она приходит в <strong>Telegram</strong> отформатированным сообщением: имя, ниша дела, контакт, ответы из квиза и ссылка на источник. Параллельно лид попадает в таблицу со статусом — «новый», «в работе», «закрыт» — и UTM-меткой, по которой видно, с какой рекламы или поста пришёл человек. Так вы перестаёте терять обращения в переписках и видите, какой канал реально приносит дела.',
  'Всё работает на чистом коде, без конструкторов и ежемесячных подписок. Сайт грузится быстро (Lighthouse 95+), индексируется поисковиками и остаётся вашим — исходники и доступы я передаю вам. Если у вас уже есть сайт, не обязательно делать новый: иногда достаточно переработать первый экран и настроить приём заявок. Что именно нужно — покажу на бесплатном разборе.',
];

const faq = [
  {
    q: 'Сколько стоит сайт для юриста?',
    a: 'Экспресс-лендинг под одну специализацию — от 49 000 ₽, запуск за 3–5 дней. Лендинг с кейсами, квизом и аналитикой — 75 000–95 000 ₽. Полная система заявок с Telegram-ботом и CRM — от 120 000 ₽. Точную цену называю после бесплатного разбора.',
  },
  {
    q: 'Чем сайт под заявки отличается от обычного сайта-визитки?',
    a: 'Визитка просто рассказывает о вас. Сайт под заявки ведёт клиента по маршруту: оффер по специализации → доверие через кейсы → квиз для квалификации → заявка в Telegram и таблицу. Каждый блок решает одну задачу, и ни одно обращение не теряется.',
  },
  {
    q: 'Зачем юристу квиз на сайте?',
    a: 'Квиз задаёт 3–5 вопросов: тип дела, срочность, ситуация. Он отсеивает нецелевые обращения и собирает контекст до первого разговора. Вы приходите на консультацию, уже понимая суть дела, а не тратите время на тех, кому не подходите.',
  },
  {
    q: 'Заявки правда будут приходить в Telegram?',
    a: 'Да. Форма и квиз отправляют заявку отформатированным сообщением прямо в Telegram: имя, тип дела, контакт, ответы квиза и источник. Дополнительно лид фиксируется в таблице со статусом. Можно подключить полноценную CRM.',
  },
  {
    q: 'У меня уже есть сайт. Нужен новый?',
    a: 'Не всегда. Иногда хватает переработать первый экран, добавить квиз и настроить приём заявок. Начните с бесплатного разбора — я посмотрю текущий сайт и скажу честно, нужен ли новый или достаточно поправить вход.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Разработка сайта для юриста под заявки',
    name: 'Сайт для юриста и адвоката',
    description,
    provider: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    areaServed: 'RU',
    offers: { '@type': 'Offer', price: '49000', priceCurrency: 'RUB' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Сайт для юриста', item: 'https://kirillbaryev.ru/sajt-dlya-yurista/' },
    ],
  },
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <SeoLanding
    eyebrow="Сайт для юриста"
    h1="Сайт для юриста и адвоката под заявки"
    lead="Оффер по специализации, кейсы практики, квиз для квалификации и заявки в Telegram. Клиент понимает, чем вы отличаетесь, а обращения не теряются в переписках."
    intro={intro}
    forWhom={forWhom}
    pains={pains}
    includes={includes}
    formats={formats}
    faq={faq}
  />
</Layout>

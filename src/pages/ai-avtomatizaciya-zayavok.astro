---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'AI-автоматизация заявок для малого бизнеса · Антислив заявок';
const description = 'Сайт/квиз, Telegram/CRM и AI-бот за 14–21 день, чтобы бизнес быстрее обрабатывал заявки без расширения штата. Внедрение от 150 000 ₽.';

const PRICE = '150 000 ₽';
const TERM = '14–21 день';
const SUPPORT = '25 000–50 000 ₽/мес';

// Схема системы: что делает / зачем / какой риск закрывает
const flow = [
  { n: '01', t: 'Сайт / квиз', d: 'Собирает и квалифицирует заявку', risk: 'Лид не уходит без следа' },
  { n: '02', t: 'Telegram / WhatsApp', d: 'Уведомление приходит сразу', risk: 'Заявку видят за минуты, а не за сутки' },
  { n: '03', t: 'CRM / таблица', d: 'Лид фиксируется со статусом и источником', risk: 'Заявки не теряются в переписках' },
  { n: '04', t: 'AI-бот', d: 'Отвечает по базе знаний бизнеса', risk: 'Клиент получает ответ мгновенно' },
  { n: '05', t: 'Квалификация', d: 'Горячий / тёплый / холодный', risk: 'Менеджер тратит время на целевых' },
  { n: '06', t: 'Follow-up', d: 'Дожим недозакрытых', risk: 'Деньги не утекают после первого «подумаю»' },
];

const fitYes = [
  'У вас уже есть 50+ заявок в месяц',
  'Заявки идут из нескольких каналов: сайт, Telegram, WhatsApp, Direct, звонки',
  'Есть администратор или менеджер, но нет прозрачной системы',
  'Владелец хочет видеть, где теряются деньги',
  'Средний чек и маржа окупают внедрение за 1–3 сделки',
];

const fitNo = [
  'Нужен просто красивый сайт без системы обработки',
  'Потока заявок пока нет',
  'Не готовы считать заявки, деньги и скорость ответа',
  'Решение зависит только от администратора без права голоса владельца',
  'Нет бюджета на внедрение',
];

const includes = [
  'Аудит пути заявки',
  'Карта точек слива',
  'Квиз или форма квалификации',
  'Telegram / CRM-уведомления',
  'Таблица лидов или CRM',
  'AI-бот-консультант по базе знаний бизнеса',
  'Квалификация лида: горячий / тёплый / холодный',
  'Подсказки менеджеру',
  'Инструкция владельцу и менеджеру',
  '7–14 дней поддержки после запуска',
];

const notPromise = [
  'Не веду рекламу',
  'Не гарантирую количество новых лидов',
  'Не веду соцсети',
  'Не заменяю отдел продаж',
  'Не отвечаю за качество продукта клиента',
  'Не беру бизнесы без потока заявок и бюджета',
  'Не делаю бесконечные доработки вне состава проекта',
];

const delivery = [
  { n: '01', t: 'Диагностика', d: 'Смотрю текущий путь заявки и точки слива' },
  { n: '02', t: 'Оффер', d: 'Формулируем ценность и целевое действие' },
  { n: '03', t: 'Сценарий', d: 'Логика квиза, квалификации и дожима' },
  { n: '04', t: 'Сборка', d: 'Сайт/квиз, уведомления, таблица/CRM' },
  { n: '05', t: 'AI-бот', d: 'Бот на базе знаний бизнеса' },
  { n: '06', t: 'Тесты', d: 'Прогон заявок по всей цепочке' },
  { n: '07', t: 'Обучение', d: 'Инструкции владельцу и менеджеру' },
  { n: '08', t: 'Поддержка', d: '7–14 дней после запуска' },
];

const support = [
  'Доработка сценариев', 'Улучшение AI-бота', 'Аналитика заявок',
  'Новые связки', 'Контроль системы', 'Улучшение конверсии', 'Отчёт раз в месяц',
];

const faq = [
  { q: 'Что такое антислив заявок?', a: 'Это система после клика, где лид фиксируется, квалифицируется, попадает ответственному и не теряется в переписках. Заявка автоматически уходит в Telegram/CRM, клиент получает быстрый ответ, а недозакрытый лид — дожим.' },
  { q: 'Кому подходит AI-автоматизация заявок?', a: 'Бизнесу, у которого уже есть поток заявок (от 50 в месяц) из нескольких каналов, но нет прозрачной обработки. Если заявок пока нет — сначала нужен трафик, а не автоматизация.' },
  { q: 'Что входит во внедрение за 150 000 ₽?', a: 'Аудит пути заявки и карта точек слива, квиз/форма квалификации, Telegram/CRM-уведомления, таблица лидов или CRM, AI-бот по базе знаний, квалификация лида, подсказки менеджеру, инструкции и 7–14 дней поддержки. Срок — 14–21 день.' },
  { q: 'Можно ли внедрить без CRM?', a: 'Да. Для малого бизнеса часто достаточно Google Sheets со статусами и автозаполнением из заявок. Полноценную CRM (AmoCRM/Bitrix24) подключаю, когда поток лидов это оправдывает.' },
  { q: 'AI-бот заменяет менеджера?', a: 'Нет. Бот снимает рутину: отвечает на типовые вопросы по базе знаний, квалифицирует лида и передаёт его менеджеру с подсказками. Сокращаем ручную работу, а не людей.' },
  { q: 'Что будет после запуска?', a: 'Включено 7–14 дней поддержки. Дальше — опциональное сопровождение (25 000–50 000 ₽/мес): доработка сценариев, улучшение бота, аналитика, новые связки и отчёт раз в месяц.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'AI-система обработки заявок «Антислив заявок»',
    name: 'Антислив заявок: AI-система обработки лидов',
    description,
    provider: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    areaServed: 'RU',
    offers: {
      '@type': 'Offer',
      name: 'Внедрение системы «Антислив заявок»',
      price: '150000',
      priceCurrency: 'RUB',
      url: 'https://kirillbaryev.ru/ai-avtomatizaciya-zayavok/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Антислив заявок', item: 'https://kirillbaryev.ru/ai-avtomatizaciya-zayavok/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main>
    <!-- Hero продукта -->
    <section class="aa-hero section-dark">
      <div class="container-x">
        <div class="aa-hero__inner reveal">
          <div class="sec-tag">Основной продукт</div>
          <h1 class="display-h aa-hero__h1">
            Антислив заявок: <em>AI-система обработки лидов</em>
          </h1>
          <p class="aa-hero__lead">
            Внедряю сайт/квиз, Telegram/CRM и AI-бота, чтобы бизнес быстрее обрабатывал
            заявки и получал больше клиентов <b>без найма нового сотрудника</b>.
          </p>
          <div class="aa-price">
            <div class="aa-price__card glass">
              <div class="aa-price__label">Внедрение</div>
              <div class="aa-price__val">{PRICE}</div>
            </div>
            <div class="aa-price__card glass">
              <div class="aa-price__label">Срок</div>
              <div class="aa-price__val">{TERM}</div>
            </div>
            <div class="aa-price__card glass">
              <div class="aa-price__label">Сопровождение</div>
              <div class="aa-price__val aa-price__val--sm">{SUPPORT}</div>
            </div>
          </div>
          <div class="aa-hero__cta">
            <a href="/razbor" class="btn btn--filled" data-magnetic="0.4" data-track="click_razbor_cta">
              <span class="btn__plus">(+)</span> Найти 3 точки слива
            </a>
            <a href="/calculator" class="btn">Посчитать потери</a>
          </div>
        </div>
      </div>
    </section>

    <!-- AEO короткий ответ -->
    <section class="aa-tldr section-dark">
      <div class="container-x">
        <div class="aa-tldr__box glass reveal">
          <div class="aa-tldr__label">Если коротко</div>
          <p>
            Антислив заявок — это <b>система после клика</b>, где лид фиксируется,
            квалифицируется, попадает ответственному и не теряется в переписках.
            Подходит бизнесу, у которого <b>заявки уже есть, но обработка слабая</b>.
          </p>
        </div>
      </div>
    </section>

    <!-- Кому подходит / не подходит -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-fit">
          <div class="aa-fit__col aa-fit__col--yes glass reveal-left">
            <div class="aa-fit__head">Подходит, если</div>
            <ul>{fitYes.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="aa-fit__col aa-fit__col--no glass reveal-right">
            <div class="aa-fit__head">Не подойдёт, если</div>
            <ul>{fitNo.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Схема системы -->
    <section class="aa-flow section-dark">
      <div class="container-x">
        <div class="aa-flow__head reveal">
          <div class="sec-tag">Как устроена система</div>
          <h2 class="aa-h2">Путь заявки <em>под контролем</em></h2>
        </div>
        <div class="aa-flow__grid">
          {flow.map((s, i) => (
            <div class="aa-flow__node glass reveal" style={`transition-delay:${i * 0.05}s`}>
              <span class="aa-flow__n">{s.n}</span>
              <span class="aa-flow__t">{s.t}</span>
              <span class="aa-flow__d">{s.d}</span>
              <span class="aa-flow__risk">{s.risk}</span>
              {i < flow.length - 1 && <span class="aa-flow__arr" aria-hidden="true">→</span>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Что входит -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">Состав внедрения</div>
          <h2 class="aa-h2">Что <em>входит</em></h2>
        </div>
        <ul class="aa-includes reveal">
          {includes.map((x) => <li><span class="aa-check">(+)</span>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как выглядит результат (доказательства без выдуманных цифр) -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">Как выглядит результат</div>
          <h2 class="aa-h2">Что вы <em>получаете на практике</em></h2>
        </div>
        <div class="aa-proof">
          <!-- 1. Telegram-заявка -->
          <div class="aa-proof__card glass reveal">
            <div class="aa-pm aa-pm--tg">
              <div class="aa-pm__head"><span class="aa-pm__ic">✈</span> Новая заявка</div>
              <div class="aa-pm__row"><b>Источник:</b> реклама · квиз</div>
              <div class="aa-pm__row"><b>Контакт:</b> @client</div>
              <div class="aa-pm__row"><b>Ниша:</b> стоматология</div>
            </div>
            <div class="aa-proof__t">Telegram-заявка</div>
            <p class="aa-proof__d">Заявка приходит сразу, виден источник и контакт.
              Закрывает риск «увидели через сутки».</p>
          </div>
          <!-- 2. Таблица / CRM -->
          <div class="aa-proof__card glass reveal" style="transition-delay:.07s">
            <div class="aa-pm aa-pm--crm">
              <div class="aa-pm__crow"><span>Анна К.</span><span class="aa-st aa-st--new">новый</span></div>
              <div class="aa-pm__crow"><span>Игорь П.</span><span class="aa-st aa-st--work">в работе</span></div>
              <div class="aa-pm__crow"><span>Мария В.</span><span class="aa-st aa-st--won">продажа</span></div>
            </div>
            <div class="aa-proof__t">Таблица / CRM</div>
            <p class="aa-proof__d">Лид фиксируется со статусом и следующим шагом.
              Снижает ручную рутину и показывает узкие места.</p>
          </div>
          <!-- 3. AI-бот / follow-up -->
          <div class="aa-proof__card glass reveal" style="transition-delay:.14s">
            <div class="aa-pm aa-pm--bot">
              <div class="aa-pm__msg aa-pm__msg--in">Сколько стоит и какие сроки?</div>
              <div class="aa-pm__msg aa-pm__msg--out">Отвечаю по вашей нише + уточняю задачу…</div>
              <div class="aa-pm__msg aa-pm__msg--note">→ квалифицирован: тёплый</div>
            </div>
            <div class="aa-proof__t">AI-бот и follow-up</div>
            <p class="aa-proof__d">Отвечает на типовые вопросы, квалифицирует лида
              и напоминает о повторном касании.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Delivery timeline -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">Внедрение {TERM}</div>
          <h2 class="aa-h2">8 шагов <em>до запуска</em></h2>
        </div>
        <div class="aa-steps reveal">
          {delivery.map((s) => (
            <div class="aa-step">
              <span class="aa-step__n">{s.n}</span>
              <div class="aa-step__body">
                <div class="aa-step__t">{s.t}</div>
                <div class="aa-step__d">{s.d}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Цена и окупаемость -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="sec-tag reveal">Логика цены</div>
        <h2 class="aa-h2 reveal">Почему 150 000 ₽ <em>логично</em></h2>
        <p class="aa-text reveal">
          Цена внедрения продаётся не количеством экранов и не числом функций.
          Она считается через стоимость потерь: сколько заявок приходит, сколько из них
          не обработано, сколько стоит одна продажа и сколько бизнес теряет из-за
          медленного ответа и хаоса в переписках.
        </p>
        <div class="aa-payback glass reveal">
          <p>Если <b>5 потерянных клиентов</b> дают больше 150 000 ₽ маржи —
            внедрение окупается быстрее, чем кажется.</p>
          <a href="/calculator" class="btn btn--filled" data-magnetic="0.3" data-track="click_razbor_cta">
            <span class="btn__plus">(+)</span> Посчитать свои потери
          </a>
        </div>
      </div>
    </section>

    <!-- Что не обещаю -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="sec-tag reveal">Честно</div>
        <h2 class="aa-h2 reveal">Что я <em>не обещаю</em></h2>
        <ul class="aa-not reveal">
          {notPromise.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- Сопровождение -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">После запуска</div>
          <h2 class="aa-h2">Сопровождение — <em>{SUPPORT}</em></h2>
        </div>
        <ul class="aa-chips reveal">
          {support.map((x) => <li class="aa-chip">{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="aa-block__head reveal">
          <div class="sec-tag">FAQ</div>
          <h2 class="aa-h2">Частые <em>вопросы</em></h2>
        </div>
        <dl class="aa-faq reveal">
          {faq.map((item, i) => (
            <div class="aa-faq__item">
              <details>
                <summary><span class="aa-faq__n">0{i + 1}</span>{item.q}<span class="aa-faq__ic">+</span></summary>
                <dd>{item.a}</dd>
              </details>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Финальный CTA -->
    <section class="aa-final section-dark">
      <div class="container-x">
        <div class="aa-final__box glass reveal">
          <h2 class="aa-final__h2">Разберём вашу систему заявок</h2>
          <div class="aa-final__cta">
            <a href="/calculator" class="btn">Посчитать потери</a>
            <a href="/razbor" class="btn btn--filled" data-magnetic="0.3" data-track="click_razbor_cta">
              <span class="btn__plus">(+)</span> Найти 3 точки слива
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .aa-narrow { max-width: 760px; }
  .aa-hero__h1, .aa-h2 { overflow-wrap: break-word; }
  .aa-h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(24px, 3.4vw, 44px); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text); margin: 14px 0 18px; }
  .aa-h2 em { font-style: italic; font-weight: 300; color: var(--aurora-cyan); }
  .aa-text { font-size: 16px; line-height: 1.7; color: var(--color-muted); margin: 0 0 20px; }
  .aa-text b { color: var(--color-text); font-weight: 500; }

  .aa-hero { padding: 140px 0 50px; }
  .aa-hero__h1 { margin: 16px 0 18px; max-width: 18ch; }
  .aa-hero__h1 em { color: var(--aurora-cyan); }
  .aa-hero__lead { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.6; color: var(--color-muted); max-width: 620px; margin: 0 0 28px; }
  .aa-hero__lead b { color: var(--color-text); font-weight: 600; }

  /* Цена-карточки */
  .aa-price { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 30px; }
  .aa-price__card { padding: 16px 22px; border-radius: 14px; min-width: 150px; }
  .aa-price__label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 8px; }
  .aa-price__val { font-family: 'Unbounded', sans-serif; font-size: clamp(18px, 2vw, 26px); font-weight: 500; letter-spacing: -0.02em; color: var(--color-text); }
  .aa-price__val--sm { font-size: clamp(14px, 1.4vw, 18px); }

  .aa-hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .aa-tldr { padding: 10px 0 30px; }
  .aa-tldr__box { padding: 24px 28px; border-radius: 16px; max-width: 820px; border-color: rgba(139,92,255,0.25); background: linear-gradient(135deg, rgba(139,92,255,0.07), var(--glass-tint)); }
  .aa-tldr__label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px; }
  .aa-tldr__box p { font-size: 16px; line-height: 1.65; color: var(--color-text); margin: 0; }
  .aa-tldr__box b { font-weight: 600; }

  .aa-block { padding: 56px 0; }
  .aa-block__head { max-width: 680px; margin-bottom: 36px; }

  /* Кому подходит / не подходит */
  .aa-fit { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .aa-fit__col { padding: 28px 26px; border-radius: 18px; }
  .aa-fit__col--yes { border-color: rgba(95,198,160,0.3); }
  .aa-fit__col--no { border-color: rgba(255,138,138,0.25); }
  .aa-fit__head { font-family: 'Unbounded', sans-serif; font-size: 15px; font-weight: 500; margin-bottom: 18px; }
  .aa-fit__col--yes .aa-fit__head { color: #6fd6ad; }
  .aa-fit__col--no .aa-fit__head { color: #ff8a8a; }
  .aa-fit__col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px; }
  .aa-fit__col li { display: flex; gap: 10px; font-size: 14.5px; line-height: 1.5; color: var(--color-text); }

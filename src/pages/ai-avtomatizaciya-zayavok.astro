---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'AI-автоматизация заявок для малого бизнеса: Telegram, CRM, дожим';
const description = 'Автоматизирую обработку заявок: сайт/квиз → Telegram/WhatsApp → таблица/CRM → статус → автоответ → дожим. Больше лидов доходит до обработки без расширения штата. Разбор бесплатно.';

const flow = [
  { n: '01', t: 'Сайт / квиз', d: 'Заявка собирается и квалифицируется' },
  { n: '02', t: 'Telegram / WhatsApp', d: 'Уведомление приходит сразу' },
  { n: '03', t: 'Таблица / CRM', d: 'Лид фиксируется со статусом и источником' },
  { n: '04', t: 'Статус', d: 'Новый → в работе → продажа' },
  { n: '05', t: 'Автоответ', d: 'Клиент получает первый ответ за минуты' },
  { n: '06', t: 'Follow-up', d: 'Недозакрытый лид уходит в дожим' },
];

const automate = [
  { t: 'Приём заявок', d: 'Форма и квиз с сайта, профиля, рекламы — в одно русло' },
  { t: 'Уведомления', d: 'Telegram/WhatsApp о каждой заявке в нужном формате' },
  { t: 'Фиксация лидов', d: 'Google Sheets или CRM: имя, ниша, источник, статус' },
  { t: 'Быстрый ответ', d: 'Автоответ клиенту + напоминание менеджеру через 10–15 минут' },
  { t: 'Дожим', d: 'Серия напоминаний по недозакрытым заявкам' },
  { t: 'Аналитика', d: 'UTM-метки: видно, какой канал приносит продажи' },
];

const forWhom = [
  'Клиники и медцентры', 'Салоны и студии', 'Онлайн-школы',
  'Сервисный бизнес', 'Эксперты и консультанты', 'Локальные услуги',
];

const week = [
  'Telegram-уведомления о заявках с сайта и квиза',
  'Единая таблица лидов со статусом и источником',
  'Автоответ клиенту и напоминание менеджеру',
  'Базовый дожим: 2–3 напоминания по недозакрытым',
];

const faq = [
  { q: 'Что такое автоматизация заявок простыми словами?', a: 'Это система, в которой заявка с сайта или квиза автоматически попадает в Telegram/WhatsApp и в таблицу/CRM со статусом, клиент получает быстрый ответ, а недозакрытый лид уходит в дожим. Менеджер не держит заявки в голове и не теряет их в переписках.' },
  { q: 'Нужно ли расширять штат?', a: 'Нет. Цель — чтобы больше заявок доходило до обработки без расширения штата. Система забирает рутину: фиксирует лиды, напоминает и дожимает. Сокращаем ручную работу, а не людей.' },
  { q: 'Подойдёт ли Google Sheets вместо дорогой CRM?', a: 'Для малого бизнеса часто да. Таблица со статусами, источником и автозаполнением из заявок закрывает 80% задач CRM почти бесплатно. Полноценную CRM (AmoCRM/Bitrix24) подключаю, когда поток лидов это оправдывает.' },
  { q: 'За сколько можно запустить?', a: 'Базовую связку (Telegram-уведомления + таблица + автоответ + дожим) — за 7 дней. Полную систему с сайтом, квизом и CRM — за 2–4 недели.' },
  { q: 'С чего начать?', a: 'С бесплатного разбора: посмотрю, как у вас сейчас устроен путь заявки, и покажу 3 точки, где теряются лиды. Прикинуть потери можно в калькуляторе, а карту слива забрать в PDF-гайде.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'AI-автоматизация обработки заявок',
    name: 'AI-автоматизация заявок для малого бизнеса',
    description,
    provider: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    areaServed: 'RU',
    offers: { '@type': 'Offer', price: '49000', priceCurrency: 'RUB' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'AI-автоматизация заявок', item: 'https://kirillbaryev.ru/ai-avtomatizaciya-zayavok/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="aa-hero section-dark">
      <div class="container-x">
        <div class="aa-hero__inner reveal">
          <div class="sec-tag">AI-автоматизация заявок</div>
          <h1 class="display-h aa-hero__h1">
            AI-автоматизация заявок <em>для малого бизнеса</em>
          </h1>
          <p class="aa-hero__lead">
            <b>Больше обработанных заявок — без расширения штата.</b>
            Сокращаем ручную рутину, а не людей: заявка сама доходит до Telegram,
            фиксируется в таблице/CRM и уходит в дожим.
          </p>
          <div class="aa-hero__cta">
            <a href="/razbor" class="btn btn--filled" data-magnetic="0.4">
              <span class="btn__plus">(+)</span> Найти 3 точки слива
            </a>
            <a href="/calculator" class="btn">Посчитать потери</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Короткий ответ (AEO) -->
    <section class="aa-tldr section-dark">
      <div class="container-x">
        <div class="aa-tldr__box glass reveal">
          <div class="aa-tldr__label">Если коротко</div>
          <p>
            AI-автоматизация заявок — это система, в которой лид с сайта или квиза
            автоматически попадает в Telegram/WhatsApp и таблицу/CRM, получает быстрый
            ответ и дожим. Бизнес перестаёт терять заявки после клика и обрабатывает
            больше лидов теми же руками.
          </p>
        </div>
      </div>
    </section>

    <!-- Проблема -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="sec-tag reveal">Проблема</div>
        <h2 class="aa-h2 reveal">Трафик купили — а лиды утекают <em>после клика</em></h2>
        <p class="aa-text reveal">
          Малый бизнес платит за рекламу, но теряет деньги уже после клика: заявку
          замечают через сутки, она тонет в переписках, менеджер забывает перезвонить,
          недозакрытый лид никто не дожимает. Реклама привела клиента — система его не удержала.
        </p>
      </div>
    </section>

    <!-- Схема потока -->
    <section class="aa-flow section-dark">
      <div class="container-x">
        <div class="aa-flow__head reveal">
          <div class="sec-tag">Как устроена система</div>
          <h2 class="aa-h2">Путь заявки <em>под контролем</em></h2>
        </div>
        <div class="aa-flow__grid">
          {flow.map((s, i) => (
            <div class="aa-flow__node glass reveal" style={`transition-delay:${i * 0.05}s`}>
              <span class="aa-flow__n">{s.n}</span>
              <span class="aa-flow__t">{s.t}</span>
              <span class="aa-flow__d">{s.d}</span>
              {i < flow.length - 1 && <span class="aa-flow__arr" aria-hidden="true">→</span>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Что автоматизируем -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">Что автоматизируем</div>
          <h2 class="aa-h2">6 узлов <em>обработки лида</em></h2>
        </div>
        <div class="aa-cards">
          {automate.map((a, i) => (
            <div class="aa-card glass reveal" style={`transition-delay:${i * 0.05}s`}>
              <div class="aa-card__t">{a.t}</div>
              <p class="aa-card__d">{a.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Кому подходит -->
    <section class="aa-block section-dark">
      <div class="container-x">
        <div class="aa-block__head reveal">
          <div class="sec-tag">Кому подходит</div>
          <h2 class="aa-h2">Для бизнеса <em>с потоком заявок</em></h2>
        </div>
        <ul class="aa-chips reveal">
          {forWhom.map((w) => <li class="aa-chip">{w}</li>)}
        </ul>
      </div>
    </section>

    <!-- За 7 дней -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="sec-tag reveal">Быстрый старт</div>
        <h2 class="aa-h2 reveal">Что можно внедрить <em>за 7 дней</em></h2>
        <ul class="aa-week reveal">
          {week.map((w) => <li>{w}</li>)}
        </ul>
        <p class="aa-text reveal aa-week__note">
          Это база, которая сразу останавливает утечку. Полную систему с сайтом, квизом
          и CRM собираем дальше — смотрите <a href="/services">услуги и цены</a>.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="aa-block section-dark">
      <div class="container-x aa-narrow">
        <div class="aa-block__head reveal">
          <div class="sec-tag">FAQ</div>
          <h2 class="aa-h2">Частые <em>вопросы</em></h2>
        </div>
        <dl class="aa-faq reveal">
          {faq.map((item, i) => (
            <div class="aa-faq__item">
              <details>
                <summary><span class="aa-faq__n">0{i + 1}</span>{item.q}<span class="aa-faq__ic">+</span></summary>
                <dd>{item.a}</dd>
              </details>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Финальный CTA -->
    <section class="aa-final section-dark">
      <div class="container-x">
        <div class="aa-final__box glass reveal">
          <h2 class="aa-final__h2">Посчитайте, сколько теряете — и закройте утечку</h2>
          <div class="aa-final__cta">
            <a href="/calculator" class="btn">Калькулятор потерь</a>
            <a href="/anti-sliv-zayavok" class="btn">PDF-гайд</a>
            <a href="/razbor" class="btn btn--filled" data-magnetic="0.3">
              <span class="btn__plus">(+)</span> Бесплатный разбор
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .aa-narrow { max-width: 760px; }
  .aa-hero__h1, .aa-h2 { overflow-wrap: break-word; }
  .aa-h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(24px, 3.4vw, 44px); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text); margin: 14px 0 18px; }
  .aa-h2 em { font-style: italic; font-weight: 300; color: var(--aurora-cyan); }
  .aa-text { font-size: 16px; line-height: 1.7; color: var(--color-muted); margin: 0; }
  .aa-text a, .aa-week__note a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }

  .aa-hero { padding: 140px 0 50px; }
  .aa-hero__h1 { margin: 16px 0 18px; max-width: 16ch; }
  .aa-hero__h1 em { color: var(--aurora-cyan); }
  .aa-hero__lead { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.6; color: var(--color-muted); max-width: 620px; margin: 0 0 30px; }
  .aa-hero__lead b { color: var(--color-text); font-weight: 600; }
  .aa-hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .aa-tldr { padding: 10px 0 30px; }
  .aa-tldr__box { padding: 24px 28px; border-radius: 16px; max-width: 820px; border-color: rgba(95,198,255,0.25); background: linear-gradient(135deg, rgba(95,198,255,0.07), var(--glass-tint)); }
  .aa-tldr__label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px; }
  .aa-tldr__box p { font-size: 16px; line-height: 1.65; color: var(--color-text); margin: 0; }

  .aa-block { padding: 56px 0; }
  .aa-block__head { max-width: 680px; margin-bottom: 36px; }

  /* Flow */
  .aa-flow { padding: 56px 0; }
  .aa-flow__head { max-width: 680px; margin-bottom: 36px; }
  .aa-flow__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .aa-flow__node { position: relative; padding: 22px 20px; border-radius: 14px; display: flex; flex-direction: column; gap: 6px; }
  .aa-flow__n { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; color: var(--color-accent); opacity: 0.6; }
  .aa-flow__t { font-family: 'Unbounded', sans-serif; font-size: 14px; font-weight: 500; color: var(--color-text); }
  .aa-flow__d { font-size: 13px; color: var(--color-muted); line-height: 1.5; }
  .aa-flow__arr { position: absolute; right: -11px; top: 50%; transform: translateY(-50%); color: var(--color-accent); font-size: 14px; z-index: 2; }

  /* Cards */
  .aa-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .aa-card { padding: 24px 22px; border-radius: 14px; }
  .aa-card__t { font-family: 'Unbounded', sans-serif; font-size: 14px; font-weight: 500; color: var(--color-accent); margin-bottom: 10px; }
  .aa-card__d { font-size: 14px; color: var(--color-muted); line-height: 1.55; margin: 0; }

  /* Chips */
  .aa-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .aa-chip { font-family: 'JetBrains Mono', monospace; font-size: 13px; padding: 11px 18px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text); background: var(--glass-tint); }

  /* Week list */
  .aa-week { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-direction: column; gap: 11px; }
  .aa-week li { display: flex; gap: 11px; font-size: 15px; line-height: 1.5; color: var(--color-text); }
  .aa-week li::before { content: '✓'; color: #6fd6ad; font-weight: 600; flex-shrink: 0; }
  .aa-week__note { font-size: 14px; }

  /* FAQ */
  .aa-faq__item { border-bottom: 1px solid var(--color-border); }
  .aa-faq__item:first-child { border-top: 1px solid var(--color-border); }
  .aa-faq summary { display: flex; align-items: center; gap: 12px; padding: 18px 0; cursor: pointer; list-style: none; font-size: 16px; font-weight: 500; color: var(--color-text); }
  .aa-faq summary::-webkit-details-marker { display: none; }
  .aa-faq__n { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-accent); opacity: 0.6; }
  .aa-faq__ic { margin-left: auto; color: var(--color-accent); font-size: 18px; transition: transform 0.25s; font-family: 'JetBrains Mono', monospace; }
  details[open] .aa-faq__ic { transform: rotate(45deg); }
  .aa-faq dd { margin: 0; padding: 0 0 18px 26px; font-size: 15px; line-height: 1.7; color: var(--color-muted); }

  /* Final */
  .aa-final { padding: 40px 0 120px; }
  .aa-final__box { padding: 48px 44px; border-radius: 20px; text-align: center; }
  .aa-final__h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(22px, 3vw, 38px); font-weight: 500; letter-spacing: -0.02em; margin: 0 0 28px; color: var(--color-text); }
  .aa-final__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .aa-hero { padding: 110px 0 40px; }
    .aa-flow__grid, .aa-cards { grid-template-columns: 1fr 1fr; }
    .aa-flow__arr { display: none; }
  }
  @media (max-width: 600px) {
    .aa-flow__grid, .aa-cards { grid-template-columns: 1fr; }
    .aa-hero__cta .btn { width: 100%; justify-content: center; }
    .aa-final__box { padding: 32px 22px; }
    .aa-final__cta .btn { width: 100%; justify-content: center; }
  }
</style>

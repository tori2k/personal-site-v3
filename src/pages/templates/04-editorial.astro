---
import TemplateLayout from '../../layouts/templates/TemplateLayout.astro';

const issues = [
  { n: 'NO. 14', title: 'Шёлк и пар: возвращение чайной церемонии', author: 'Анна Лебедева', tag: 'Культура' },
  { n: 'NO. 13', title: 'Архитектура тишины: дома без окон', author: 'Михаил Орлов', tag: 'Архитектура' },
  { n: 'NO. 12', title: 'Конец эпохи открытых офисов', author: 'Дарья Соколова', tag: 'Бизнес' },
  { n: 'NO. 11', title: 'Города, которые читают: книжные клубы 2026', author: 'Игорь Климов', tag: 'Литература' },
];
---
<TemplateLayout
  title="04 · Editorial — REVUE Magazine"
  description="Образец шаблона сайта в editorial / журнальном стиле: Playfair serif, multi-column, буквица."
  fontsHref="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&display=swap"
>
  <main class="ed">
    <header class="ed-nav">
      <div class="ed-nav__top">
        <div class="ed-nav__date">Москва · четверг, 21 мая 2026</div>
        <div class="ed-nav__weather">+18°C · ясно</div>
      </div>
      <div class="ed-nav__main">
        <div class="ed-nav__brand">
          <span class="ed-nav__brand-name">REVUE</span>
          <span class="ed-nav__brand-sub">Журнал о людях, городах и&nbsp;идеях · Est.&nbsp;2019</span>
        </div>
        <nav class="ed-nav__links">
          <a href="#current">Этот выпуск</a>
          <a href="#archive">Архив</a>
          <a href="#about">О журнале</a>
          <a href="#sub">Подписка</a>
        </nav>
      </div>
    </header>

    <article class="ed-cover">
      <div class="ed-container">
        <div class="ed-cover__meta">
          <span class="ed-cover__issue">Выпуск №&nbsp;14 · Май 2026</span>
          <span class="ed-cover__sep">·</span>
          <span class="ed-cover__theme">Тема номера: «Замедление»</span>
        </div>

        <h1 class="ed-cover__title">
          Шёлк и&nbsp;пар:<br/>
          <em>возвращение</em><br/>
          чайной церемонии.
        </h1>

        <div class="ed-cover__author">
          <span class="ed-cover__author-label">Текст —</span>
          <span class="ed-cover__author-name">Анна Лебедева</span>
          <span class="ed-cover__author-sep">·</span>
          <span class="ed-cover__author-label">Фотографии —</span>
          <span class="ed-cover__author-name">Илья Самойлов</span>
        </div>

        <div class="ed-cover__lead">
          <p>
            <span class="ed-dropcap">Б</span>уддистский монах из&nbsp;Киото
            варит чай 47 минут. Ему&nbsp;52, и&nbsp;он&nbsp;занимается этим
            каждый день с&nbsp;двадцати трёх. На&nbsp;вопрос &laquo;зачем так
            долго?&raquo; он&nbsp;отвечает: &laquo;Я&nbsp;не&nbsp;варю чай.
            Я&nbsp;становлюсь чаем&raquo;.
          </p>
        </div>

        <div class="ed-cover__divider">
          <span></span>
          <em>I</em>
          <span></span>
        </div>

        <div class="ed-cover__body">
          <div class="ed-cover__columns">
            <p>
              <b>В&nbsp;последний год</b> в&nbsp;Москве, Петербурге и&nbsp;Казани
              открылись 17&nbsp;новых чайных. Не&nbsp;кофеен с&nbsp;чаем
              в&nbsp;меню&nbsp;— а&nbsp;именно чайных: с&nbsp;ритуалом, тишиной
              и&nbsp;запретом на&nbsp;телефоны.
            </p>
            <p>
              Это не&nbsp;возвращение моды&nbsp;— это симптом. Люди, которые
              привыкли &laquo;экономить время&raquo;, начинают тратить его
              осознанно. И&nbsp;47&nbsp;минут чайной церемонии становятся
              не&nbsp;роскошью, а&nbsp;необходимостью.
            </p>
            <p>
              Феномен интересен и&nbsp;экономически. Средний чек в&nbsp;таких
              местах&nbsp;— 4&ndash;6&nbsp;тысяч рублей. И&nbsp;записываться
              нужно за&nbsp;две недели.
            </p>
            <p>
              Мы&nbsp;поговорили с&nbsp;тремя владельцами, четырьмя клиентами
              и&nbsp;одним монахом. Получилось не&nbsp;о&nbsp;чае.
            </p>
          </div>

          <aside class="ed-cover__aside">
            <div class="ed-pull">
              <span class="ed-pull__mark">&laquo;</span>
              <p>Я&nbsp;не&nbsp;варю чай. Я&nbsp;становлюсь чаем.</p>
              <span class="ed-pull__name">— монах Тэцу, Киото</span>
            </div>
            <div class="ed-stats">
              <div class="ed-stat">
                <div class="ed-stat__num">47</div>
                <div class="ed-stat__lbl">минут на одну заварку</div>
              </div>
              <div class="ed-stat">
                <div class="ed-stat__num">17</div>
                <div class="ed-stat__lbl">новых чайных за год</div>
              </div>
              <div class="ed-stat">
                <div class="ed-stat__num">4–6К&nbsp;₽</div>
                <div class="ed-stat__lbl">средний чек</div>
              </div>
            </div>
          </aside>
        </div>

        <div class="ed-cover__continued">
          <span>Продолжение на&nbsp;стр. 14&nbsp;→</span>
        </div>
      </div>
    </article>

    <section id="archive" class="ed-archive">
      <div class="ed-container">
        <div class="ed-archive__head">
          <h2 class="ed-h2">
            Индекс<br/>
            <em>номеров.</em>
          </h2>
          <p class="ed-archive__lead">
            Каждый месяц&nbsp;— один выпуск, одна тема, четыре материала.
            Архив с&nbsp;2019&nbsp;года.
          </p>
        </div>

        <ol class="ed-archive__list">
          {issues.map((iss) => (
            <li class="ed-archive__item">
              <span class="ed-archive__num">{iss.n}</span>
              <div class="ed-archive__body">
                <a href="#" class="ed-archive__title">{iss.title}</a>
                <div class="ed-archive__meta">
                  <span class="ed-archive__author">{iss.author}</span>
                  <span class="ed-archive__sep">·</span>
                  <span class="ed-archive__tag">{iss.tag}</span>
                </div>
              </div>
              <a href="#" class="ed-archive__read">читать →</a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="sub" class="ed-sub">
      <div class="ed-container">
        <div class="ed-sub__inner">
          <div class="ed-sub__copy">
            <h2 class="ed-h2 ed-h2--light">
              Подписка<br/>
              <em>на бумаге.</em>
            </h2>
            <p>
              Журнал выходит раз в&nbsp;месяц. 96&nbsp;страниц, мелованная бумага,
              тираж 500&nbsp;экземпляров. Доставка по&nbsp;Москве и&nbsp;России.
            </p>
            <p class="ed-sub__price">
              <span class="ed-sub__price-num">2&nbsp;400&nbsp;₽</span>
              <span class="ed-sub__price-period">/ выпуск, доставка включена</span>
            </p>
            <form class="ed-sub__form" onsubmit="event.preventDefault();">
              <input type="email" placeholder="ваш e-mail" required />
              <button type="submit">Оформить →</button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <footer class="ed-foot">
      <div class="ed-container">
        <div class="ed-foot__top">
          <div class="ed-foot__brand">
            <span class="ed-foot__name">REVUE</span>
            <span class="ed-foot__tag">Журнал о&nbsp;людях, городах и&nbsp;идеях</span>
          </div>
          <nav class="ed-foot__cols">
            <div>
              <span class="ed-foot__col-title">Журнал</span>
              <a href="#">О нас</a>
              <a href="#">Редакция</a>
              <a href="#">Контакты</a>
            </div>
            <div>
              <span class="ed-foot__col-title">Подписка</span>
              <a href="#">Бумажная</a>
              <a href="#">Электронная</a>
              <a href="#">Корпоративная</a>
            </div>
          </nav>
        </div>
        <div class="ed-foot__bottom">
          <span>© REVUE · 2019—2026 · все материалы под лицензией CC BY-NC</span>
          <span class="ed-mono">шаблон 04 · editorial</span>
        </div>
      </div>
    </footer>
  </main>

  <style is:global>
    body { background: #f5efe2; }
    .ed {
      --paper:   #f5efe2;
      --paper-2: #ece4d2;
      --ink:     #1a1812;
      --wine:    #7c1f2d;
      --wine-2:  #9a2b3a;
      --muted:   #6b6657;
      --muted-2: #9a9384;
      --line:    rgba(26, 24, 18, 0.18);
      font: 400 17px/1.65 'Inter', system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
      min-height: 100vh;
    }
    .ed-container { max-width: 1240px; margin: 0 auto; padding: 0 32px; }
    .ed-mono { font-family: 'Inter', monospace; font-feature-settings: 'tnum'; }

    .ed-h2 {
      margin: 0;
      font: 500 clamp(44px, 6.4vw, 88px)/1 'Playfair Display', serif;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .ed-h2 em {
      font-style: italic; font-weight: 400;
      color: var(--wine);
    }
    .ed-h2--light em { color: var(--paper); }

    /* === NAV === */
    .ed-nav {
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
      position: sticky; top: 0; z-index: 50;
    }
    .ed-nav__top {
      display: flex; justify-content: space-between;
      padding: 8px 32px;
      font: italic 400 12px/1 'Cormorant Garamond', serif;
      color: var(--muted);
      letter-spacing: 0.3px;
      border-bottom: 1px solid var(--line);
    }
    .ed-nav__main {
      display: flex; align-items: center; justify-content: space-between;
      gap: 24px;
      padding: 18px 32px;
    }
    .ed-nav__brand { display: flex; flex-direction: column; gap: 4px; }
    .ed-nav__brand-name {
      font: 700 42px/0.9 'Playfair Display', serif;
      letter-spacing: 4px;
    }
    .ed-nav__brand-sub {
      font: italic 400 12.5px/1 'Cormorant Garamond', serif;
      color: var(--muted);
    }
    .ed-nav__links { display: none; gap: 28px; }
    .ed-nav__links a {
      font: italic 400 16px/1 'Cormorant Garamond', serif;
      color: var(--ink);
      transition: color 0.2s;
      position: relative;
    }
    .ed-nav__links a::after {
      content: '';
      position: absolute; left: 0; right: 100%;
      bottom: -4px;
      height: 1px; background: var(--wine);
      transition: right 0.3s;
    }
    .ed-nav__links a:hover { color: var(--wine); }
    .ed-nav__links a:hover::after { right: 0; }

    /* === COVER ARTICLE === */
    .ed-cover {
      padding: 70px 0 80px;
      border-bottom: 2px solid var(--ink);
    }
    .ed-cover__meta {
      display: flex; flex-wrap: wrap; gap: 8px;
      font: 500 13px/1 'Inter', sans-serif;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: var(--wine);
      margin-bottom: 36px;
    }
    .ed-cover__sep { color: var(--muted-2); }
    .ed-cover__theme { color: var(--ink); }

    .ed-cover__title {
      margin: 0;
      font: 500 clamp(48px, 9vw, 132px)/0.94 'Playfair Display', serif;
      letter-spacing: -0.025em;
      color: var(--ink);
      max-width: 900px;
    }
    .ed-cover__title em {
      font-style: italic; font-weight: 400;
      color: var(--wine);
    }

    .ed-cover__author {
      margin-top: 36px;
      display: flex; flex-wrap: wrap; gap: 8px;
      font: italic 400 16px/1 'Cormorant Garamond', serif;
      color: var(--ink);
    }
    .ed-cover__author-label { color: var(--muted); }
    .ed-cover__author-sep { color: var(--muted-2); margin: 0 6px; }

    .ed-cover__lead {
      margin-top: 44px;
      max-width: 720px;
    }
    .ed-cover__lead p {
      margin: 0;
      font: italic 400 24px/1.5 'Cormorant Garamond', serif;
      color: var(--ink);
      letter-spacing: -0.005em;
    }
    .ed-dropcap {
      float: left;
      font: 500 90px/0.85 'Playfair Display', serif;
      color: var(--wine);
      margin: 4px 12px 0 0;
      font-style: normal;
    }

    .ed-cover__divider {
      margin: 60px auto;
      display: flex; align-items: center; gap: 22px;
      max-width: 400px;
    }
    .ed-cover__divider span {
      flex: 1; height: 1px;
      background: var(--ink);
    }
    .ed-cover__divider em {
      font: italic 400 22px/1 'Cormorant Garamond', serif;
      color: var(--wine);
    }

    .ed-cover__body {
      display: grid; grid-template-columns: 1fr; gap: 50px;
    }
    .ed-cover__columns {
      column-count: 1;
      column-gap: 36px;
      font-size: 16.5px;
      line-height: 1.75;
    }
    .ed-cover__columns p {
      margin: 0 0 18px;
      break-inside: avoid;
    }
    .ed-cover__columns b { font-weight: 600; font-variant: small-caps; letter-spacing: 0.5px; }

    .ed-cover__aside {
      display: flex; flex-direction: column; gap: 26px;
    }
    .ed-pull {
      padding: 26px 24px;
      background: var(--paper-2);
      border-left: 4px solid var(--wine);
      position: relative;
    }
    .ed-pull__mark {
      font: 400 64px/0.6 'Playfair Display', serif;
      color: var(--wine);
      font-style: italic;
      display: block;
    }
    .ed-pull p {
      margin: 8px 0 14px;
      font: italic 400 22px/1.4 'Cormorant Garamond', serif;
      color: var(--ink);
    }
    .ed-pull__name {
      font: 500 11.5px/1 'Inter', sans-serif;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
    }

    .ed-stats {
      display: grid; grid-template-columns: 1fr;
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }
    .ed-stat {
      padding: 18px 0;
      border-bottom: 1px dashed var(--line);
      display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    }
    .ed-stat:last-child { border-bottom: none; }
    .ed-stat__num {
      font: 500 32px/1 'Playfair Display', serif;
      color: var(--wine);
      letter-spacing: -0.02em;
    }
    .ed-stat__lbl {
      font: italic 400 14.5px/1.3 'Cormorant Garamond', serif;
      color: var(--ink);
      text-align: right;
    }

    .ed-cover__continued {
      margin-top: 50px;
      padding-top: 26px;
      border-top: 1px solid var(--ink);
      text-align: right;
      font: italic 400 14px/1 'Cormorant Garamond', serif;
      color: var(--wine);
    }

    /* === ARCHIVE === */
    .ed-archive { padding: 90px 0; background: var(--paper-2); border-bottom: 2px solid var(--ink); }
    .ed-archive__head {
      max-width: 720px;
      margin-bottom: 50px;
    }
    .ed-archive__lead {
      margin: 18px 0 0;
      font: italic 400 17px/1.5 'Cormorant Garamond', serif;
      color: var(--muted);
      max-width: 480px;
    }
    .ed-archive__list {
      list-style: none; margin: 0; padding: 0;
      counter-reset: archive;
    }
    .ed-archive__item {
      display: grid; grid-template-columns: 90px 1fr auto; gap: 24px;
      align-items: baseline;
      padding: 26px 0;
      border-top: 1px solid var(--ink);
    }
    .ed-archive__item:last-child { border-bottom: 1px solid var(--ink); }
    .ed-archive__num {
      font: 500 13px/1 'Inter', sans-serif;
      letter-spacing: 1.5px;
      color: var(--wine);
    }
    .ed-archive__body { display: flex; flex-direction: column; gap: 6px; }
    .ed-archive__title {
      font: 500 clamp(20px, 2.6vw, 30px)/1.2 'Playfair Display', serif;
      letter-spacing: -0.01em;
      color: var(--ink);
      transition: color 0.2s;
    }
    .ed-archive__item:hover .ed-archive__title { color: var(--wine); font-style: italic; }
    .ed-archive__meta {
      display: flex; gap: 8px;
      font: italic 400 14px/1 'Cormorant Garamond', serif;
      color: var(--muted);
    }
    .ed-archive__sep { color: var(--muted-2); }
    .ed-archive__read {
      font: 500 12px/1 'Inter', sans-serif;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--wine);
      transition: gap 0.2s;
    }
    .ed-archive__item:hover .ed-archive__read { letter-spacing: 1.5px; }

    /* === SUB === */
    .ed-sub {
      padding: 100px 0;
      background: var(--ink);
      color: var(--paper);
    }
    .ed-sub__inner { display: grid; grid-template-columns: 1fr; gap: 50px; }
    .ed-sub p {
      margin: 26px 0 0;
      font-size: 17px; line-height: 1.7;
      max-width: 480px;
      color: rgba(245, 239, 226, 0.85);
    }
    .ed-sub__price {
      margin-top: 36px;
      display: flex; align-items: baseline; gap: 14px;
    }
    .ed-sub__price-num {
      font: 500 60px/1 'Playfair Display', serif;
      letter-spacing: -0.02em;
      color: var(--paper);
    }
    .ed-sub__price-period {
      font: italic 400 16px/1 'Cormorant Garamond', serif;
      color: rgba(245, 239, 226, 0.6);
    }
    .ed-sub__form {
      margin-top: 32px;
      display: flex; flex-wrap: wrap; gap: 0;
      max-width: 520px;
    }
    .ed-sub__form input {
      flex: 1; min-width: 200px;
      padding: 16px 18px;
      background: transparent;
      border: 1px solid rgba(245, 239, 226, 0.4);
      color: var(--paper);
      font: 400 15px/1 'Inter', sans-serif;
      outline: none;
    }
    .ed-sub__form input::placeholder { color: rgba(245, 239, 226, 0.5); }
    .ed-sub__form input:focus { border-color: var(--paper); }
    .ed-sub__form button {
      padding: 16px 24px;
      background: var(--wine);
      color: var(--paper);
      border: 1px solid var(--wine);
      font: 500 14px/1 'Inter', sans-serif;
      letter-spacing: 0.5px;
      transition: background 0.2s, color 0.2s;
    }
    .ed-sub__form button:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }

    /* === FOOTER === */
    .ed-foot {
      padding: 60px 0 30px;
      background: var(--paper);
      border-top: 2px solid var(--ink);
    }
    .ed-foot__top {
      display: grid; grid-template-columns: 1fr; gap: 36px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--ink);
    }
    .ed-foot__brand { display: flex; flex-direction: column; gap: 6px; }
    .ed-foot__name {
      font: 700 32px/0.9 'Playfair Display', serif;
      letter-spacing: 3px;
    }
    .ed-foot__tag {
      font: italic 400 13.5px/1 'Cormorant Garamond', serif;
      color: var(--muted);
    }
    .ed-foot__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
    .ed-foot__cols > div { display: flex; flex-direction: column; gap: 10px; }
    .ed-foot__col-title {
      font: 600 11px/1 'Inter', sans-serif;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--wine);
      margin-bottom: 4px;
    }
    .ed-foot__cols a {
      font: italic 400 14.5px/1 'Cormorant Garamond', serif;
      color: var(--ink);
      transition: color 0.2s;
    }
    .ed-foot__cols a:hover { color: var(--wine); }
    .ed-foot__bottom {
      display: flex; flex-direction: column; gap: 8px;
      margin-top: 24px;
      font: italic 400 13px/1.5 'Cormorant Garamond', serif;
      color: var(--muted);
    }

    @media (min-width: 760px) {
      .ed-cover__body { grid-template-columns: 1.4fr 0.6fr; gap: 60px; }
      .ed-cover__columns { column-count: 2; }
      .ed-archive__item { grid-template-columns: 110px 1fr auto; }
      .ed-sub__inner { grid-template-columns: 1.1fr 0.9fr; align-items: end; }
      .ed-foot__top { grid-template-columns: 1fr 1.4fr; align-items: end; }
      .ed-foot__cols { justify-content: end; }
      .ed-foot__bottom { flex-direction: row; justify-content: space-between; }
    }
    @media (min-width: 1024px) {
      .ed-nav__links { display: flex; }
    }
  </style>
</TemplateLayout>

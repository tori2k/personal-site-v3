---
import PapercraftLayout from '../../layouts/templates/PapercraftLayout.astro';

const HOME = '/templates/06-papercraft';
const levels = [
  'Ссылка / визитка',
  'Шаблонный лендинг',
  'Лендинг с оффером',
  'Сайт с доверием',
  'Сайт с квизом',
  'Сайт + Telegram / CRM',
  'Бренд-платформа',
];
const principles = [
  { t: 'Один экран — одна мысль', d: 'Каждый блок решает одну задачу и не перегружает.' },
  { t: 'Заявка как маршрут', d: 'Путь от интереса до отправки выстроен по шагам.' },
  { t: 'Квиз квалифицирует', d: 'К вам приходят целевые, а не «просто посмотреть».' },
  { t: 'Telegram — не «дополнительно»', d: 'Заявка падает в чат сразу, ничего не теряется.' },
];
---
<PapercraftLayout title="Метод · Papercraft — kirillbaryev.ru" description="Метод «один экран — одна мысль»: как сайт превращается в маршрут к заявке." active="method">
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Метод</span>
    <h1 class="pc-h1b">Один экран — <span class="pc-mark">одна мысль</span></h1>
    <p class="pc-lead">Сайт — это маршрут к&nbsp;заявке. Каждый экран ведёт к&nbsp;следующему шагу.</p>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Лестница</span>
    <h2 class="pc-h2">От визитки до <span class="pc-mark">системы</span></h2>
    <ol class="pc-ladder">
      {levels.map((l, i) => (
        <li class:list={['pc-ladder__step pc-paper pc-reveal', i >= 5 && 'is-top']} style={`--i:${i}`}>
          <span class="pc-ladder__n">{i + 1}</span><span>{l}</span>
          {i >= 5 && <span class="pc-ladder__here">здесь работаю я</span>}
        </li>
      ))}
    </ol>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Принципы</span>
    <h2 class="pc-h2">Как я <span class="pc-mark">строю</span></h2>
    <div class="pc-prin">
      {principles.map((p) => (
        <div class="pc-prin__card pc-paper pc-reveal">
          <h3 class="pc-h3">{p.t}</h3>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pc-sec pc-ctasec">
    <div class="pc-ticket pc-paper pc-reveal">
      <h2 class="pc-h2">Узнайте, <span class="pc-mark">на каком вы уровне</span></h2>
      <p class="pc-lead pc-lead--c">Напишите нишу — скажу, что докрутить, чтобы заявок было больше.</p>
      <a href="https://t.me/tori2k" class="pc-btn"><span class="pc-btn__plus">(+)</span>Получить разбор</a>
    </div>
  </section>

  <style>
    .pc-ladder { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
    .pc-ladder__step { display: flex; align-items: center; gap: 14px; padding: 16px 22px; font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: clamp(14px, 1.6vw, 17px); margin-left: calc(var(--i) * 34px); transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-ladder__step:hover { transform: translateX(6px) rotate(-.6deg); }
    .pc-ladder__n { font-family: 'Special Elite', monospace; font-size: 13px; color: var(--mark2); flex-shrink: 0; }
    .pc-ladder__step.is-top { background: var(--mark); color: #fff; text-shadow: none; }
    .pc-ladder__step.is-top .pc-ladder__n { color: #ffe9c4; }
    .pc-ladder__here { margin-left: auto; font-family: 'Caveat', cursive; font-size: 19px; color: #ffe9c4; white-space: nowrap; }

    .pc-prin { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; max-width: 860px; }
    .pc-prin__card { padding: 24px 24px; transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-prin__card:nth-child(2n) { transform: rotate(.6deg); }
    .pc-prin__card:hover { transform: translateY(-5px) rotate(-1deg); }
    .pc-prin__card p { margin: 8px 0 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }

    @media (max-width: 700px) {
      .pc-prin { grid-template-columns: 1fr; }
      .pc-ladder__step { margin-left: calc(var(--i) * 14px); }
      .pc-ladder__here { display: none; }
    }
  </style>
</PapercraftLayout>

---
import TemplateLayout from '../../layouts/templates/TemplateLayout.astro';

const works = [
  { num: '01', title: 'NOISE/REC', tag: 'identity · 2025', desc: 'Айдентика для подкаст-студии. 12 паттернов, 4 шрифта, 0 компромиссов.' },
  { num: '02', title: 'BANK OF MARS', tag: 'web · 2024', desc: 'Концепт-сайт банка для марсианской колонии. Awwwards SOTD.' },
  { num: '03', title: 'NEON CULTS',  tag: 'merch · 2024', desc: 'Лимитированная коллекция мерча. Распродано за 48 часов.' },
  { num: '04', title: 'ZINE NO.07', tag: 'print · 2024', desc: 'Журнал о брутализме в digital-дизайне. 144 страницы, тираж 500.' },
];
---
<TemplateLayout
  title="03 · Брутализм — Studio Faktor"
  description="Образец шаблона сайта в брутализм/Awwwards стиле: жирные шрифты, электро-жёлтый, marquee."
  fontsHref="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
>
  <main class="brut">
    <header class="brut-nav">
      <a href="#top" class="brut-nav__brand">
        <span class="brut-nav__brand-block">STUDIO</span>
        <span class="brut-nav__brand-block brut-nav__brand-block--yellow">FAKTOR</span>
      </a>
      <nav class="brut-nav__links">
        <a href="#works">/works</a>
        <a href="#about">/about</a>
        <a href="#contact">/say-hi</a>
      </nav>
      <a href="#contact" class="brut-btn brut-btn--big">
        START PROJECT
        <span class="brut-btn__arrow">→</span>
      </a>
    </header>

    <section id="top" class="brut-hero">
      <div class="brut-hero__noise" aria-hidden="true"></div>

      <div class="brut-container">
        <div class="brut-hero__row1">
          <span class="brut-hero__year">/2026</span>
          <span class="brut-hero__loc">MSK · 55.7558° N</span>
        </div>

        <h1 class="brut-hero__title">
          <span class="brut-hero__title-line">DESIGN</span>
          <span class="brut-hero__title-line brut-hero__title-line--yellow">THAT</span>
          <span class="brut-hero__title-line brut-hero__title-line--outline">DOESN'T</span>
          <span class="brut-hero__title-line">APOLOGIZE.</span>
        </h1>

        <div class="brut-hero__bottom">
          <div class="brut-hero__bottom-l">
            <p class="brut-hero__lead">
              Мы&nbsp;— дизайн-студия, которая не&nbsp;делает &laquo;универсальные&raquo;,
              &laquo;современные&raquo; и&nbsp;&laquo;продающие&raquo; сайты.
              Мы&nbsp;делаем работы, которые невозможно перепутать.
            </p>
            <div class="brut-hero__actions">
              <a href="#works" class="brut-btn brut-btn--yellow">
                ВЗГЛЯНУТЬ
                <span class="brut-btn__arrow">→</span>
              </a>
              <a href="#contact" class="brut-btn">НАПИСАТЬ</a>
            </div>
          </div>
          <div class="brut-hero__bottom-r">
            <div class="brut-stat">
              <div class="brut-stat__num">047</div>
              <div class="brut-stat__lbl">PROJECTS<br/>SHIPPED</div>
            </div>
            <div class="brut-stat brut-stat--yellow">
              <div class="brut-stat__num">12<sup>×</sup></div>
              <div class="brut-stat__lbl">AWWWARDS<br/>SOTD</div>
            </div>
          </div>
        </div>
      </div>

      <div class="brut-marquee" aria-hidden="true">
        <div class="brut-marquee__track">
          <span>BRANDING</span><span>★</span>
          <span>WEB · DESIGN</span><span>★</span>
          <span>3D · MOTION</span><span>★</span>
          <span>PRINT</span><span>★</span>
          <span>ART · DIRECTION</span><span>★</span>
          <span>BRANDING</span><span>★</span>
          <span>WEB · DESIGN</span><span>★</span>
          <span>3D · MOTION</span><span>★</span>
          <span>PRINT</span><span>★</span>
          <span>ART · DIRECTION</span><span>★</span>
          <span>BRANDING</span><span>★</span>
          <span>WEB · DESIGN</span><span>★</span>
        </div>
      </div>
    </section>

    <section id="works" class="brut-works">
      <div class="brut-container">
        <div class="brut-works__head">
          <span class="brut-eyebrow">/portfolio</span>
          <h2 class="brut-h2">SELECTED<br/>WORKS<sup>↗</sup></h2>
        </div>

        <div class="brut-works__list">
          {works.map((w, i) => (
            <a href="#" class={`brut-work${i % 2 === 1 ? ' brut-work--alt' : ''}`}>
              <span class="brut-work__num">{w.num}</span>
              <div class="brut-work__body">
                <h3 class="brut-work__title">{w.title}</h3>
                <span class="brut-work__tag">{w.tag}</span>
              </div>
              <p class="brut-work__desc">{w.desc}</p>
              <span class="brut-work__cta">VIEW <span>→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="brut-about">
      <div class="brut-container">
        <div class="brut-about__grid">
          <div class="brut-about__head">
            <span class="brut-eyebrow">/manifesto</span>
            <h2 class="brut-h2 brut-h2--yellow">
              WE DON'T<br/>
              DO BORING.
            </h2>
          </div>
          <div class="brut-about__body">
            <p>
              Студия Faktor основана в&nbsp;2021 году. Мы&nbsp;работаем
              с&nbsp;брендами, которые готовы выделяться. Никаких stock-фотографий,
              никаких &laquo;универсальных&raquo; решений&nbsp;— только концепт,
              который запоминается.
            </p>
            <div class="brut-about__rules">
              <div class="brut-rule">
                <span class="brut-rule__num">→ 01.</span>
                <div>
                  <b>NO STOCK.</b> Каждое изображение, иллюстрация, иконка
                  рисуется под проект.
                </div>
              </div>
              <div class="brut-rule">
                <span class="brut-rule__num">→ 02.</span>
                <div>
                  <b>NO SHORTCUTS.</b> Срок &laquo;нужно к&nbsp;завтра&raquo;
                  не&nbsp;для нас. Хороший дизайн нельзя сделать за&nbsp;ночь.
                </div>
              </div>
              <div class="brut-rule">
                <span class="brut-rule__num">→ 03.</span>
                <div>
                  <b>NO BS.</b> Если задача нам неинтересна&nbsp;— говорим
                  сразу. Если интересна&nbsp;— гарантируем результат.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer id="contact" class="brut-foot">
      <div class="brut-container">
        <div class="brut-foot__big">
          <a href="mailto:hi@faktor.studio" class="brut-foot__email">
            HI@FAKTOR.STUDIO
            <span>↗</span>
          </a>
          <div class="brut-foot__sub">
            Пишите про&nbsp;проект, бюджет, дедлайн. Без воды.
          </div>
        </div>

        <div class="brut-foot__bottom">
          <div class="brut-foot__channels">
            <a href="#">@faktor.studio</a>
            <span>·</span>
            <a href="#">telegram</a>
            <span>·</span>
            <a href="#">behance</a>
            <span>·</span>
            <a href="#">are.na</a>
          </div>
          <div class="brut-foot__copy">
            © STUDIO FAKTOR · 2021—2026 · TEMPLATE 03 · BRUTALISM
          </div>
        </div>
      </div>
    </footer>
  </main>

  <style is:global>
    body { background: #f5f4ee; }
    .brut {
      --paper:   #f5f4ee;
      --ink:     #0a0a0a;
      --line:    rgba(10, 10, 10, 0.15);
      --line-2:  rgba(10, 10, 10, 0.35);
      --yellow:  #f5ec27;
      --yellow-2:#fcf263;
      --muted:   #555;
      font: 400 16px/1.4 'Space Grotesk', system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
      min-height: 100vh;
    }
    .brut-container { max-width: 1400px; margin: 0 auto; padding: 0 32px; }
    .brut-eyebrow {
      font: 700 12px/1 'Space Mono', monospace;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--ink);
    }
    .brut-h2 {
      margin: 18px 0 0;
      font: 400 clamp(56px, 9vw, 130px)/0.92 'Anton', sans-serif;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }
    .brut-h2 sup { font-size: 0.5em; vertical-align: super; }
    .brut-h2--yellow { background: var(--yellow); padding: 18px 22px; display: inline-block; }

    .brut-btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 16px 24px;
      font: 700 13px/1 'Space Mono', monospace;
      letter-spacing: 1px;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--paper);
      border: 2px solid var(--ink);
      border-radius: 0;
      transition: all 0.2s ease;
      box-shadow: 5px 5px 0 0 var(--ink);
    }
    .brut-btn:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 0 var(--ink); }
    .brut-btn:active { transform: translate(0, 0); box-shadow: 2px 2px 0 0 var(--ink); }
    .brut-btn--yellow {
      background: var(--yellow);
      color: var(--ink);
      box-shadow: 5px 5px 0 0 var(--ink);
    }
    .brut-btn--yellow:hover { box-shadow: 7px 7px 0 0 var(--ink); }
    .brut-btn--big { padding: 18px 28px; font-size: 13.5px; }
    .brut-btn__arrow { font-size: 14px; transition: transform 0.2s; }
    .brut-btn:hover .brut-btn__arrow { transform: rotate(-45deg); }

    /* === NAV === */
    .brut-nav {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      gap: 24px;
      padding: 16px 32px;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
    }
    .brut-nav__brand {
      display: inline-flex; gap: 6px;
      font: 400 22px/1 'Anton', sans-serif;
      letter-spacing: 1px;
    }
    .brut-nav__brand-block {
      padding: 6px 10px;
      background: var(--ink);
      color: var(--paper);
      text-transform: uppercase;
    }
    .brut-nav__brand-block--yellow {
      background: var(--yellow);
      color: var(--ink);
    }
    .brut-nav__links {
      display: none; gap: 28px;
      font: 700 13px/1 'Space Mono', monospace;
      letter-spacing: 1px;
    }
    .brut-nav__links a { color: var(--ink); transition: color 0.15s; }
    .brut-nav__links a:hover { color: var(--yellow); background: var(--ink); padding: 4px 6px; }

    /* === HERO === */
    .brut-hero { position: relative; padding: 60px 0 0; overflow: hidden; }
    .brut-hero__noise {
      position: absolute; inset: 0;
      background-image:
        repeating-linear-gradient(45deg, rgba(10, 10, 10, 0.04) 0 1px, transparent 1px 6px);
      pointer-events: none;
    }
    .brut-hero__row1 {
      display: flex; justify-content: space-between;
      font: 700 13px/1 'Space Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 30px;
    }
    .brut-hero__year { color: var(--ink); }
    .brut-hero__loc { color: var(--muted); }

    .brut-hero__title {
      margin: 0;
      font: 400 clamp(64px, 14vw, 240px)/0.86 'Anton', sans-serif;
      letter-spacing: -0.03em;
      text-transform: uppercase;
    }
    .brut-hero__title-line { display: block; }
    .brut-hero__title-line--yellow {
      background: var(--yellow);
      padding: 0 0.1em;
      display: inline-block;
      margin-left: 0.1em;
    }
    .brut-hero__title-line--outline {
      color: transparent;
      -webkit-text-stroke: 2px var(--ink);
      text-stroke: 2px var(--ink);
    }

    .brut-hero__bottom {
      margin-top: 60px;
      display: grid; grid-template-columns: 1fr; gap: 40px;
      align-items: end;
      padding-bottom: 50px;
    }
    .brut-hero__lead {
      margin: 0;
      max-width: 500px;
      font-size: 17.5px; line-height: 1.55;
      color: var(--ink);
      font-weight: 400;
    }
    .brut-hero__actions {
      margin-top: 26px;
      display: flex; flex-wrap: wrap; gap: 14px;
    }
    .brut-hero__bottom-r {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    }
    .brut-stat {
      padding: 24px 22px;
      border: 2px solid var(--ink);
      background: var(--paper);
    }
    .brut-stat--yellow { background: var(--yellow); }
    .brut-stat__num {
      font: 400 clamp(48px, 7vw, 80px)/1 'Anton', sans-serif;
      letter-spacing: -0.02em;
    }
    .brut-stat__num sup {
      font-size: 0.45em;
      vertical-align: super;
    }
    .brut-stat__lbl {
      margin-top: 10px;
      font: 700 11px/1.3 'Space Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* === MARQUEE === */
    .brut-marquee {
      overflow: hidden;
      background: var(--ink);
      color: var(--yellow);
      padding: 16px 0;
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
    }
    .brut-marquee__track {
      display: flex; gap: 32px;
      white-space: nowrap;
      animation: brut-marquee 25s linear infinite;
      font: 400 clamp(28px, 4vw, 48px)/1 'Anton', sans-serif;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .brut-marquee__track span { flex-shrink: 0; }
    @keyframes brut-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* === WORKS === */
    .brut-works { padding: 110px 0; border-top: 2px solid var(--ink); }
    .brut-works__head { margin-bottom: 60px; }
    .brut-works__list {
      display: grid; grid-template-columns: 1fr; gap: 1px;
      background: var(--ink);
      border: 2px solid var(--ink);
    }
    .brut-work {
      display: grid;
      grid-template-columns: 80px 1fr;
      grid-template-rows: auto auto;
      column-gap: 28px;
      row-gap: 12px;
      padding: 30px 28px;
      background: var(--paper);
      color: var(--ink);
      transition: background 0.15s;
      align-items: start;
    }
    .brut-work--alt { background: var(--paper); }
    .brut-work:hover { background: var(--yellow); }
    .brut-work__num {
      grid-row: 1 / 3;
      font: 400 60px/0.9 'Anton', sans-serif;
      letter-spacing: -0.02em;
    }
    .brut-work__body { display: flex; flex-direction: column; gap: 6px; }
    .brut-work__title {
      margin: 0;
      font: 400 clamp(28px, 3.6vw, 46px)/1 'Anton', sans-serif;
      letter-spacing: -0.01em;
      text-transform: uppercase;
    }
    .brut-work__tag {
      font: 700 11px/1 'Space Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
    }
    .brut-work__desc {
      grid-column: 2;
      margin: 0;
      font-size: 14.5px; line-height: 1.55;
      max-width: 540px;
    }
    .brut-work__cta {
      grid-column: 2;
      font: 700 12px/1 'Space Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: inline-flex; gap: 8px;
      align-items: center;
    }
    .brut-work__cta span { transition: transform 0.2s; }
    .brut-work:hover .brut-work__cta span { transform: translateX(4px); }

    /* === ABOUT === */
    .brut-about { padding: 110px 0; background: var(--ink); color: var(--paper); }
    .brut-about__grid { display: grid; grid-template-columns: 1fr; gap: 50px; }
    .brut-about .brut-eyebrow { color: var(--yellow); }
    .brut-about .brut-h2 { color: var(--paper); }
    .brut-about__body p {
      margin: 0;
      max-width: 580px;
      font-size: 17px; line-height: 1.6;
    }
    .brut-about__rules {
      margin-top: 36px;
      display: flex; flex-direction: column; gap: 22px;
    }
    .brut-rule {
      display: grid; grid-template-columns: 70px 1fr; gap: 18px;
      padding-bottom: 22px;
      border-bottom: 1px solid rgba(245, 244, 238, 0.18);
    }
    .brut-rule:last-child { border-bottom: none; }
    .brut-rule__num {
      font: 700 13px/1.4 'Space Mono', monospace;
      letter-spacing: 1.5px;
      color: var(--yellow);
    }
    .brut-rule div {
      font-size: 15px; line-height: 1.55;
    }
    .brut-rule b { color: var(--yellow); font-weight: 700; }

    /* === FOOTER === */
    .brut-foot { padding: 80px 0 30px; background: var(--paper); border-top: 2px solid var(--ink); }
    .brut-foot__big { margin-bottom: 60px; }
    .brut-foot__email {
      display: inline-flex; align-items: baseline; gap: 14px;
      font: 400 clamp(40px, 8vw, 120px)/0.9 'Anton', sans-serif;
      letter-spacing: -0.02em;
      color: var(--ink);
      text-transform: uppercase;
      border-bottom: 4px solid var(--ink);
      padding-bottom: 6px;
      transition: color 0.2s;
    }
    .brut-foot__email:hover { color: var(--yellow); background: var(--ink); padding: 6px 14px; border-color: transparent; }
    .brut-foot__email span { font-size: 0.5em; }
    .brut-foot__sub {
      margin-top: 16px;
      font: 700 13px/1.5 'Space Mono', monospace;
      letter-spacing: 0.5px;
      max-width: 520px;
      color: var(--muted);
    }
    .brut-foot__bottom {
      display: flex; flex-direction: column; gap: 12px;
      padding-top: 24px;
      border-top: 2px solid var(--ink);
    }
    .brut-foot__channels {
      display: flex; flex-wrap: wrap; gap: 14px;
      font: 700 12px/1 'Space Mono', monospace;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .brut-foot__channels span { color: var(--muted); }
    .brut-foot__copy {
      font: 700 11px/1 'Space Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
    }

    @media (min-width: 760px) {
      .brut-hero__bottom { grid-template-columns: 1.2fr 0.8fr; gap: 60px; }
      .brut-about__grid { grid-template-columns: 0.9fr 1.1fr; gap: 70px; }
      .brut-foot__bottom { flex-direction: row; justify-content: space-between; align-items: center; }
    }
    @media (min-width: 1024px) {
      .brut-nav__links { display: flex; }
    }
  </style>
</TemplateLayout>

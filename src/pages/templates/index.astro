---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const tpls = [
  {
    slug: '01-premium',
    num: '01',
    title: 'Премиум-минимал',
    sub: 'Atelier Vermeer',
    desc: 'Айвори, графит, золото. Cormorant serif с курсивами. Liquid-glass карточки, scroll-rotate, золотая печать «est.». Для юристов, экспертов, premium-бьюти, частной практики.',
    fontPair: 'Cormorant Garamond + Inter',
    palette: ['#f7f4ee', '#0b1424', '#b8923f'],
    tags: ['premium', 'serif', 'liquid-glass'],
  },
  {
    slug: '02-dark-saas',
    num: '02',
    title: 'Тёмный SaaS / Fin-tech',
    sub: 'Helix Finance',
    desc: 'Полночный синий, neon-cyan, glass-эффекты, gradient blobs. Live-чарт с анимацией, metrics-grid, glow-кнопки. Для IT, финтеха, B2B SaaS, стартапов с продуктом.',
    fontPair: 'Manrope + JetBrains Mono',
    palette: ['#050913', '#5fbef0', '#a280ff'],
    tags: ['saas', 'dark', 'glow'],
  },
  {
    slug: '03-brutalism',
    num: '03',
    title: 'Брутализм / Awwwards',
    sub: 'Studio Faktor',
    desc: 'Электро-жёлтый и чёрный, Anton-заголовки во всю ширину, marquee-лента, asymmetric grid. Толстые рамки, обводка outline-шрифтом. Для агентств, дизайнеров, креативных брендов.',
    fontPair: 'Anton + Space Grotesk + Space Mono',
    palette: ['#f5f4ee', '#0a0a0a', '#f5ec27'],
    tags: ['bold', 'marquee', 'awwwards'],
  },
  {
    slug: '04-editorial',
    num: '04',
    title: 'Editorial / журнальный',
    sub: 'REVUE Magazine',
    desc: 'Кремовая бумага, бордо-акценты. Playfair Display заголовки, многоколоночный текст, буквица, pull-quotes, статистика рядом со статьёй. Для журналов, блогеров, ресторанов, культурных проектов.',
    fontPair: 'Playfair Display + Cormorant + Inter',
    palette: ['#f5efe2', '#1a1812', '#7c1f2d'],
    tags: ['serif', 'long-read', 'print'],
  },
  {
    slug: '05-y2k',
    num: '05',
    title: 'Y2K / retro-future',
    sub: 'NULL_POINTER',
    desc: 'Pixel-арт, CRT-сканлайны, glitch-анимация на заголовке. Press Start 2P + VT323. Винд-95-окна, неоновые розовый и cyan, perspective-grid floor, vaporwave-солнце. Для музыки, инди-продуктов, креативных нишевых брендов.',
    fontPair: 'VT323 + Press Start 2P + Space Mono',
    palette: ['#0a001f', '#ff3ec9', '#4ddfff'],
    tags: ['retro', 'pixel', 'crt'],
  },
];
---
<Layout
  title="Шаблоны сайтов · Кирилл Барышев"
  description="Пять готовых дизайн-направлений для сайта: премиум-минимал, тёмный SaaS, брутализм, editorial, Y2K. Откройте любой — это живой шаблон."
>
  <Nav />
  <main>
    <section class="tpl-gallery section-dark">
      <div class="container-x">

        <div class="tpl-gallery__head reveal">
          <div class="sec-tag">шаблоны</div>
          <h1 class="display-h">
            Пять<br/>
            <em>визуальных направлений.</em>
          </h1>
          <p class="tpl-gallery__lead">
            Каждый шаблон&nbsp;— живой сайт, который можно открыть и&nbsp;посмотреть.
            Выбрали направление&nbsp;— я&nbsp;беру его за&nbsp;основу и&nbsp;адаптирую
            под ваш бренд: меняю тексты, фотографии, добавляю/убираю секции.
          </p>
          <p class="tpl-gallery__hint">
            <span class="tpl-gallery__hint-num">5</span>
            <span>стилей с разными шрифтами, цветами и&nbsp;фишками&nbsp;— это&nbsp;не&nbsp;один&nbsp;CSS, а&nbsp;пять отдельных дизайн-языков.</span>
          </p>
        </div>

        <div class="tpl-grid">
          {tpls.map((t, i) => (
            <a href={`${base}templates/${t.slug}/`} class="tpl-card reveal" style={`transition-delay: ${i * 0.08}s`}>
              <div class="tpl-card__head">
                <span class="tpl-card__num font-mono">{t.num}</span>
                <div class="tpl-card__palette">
                  {t.palette.map((c) => (
                    <span class="tpl-card__swatch" style={`background:${c}`}></span>
                  ))}
                </div>
              </div>
              <div class="tpl-card__body">
                <h2 class="tpl-card__title">{t.title}</h2>
                <div class="tpl-card__sub">{t.sub}</div>
                <p class="tpl-card__desc">{t.desc}</p>
                <div class="tpl-card__fonts font-mono">{t.fontPair}</div>
                <div class="tpl-card__tags">
                  {t.tags.map((tag) => (
                    <span class="tpl-card__tag font-mono">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="tpl-card__cta">
                <span>Открыть шаблон</span>
                <span class="tpl-card__cta-arrow">→</span>
              </div>
            </a>
          ))}
        </div>

        <div class="tpl-gallery__bottom reveal">
          <p>
            Не&nbsp;нашли подходящий? Соберу под вас отдельную концепцию&nbsp;—
            начнём с&nbsp;брифа.
          </p>
          <a href={`${base}brief/`} class="tpl-cta-btn">
            Заполнить бриф <span>→</span>
          </a>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .tpl-gallery { padding: 80px 0 110px; }
  .tpl-gallery__head { max-width: 820px; margin-bottom: 60px; }
  .tpl-gallery__head .display-h {
    margin-top: 20px;
    font-size: clamp(40px, 6.4vw, 78px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .tpl-gallery__head .display-h em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-muted);
  }
  .tpl-gallery__lead {
    margin: 28px 0 0;
    color: var(--color-muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    max-width: 620px;
  }
  .tpl-gallery__hint {
    margin: 30px 0 0;
    display: flex; align-items: flex-start; gap: 18px;
    padding: 18px 22px;
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    max-width: 620px;
  }
  .tpl-gallery__hint-num {
    font-family: 'Unbounded', sans-serif;
    font-size: 40px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-text);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .tpl-gallery__hint span:last-child {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
    padding-top: 6px;
  }

  .tpl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  .tpl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .tpl-card:hover {
    border-color: var(--color-text);
    transform: translateY(-3px);
    box-shadow: 0 22px 50px rgba(11, 20, 36, 0.08);
  }
  .tpl-card__head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 22px;
  }
  .tpl-card__num {
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--color-muted-2);
  }
  .tpl-card__palette { display: flex; gap: 6px; }
  .tpl-card__swatch {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }
  .tpl-card__body { flex: 1; display: flex; flex-direction: column; }
  .tpl-card__title {
    margin: 0;
    font: 500 24px/1.15 'Unbounded', sans-serif;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }
  .tpl-card__sub {
    margin-top: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tpl-card__desc {
    margin: 18px 0 18px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.65;
    flex: 1;
  }
  .tpl-card__fonts {
    font-size: 11px;
    color: var(--color-muted-2);
    letter-spacing: 0.5px;
    padding: 8px 12px;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .tpl-card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tpl-card__tag {
    font-size: 10.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 4px 10px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .tpl-card__cta {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: space-between;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }
  .tpl-card__cta-arrow {
    transition: transform 0.25s;
    color: var(--color-muted);
  }
  .tpl-card:hover .tpl-card__cta-arrow {
    transform: translateX(5px);
    color: var(--color-text);
  }

  .tpl-gallery__bottom {
    margin-top: 60px;
    padding: 36px;
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex; flex-direction: column; gap: 20px;
    align-items: flex-start;
  }
  .tpl-gallery__bottom p {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .tpl-cta-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 26px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    transition: background 0.2s;
  }
  .tpl-cta-btn:hover { background: var(--color-muted); }
  .tpl-cta-btn span { transition: transform 0.2s; }
  .tpl-cta-btn:hover span { transform: translateX(4px); }

  @media (min-width: 720px) {
    .tpl-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) {
    .tpl-grid { grid-template-columns: repeat(3, 1fr); }
    .tpl-gallery__bottom { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>

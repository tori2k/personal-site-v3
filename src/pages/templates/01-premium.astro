---
import TemplateLayout from '../../layouts/templates/TemplateLayout.astro';

const tiers = [
  { name: 'Standard', price: 'от 50 000 ₽', desc: 'Один лендинг с заявками. Концепция, дизайн, вёрстка. Срок 2–3 недели.' },
  { name: 'Atelier',  price: 'от 120 000 ₽', desc: 'Эксклюзивный дизайн, кастомные иллюстрации, анимации. Срок 4–6 недель.', featured: true },
  { name: 'Couture',  price: 'индивидуально', desc: 'Полная разработка бренд-системы и сайта. Срок от 2 месяцев.' },
];
---
<TemplateLayout
  title="01 · Премиум-минимал — Atelier Vermeer"
  description="Образец шаблона сайта в премиальном стиле: айвори, графит, золото, Cormorant serif."
  fontsHref="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
>
  <main class="premium">
    <header class="premium-nav">
      <a href="#top" class="premium-nav__brand">
        <svg class="premium-nav__crest" viewBox="0 0 40 40" aria-hidden="true">
          <rect x="6" y="6" width="28" height="28" fill="none" stroke="currentColor" stroke-width="0.8"/>
          <rect x="12" y="12" width="16" height="16" fill="none" stroke="currentColor" stroke-width="0.4"/>
          <text x="20" y="25" text-anchor="middle" font-family="Cormorant Garamond" font-style="italic" font-size="13">A</text>
        </svg>
        <span class="premium-nav__brand-text">
          <span class="premium-nav__brand-name">Atelier Vermeer</span>
          <span class="premium-nav__brand-sub">est. 2024 · Москва</span>
        </span>
      </a>
      <nav class="premium-nav__links">
        <a href="#about">О бюро</a>
        <a href="#pricing">Услуги</a>
        <a href="#contact">Контакты</a>
      </nav>
      <a href="#contact" class="premium-btn premium-btn--gold premium-nav__cta">
        Связаться
        <span class="premium-btn__arrow">→</span>
      </a>
    </header>

    <section id="top" class="premium-hero">
      <div class="premium-hero__bg" aria-hidden="true">
        <span class="premium-hero__circle premium-hero__circle--gold"></span>
        <span class="premium-hero__circle premium-hero__circle--ink"></span>
        <span class="premium-hero__grid"></span>
      </div>

      <div class="premium-container">
        <div class="premium-hero__inner">
          <div class="premium-hero__copy">
            <div class="premium-eyebrow">— Adv. Law &amp; Wealth · est. 2024</div>
            <h1 class="premium-hero__title">
              Право — это<br/>
              <em>искусство</em><br/>
              формы.
            </h1>
            <p class="premium-hero__lead">
              Бюро частной юридической практики. Сопровождаем сделки,
              наследство, корпоративные структуры. Работаем тихо, точно,
              с&nbsp;документальной чистотой.
            </p>
            <div class="premium-hero__actions">
              <a href="#contact" class="premium-btn premium-btn--gold">
                Записаться на консультацию
                <span class="premium-btn__arrow">→</span>
              </a>
              <a href="#about" class="premium-btn">
                О бюро
                <span class="premium-btn__arrow">→</span>
              </a>
            </div>
            <div class="premium-hero__meta">
              <div class="premium-hero__meta-item">
                <span class="premium-hero__meta-dot"></span>
                <span>Конфиденциальность фиксируется договором</span>
              </div>
              <div class="premium-hero__meta-item">
                <span class="premium-hero__meta-dot"></span>
                <span>Партнёрский состав с практикой 15+ лет</span>
              </div>
            </div>
          </div>

          <div class="premium-hero__card-wrap">
            <div class="premium-hero__card">
              <div class="premium-hero__card-head">
                <span class="premium-hero__card-tag">портфель доверителей</span>
                <span class="premium-hero__card-live"></span>
              </div>
              <div class="premium-hero__card-num">847<span class="premium-hero__card-plus">+</span></div>
              <div class="premium-hero__card-sub">завершённых дел за 18 лет практики</div>

              <div class="premium-hero__card-divider"></div>

              <div class="premium-hero__card-grid">
                <div>
                  <div class="premium-hero__card-cell-num">18<span>+</span></div>
                  <div class="premium-hero__card-cell-lbl">лет практики</div>
                </div>
                <div>
                  <div class="premium-hero__card-cell-num">96<span>%</span></div>
                  <div class="premium-hero__card-cell-lbl">успешных дел</div>
                </div>
              </div>

              <div class="premium-hero__card-quote">
                <span class="premium-hero__card-quote-mark">«</span>
                <p>Каждое дело&nbsp;— это история. Наша работа&nbsp;— рассказать&nbsp;её правильно.</p>
                <span class="premium-hero__card-quote-name">— партнёры бюро</span>
              </div>

              <div class="premium-hero__card-seal" aria-hidden="true">
                <svg viewBox="0 0 80 80">
                  <circle cx="40" cy="40" r="36" fill="none" stroke="currentColor" stroke-width="0.4"/>
                  <circle cx="40" cy="40" r="30" fill="none" stroke="currentColor" stroke-width="0.4"/>
                  <text x="40" y="36" text-anchor="middle" font-family="Cormorant Garamond" font-style="italic" font-size="10">est.</text>
                  <text x="40" y="50" text-anchor="middle" font-family="Cormorant Garamond" font-size="13">2024</text>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="premium-about">
      <div class="premium-container">
        <div class="premium-about__grid">
          <div class="premium-about__head">
            <div class="premium-eyebrow">— Бюро</div>
            <h2 class="premium-h2">
              Сделки, наследство,<br/>
              <em>корпоративные<br/>структуры.</em>
            </h2>
          </div>
          <div class="premium-about__body">
            <p>
              Atelier Vermeer&nbsp;— частная юридическая практика для людей,
              которым важна точность формы. Не&nbsp;конвейер&nbsp;— а&nbsp;ремесло.
              За&nbsp;каждым делом&nbsp;— партнёр, а&nbsp;не&nbsp;ассистент.
            </p>
            <p>
              Работаем по&nbsp;четырём направлениям: частное право,
              наследственные дела, M&amp;A, защита активов. Никаких массовых
              рассылок и&nbsp;холодных звонков&nbsp;— только рекомендации.
            </p>
            <ul class="premium-about__list">
              <li><span>I.</span> Конфиденциальность фиксируется договором</li>
              <li><span>II.</span> Партнёр ведёт дело лично, без передачи помощникам</li>
              <li><span>III.</span> Прозрачные сметы, без скрытых процентов</li>
              <li><span>IV.</span> Доверительный формат коммуникации</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="premium-pricing">
      <div class="premium-container">
        <div class="premium-pricing__head">
          <div class="premium-eyebrow">— Услуги</div>
          <h2 class="premium-h2">Три формата<br/><em>сотрудничества.</em></h2>
          <p class="premium-pricing__lead">
            Точная стоимость и&nbsp;сроки определяются после очной встречи.
            Ниже&nbsp;— ориентир по&nbsp;ставкам.
          </p>
        </div>
        <div class="premium-pricing__grid">
          {tiers.map((t) => (
            <article class={`premium-tier${t.featured ? ' premium-tier--featured' : ''}`}>
              {t.featured && <span class="premium-tier__badge">Рекомендуем</span>}
              <h3 class="premium-tier__name">{t.name}</h3>
              <div class="premium-tier__price">{t.price}</div>
              <p class="premium-tier__desc">{t.desc}</p>
              <a href="#contact" class={`premium-btn${t.featured ? ' premium-btn--gold' : ''} premium-tier__cta`}>
                Запросить смету
                <span class="premium-btn__arrow">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer id="contact" class="premium-foot">
      <div class="premium-container">
        <div class="premium-foot__inner">
          <div>
            <div class="premium-eyebrow">— Контакты</div>
            <h3 class="premium-foot__title">Atelier Vermeer</h3>
            <p class="premium-foot__addr">Москва · ул. Большая Никитская, 14</p>
          </div>
          <div class="premium-foot__channels">
            <a href="tel:+74950000000">+7 495 000-00-00</a>
            <a href="mailto:hello@vermeer.law">hello@vermeer.law</a>
            <a href="https://t.me/">Telegram · @vermeer_law</a>
          </div>
        </div>
        <div class="premium-foot__bottom">
          <span>© 2026 Atelier Vermeer · Все права защищены</span>
          <span>шаблон 01 · премиум-минимал</span>
        </div>
      </div>
    </footer>
  </main>

  <style is:global>
    .premium {
      --paper:     #f7f4ee;
      --paper-2:   #efeae0;
      --ink:       #0b1424;
      --ink-soft:  #2a3654;
      --slate:     #5a6580;
      --slate-2:   #8a93a6;
      --line:      rgba(11, 20, 36, 0.10);
      --line-2:    rgba(11, 20, 36, 0.20);
      --gold:      #b8923f;
      --gold-deep: #8e6f24;

      background: var(--paper);
      color: var(--ink);
      font: 400 16px/1.6 'Inter', system-ui, sans-serif;
      min-height: 100vh;
    }
    .premium-container { max-width: 1240px; margin: 0 auto; padding: 0 28px; }

    .premium-eyebrow {
      font: 500 11px/1 'JetBrains Mono', monospace;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--gold-deep);
    }
    .premium-h2 {
      margin: 18px 0 0;
      font: 400 clamp(36px, 5vw, 60px)/1.05 'Cormorant Garamond', serif;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .premium-h2 em { font-style: italic; color: var(--gold-deep); font-weight: 400; }

    .premium-btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 24px;
      border: 1px solid var(--ink);
      background: transparent;
      color: var(--ink);
      font: 500 13.5px/1 'Inter', system-ui, sans-serif;
      letter-spacing: 0.4px;
      border-radius: 2px;
      transition: all 0.2s ease;
    }
    .premium-btn:hover { background: var(--ink); color: var(--paper); }
    .premium-btn__arrow { transition: transform 0.2s; }
    .premium-btn:hover .premium-btn__arrow { transform: translateX(4px); }

    .premium-btn--gold {
      background: linear-gradient(180deg, #d4a957 0%, #8e6f24 100%);
      border-color: var(--gold-deep);
      color: #1a1306;
      font-weight: 600;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
      box-shadow:
        inset 0 1px 0 rgba(255, 240, 200, 0.6),
        inset 0 -1px 0 rgba(94, 70, 14, 0.3),
        0 8px 22px rgba(142, 111, 36, 0.25);
    }
    .premium-btn--gold:hover {
      background: linear-gradient(180deg, #e0b766 0%, #9b7b29 100%);
      color: #1a1306;
      transform: translateY(-1px);
      box-shadow:
        inset 0 1px 0 rgba(255, 248, 220, 0.75),
        inset 0 -1px 0 rgba(94, 70, 14, 0.35),
        0 12px 30px rgba(142, 111, 36, 0.32);
    }

    /* === NAV === */
    .premium-nav {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      gap: 24px;
      padding: 18px 28px;
      background: rgba(247, 244, 238, 0.85);
      backdrop-filter: blur(18px) saturate(1.4);
      -webkit-backdrop-filter: blur(18px) saturate(1.4);
      border-bottom: 1px solid var(--line);
    }
    .premium-nav__brand { display: flex; align-items: center; gap: 12px; color: var(--ink); }
    .premium-nav__crest { width: 38px; height: 38px; color: var(--ink); }
    .premium-nav__brand-text { display: flex; flex-direction: column; line-height: 1.05; }
    .premium-nav__brand-name {
      font: 500 20px/1 'Cormorant Garamond', serif;
      letter-spacing: -0.01em;
    }
    .premium-nav__brand-sub {
      font: 400 10px/1 'JetBrains Mono', monospace;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--slate);
      margin-top: 4px;
    }
    .premium-nav__links { display: none; gap: 32px; }
    .premium-nav__links a {
      font-size: 14px; color: var(--ink-soft);
      transition: color 0.2s;
    }
    .premium-nav__links a:hover { color: var(--gold-deep); }
    .premium-nav__cta { padding: 11px 20px; font-size: 12.5px; }

    /* === HERO === */
    .premium-hero { position: relative; overflow: hidden; padding: 50px 0 100px; }
    .premium-hero__bg { position: absolute; inset: 0; pointer-events: none; }
    .premium-hero__circle {
      position: absolute; border-radius: 50%; filter: blur(20px);
    }
    .premium-hero__circle--gold {
      top: -20%; right: -10%;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(184, 146, 63, 0.10) 0%, transparent 65%);
    }
    .premium-hero__circle--ink {
      bottom: -15%; left: -10%;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(26, 37, 66, 0.06) 0%, transparent 65%);
    }
    .premium-hero__grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(to right, rgba(11, 20, 36, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(11, 20, 36, 0.04) 1px, transparent 1px);
      background-size: 80px 80px;
      mask-image: radial-gradient(ellipse at 50% 40%, black 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 0%, transparent 75%);
    }

    .premium-hero__inner {
      position: relative;
      display: grid; grid-template-columns: 1fr; gap: 60px;
      padding-top: 60px;
      align-items: center;
    }
    .premium-hero__title {
      margin: 24px 0 0;
      font: 400 clamp(46px, 7vw, 92px)/1.02 'Cormorant Garamond', serif;
      letter-spacing: -0.025em;
      color: var(--ink);
    }
    .premium-hero__title em {
      font-style: italic; font-weight: 400; color: var(--gold-deep);
    }
    .premium-hero__lead {
      margin: 28px 0 0;
      max-width: 480px;
      color: var(--ink-soft);
      font-size: 16.5px;
      line-height: 1.75;
    }
    .premium-hero__actions {
      margin-top: 36px;
      display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
    }
    .premium-hero__meta {
      margin-top: 40px;
      display: flex; flex-direction: column; gap: 14px;
    }
    .premium-hero__meta-item {
      display: flex; align-items: flex-start; gap: 12px;
      font-size: 13.5px; color: var(--slate);
    }
    .premium-hero__meta-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 0 4px rgba(184, 146, 63, 0.15);
      flex-shrink: 0;
      margin-top: 6px;
    }

    .premium-hero__card-wrap {
      position: relative;
      perspective: 1400px;
    }
    .premium-hero__card {
      position: relative;
      padding: 30px 28px 26px;
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(20px) saturate(1.4);
      -webkit-backdrop-filter: blur(20px) saturate(1.4);
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 14px;
      box-shadow:
        0 30px 60px rgba(11, 20, 36, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
      transform: rotateX(2deg);
    }
    .premium-hero__card-head {
      display: flex; align-items: center; justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 22px;
    }
    .premium-hero__card-tag {
      font: 500 10px/1 'JetBrains Mono', monospace;
      letter-spacing: 2px; text-transform: uppercase;
      color: var(--slate);
    }
    .premium-hero__card-live {
      width: 8px; height: 8px; border-radius: 50%;
      background: #2f8f5a;
      box-shadow: 0 0 0 4px rgba(47, 143, 90, 0.18);
      animation: premium-pulse 1.8s ease-in-out infinite;
    }
    @keyframes premium-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(0.75); opacity: 0.5; }
    }
    .premium-hero__card-num {
      font: 500 clamp(72px, 11vw, 132px)/0.95 'Cormorant Garamond', serif;
      letter-spacing: -0.03em;
      color: var(--ink);
      display: flex; align-items: baseline;
    }
    .premium-hero__card-plus { font-size: 0.55em; color: var(--gold-deep); margin-left: 4px; }
    .premium-hero__card-sub {
      margin-top: 8px;
      font-size: 13.5px;
      color: var(--ink-soft);
      max-width: 280px;
    }
    .premium-hero__card-divider {
      margin: 22px 0;
      height: 1px;
      background: var(--gold);
      width: 50px;
    }
    .premium-hero__card-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .premium-hero__card-grid > div {
      background: rgba(255, 255, 255, 0.5);
      padding: 18px 16px;
    }
    .premium-hero__card-cell-num {
      font: 500 30px/1 'Cormorant Garamond', serif;
      letter-spacing: -0.02em;
      color: var(--ink);
      display: inline-flex; align-items: baseline;
    }
    .premium-hero__card-cell-num span {
      font-size: 0.55em;
      color: var(--gold-deep);
      margin-left: 3px;
    }
    .premium-hero__card-cell-lbl {
      margin-top: 6px;
      font-size: 11.5px; color: var(--slate);
      letter-spacing: 0.3px;
    }
    .premium-hero__card-quote {
      margin-top: 26px;
      padding: 0 0 0 26px;
      position: relative;
    }
    .premium-hero__card-quote-mark {
      position: absolute; left: -4px; top: -16px;
      font: 400 56px/1 'Cormorant Garamond', serif;
      color: var(--gold);
      font-style: italic;
    }
    .premium-hero__card-quote p {
      margin: 0;
      font: italic 400 16.5px/1.5 'Cormorant Garamond', serif;
      color: var(--ink);
    }
    .premium-hero__card-quote-name {
      display: block; margin-top: 12px;
      font: 500 10.5px/1 'JetBrains Mono', monospace;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--slate);
    }
    .premium-hero__card-seal {
      position: absolute; bottom: 18px; right: 18px;
      width: 64px; height: 64px;
      color: var(--gold-deep);
      opacity: 0.65;
    }
    .premium-hero__card-seal svg { width: 100%; height: 100%; }

    /* === ABOUT === */
    .premium-about { padding: 110px 0; background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .premium-about__grid { display: grid; grid-template-columns: 1fr; gap: 50px; }
    .premium-about__body p {
      margin: 0 0 18px;
      color: var(--ink-soft);
      font-size: 16px; line-height: 1.7;
      max-width: 540px;
    }
    .premium-about__list {
      margin: 30px 0 0; padding: 0; list-style: none;
      display: flex; flex-direction: column; gap: 14px;
    }
    .premium-about__list li {
      display: grid; grid-template-columns: 40px 1fr; gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font: 400 15.5px/1.5 'Cormorant Garamond', serif;
      color: var(--ink);
    }
    .premium-about__list li span {
      color: var(--gold-deep);
      font-style: italic;
    }

    /* === PRICING === */
    .premium-pricing { padding: 110px 0; }
    .premium-pricing__head { max-width: 720px; margin-bottom: 50px; }
    .premium-pricing__lead {
      margin: 24px 0 0;
      color: var(--ink-soft);
      font-size: 16px; line-height: 1.7;
      max-width: 540px;
    }
    .premium-pricing__grid {
      display: grid; grid-template-columns: 1fr; gap: 20px;
    }
    .premium-tier {
      position: relative;
      padding: 36px 30px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 10px;
      transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    }
    .premium-tier:hover {
      border-color: var(--gold);
      transform: translateY(-3px);
      box-shadow: 0 22px 48px rgba(11, 20, 36, 0.08);
    }
    .premium-tier--featured {
      background: linear-gradient(180deg, var(--paper) 0%, #fbf6ec 100%);
      border-color: var(--gold);
      box-shadow: 0 18px 40px rgba(184, 146, 63, 0.15);
    }
    .premium-tier__badge {
      position: absolute; top: -10px; left: 28px;
      background: linear-gradient(180deg, #d4a957 0%, #8e6f24 100%);
      color: #1a1306;
      font: 600 10px/1 'Inter', sans-serif;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 12px;
      border-radius: 999px;
    }
    .premium-tier__name {
      margin: 0;
      font: 500 28px/1 'Cormorant Garamond', serif;
      letter-spacing: -0.01em;

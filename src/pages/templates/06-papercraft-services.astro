---
import PapercraftLayout from '../../layouts/templates/PapercraftLayout.astro';

const HOME = '/templates/06-papercraft';
const services = [
  { name: 'Бесплатный разбор', tag: 'старт', price: '0 ₽', d: 'Смотрю сайт и путь заявки — план из 3 шагов.' },
  { name: 'Аудит обработки заявок', tag: 'диагностика', price: 'от 0 ₽', d: 'Где теряются лиды между кликом и продажей.' },
  { name: 'Сайт с Telegram-заявками', tag: 'лёгкий фикс', price: 'от 49 000 ₽', d: 'Лендинг + приём заявок в Telegram, быстрый запуск.' },
  { name: 'Антислив: AI-система', tag: 'система', price: 'от 120 000 ₽', d: 'Сайт + квиз + Telegram + CRM + AI-дожим.', featured: true },
  { name: 'Антислив + сопровождение', tag: 'максимум', price: 'индивид.', d: 'Система заявок плюс ведение и доработки.' },
];
const autos = ['Заявка → Telegram', 'CRM / таблица', 'AI-дожим', 'Онлайн-оплата', 'Лид-воронка', 'Контент-завод'];
---
<PapercraftLayout title="Услуги · Papercraft — kirillbaryev.ru" description="Сайты и автоматизация заявок: разбор, лёгкий фикс, AI-система, сопровождение." active="services">
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-sticker pc-sticker--ai" style="--rot:12deg; top:0; right:8px">AI</span>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Услуги</span>
    <h1 class="pc-h1b">Сайт + автоматизация <span class="pc-mark">под заявки</span></h1>
    <p class="pc-lead">От бесплатного разбора до&nbsp;системы, где заявка сама доходит до&nbsp;вас.</p>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Линейка</span>
    <h2 class="pc-h2">Выберите <span class="pc-mark">формат</span></h2>
    <div class="pc-svc">
      {services.map((s) => (
        <div class:list={['pc-svc__card pc-paper pc-reveal', s.featured && 'is-feat']}>
          <span class="pc-svc__tag">{s.tag}</span>
          <h3 class="pc-svc__name">{s.name}</h3>
          <div class="pc-svc__price">{s.price}</div>
          <p class="pc-svc__d">{s.d}</p>
          <a href="https://t.me/tori2k" class="pc-btn pc-btn--sm pc-btn--ghost">Обсудить</a>
        </div>
      ))}
    </div>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Под капотом</span>
    <h2 class="pc-h2">Что я <span class="pc-mark">автоматизирую</span></h2>
    <ul class="pc-autos pc-reveal">
      {autos.map((a) => (<li class="pc-autos__chip">{a}</li>))}
    </ul>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>По нишам</span>
    <h2 class="pc-h2">Найдите <span class="pc-mark">свой случай</span></h2>
    <div class="pc-niches pc-reveal">
      <a href="/templates/06-papercraft-niche/ekspert" class="pc-niche pc-paper">Экспертам</a>
      <a href="/templates/06-papercraft-niche/yurist" class="pc-niche pc-paper">Юристам</a>
      <a href="/templates/06-papercraft-niche/ai" class="pc-niche pc-paper">AI-автоматизация</a>
      <a href="/templates/06-papercraft-niche/antisliv" class="pc-niche pc-paper">Антислив заявок</a>
    </div>
  </section>

  <section class="pc-sec pc-ctasec">
    <div class="pc-ticket pc-paper pc-reveal">
      <h2 class="pc-h2">Не знаете, <span class="pc-mark">что вам нужно?</span></h2>
      <p class="pc-lead pc-lead--c">Начните с бесплатного разбора — скажу честно, нужен ли новый сайт.</p>
      <a href="https://t.me/tori2k" class="pc-btn"><span class="pc-btn__plus">(+)</span>Получить разбор</a>
    </div>
  </section>

  <style>
    .pc-svc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 24px; align-items: start; }
    .pc-svc__card { position: relative; padding: 26px 24px 24px; display: flex; flex-direction: column; transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-svc__card:nth-child(2n) { transform: rotate(.5deg); }
    .pc-svc__card:hover { transform: translateY(-6px) rotate(-.7deg); }
    .pc-svc__card.is-feat { outline: 3px solid var(--mark); outline-offset: -3px; }
    .pc-svc__tag { display: inline-block; align-self: flex-start; font-family: 'Special Elite', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #fff; background: var(--mark2); padding: 3px 9px; border-radius: 4px; text-shadow: none; }
    .pc-svc__name { font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: 17px; margin: 12px 0 0; }
    .pc-svc__price { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 22px; color: var(--mark); margin: 8px 0 0; }
    .pc-svc__d { margin: 8px 0 16px; font-size: 13.5px; line-height: 1.5; color: var(--ink-soft); }
    .pc-svc__card .pc-btn { margin-top: auto; align-self: flex-start; }

    .pc-autos { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
    .pc-autos__chip { font-family: 'Special Elite', monospace; font-size: 14px; background: var(--paper); padding: 11px 18px; filter: url(#torn) drop-shadow(0 6px 10px rgba(40,28,12,.22)); transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
    .pc-autos__chip:nth-child(2n) { transform: rotate(-1.4deg); }
    .pc-autos__chip:hover { transform: translateY(-3px) rotate(1.5deg); }

    .pc-niches { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
    .pc-niche { padding: 16px 24px; font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: 16px; transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-niche:nth-child(2n) { transform: rotate(-1.2deg); }
    .pc-niche:hover { transform: translateY(-4px) rotate(1.4deg); }
    @media (max-width: 860px) { .pc-svc { grid-template-columns: 1fr; } }
  </style>
</PapercraftLayout>

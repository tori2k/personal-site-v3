---
import TemplateLayout from '../../layouts/templates/TemplateLayout.astro';

const features = [
  { icon: '⚡', title: 'Реалтайм-данные', desc: 'WebSocket-стримы из 14 рынков. Лаг <50 мс.', tag: 'core' },
  { icon: '◇', title: 'Smart-routing', desc: 'Маршрутизация ордеров по 6 venues с минимальным slippage.', tag: 'engine' },
  { icon: '⊞', title: 'Risk-scoring', desc: 'ML-модель оценивает риск каждой позиции в момент входа.', tag: 'ai' },
  { icon: '⋈', title: 'Compliance API', desc: 'AML/KYC встроены. Готовые отчёты для регулятора.', tag: 'sec' },
  { icon: '◐', title: 'Multi-tenant', desc: 'Изолированные среды для каждого клиента. SLA 99.99%.', tag: 'infra' },
  { icon: '⊕', title: 'Open API', desc: 'REST + GraphQL + Webhooks. SDK на 6 языках.', tag: 'dev' },
];
const stats = [
  { num: '14.2', tail: 'млрд $', label: 'оборот за 2025', tone: 'cyan' },
  { num: '847', tail: 'банков', label: 'в сети партнёров', tone: 'cyan' },
  { num: '99.97', tail: '%', label: 'аптайм', tone: 'green' },
  { num: '<50', tail: 'мс', label: 'медиана отклика', tone: 'green' },
];
---
<TemplateLayout
  title="02 · Тёмный SaaS — Helix Finance"
  description="Образец шаблона сайта в тёмном фин-тех стиле: глубокий синий, neon-cyan, glass-эффекты."
  fontsHref="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
  bodyClass="dark"
>
  <main class="dark">
    <div class="dark-grid" aria-hidden="true"></div>
    <div class="dark-blob dark-blob--cyan" aria-hidden="true"></div>
    <div class="dark-blob dark-blob--purple" aria-hidden="true"></div>

    <header class="dark-nav">
      <a href="#top" class="dark-nav__brand">
        <span class="dark-nav__mark">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 4 L28 11 L28 21 L16 28 L4 21 L4 11 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="16" cy="16" r="4" fill="currentColor"/>
          </svg>
        </span>
        <span class="dark-nav__name">Helix<span class="dark-nav__name-dot">.</span>finance</span>
      </a>
      <nav class="dark-nav__links">
        <a href="#features">Платформа</a>
        <a href="#stats">Цифры</a>
        <a href="#docs">Docs</a>
        <a href="#pricing">Pricing</a>
      </nav>
      <div class="dark-nav__right">
        <a href="#login" class="dark-nav__login">Вход</a>
        <a href="#demo" class="dark-btn dark-btn--primary">
          Демо <span class="dark-btn__arrow">→</span>
        </a>
      </div>
    </header>

    <section id="top" class="dark-hero">
      <div class="dark-container">
        <div class="dark-hero__inner">
          <div class="dark-hero__copy">
            <div class="dark-badge">
              <span class="dark-badge__dot"></span>
              <span>v2.4 · live trading engine</span>
            </div>
            <h1 class="dark-hero__title">
              Финансовая<br/>
              инфраструктура.<br/>
              <span class="dark-grad">Без посредников.</span>
            </h1>
            <p class="dark-hero__lead">
              Helix&nbsp;— SaaS для банков, брокеров и&nbsp;fintech-стартапов.
              Маршрутизация ордеров, риск-скоринг, compliance&nbsp;— в&nbsp;одной
              платформе. От&nbsp;интеграции до&nbsp;первого ордера&nbsp;— 14&nbsp;дней.
            </p>
            <div class="dark-hero__actions">
              <a href="#demo" class="dark-btn dark-btn--primary">
                Начать демо
                <span class="dark-btn__arrow">→</span>
              </a>
              <a href="#docs" class="dark-btn dark-btn--ghost">
                <span class="dark-btn__dot"></span>
                docs.helix.fi
              </a>
            </div>
            <div class="dark-hero__partners">
              <span class="dark-hero__partners-label">trusted by</span>
              <div class="dark-hero__partners-list">
                <span>NEXUS</span>
                <span>FIVE.X</span>
                <span>METRIK</span>
                <span>ORBIT</span>
              </div>
            </div>
          </div>

          <div class="dark-hero__panel">
            <div class="dark-glass">
              <div class="dark-glass__head">
                <div class="dark-glass__dots">
                  <span></span><span></span><span class="dark-glass__dot-live"></span>
                </div>
                <span class="dark-glass__title">live · order_book.eth</span>
              </div>
              <div class="dark-glass__body">
                <div class="dark-glass__chart">
                  <svg viewBox="0 0 280 120" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="dark-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#5fbef0" stop-opacity="0.5"/>
                        <stop offset="100%" stop-color="#5fbef0" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <path d="M0,80 L20,72 L40,78 L60,60 L80,55 L100,68 L120,40 L140,45 L160,30 L180,38 L200,22 L220,28 L240,18 L260,24 L280,12 L280,120 L0,120 Z" fill="url(#dark-grad)"/>
                    <path d="M0,80 L20,72 L40,78 L60,60 L80,55 L100,68 L120,40 L140,45 L160,30 L180,38 L200,22 L220,28 L240,18 L260,24 L280,12" fill="none" stroke="#5fbef0" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="280" cy="12" r="4" fill="#5fbef0">
                      <animate attributeName="r" values="3;6;3" dur="1.6s" repeatCount="indefinite"/>
                    </circle>
                  </svg>
                </div>
                <div class="dark-glass__metrics">
                  <div>
                    <div class="dark-glass__metric-lbl">spread</div>
                    <div class="dark-glass__metric-val">0.014<span>%</span></div>
                  </div>
                  <div>
                    <div class="dark-glass__metric-lbl">volume 24h</div>
                    <div class="dark-glass__metric-val">$2.4<span>M</span></div>
                  </div>
                  <div>
                    <div class="dark-glass__metric-lbl">latency</div>
                    <div class="dark-glass__metric-val dark-grad">42<span>ms</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="dark-features">
      <div class="dark-container">
        <div class="dark-section-head">
          <span class="dark-eyebrow">// platform.modules</span>
          <h2 class="dark-h2">
            Шесть модулей<br/>
            <span class="dark-grad">в одной платформе.</span>
          </h2>
          <p class="dark-section-lead">
            Подключайте только то, что нужно. Каждый модуль работает
            автономно или в&nbsp;связке. Pay-as-you-go.
          </p>
        </div>

        <div class="dark-features__grid">
          {features.map((f) => (
            <div class="dark-feature">
              <div class="dark-feature__head">
                <span class="dark-feature__icon">{f.icon}</span>
                <span class="dark-feature__tag">{f.tag}</span>
              </div>
              <h3 class="dark-feature__title">{f.title}</h3>
              <p class="dark-feature__desc">{f.desc}</p>
              <a href="#" class="dark-feature__link">
                подробнее <span>→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="stats" class="dark-stats">
      <div class="dark-container">
        <div class="dark-stats__head">
          <span class="dark-eyebrow">// runtime.metrics</span>
          <h2 class="dark-h2">
            Цифры,<br/>
            <span class="dark-grad">которые работают.</span>
          </h2>
        </div>
        <div class="dark-stats__grid">
          {stats.map((s) => (
            <div class={`dark-stat dark-stat--${s.tone}`}>
              <div class="dark-stat__num">
                {s.num}<span class="dark-stat__tail">{s.tail}</span>
              </div>
              <div class="dark-stat__label">{s.label}</div>
              <div class="dark-stat__bar"><span></span></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <footer class="dark-foot">
      <div class="dark-container">
        <div class="dark-foot__top">
          <div class="dark-foot__brand">
            <span class="dark-nav__mark">
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <path d="M16 4 L28 11 L28 21 L16 28 L4 21 L4 11 Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="16" cy="16" r="4" fill="currentColor"/>
              </svg>
            </span>
            <span class="dark-nav__name">Helix<span class="dark-nav__name-dot">.</span>finance</span>
          </div>
          <div class="dark-foot__links">
            <a href="#">Документация</a>
            <a href="#">Status · 99.97%</a>
            <a href="#">Changelog</a>
            <a href="#">Контакты</a>
          </div>
        </div>
        <div class="dark-foot__bottom">
          <span>© 2026 Helix Finance Ltd. All systems operational.</span>
          <span class="dark-mono">// template 02 · dark saas</span>
        </div>
      </div>
    </footer>
  </main>

  <style is:global>
    body.dark { background: #050913; color: #e6edf7; }
    .dark {
      --bg:        #050913;
      --bg-2:      #0a0f1f;
      --surface:   #11182d;
      --surface-2: #1a2340;
      --line:      rgba(110, 170, 240, 0.10);
      --line-2:    rgba(110, 170, 240, 0.22);
      --text:      #e6edf7;
      --muted:     #8b9bbc;
      --muted-2:   #5a6688;
      --cyan:      #5fbef0;
      --cyan-2:    #4d9fde;
      --purple:    #a280ff;
      --green:     #4ade80;
      --gold:      #f0c360;
      font: 400 16px/1.55 'Manrope', system-ui, sans-serif;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }
    .dark-mono { font-family: 'JetBrains Mono', monospace; }
    .dark-grad {
      background: linear-gradient(120deg, #5fbef0 0%, #a280ff 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .dark-container { max-width: 1280px; margin: 0 auto; padding: 0 28px; position: relative; z-index: 2; }

    .dark-grid {
      position: fixed; inset: 0;
      background-image:
        linear-gradient(to right, rgba(110, 170, 240, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(110, 170, 240, 0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
      pointer-events: none; z-index: 1;
    }
    .dark-blob {
      position: fixed; border-radius: 50%; filter: blur(80px);
      pointer-events: none; z-index: 1;
    }
    .dark-blob--cyan {
      top: -20%; left: -10%;
      width: 600px; height: 600px;
      background: rgba(95, 190, 240, 0.20);
    }
    .dark-blob--purple {
      bottom: -20%; right: -10%;
      width: 700px; height: 700px;
      background: rgba(162, 128, 255, 0.15);
    }

    .dark-eyebrow {
      font: 500 11px/1 'JetBrains Mono', monospace;
      letter-spacing: 1.5px;
      color: var(--cyan);
      text-transform: lowercase;
    }
    .dark-h2 {
      margin: 18px 0 0;
      font: 600 clamp(34px, 5vw, 58px)/1.05 'Manrope', sans-serif;
      letter-spacing: -0.025em;
      color: var(--text);
    }
    .dark-section-head { max-width: 720px; margin-bottom: 56px; }
    .dark-section-lead { margin: 22px 0 0; color: var(--muted); font-size: 15.5px; line-height: 1.7; max-width: 540px; }

    .dark-btn {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 26px;
      font: 600 13.5px/1 'Manrope', sans-serif;
      letter-spacing: 0.2px;
      border-radius: 8px;
      border: 1px solid var(--line-2);
      background: var(--surface);
      color: var(--text);
      transition: all 0.2s ease;
    }
    .dark-btn:hover { transform: translateY(-1px); border-color: var(--cyan); }
    .dark-btn--primary {
      background: linear-gradient(135deg, #5fbef0 0%, #4d9fde 100%);
      color: #050913;
      border-color: var(--cyan);
      box-shadow: 0 8px 24px rgba(95, 190, 240, 0.3);
    }
    .dark-btn--primary:hover {
      box-shadow: 0 14px 36px rgba(95, 190, 240, 0.4);
    }
    .dark-btn--ghost {
      background: transparent;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12.5px;
    }
    .dark-btn__arrow { transition: transform 0.2s; }
    .dark-btn:hover .dark-btn__arrow { transform: translateX(4px); }
    .dark-btn__dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    /* === NAV === */
    .dark-nav {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      gap: 24px;
      padding: 18px 28px;
      background: rgba(5, 9, 19, 0.7);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }
    .dark-nav__brand { display: flex; align-items: center; gap: 12px; }
    .dark-nav__mark {
      width: 32px; height: 32px;
      color: var(--cyan);
      display: inline-flex;
    }
    .dark-nav__mark svg { width: 100%; height: 100%; }
    .dark-nav__name {
      font: 700 18px/1 'Manrope', sans-serif;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .dark-nav__name-dot { color: var(--cyan); }
    .dark-nav__links { display: none; gap: 32px; }
    .dark-nav__links a {
      font-size: 14px; color: var(--muted);
      transition: color 0.2s;
    }
    .dark-nav__links a:hover { color: var(--cyan); }
    .dark-nav__right { display: flex; align-items: center; gap: 14px; }
    .dark-nav__login {
      font-size: 14px; color: var(--muted);
      transition: color 0.2s;
    }
    .dark-nav__login:hover { color: var(--text); }

    /* === HERO === */
    .dark-hero { padding: 60px 0 100px; position: relative; }
    .dark-hero__inner { display: grid; grid-template-columns: 1fr; gap: 60px; align-items: center; }
    .dark-badge {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 14px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      background: rgba(95, 190, 240, 0.06);
      font: 500 11.5px/1 'JetBrains Mono', monospace;
      letter-spacing: 0.5px;
      color: var(--muted);
    }
    .dark-badge__dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 10px var(--green);
      animation: dark-pulse 1.8s ease-in-out infinite;
    }
    @keyframes dark-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }
    .dark-hero__title {
      margin: 22px 0 0;
      font: 600 clamp(42px, 6.4vw, 80px)/1.02 'Manrope', sans-serif;
      letter-spacing: -0.03em;
      color: var(--text);
    }
    .dark-hero__lead {
      margin: 26px 0 0;
      max-width: 510px;
      color: var(--muted);
      font-size: 16px; line-height: 1.7;
    }
    .dark-hero__actions {
      margin-top: 36px;
      display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
    }
    .dark-hero__partners {
      margin-top: 50px;
      display: flex; flex-direction: column; gap: 14px;
    }
    .dark-hero__partners-label {
      font: 500 10px/1 'JetBrains Mono', monospace;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted-2);
    }
    .dark-hero__partners-list {
      display: flex; flex-wrap: wrap; gap: 28px;
    }
    .dark-hero__partners-list span {
      font: 700 18px/1 'Manrope', sans-serif;
      letter-spacing: 2px;
      color: var(--muted);
      opacity: 0.75;
      transition: opacity 0.2s, color 0.2s;
    }
    .dark-hero__partners-list span:hover { color: var(--text); opacity: 1; }

    /* === Glass panel === */
    .dark-glass {
      position: relative;
      background: rgba(17, 24, 45, 0.6);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      border: 1px solid rgba(95, 190, 240, 0.2);
      border-radius: 14px;
      overflow: hidden;
      box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.4),
        0 0 0 1px rgba(95, 190, 240, 0.05) inset;
    }
    .dark-glass__head {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      background: rgba(10, 15, 31, 0.5);
    }
    .dark-glass__dots { display: flex; gap: 6px; }
    .dark-glass__dots span {
      width: 9px; height: 9px; border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
    }
    .dark-glass__dots span:nth-child(2) { background: rgba(255, 255, 255, 0.18); }
    .dark-glass__dot-live {
      background: var(--green) !important;
      box-shadow: 0 0 10px var(--green);
      animation: dark-pulse 1.8s ease-in-out infinite;
    }
    .dark-glass__title {
      font: 500 11.5px/1 'JetBrains Mono', monospace;
      letter-spacing: 1px;
      color: var(--muted);
    }
    .dark-glass__body { padding: 0; }
    .dark-glass__chart { padding: 24px 18px 6px; }
    .dark-glass__chart svg { width: 100%; height: 140px; display: block; }
    .dark-glass__metrics {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--line);
      border-top: 1px solid var(--line);
    }
    .dark-glass__metrics > div {
      background: rgba(17, 24, 45, 0.6);
      padding: 16px 18px;
    }
    .dark-glass__metric-lbl {
      font: 500 10px/1 'JetBrains Mono', monospace;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--muted-2);
    }
    .dark-glass__metric-val {
      margin-top: 6px;
      font: 600 24px/1 'Manrope', sans-serif;
      letter-spacing: -0.02em;
      color: var(--text);
      display: inline-flex; align-items: baseline;
    }
    .dark-glass__metric-val span {
      font-size: 0.5em;
      color: var(--muted);
      margin-left: 3px;
    }

    /* === FEATURES === */
    .dark-features { padding: 110px 0; position: relative; }
    .dark-features__grid {
      display: grid; grid-template-columns: 1fr;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }
    .dark-feature {
      background: rgba(17, 24, 45, 0.5);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 28px 26px;
      transition: background 0.3s;
      display: flex; flex-direction: column;
    }
    .dark-feature:hover { background: rgba(26, 35, 64, 0.7); }
    .dark-feature__head {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px;
    }
    .dark-feature__icon {
      width: 44px; height: 44px;
      display: inline-flex;
      align-items: center; justify-content: center;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(95, 190, 240, 0.18), rgba(162, 128, 255, 0.08));
      color: var(--cyan);
      font-size: 22px;
      border: 1px solid rgba(95, 190, 240, 0.25);
    }
    .dark-feature__tag {
      font: 500 10px/1 'JetBrains Mono', monospace;
      letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--muted-2);
      padding: 4px 8px;
      border: 1px solid var(--line-2);
      border-radius: 4px;
    }
    .dark-feature__title {
      margin: 0 0 8px;
      font: 600 19px/1.2 'Manrope', sans-serif;
      letter-spacing: -0.01em;
      color: var(--text);
    }
    .dark-feature__desc {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 14px; line-height: 1.6;
      flex: 1;
    }
    .dark-feature__link {
      display: inline-flex; align-items: center; gap: 6px;
      font: 500 12.5px/1 'JetBrains Mono', monospace;
      letter-spacing: 0.5px;
      color: var(--cyan);
      transition: gap 0.2s;
    }
    .dark-feature__link:hover { gap: 10px; }

    /* === STATS === */
    .dark-stats { padding: 110px 0; position: relative; }
    .dark-stats__head { max-width: 720px; margin-bottom: 50px; }
    .dark-stats__grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    .dark-stat {
      position: relative;
      padding: 32px 28px;
      background: rgba(17, 24, 45, 0.5);
      border: 1px solid var(--line-2);
      border-radius: 12px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      overflow: hidden;
    }
    .dark-stat::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(circle at top right, var(--accent, transparent), transparent 60%);
      opacity: 0.15;
      pointer-events: none;
    }
    .dark-stat--cyan { --accent: rgba(95, 190, 240, 0.4); }
    .dark-stat--green { --accent: rgba(74, 222, 128, 0.4); }
    .dark-stat__num {
      font: 700 clamp(40px, 5.4vw, 56px)/0.95 'Manrope', sans-serif;
      letter-spacing: -0.03em;
      color: var(--text);
      display: inline-flex; align-items: baseline;
    }
    .dark-stat__tail {
      font-size: 0.4em;
      color: var(--cyan);
      font-weight: 500;
      margin-left: 6px;
      letter-spacing: 0.5px;
    }
    .dark-stat--green .dark-stat__tail { color: var(--green); }
    .dark-stat__label {
      margin-top: 14px;

---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = 'Почему бизнес теряет заявки после клика — 6 точек слива и как закрыть';
const description = 'Чаще теряют не на рекламе, а после клика: первый экран, форма, Telegram/WhatsApp, скорость ответа, CRM и дожим. Разбор 6 точек слива заявок + чек-лист и калькулятор потерь.';

const URL = 'https://kirillbaryev.ru/articles/pochemu-biznes-teryaet-zayavki-posle-klika/';
const updated = '2026-06-05';
const updatedHuman = '5 июня 2026';

// Таблица «проблема → причина → решение»
const rows = [
  { p: 'Первый экран не цепляет', c: 'Непонятно, что за услуга и для кого — человек не успевает понять за 5 секунд', s: 'Оффер по нише + понятный следующий шаг на первом экране' },
  { p: 'Форма слишком длинная', c: '8–12 полей, человек закрывает, не дозаполнив', s: 'Квиз из 3–5 шагов вместо формы — выше доходимость' },
  { p: 'Заявку не видят сразу', c: 'Письмо на почту или заявка в админке, которую открывают раз в день', s: 'Telegram/WhatsApp-уведомление о каждой заявке' },
  { p: 'Медленный ответ', c: 'Отвечают через час–сутки, лид успевает уйти к конкуренту', s: 'Напоминание менеджеру через 10–15 минут + быстрый шаблон' },
  { p: 'Лиды теряются', c: 'Заявки в голове и в переписках, нет единого списка', s: 'Google Sheets или CRM со статусами и источником' },
  { p: 'Нет дожима', c: 'Не ответил один раз — лида забыли навсегда', s: 'Автоматический follow-up: серия напоминаний' },
];

const checklist = [
  'На первом экране за 5 секунд понятно, что за услуга и для кого',
  'Вместо длинной формы — квиз на 3–5 шагов',
  'Заявка приходит в Telegram или WhatsApp сразу',
  'На заявку отвечают в течение 15 минут',
  'Все лиды в одной таблице/CRM со статусом и источником',
  'Есть автоматический дожим недозакрытых заявок',
];

const faq = [
  { q: 'Где бизнес чаще всего теряет заявки?', a: 'Не на рекламе, а после клика: на первом экране, в длинной форме, из-за медленного ответа, отсутствия Telegram-уведомлений, CRM и дожима. Каждая точка отнимает часть лидов, и вместе они дают основную утечку.' },
  { q: 'Как понять, сколько денег теряется?', a: 'Посчитайте: заявки в месяц × доля потерянных × потенциальная конверсия × средний чек. Это и есть упущенная выручка. Готовый расчёт — в калькуляторе потерь на сайте.' },
  { q: 'Что чинить первым?', a: 'Сначала — скорость реакции: Telegram-уведомление о заявке и ответ в первые 15 минут. Это самое дешёвое действие с самым быстрым эффектом. Дальше — единый список лидов и дожим.' },
  { q: 'Нужно ли для этого расширять штат?', a: 'Нет. Цель автоматизации — чтобы больше заявок доходило до обработки без раздувания штата: система фиксирует лиды, напоминает и дожимает, менеджер не держит их в голове.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Почему бизнес теряет заявки после клика',
    description,
    url: URL,
    datePublished: updated,
    dateModified: updated,
    inLanguage: 'ru',
    author: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    publisher: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    mainEntityOfPage: URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: 'https://kirillbaryev.ru/articles/' },
      { '@type': 'ListItem', position: 3, name: 'Почему бизнес теряет заявки после клика', item: URL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main>
    <article class="art section-dark">
      <div class="container-x art__wrap">
        <!-- Breadcrumbs -->
        <nav class="art__crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a> <span>/</span>
          <a href="/articles">Статьи</a> <span>/</span>
          <span class="art__crumbs-cur">Почему теряются заявки</span>
        </nav>

        <header class="art__head">
          <div class="sec-tag">Статья</div>
          <h1 class="art__h1">Почему бизнес теряет заявки <em>после клика</em></h1>
          <div class="art__meta">Обновлено {updatedHuman} · 6 минут чтения</div>
        </header>

        <!-- Короткий ответ (AEO) -->
        <div class="art__tldr glass">
          <div class="art__tldr-label">Если коротко</div>
          <p>
            Чаще теряют не на рекламе, а <b>после клика</b>: на первом экране, в длинной форме,
            из-за медленного ответа, отсутствия Telegram-уведомлений, CRM и дожима.
            Реклама приводит лида — а он утекает в воронке. Хорошая новость: эти точки
            закрываются дешевле, чем кажется, и <a href="/calculator">потери можно посчитать</a>.
          </p>
        </div>

        <div class="art__body">
          <p>
            Бизнес часто ищет проблему в трафике: «дорогая реклама», «плохие лиды».
            Но если посмотреть на путь заявки целиком, окажется, что реклама свою работу
            сделала — человек кликнул и оставил интерес. Деньги теряются дальше, в шести
            типовых точках. Разберём каждую.
          </p>

          <h2>6 точек, где утекают заявки</h2>
          <p>
            Это не редкие случаи, а типовая картина малого бизнеса в РФ/СНГ. Обычно работают
            не все точки сразу, но даже две-три дают заметную утечку выручки.
          </p>

          <!-- Таблица проблема → причина → решение -->
          <div class="art__table-wrap">
            <table class="art__table">
              <thead>
                <tr><th>Проблема</th><th>Причина</th><th>Решение</th></tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td>{r.p}</td>
                    <td>{r.c}</td>
                    <td>{r.s}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h2>Почему это вопрос автоматизации, а не «найма ещё людей»</h2>
          <p>
            Логичная реакция — «посадим менеджера, чтобы быстрее отвечал». Но человек
            устаёт, забывает, уходит в отпуск, держит заявки в голове. Система — нет.
            Цель автоматизации не в том, чтобы <b>сокращать людей</b>, а в том, чтобы
            <b>больше заявок доходило до обработки без расширения штата</b>: заявка
            автоматически попадает в Telegram и таблицу, менеджер получает напоминание,
            недозакрытый лид уходит в дожим. Рутина уходит системе — люди занимаются продажей.
          </p>

          <h2>Что проверить у себя — чек-лист</h2>
          <ul class="art__check">
            {checklist.map((c) => <li>{c}</li>)}
          </ul>
          <p>
            Если хотя бы 2–3 пункта не выполнены — заявки утекают прямо сейчас.
            Точную сумму потерь покажет <a href="/calculator">калькулятор</a>, а
            полную карту слива и 25 ошибок — <a href="/anti-sliv-zayavok">бесплатный PDF-гайд</a>.
          </p>

          <!-- CTA-блок -->
          <div class="art__cta glass">
            <div class="art__cta-text">
              <div class="art__cta-title">Найдём ваши точки слива</div>
              <p>Посмотрю сайт или профиль, путь заявки и обработку лида — пришлю 3 конкретные правки.</p>
            </div>
            <a href="/razbor" class="btn btn--filled" data-magnetic="0.3">
              <span class="btn__plus">(+)</span>
              Получить бесплатный разбор
            </a>
          </div>

          <h2>Частые вопросы</h2>
          <dl class="art__faq">
            {faq.map((item, i) => (
              <div class="art__faq-item">
                <details>
                  <summary><span class="art__faq-n">0{i + 1}</span>{item.q}<span class="art__faq-ic">+</span></summary>
                  <dd>{item.a}</dd>
                </details>
              </div>
            ))}
          </dl>

          <p class="art__more">
            Дальше: <a href="/ai-avtomatizaciya-zayavok">AI-автоматизация заявок</a> ·
            <a href="/method">метод и карта слива</a> ·
            <a href="/calculator">калькулятор потерь</a> ·
            <a href="/anti-sliv-zayavok">PDF-гайд «Антислив заявок»</a> ·
            <a href="/razbor">бесплатный разбор</a>.
          </p>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .art { padding: 130px 0 110px; }
  .art__wrap { max-width: 760px; }
  .art__crumbs { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-muted-2); margin-bottom: 28px; }
  .art__crumbs a { color: var(--color-muted); text-decoration: none; }
  .art__crumbs a:hover { color: var(--color-accent); }
  .art__crumbs span { margin: 0 6px; }
  .art__crumbs-cur { color: var(--color-muted-2); }

  .art__h1 { font-family: 'Unbounded', sans-serif; font-size: clamp(30px, 4.5vw, 56px); font-weight: 500; line-height: 1.05; letter-spacing: -0.02em; margin: 14px 0 14px; }
  .art__h1 em { font-style: italic; font-weight: 300; color: var(--aurora-cyan); }
  .art__meta { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--color-muted-2); margin-bottom: 36px; }

  .art__tldr { padding: 24px 26px; border-radius: 16px; margin-bottom: 40px; border-color: rgba(95,198,255,0.25); background: linear-gradient(135deg, rgba(95,198,255,0.07), var(--glass-tint)); }
  .art__tldr-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 10px; }
  .art__tldr p { font-size: 16px; line-height: 1.65; color: var(--color-text); margin: 0; }
  .art__tldr b { font-weight: 600; }
  .art__tldr a, .art__body a, .art__more a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }

  .art__body { font-size: 16px; line-height: 1.75; color: var(--color-muted); }
  .art__body h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(20px, 2.4vw, 28px); font-weight: 500; letter-spacing: -0.01em; color: var(--color-text); margin: 44px 0 16px; }
  .art__body p { margin: 0 0 18px; }
  .art__body b { color: var(--color-text); font-weight: 500; }

  .art__table-wrap { overflow-x: auto; margin: 8px 0 24px; border-radius: 14px; border: 1px solid var(--color-border); }
  .art__table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 520px; }
  .art__table th { text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-accent); padding: 14px 16px; border-bottom: 1px solid var(--color-border); background: rgba(95,198,255,0.04); }
  .art__table td { padding: 14px 16px; border-bottom: 1px solid var(--color-border); color: var(--color-text); line-height: 1.5; vertical-align: top; }
  .art__table tr:last-child td { border-bottom: none; }
  .art__table td:nth-child(2) { color: var(--color-muted); }
  .art__table td:nth-child(3) { color: var(--aurora-cyan); }

  .art__check { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-direction: column; gap: 11px; }
  .art__check li { display: flex; gap: 11px; font-size: 15px; line-height: 1.5; color: var(--color-text); }
  .art__check li::before { content: '✓'; color: #6fd6ad; flex-shrink: 0; font-weight: 600; }

  .art__cta { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 30px; border-radius: 18px; margin: 36px 0; flex-wrap: wrap; }
  .art__cta-title { font-family: 'Unbounded', sans-serif; font-size: 18px; font-weight: 500; color: var(--color-text); margin-bottom: 6px; }
  .art__cta-text p { font-size: 14px; color: var(--color-muted); margin: 0; line-height: 1.5; }

  .art__faq { margin: 0 0 28px; }
  .art__faq-item { border-bottom: 1px solid var(--color-border); }
  .art__faq-item:first-child { border-top: 1px solid var(--color-border); }
  .art__faq summary { display: flex; align-items: center; gap: 12px; padding: 18px 0; cursor: pointer; list-style: none; font-size: 16px; font-weight: 500; color: var(--color-text); }
  .art__faq summary::-webkit-details-marker { display: none; }
  .art__faq-n { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--color-accent); opacity: 0.6; }
  .art__faq-ic { margin-left: auto; color: var(--color-accent); font-size: 18px; transition: transform 0.25s; font-family: 'JetBrains Mono', monospace; }
  details[open] .art__faq-ic { transform: rotate(45deg); }
  .art__faq dd { margin: 0; padding: 0 0 18px 26px; font-size: 15px; line-height: 1.7; color: var(--color-muted); }

  .art__more { font-size: 14px; padding-top: 24px; border-top: 1px solid var(--color-border); color: var(--color-muted-2); }

  @media (max-width: 600px) {
    .art { padding: 100px 0 72px; }
    .art__cta { flex-direction: column; align-items: flex-start; padding: 24px 20px; }
    .art__cta .btn { width: 100%; justify-content: center; }
  }
</style>

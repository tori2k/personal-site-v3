---
import PapercraftLayout from '../../layouts/PapercraftLayout.astro';
import { pcArticles } from '../../data/pcArticles';
const HOME = '/';
const blogJsonLd = {
  '@context': 'https://schema.org', '@type': 'Blog',
  name: 'Блог — Кирилл Барыев', url: 'https://kirillbaryev.ru/articles/', inLanguage: 'ru',
  blogPost: pcArticles.map((a) => ({ '@type': 'BlogPosting', headline: a.title, description: a.excerpt, url: `https://kirillbaryev.ru/articles/${a.slug}/` })),
};
---
<PapercraftLayout title="Блог — заявки, автоматизация, сайты · Кирилл Барыев" description="Заметки про заявки, автоматизацию и сайты, которые продают." jsonLd={blogJsonLd} active="">
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Блог</span>
    <h1 class="pc-h1b">Заметки про <span class="pc-mark">заявки и сайты</span></h1>
    <p class="pc-lead">Коротко о&nbsp;том, как не&nbsp;терять обращения и&nbsp;превращать клики в&nbsp;деньги.</p>
  </section>

  <section class="pc-sec">
    <div class="pc-arts">
      {pcArticles.map((a) => (
        <a href={`/articles/${a.slug}`} class="pc-art pc-paper pc-reveal">
          <span class="pc-art__tag">{a.tag}</span>
          <h2 class="pc-art__title">{a.title}</h2>
          <p class="pc-art__ex">{a.excerpt}</p>
          <span class="pc-art__read">читать →</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .pc-arts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
    .pc-art { display: flex; flex-direction: column; padding: 26px 28px 24px; transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-art:nth-child(3n+2) { transform: rotate(.6deg); }
    .pc-art:hover { transform: translateY(-6px) rotate(-.8deg); }
    .pc-art__tag { align-self: flex-start; font-family: 'Special Elite', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #fff; background: var(--mark); padding: 3px 9px; border-radius: 4px; text-shadow: none; }
    .pc-art__title { font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: 20px; line-height: 1.15; margin: 14px 0 8px; }
    .pc-art__ex { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
    .pc-art__read { margin-top: 16px; font-family: 'Special Elite', monospace; font-size: 13px; color: var(--mark); }
    @media (max-width: 720px) { .pc-arts { grid-template-columns: 1fr; } }
  </style>
</PapercraftLayout>

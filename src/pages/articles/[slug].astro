---
import PapercraftLayout from '../../layouts/PapercraftLayout.astro';
import { pcArticles } from '../../data/pcArticles';

export function getStaticPaths() {
  return pcArticles.map((a) => ({ params: { slug: a.slug }, props: a }));
}
const a = Astro.props;
const BLOG = '/articles';
const articleJsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: a.title, description: a.excerpt,
    datePublished: a.date, dateModified: a.date,
    image: 'https://kirillbaryev.ru/og-image.jpg',
    author: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    publisher: { '@type': 'Person', name: 'Кирилл Барыев' },
    mainEntityOfPage: `https://kirillbaryev.ru/articles/${a.slug}/`,
    inLanguage: 'ru',
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Блог', item: 'https://kirillbaryev.ru/articles/' },
      { '@type': 'ListItem', position: 3, name: a.title, item: `https://kirillbaryev.ru/articles/${a.slug}/` },
    ],
  },
];
---
<PapercraftLayout title={`${a.title} — блог · Кирилл Барыев`} description={a.excerpt} jsonLd={articleJsonLd} ogType="article" active="">
  <section class="pc-press">
    <a href={BLOG} class="pc-back">← все заметки</a>
    <article class="pc-clip pc-reveal">
      <span class="pc-clip__pin" aria-hidden="true"></span>
      <div class="pc-clip__masthead"><span>The&nbsp;Lead&nbsp;Times</span><i>{a.tag} · Москва · 2026</i></div>
      <h1 class="pc-clip__head">{a.title}</h1>
      <div class="pc-clip__sub">{a.excerpt}</div>
      <div class="pc-clip__body">
        {a.body.map((p) => (<p>{p}</p>))}
      </div>
      <div class="pc-clip__foot">Отдел автоматизации · спецрепортаж · стр.&nbsp;1</div>
    </article>

    <div class="pc-press__cta pc-reveal">
      <a href={BLOG} class="pc-btn pc-btn--ghost pc-btn--sm">← к заметкам</a>
      <a href="/razbor" class="pc-btn pc-btn--sm"><span class="pc-btn__plus">(+)</span>Получить разбор</a>
    </div>
  </section>

  <style>
    .pc-press { max-width: 1140px; margin: 0 auto; padding: 20px 26px 40px; }
    .pc-press .pc-back { display: inline-block; margin-bottom: 18px; }
    .pc-clip {
      position: relative; max-width: 720px; margin: 0 auto; padding: 32px 36px 26px;
      background: #efe7d2; color: #1d1812; text-shadow: none; transform: rotate(-1deg);
      font-family: Georgia, 'Times New Roman', serif; box-shadow: 0 22px 44px rgba(40,28,12,.34);
      background-image: linear-gradient(rgba(0,0,0,.022) .5px, transparent .5px); background-size: 100% 4px;
    }
    .pc-clip__pin { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle at 36% 30%, #ff8475, #c0392b 72%); box-shadow: 0 4px 7px rgba(40,28,12,.45), inset -2px -2px 3px rgba(0,0,0,.3); z-index: 2; }
    .pc-clip__masthead { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 8px 0; border-top: 3px double #1d1812; border-bottom: 1px solid #1d1812; }
    .pc-clip__masthead span { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: clamp(18px, 2.6vw, 28px); letter-spacing: .5px; text-transform: uppercase; }
    .pc-clip__masthead i { font-style: normal; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; opacity: .8; white-space: nowrap; }
    .pc-clip__head { font-weight: 700; font-size: clamp(25px, 4vw, 38px); line-height: 1.12; margin: 16px 0 6px; text-align: center; }
    .pc-clip__sub { text-align: center; font-style: italic; font-size: 15px; opacity: .85; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid rgba(29,24,18,.4); }
    .pc-clip__body { column-count: 2; column-gap: 28px; font-size: 14px; line-height: 1.6; text-align: justify; hyphens: auto; }
    .pc-clip__body p { margin: 0 0 11px; }
    .pc-clip__body p:first-of-type::first-letter { font-size: 3.1em; float: left; line-height: .8; padding: 4px 7px 0 0; font-weight: 700; }
    .pc-clip__foot { margin-top: 14px; padding-top: 8px; border-top: 1px solid #1d1812; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; text-align: center; opacity: .75; }
    .pc-press__cta { max-width: 720px; margin: 28px auto 0; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    @media (max-width: 700px) { .pc-clip__body { column-count: 1; } }
  </style>
</PapercraftLayout>

---
import { ArrowUpRightIcon as ArrowUpRight } from '@phosphor-icons/react';
import PapercraftLayout from '../layouts/PapercraftLayout.astro';
---
<PapercraftLayout title="404 | Кирилл Барыев" description="Страница не найдена." noindex={true}>
  <section class="not-found">
    <span class="mono-label">404</span>
    <h1>Здесь <span>ничего нет</span></h1>
    <p>Вернитесь на главную.</p>
    <a class="button" href="/">На главную <ArrowUpRight size={18} weight="regular" /></a>
  </section>
  <style>
    .not-found { width: var(--container); min-height: calc(100svh - 78px); margin: 0 auto; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
    .not-found h1 { max-width: 1000px; margin: 22px 0 0; font-size: clamp(58px, 10vw, 140px); font-weight: 500; line-height: .88; letter-spacing: -.07em; }.not-found h1 span { color: var(--accent); }.not-found p { margin: 30px 0 0; color: var(--muted); font-size: 18px; }.not-found .button { margin-top: 28px; }
  </style>
</PapercraftLayout>

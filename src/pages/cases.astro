---
import PapercraftLayout from '../layouts/PapercraftLayout.astro';

const HOME = '/';
const cases = [
  {
    init: 'M', title: 'Manifik', niche: 'Школа вокала', status: 'В продакшене',
    url: 'https://manifik-school.ru', vid: '/pc/video/manifik.mp4', poster: '/pc/manifik.jpg',
    task: 'Школе нужен сайт, через который родители находят педагогов и сразу записываются и оплачивают — без звонков.',
    points: ['Запись на пробный → Telegram', 'Оплата прямо на сайте', 'Цены и расписание без разработчика', 'Путь «нашёл → записался» в три клика'],
    automated: 'Заявка → Telegram → таблица со статусом',
  },
  {
    init: 'Ф', title: 'ФК «Знамя Труда»', niche: 'Футбольный клуб · Орехово-Зуево', status: 'Запущен',
    url: 'https://fczt1909.ru', vid: '/pc/video/znamya.mp4', poster: '/pc/znamya.jpg',
    task: 'Старейший клуб России жил в соцсетях. Нужен сайт, где болельщик за 10 секунд найдёт матч, состав и новости.',
    points: ['Навигация под сценарий болельщика', 'Новости публикует редактор без программиста', 'Партнёры — как предложение', 'Один источник вместо пабликов'],
    automated: 'Публикация новостей через CMS',
  },
  {
    init: 'Ч', title: 'ЧТИВО ДОМ', niche: 'Концепт · спекулятивная работа', status: 'Концепт',
    url: 'https://tori2k.github.io/chtivo-dom-concept/', img: '/pc/chtivo.jpg',
    task: 'Место зацепило — собрал сайт-визитку в их фирменной стилистике. Упражнение в рамках понравившегося пространства.',
    points: ['Тёмная эстетика под стиль места', 'Быстрая навигация по залам', 'Форма брони прямо на странице', 'Адаптив под телефон'],
    automated: 'Форма брони → уведомление организаторам',
  },
];
const casesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Кейсы — сайты с системой заявок',
  url: 'https://kirillbaryev.ru/cases/',
  inLanguage: 'ru',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: cases.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: c.url })),
  },
};
---
<PapercraftLayout
  title="Кейсы — сайты с системой заявок · Кирилл Барыев"
  description="Проекты: сайты с приёмом заявок в Telegram, оплатой и автоматизацией. Manifik, ФК «Знамя Труда», ЧТИВО ДОМ."
  jsonLd={casesJsonLd}
  active="cases"
>
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-sticker pc-sticker--star" style="--rot:13deg; top:0; right:6px">★</span>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Портфолио</span>
    <h1 class="pc-h1b">Сайты, которые <span class="pc-mark">ловят заявки</span></h1>
    <p class="pc-lead">Каждый — с системой заявок и&nbsp;интеграциями. Наведитесь — запись оживает.</p>
  </section>

  <section class="pc-cases2">
    {cases.map((c) => (
      <article class="pc-case2 pc-paper pc-reveal">
        <a href={c.url} target="_blank" rel="noopener" class="pc-case2__media">
          <img class="pc-case2__frame" src="/pc/caseframe.webp" alt="" aria-hidden="true" />
          <span class="pc-case2__screen" aria-hidden="true">
            {c.vid
              ? <video class="pc-case2__vid" src={c.vid} poster={c.poster} muted loop playsinline preload="none"></video>
              : <img class="pc-case2__vid" src={c.img} alt="" />}
            <span class="pc-case2__tint"></span>
          </span>
          <span class="pc-case2__status">{c.status}</span>
          <span class="pc-case2__play">▶ открыть</span>
        </a>
        <div class="pc-case2__body">
          <div class="pc-case2__niche">{c.niche}</div>
          <div class="pc-case2__title">{c.title}</div>
          <p class="pc-case2__task">{c.task}</p>
          <ul class="pc-case2__points">{c.points.map((p) => (<li><span>✓</span>{p}</li>))}</ul>
          <div class="pc-case2__auto"><b>Автоматизировано:</b> {c.automated}</div>
        </div>
      </article>
    ))}
  </section>

  <section class="pc-sec pc-ctasec">
    <div class="pc-ticket pc-paper pc-reveal">
      <h2 class="pc-h2">Хотите так же — <span class="pc-mark">с системой заявок?</span></h2>
      <p class="pc-lead pc-lead--c">Напишите нишу и&nbsp;что продаёте — покажу, где вы&nbsp;теряете заявки.</p>
      <a href="https://t.me/tori2k" data-track="click_telegram" class="pc-btn" data-magnetic><span class="pc-btn__plus">(+)</span>Получить разбор</a>
    </div>
  </section>

  <style>
    /* кейс-карточки (как на главной, но не sticky — обычная стопка) */
    .pc-cases2 { max-width: 1040px; margin: 28px auto 0; padding: 0 26px; display: flex; flex-direction: column; gap: 30px; }
    .pc-case2 { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; gap: 0; overflow: hidden; align-items: start; transition: transform .32s cubic-bezier(.34,1.56,.64,1); }
    .pc-case2:nth-child(2n) { transform: rotate(.4deg); }
    .pc-case2:hover { transform: translateY(-5px) rotate(-.3deg); }
    .pc-case2__media { position: relative; display: block; }
    .pc-case2__frame { display: block; width: 100%; height: auto; position: relative; z-index: 2; pointer-events: none; }
    .pc-case2__screen { position: absolute; inset: 17.5% 8.5% 8.5% 9.5%; z-index: 0; overflow: hidden; border-radius: 3px; background: #d8caa6; }
    .pc-case2__vid { width: 100%; height: 100%; object-fit: contain; object-position: center; filter: grayscale(.82) brightness(.74); transition: filter .5s ease; }
    .pc-case2:hover .pc-case2__vid { filter: none; }
    .pc-case2__tint { position: absolute; inset: 0; z-index: 1; background: #7b4cff; mix-blend-mode: color; opacity: .5; transition: opacity .5s ease; pointer-events: none; }
    .pc-case2:hover .pc-case2__tint { opacity: 0; }
    .pc-case2__status { position: absolute; z-index: 3; top: 14px; left: 14px; font-family: 'Special Elite', monospace; font-size: 10px; text-transform: uppercase; color: var(--ink); background: rgba(244,234,210,.92); padding: 5px 11px; border-radius: 999px; }
    .pc-case2__play { position: absolute; z-index: 3; bottom: 14px; right: 14px; font-family: 'Special Elite', monospace; font-size: 11px; color: #fff; background: rgba(44,36,24,.7); padding: 6px 12px; border-radius: 999px; opacity: 0; transition: opacity .4s; }
    .pc-case2:hover .pc-case2__play { opacity: 1; }
    .pc-case2__body { padding: 24px 26px; display: flex; flex-direction: column; }
    .pc-case2__niche { font-family: 'Special Elite', monospace; font-size: 12px; color: var(--mark); }
    .pc-case2__title { font-family: 'Unbounded', sans-serif; font-weight: 600; font-size: 24px; margin: 4px 0 8px; transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
    .pc-case2__title:hover { transform: rotate(-1deg) translateX(2px); }
    .pc-case2__task { margin: 0; font-size: 14px; color: var(--ink-soft); line-height: 1.55; }
    .pc-case2__points { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 7px; }
    .pc-case2__points li { display: flex; gap: 9px; font-size: 13.5px; }
    .pc-case2__points span { color: var(--mark); font-weight: 700; display: inline-block; transition: transform .2s ease; }
    .pc-case2__points li:hover span { transform: scale(1.45) rotate(-9deg); }
    .pc-case2__auto { margin-top: 14px; padding-top: 12px; border-top: 1px dashed rgba(44,36,24,.25); font-size: 13px; color: var(--ink-soft); }
    @media (max-width: 820px) { .pc-case2 { grid-template-columns: 1fr; } }
  </style>

  <script>
    // видео-кейсы играют при наведении (остальное — курсор/reveal/magnetic — в PapercraftLayout)
    document.querySelectorAll('.pc-case2').forEach((c) => {
      const v = c.querySelector('video');
      if (v) { c.addEventListener('mouseenter', () => v.play().catch(() => {})); c.addEventListener('mouseleave', () => v.pause()); }
    });
  </script>
</PapercraftLayout>

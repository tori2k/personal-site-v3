---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const cases = [
  {
    slug: 'manifik',
    img: 'manifik.jpg',
    title: 'Manifik',
    niche: 'Школа вокала',
    url: 'https://manifik-school.ru',
    status: 'В продакшене',
    task: 'Школе нужен был сайт, через который родители находят педагогов и сразу записываются и оплачивают занятие — без звонков и переписок.',
    built: 'Многостраничный сайт: каталог педагогов и направлений, онлайн-оплата, форма записи, интеграции.',
    points: [
      'Запись на пробный урок приходит в Telegram — администратор видит заявку сразу',
      'Оплата занятий и абонементов прямо на сайте — деньги не ждут звонка',
      'Цены и расписание редактируются без разработчика',
      'Путь от «нашёл» до «записался» — три клика',
    ],
    automated: 'Заявка → Telegram-уведомление → запись в таблицу со статусом',
  },
  {
    slug: 'znamya-truda',
    img: 'znamya-truda.jpg',
    title: 'ФК «Знамя Труда»',
    niche: 'Футбольный клуб · Орехово-Зуево',
    url: 'https://fczt1909.ru',
    status: 'Запущен',
    task: 'Старейший действующий клуб России жил в соцсетях. Нужен был официальный сайт, где болельщик за 10 секунд найдёт матч, состав и новости.',
    built: 'Многостраничник: расписание, новости, история клуба, команда, партнёры.',
    points: [
      'Пользователь быстрее понимает, куда нажать — навигация выстроена под сценарий болельщика',
      'Контент редактируется без программиста — редактор клуба сам публикует новости',
      'Страница партнёров превращает присутствие в структурированное предложение',
      'Сайт стал официальным источником информации вместо разрозненных пабликов',
    ],
    automated: 'Публикация новостей через CMS без участия разработчика',
  },
  {
    slug: 'chtivo',
    img: 'chtivo-dom.jpg',
    title: 'ЧТИВО ДОМ',
    niche: 'Концепт · спекулятивная работа',
    url: 'https://tori2k.github.io/chtivo-dom-concept/',
    status: 'Концепт',
    task: 'Место зацепило — вдохновился и собрал сайт-визитку в их фирменной стилистике. Упражнение в рамках места, которое понравилось.',
    built: 'Концепт-лендинг: атмосфера, навигация по залам, кинотека, форма брони.',
    points: [
      'Тёмная эстетика под стиль пространства',
      'Быстрая навигация — посетитель сразу видит что здесь есть',
      'Форма записи интегрирована в страницу без перехода',
      'Адаптив под телефон для посетителей на месте',
    ],
    automated: 'Форма брони → уведомление организаторам',
  },
];
---
<Layout
  title="Кейсы · Кирилл Барыев"
  description="Проекты: школа вокала Manifik, ФК Знамя Труда, ЧТИВО ДОМ. Сайты с системой заявок, Telegram-интеграцией и аналитикой."
>
  <Nav />
  <main>
    <section class="cases-hero section-dark">
      <div class="container-x">
        <div class="cases-hero__inner reveal">
          <div class="sec-tag">Кейсы</div>
          <h1 class="display-h cases-hero__h1">
            Проекты <em>в деле.</em>
          </h1>
          <p class="cases-hero__sub">
            Не просто «сделал сайт» — а как заявка теперь проходит путь от контента до CRM.
          </p>
        </div>
      </div>
    </section>

    <section class="cases-list section-dark">
      <div class="container-x">
        {cases.map((c, i) => (
          <article class:list={['ccase', 'reveal']} style={`transition-delay: ${i * 0.08}s`}>
            <a href={c.url} target="_blank" rel="noopener" class="ccase__media">
              <img src={`${base}screenshots/${c.img}`} alt={c.title} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span class="ccase__status">{c.status}</span>
            </a>

            <div class="ccase__body">
              <div class="ccase__niche">{c.niche}</div>
              <h2 class="ccase__title">{c.title}</h2>

              <div class="ccase__section-label">Задача</div>
              <p class="ccase__text">{c.task}</p>

              <div class="ccase__section-label">Что собрано</div>
              <p class="ccase__text">{c.built}</p>

              <ul class="ccase__points">
                {c.points.map((p) => (
                  <li>
                    <span class="ccase__check">(+)</span>
                    {p}
                  </li>
                ))}
              </ul>

              <div class="ccase__automated">
                <span class="ccase__auto-label">Автоматизировано</span>
                {c.automated}
              </div>

              <a href={c.url} target="_blank" rel="noopener" class="btn btn--filled ccase__cta">
                <span class="btn__plus">(+)</span>
                Открыть сайт
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="cases-cta section-dark">
      <div class="container-x">
        <div class="cases-cta__inner glass reveal">
          <p class="cases-cta__text">Хотите так же?</p>
          <a href="/razbor" class="btn btn--filled" data-magnetic="0.3">
            <span class="btn__plus">(+)</span>
            Получить бесплатный разбор
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cases-hero { padding: 140px 0 60px; }
  .cases-hero__h1 { margin: 0 0 20px; }
  .cases-hero__h1 em { color: var(--aurora-cyan); }
  .cases-hero__sub {
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--color-muted);
    max-width: 520px;
    line-height: 1.6;
    margin: 0;
  }

  .cases-list { padding: 40px 0 100px; }
  .cases-list .container-x { display: flex; flex-direction: column; gap: 28px; }

  .ccase {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    background: var(--glass-tint);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.35s, transform 0.35s cubic-bezier(.22,1,.36,1);
  }
  .ccase:hover { border-color: rgba(95,198,255,0.35); transform: translateY(-3px); }

  .ccase__media {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 360px;
  }
  .ccase__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s cubic-bezier(.22,1,.36,1);
  }
  .ccase:hover .ccase__media img { transform: scale(1.03); }

  .ccase__status {
    position: absolute; top: 18px; left: 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--color-text);
    padding: 6px 12px;
    background: rgba(6,7,13,0.7);
    border: 1px solid rgba(244,246,251,0.18);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .ccase__body { padding: 40px 36px; display: flex; flex-direction: column; }
  .ccase__niche {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 12px;
  }
  .ccase__title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.1;
    margin: 0 0 20px; color: var(--color-text);
  }
  .ccase__section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 6px;
  }
  .ccase__text { font-size: 14px; line-height: 1.6; color: var(--color-muted); margin: 0 0 16px; }
  .ccase__points {
    list-style: none; padding: 0; margin: 0 0 16px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .ccase__points li { display: flex; gap: 8px; font-size: 13px; color: var(--color-text); line-height: 1.5; }
  .ccase__check { color: var(--color-accent); font-family: 'JetBrains Mono', monospace; font-size: 11px; flex-shrink: 0; }

  .ccase__automated {
    font-size: 12px; line-height: 1.55; color: var(--color-muted);
    padding: 10px 14px; margin: 0 0 24px;
    background: rgba(95,198,255,0.06);
    border-left: 2px solid rgba(95,198,255,0.4);
    border-radius: 0 8px 8px 0;
  }
  .ccase__auto-label {
    display: block; font-family: 'JetBrains Mono', monospace;
    font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 3px;
  }
  .ccase__cta { align-self: flex-start; margin-top: auto; }

  .cases-cta { padding: 0 0 100px; }
  .cases-cta__inner {
    padding: 48px 44px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cases-cta__text {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(22px, 2.5vw, 34px);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-text);
  }

  @media (max-width: 1000px) { .ccase { grid-template-columns: 1fr; } .ccase__media { min-height: 260px; } }
  @media (max-width: 700px) {
    .cases-hero { padding: 100px 0 40px; }
    .cases-list { padding: 20px 0 60px; }
    .ccase__body { padding: 28px 22px; }
    .cases-cta__inner { flex-direction: column; align-items: flex-start; padding: 32px 28px; }
  }
</style>

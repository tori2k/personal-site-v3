---
import Layout from '../layouts/Layout.astro';
import SeoLanding from '../components/SeoLanding.astro';

const title = 'Лендинг для эксперта под заявки: оффер, квиз, Telegram и аналитика';
const description = 'Разработка лендинга для эксперта и консультанта: продающий оффер, доверие, квиз для квалификации, заявки в Telegram и таблица лидов. Запуск от 3–5 дней, от 49 000 ₽.';

const forWhom = [
  'Психологи и коучи',
  'Финансовые и бизнес-консультанты',
  'Нутрициологи и врачи частной практики',
  'Маркетологи и наставники',
  'Онлайн-школы и авторы курсов',
  'Эксперты, продающие через контент',
];

const pains = [
  {
    title: 'Аудитория есть, заявок нет',
    body: 'Контент собирает охваты, но люди не доходят до заявки: лить трафик некуда, кроме директа. Лендинг превращает внимание в обращение — с понятным оффером и одной кнопкой.',
  },
  {
    title: 'Непонятно, в чём ценность',
    body: 'Эксперт знает свою пользу, но на странице она звучит абстрактно. Я переупаковываю оффер в конкретику: что человек получит, за какой срок и почему именно вы.',
  },
  {
    title: 'Обращения приходят хаотично',
    body: 'Директ, комментарии, личные сообщения — заявки разбросаны и теряются. Квиз и форма собирают их в Telegram и таблицу, где видно имя, нишу, ссылку и статус.',
  },
];

const includes = [
  'Продающий оффер: для кого, что получите, за какой срок',
  'Блок доверия: кейсы, отзывы, результаты учеников/клиентов',
  'Квиз для квалификации (запрос, бюджет, готовность)',
  'Форма заявки → Telegram отформатированным сообщением',
  'Таблица лидов со статусом и источником (UTM)',
  'Метрика и Google Analytics — видно поведение и конверсию',
  'Адаптив, свой домен, скорость Lighthouse 95+',
  'Чистый код без подписок, исходники остаются у вас',
];

const formats = [
  {
    name: 'Экспресс-лендинг',
    price: 'от 49 000 ₽',
    desc: 'Один оффер, доверие, форма заявки в Telegram. Чтобы быстро выйти в рекламу и собирать обращения. Запуск 3–5 дней.',
  },
  {
    name: 'Лендинг эксперта',
    price: '75 000–95 000 ₽',
    desc: 'Кейсы, цены, FAQ, квиз для квалификации, аналитика. Основной выбор для эксперта, которого выбирают внимательно.',
  },
  {
    name: 'Система заявок',
    price: '120 000–300 000 ₽',
    desc: 'Лендинг + Telegram-бот + CRM/таблица + автоматизации и онлайн-оплаты. Заявка сразу попадает в вашу операционку.',
  },
];

const intro = [
  'У эксперта обычно есть аудитория и есть польза — но между ними нет моста. Контент собирает охваты, люди интересуются, а заявки приходят хаотично в директ и теряются. <strong>Лендинг для эксперта под заявки</strong> закрывает этот разрыв: даёт трафику конкретное место, куда прийти, объясняет ценность и собирает обращение в одну систему.',
  'Работа начинается с оффера. Эксперт знает свою пользу, но на странице она часто звучит абстрактно — «помогаю улучшить качество жизни». Я переупаковываю это в конкретику: кто ваш клиент, какую проблему вы решаете, что он получит и за какой срок. Первый экран должен объяснять услугу за пять секунд, иначе человек закрывает вкладку.',
  'Дальше — доверие. Для эксперта это кейсы и результаты: до/после, отзывы, цифры учеников или клиентов, ваш путь и регалии. Этот блок снимает главный барьер — «а сработает ли это у меня». После доверия идёт <strong>квиз</strong>: он задаёт несколько вопросов о запросе, бюджете и готовности, отсеивает любопытствующих и приводит к вам тех, кто действительно готов к работе.',
  'Заявка приходит в <strong>Telegram</strong> отформатированным сообщением и параллельно фиксируется в таблице: имя, ниша, ссылка на профиль, ответы квиза, статус и UTM-источник. Вы видите, какой пост или какая реклама приносит обращения, и перестаёте сливать бюджет вслепую. Подключив аналитику (Метрика, Google Analytics), вы видите и поведение на странице — где люди отваливаются.',
  'Всё на чистом коде, без конструкторов и ежемесячных подписок. Сайт быстрый, индексируется, остаётся вашим. Если не уверены, нужен ли новый лендинг или достаточно поправить текущий вход, — начните с бесплатного разбора: я посмотрю профиль или сайт и покажу 3 места, где теряются заявки.',
];

const faq = [
  {
    q: 'Сколько стоит лендинг для эксперта?',
    a: 'Экспресс-лендинг под один оффер — от 49 000 ₽, запуск за 3–5 дней. Лендинг с кейсами, квизом и аналитикой — 75 000–95 000 ₽. Полная система заявок с Telegram-ботом и CRM — от 120 000 ₽. Точную цену называю после бесплатного разбора.',
  },
  {
    q: 'У меня есть аудитория, но мало заявок. Поможет лендинг?',
    a: 'Чаще всего да. Если контент собирает охваты, но людям некуда прийти, кроме директа, заявки теряются. Лендинг даёт трафику конкретное место, объясняет ценность и собирает обращение в Telegram и таблицу. На разборе покажу, что именно мешает в вашем случае.',
  },
  {
    q: 'Зачем эксперту квиз?',
    a: 'Квиз квалифицирует: задаёт вопросы о запросе, бюджете и готовности, отсеивает любопытствующих и собирает контекст. К вам приходят те, кто готов работать, а вы экономите время на нецелевых консультациях.',
  },
  {
    q: 'Куда будут приходить заявки?',
    a: 'В Telegram — отформатированным сообщением с именем, нишей, контактом, ответами квиза и источником. Дополнительно заявка фиксируется в таблице со статусом. По желанию подключаю CRM и автоматизации.',
  },
  {
    q: 'За сколько можно запустить?',
    a: 'Экспресс-лендинг — 3–5 дней. Лендинг эксперта с квизом и кейсами — 1–2 недели. Полная система — 3–5 недель. Срок считается от момента, когда собраны материалы: оффер, кейсы, фото.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Разработка лендинга для эксперта под заявки',
    name: 'Лендинг для эксперта',
    description,
    provider: { '@type': 'Person', name: 'Кирилл Барыев', url: 'https://kirillbaryev.ru' },
    areaServed: 'RU',
    offers: { '@type': 'Offer', price: '49000', priceCurrency: 'RUB' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://kirillbaryev.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Лендинг для эксперта', item: 'https://kirillbaryev.ru/lending-dlya-eksperta/' },
    ],
  },
];
---
<Layout title={title} description={description} jsonLd={jsonLd}>
  <SeoLanding
    eyebrow="Лендинг для эксперта"
    h1="Лендинг для эксперта под заявки"
    lead="Продающий оффер, доверие через кейсы, квиз для квалификации и заявки в Telegram. Превращаю аудиторию и контент в поток целевых обращений."
    intro={intro}
    forWhom={forWhom}
    pains={pains}
    includes={includes}
    formats={formats}
    faq={faq}
  />
</Layout>

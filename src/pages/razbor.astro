---
import PapercraftLayout from '../layouts/PapercraftLayout.astro';

const HOME = '/';
const checks = ['Первый экран', 'Оффер', 'CTA', 'Доверие', 'Путь до заявки', 'Telegram / CRM'];
const gains = ['Где теряются заявки', 'Что докрутить в первую очередь', 'Конкретный план из 3 шагов'];
---
<PapercraftLayout title="Бесплатный разбор · Papercraft — kirillbaryev.ru" description="Бесплатный разбор сайта: найду 3 точки слива заявок и пришлю план из 3 шагов." active="razbor">
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-sticker pc-sticker--new" style="--rot:-11deg; top:0; right:8px">FREE</span>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Бесплатный разбор</span>
    <h1 class="pc-h1b">Найду 3 точки <span class="pc-mark">слива заявок</span></h1>
    <p class="pc-lead">Посмотрю сайт и&nbsp;путь заявки, пришлю короткий разбор в&nbsp;Telegram. Бесплатно.</p>
  </section>

  <section class="pc-sec">
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Что разбираю</span>
    <ul class="pc-chips2 pc-reveal">
      {checks.map((c) => (<li class="pc-chip2"><span>✓</span>{c}</li>))}
    </ul>
  </section>

  <section class="pc-sec pc-razbor">
    <form class="pc-form pc-paper pc-reveal" id="razbor-form">
      <h2 class="pc-h3">Заявка на разбор</h2>
      <label class="pc-field"><span>Имя</span><input type="text" name="name" placeholder="Алексей" /></label>
      <label class="pc-field"><span>Telegram / контакт</span><input type="text" name="contact" placeholder="@username" /></label>
      <label class="pc-field"><span>Сайт или профиль</span><input type="text" name="site" placeholder="kirillbaryev.ru" /></label>
      <label class="pc-field"><span>Ниша и что продаёте</span><input type="text" name="niche" placeholder="Юрист · 20 000 ₽ / консультация" /></label>
      <button type="submit" class="pc-btn"><span class="pc-btn__plus">(+)</span>Отправить заявку</button>
      <p class="pc-form__note">Заявка придёт мне в&nbsp;Telegram. Отвечу в&nbsp;тот&nbsp;же день.</p>
    </form>

    <div class="pc-ok pc-paper" id="razbor-ok" hidden>
      <div class="pc-ok__check">✓</div>
      <h2 class="pc-h3">Заявка отправлена!</h2>
      <p>Посмотрю сайт и&nbsp;путь заявки, пришлю разбор в&nbsp;Telegram — обычно в&nbsp;тот&nbsp;же день.</p>
      <a href="https://t.me/tori2k" class="pc-btn pc-btn--sm" target="_blank" rel="noopener">Написать сразу</a>
    </div>

    <aside class="pc-gains pc-reveal">
      <span class="pc-eyebrow"><i class="pc-bdot"></i>Что получите</span>
      <ul class="pc-gains__list">
        {gains.map((g) => (<li><span>→</span>{g}</li>))}
      </ul>
      <div class="pc-gains__hand">обычно отвечаю в&nbsp;тот&nbsp;же день</div>
    </aside>
  </section>

  <style>
    .pc-chips2 { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
    .pc-chip2 { display: inline-flex; align-items: center; gap: 8px; font-family: 'Special Elite', monospace; font-size: 14px; background: var(--paper); padding: 10px 16px; filter: url(#torn) drop-shadow(0 6px 10px rgba(40,28,12,.22)); transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
    .pc-chip2 span { color: var(--mark); font-weight: 700; }
    .pc-chip2:nth-child(2n) { transform: rotate(-1.3deg); }
    .pc-chip2:hover { transform: translateY(-3px) rotate(1.4deg); }

    .pc-razbor { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: start; }
    .pc-form { padding: 32px 32px 28px; display: flex; flex-direction: column; gap: 14px; }
    .pc-form h2 { margin: 0 0 4px; }
    .pc-field { display: flex; flex-direction: column; gap: 5px; }
    .pc-field span { font-family: 'Special Elite', monospace; font-size: 12px; color: var(--ink-soft); }
    .pc-field input { font-family: 'Special Elite', monospace; font-size: 15px; color: var(--ink); background: var(--paper2); border: 2px dashed rgba(44,36,24,.35); border-radius: 3px; padding: 11px 14px; outline: none; transition: border-color .2s; }
    .pc-field input:focus { border-color: var(--mark); border-style: solid; }
    .pc-field input::placeholder { color: rgba(44,36,24,.4); }
    .pc-form .pc-btn { margin-top: 6px; align-self: flex-start; }
    .pc-form__note { margin: 2px 0 0; font-size: 12px; color: var(--ink-soft); }

    .pc-gains { padding-top: 6px; }
    .pc-gains__list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 12px; }
    .pc-gains__list li { display: flex; gap: 10px; font-size: 15px; line-height: 1.5; }
    .pc-gains__list span { color: var(--mark2); font-weight: 700; }
    .pc-gains__hand { margin-top: 20px; font-family: 'Caveat', cursive; font-size: 22px; color: var(--mark); transform: rotate(-2deg); }

    .pc-ok { padding: 36px 32px; text-align: center; align-self: start; }
    .pc-ok__check { width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%; background: var(--mark); color: #fff; font-size: 30px; line-height: 56px; text-shadow: none; }
    .pc-ok p { margin: 8px 0 18px; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }

    @media (max-width: 820px) { .pc-razbor { grid-template-columns: 1fr; gap: 28px; } }
  </style>

  <script>
    const WEBHOOK = 'https://script.google.com/macros/s/AKfycbyeXV7TI8klBfvtnrAMYKOLNi3jifjO9IhRnkLDBKd7UJ0_XJCG3BpVlXlxiuvv60QM/exec';
    const form = document.getElementById('razbor-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = { source: 'papercraft-razbor', submittedAt: new Date().toISOString(), referrer: document.referrer || '', userAgent: navigator.userAgent };
      for (const [k, v] of fd.entries()) data[k] = v;
      const btn = form.querySelector('button[type=submit]');
      if (btn) { btn.disabled = true; btn.textContent = 'Отправляю…'; }
      try {
        await fetch(WEBHOOK, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(data) });
      } catch (_) {}
      const ok = document.getElementById('razbor-ok');
      if (ok) { form.style.display = 'none'; ok.hidden = false; ok.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
  </script>
</PapercraftLayout>

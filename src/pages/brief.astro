---
import PapercraftLayout from '../layouts/PapercraftLayout.astro';

const HOME = '/';
const questions = [
  { q: 'Что нужно?', opts: ['Лендинг', 'Многостраничник', 'Система заявок', 'Пока не знаю'] },
  { q: 'Ниша?', opts: ['Юрист', 'Эксперт', 'Школа / курсы', 'Услуги', 'Другое'] },
  { q: 'Что важнее всего?', opts: ['Заявки в Telegram', 'Онлайн-оплата', 'Квиз-квалификация', 'CRM / таблица'] },
  { q: 'Когда запуск?', opts: ['Срочно', '2–4 недели', 'Гибко'] },
];
---
<PapercraftLayout title="Бриф · Кирилл Барыев" description="Соберите бриф за минуту — отметьте варианты и отправьте в Telegram." active="razbor">
  <section class="pc-head">
    <a href={HOME} class="pc-back">← на главную</a>
    <span class="pc-eyebrow"><i class="pc-bdot"></i>Бриф</span>
    <h1 class="pc-h1b">Соберём бриф <span class="pc-mark">за минуту</span></h1>
    <p class="pc-lead">Отметьте варианты — соберу из&nbsp;них сообщение и&nbsp;открою Telegram.</p>
  </section>

  <section class="pc-sec pc-brief">
    {questions.map((q, qi) => (
      <div class="pc-brief__q pc-paper pc-reveal">
        <span class="pc-brief__n">{`0${qi + 1}`}</span>
        <h3 class="pc-h3">{q.q}</h3>
        <div class="pc-brief__opts" data-q={q.q}>
          {q.opts.map((o) => (<button type="button" class="pc-brief__opt" data-v={o}>{o}</button>))}
        </div>
      </div>
    ))}
    <div class="pc-brief__send pc-reveal">
      <input type="text" id="brief-contact" class="pc-brief__contact" placeholder="Ваш Telegram / контакт для ответа" />
      <button class="pc-btn" id="brief-send"><span class="pc-btn__plus">(+)</span>Отправить бриф</button>
      <span class="pc-brief__hand">займёт минуту ✦</span>
    </div>
    <div class="pc-ok pc-paper" id="brief-ok" hidden>
      <div class="pc-ok__check">✓</div>
      <h2 class="pc-h3">Бриф отправлен!</h2>
      <p>Изучу и&nbsp;напишу вам в&nbsp;Telegram с&nbsp;предложением — обычно в&nbsp;тот&nbsp;же день.</p>
      <a href="https://t.me/tori2k" data-track="click_telegram" class="pc-btn pc-btn--sm" target="_blank" rel="noopener">Написать сразу</a>
    </div>
  </section>

  <style>
    .pc-brief { max-width: 820px; display: flex; flex-direction: column; gap: 18px; }
    .pc-brief__q { position: relative; padding: 24px 26px; }
    .pc-brief__q:nth-child(2n) { transform: rotate(.4deg); }
    .pc-brief__n { position: absolute; top: 18px; right: 22px; font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 22px; color: var(--mark2); opacity: .85; }
    .pc-brief__opts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
    .pc-brief__opt { font-family: 'Special Elite', monospace; font-size: 14px; color: var(--ink); background: var(--paper2); border: 2px dashed rgba(44,36,24,.32); border-radius: 4px; padding: 9px 16px; cursor: pointer; text-shadow: none; transition: transform .2s cubic-bezier(.34,1.56,.64,1), background .2s, color .2s, border-color .2s; }
    .pc-brief__opt:hover { transform: translateY(-2px) rotate(-1.5deg); }
    .pc-brief__opt.is-on { background: var(--mark); color: #fff; border-style: solid; border-color: var(--mark); }
    .pc-brief__send { display: flex; align-items: center; gap: 16px; margin-top: 8px; flex-wrap: wrap; }
    .pc-brief__hand { font-family: 'Caveat', cursive; font-size: 21px; color: var(--mark); transform: rotate(-2deg); }
    .pc-brief__contact { font-family: 'Special Elite', monospace; font-size: 15px; color: var(--ink); background: var(--paper); border: 2px dashed rgba(44,36,24,.35); border-radius: 3px; padding: 11px 14px; outline: none; min-width: 260px; flex: 1; }
    .pc-brief__contact:focus { border-color: var(--mark); border-style: solid; }
    .pc-brief__contact.is-error { border-color: var(--mark2); border-style: solid; }
    .pc-brief__contact::placeholder { color: rgba(44,36,24,.4); }
    .pc-ok { max-width: 560px; margin-top: 10px; padding: 32px 30px; text-align: center; }
    .pc-ok__check { width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%; background: var(--mark); color: #fff; font-size: 30px; line-height: 56px; text-shadow: none; }
    .pc-ok p { margin: 8px 0 18px; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
  </style>

  <script>
    document.querySelectorAll('.pc-brief__opts').forEach((group) => {
      group.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.pc-brief__opt');
        if (!btn) return;
        group.querySelectorAll('.pc-brief__opt').forEach((b) => b.classList.remove('is-on'));
        btn.classList.add('is-on');
      });
    });
    import { LEAD_WEBHOOK } from '../data/webhook';
    document.getElementById('brief-contact')?.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('is-error'));
    document.getElementById('brief-send')?.addEventListener('click', async () => {
      // #10 валидация: без контакта отвечать некуда
      const contactEl = document.getElementById('brief-contact') as HTMLInputElement | null;
      const contact = contactEl?.value.trim() || '';
      if (!contact) { contactEl?.classList.add('is-error'); contactEl?.focus(); return; }
      const data: Record<string, string> = { source: 'papercraft-brief', submittedAt: new Date().toISOString(), referrer: document.referrer || '', userAgent: navigator.userAgent };
      data.contact = contact;
      document.querySelectorAll('.pc-brief__opts').forEach((group) => {
        const q = (group as HTMLElement).dataset.q || '';
        const sel = group.querySelector('.pc-brief__opt.is-on');
        if (sel) data[q] = (sel as HTMLElement).dataset.v || '';
      });
      const btn = document.getElementById('brief-send') as HTMLButtonElement | null;
      const origHtml = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Отправляю…'; }
      let sent = true;
      try {
        await fetch(LEAD_WEBHOOK, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(data) });
      } catch (_) { sent = false; }
      if (!sent) {
        if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
        if (contactEl) { contactEl.classList.add('is-error'); contactEl.placeholder = 'Не отправилось — напишите в Telegram @tori2k'; }
        return;
      }
      (window as any).track?.('submit_brief');
      const ok = document.getElementById('brief-ok');
      const send = document.querySelector('.pc-brief__send') as HTMLElement | null;
      if (ok) { if (send) send.style.display = 'none'; ok.hidden = false; ok.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
  </script>
</PapercraftLayout>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BriefIntro from '../components/BriefIntro.astro';
import BriefQuiz from '../components/BriefQuiz.astro';

const title = 'Бриф · Кирилл Барыев — разработка сайтов';
const description = 'Бриф для запуска проекта: 12 коротких вопросов, ответ со сметой в течение 24 часов.';
---
<Layout title={title} description={description}>
  <Nav />
  <main>
    <BriefIntro />
    <BriefQuiz />
  </main>
  <Footer />
</Layout>

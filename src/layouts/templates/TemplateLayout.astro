---
interface Props {
  title: string;
  description?: string;
  fontsHref?: string;
  bodyClass?: string;
}
const {
  title,
  description = 'Шаблон сайта · kirillbaryev.ru',
  fontsHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap',
  bodyClass = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      button { font: inherit; cursor: pointer; }
      :focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    </style>
  </head>
  <body class={bodyClass}>
    <!-- Возврат к галерее шаблонов -->
    <a href={`${base}templates/`} class="tpl-back" aria-label="Назад к шаблонам">
      <span aria-hidden="true">←</span> К&nbsp;шаблонам
    </a>

    <slot />

    <style is:global>
      .tpl-back {
        position: fixed;
        top: 18px; left: 18px;
        z-index: 1000;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: rgba(0, 0, 0, 0.78);
        color: #fff;
        font: 500 12px/1 'Inter', system-ui, sans-serif;
        letter-spacing: 0.4px;
        border-radius: 999px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: background 0.2s, transform 0.2s;
      }
      .tpl-back:hover { background: rgba(0, 0, 0, 0.92); transform: translateY(-1px); }
    </style>
  </body>
</html>

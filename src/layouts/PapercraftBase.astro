---
import YandexMetrika from '../components/YandexMetrika.astro';
import '../styles/studio.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title = 'Кирилл Барыев: сайты, системы и AI',
  description = 'Проектирую и запускаю сайты, Telegram- и AI-системы для бизнеса. ',
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  bodyClass = 'studio-body',
} = Astro.props;

const SITE = 'https://kirillbaryev.ru';
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = ogImage ?? `${SITE}/og-image.jpg`;

const baseJsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Кирилл Барыев', url: SITE, inLanguage: 'ru' },
  {
    '@context': 'https://schema.org', '@type': 'Person', name: 'Кирилл Барыев', url: SITE,
    image: `${SITE}/kirill.jpg`, sameAs: ['https://t.me/tori2k', 'https://github.com/tori2k'],
    jobTitle: 'Инженер цифровых продуктов',
    knowsAbout: ['разработка сайтов', 'маршруты заявок', 'Telegram-боты', 'CRM-интеграции', 'AI-ассистенты', 'автоматизация процессов'],
  },
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService',
    name: 'Кирилл Барыев', url: SITE, image: ogImageUrl,
    description: 'Сайты, Telegram- и AI-системы для бизнеса.',
    areaServed: 'RU',
    founder: { '@type': 'Person', name: 'Кирилл Барыев' },
    sameAs: ['https://t.me/tori2k', 'https://github.com/tori2k'],
  },
];
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [...baseJsonLd, ...pageJsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f2f7" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Кирилл Барыев" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {allJsonLd.map((node) => <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />)}
    <link rel="preload" href="/fonts/onest-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={bodyClass}>
    <!-- THESIS: Personal digital products shown through real projects on one lavender stage.
    OWN-WORLD: Ice-gray ground, indigo crest, bold Onest, overlapping tinted screenshots, black rounded actions.
    STORY: See real work, understand personal contribution, discuss a project directly in Telegram.
    FIRST VIEWPORT: At 1536px, a 128px two-line heading fills the left; description and CTA sit right. A lavender field begins at 366px with GoalSphere right and Znamya Truda overlapping left. Previews regain color on interaction.
    FORM: User-pinned Only foundation plus Realweb expression; chosen composition 2; seed b9b9ab2e, assigned 4 overridden by explicit brief.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#content">К содержанию</a>
    <slot />
    <YandexMetrika />
  </body>
</html>

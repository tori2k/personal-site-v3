---
import '../styles/global.css';
import YandexMetrika from '../components/YandexMetrika.astro';

interface Props {
  title?: string;
  description?: string;
  /** Абсолютный og:image (по умолчанию /og-image.jpg на домене) */
  ogImage?: string;
  /** Закрыть страницу от индексации (noindex, follow) */
  noindex?: boolean;
  /** Дополнительный per-page JSON-LD (объект или массив объектов schema.org) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'AI-автоматизация заявок для малого бизнеса: сайт, квиз, Telegram, CRM',
  description = 'Автоматизирую обработку заявок: сайт/квиз → Telegram/WhatsApp → таблица/CRM → дожим. Больше лидов доходит до обработки без расширения штата. Первый разбор бесплатно.',
  ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const SITE = 'https://kirillbaryev.ru';
// Канонический абсолютный URL текущей страницы (со слэшем на конце для каталогов)
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = ogImage ?? `${SITE}/og-image.jpg`;

// Базовый JSON-LD на всех страницах: сайт + персона + услуга
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Кирилл Барыев',
    url: SITE,
    inLanguage: 'ru',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Кирилл Барыев',
    url: SITE,
    image: `${SITE}/kirill.jpg`,
    sameAs: ['https://t.me/tori2k', 'https://github.com/tori2k'],
    jobTitle: 'Разработчик сайтов и AI-воронок',
    knowsAbout: [
      'разработка сайтов',
      'лендинги под заявки',
      'AI-воронки',
      'Telegram-боты',
      'квизы для лендинга',
      'CRM и автоматизация заявок',
      'лидогенерация',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Кирилл Барыев — разработка сайтов и AI-воронок',
    url: SITE,
    image: `${SITE}/og-image.jpg`,
    description:
      'Лендинги, сайты, квизы, Telegram-заявки, CRM/таблицы и AI-автоматизации для экспертов, юристов, консультантов, онлайн-школ и сервисного бизнеса.',
    priceRange: 'от 49 000 ₽',
    areaServed: 'RU',
    founder: { '@type': 'Person', name: 'Кирилл Барыев' },
    sameAs: ['https://t.me/tori2k', 'https://github.com/tori2k'],
  },
];

const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [...baseJsonLd, ...pageJsonLd];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0712" />

  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Кирилл Барыев" />
  <meta property="og:image" content={ogImageUrl} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Structured data: WebSite + Person + ProfessionalService (+ per-page) -->
  {allJsonLd.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Грузим CSS-шрифтов с высоким приоритетом (preload), затем применяем как stylesheet.
       display=swap уже не даёт «невидимого текста», а прелоадер скрывает swap-прыжок. -->
  <link rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Критичный инлайн-CSS прелоадера: появляется мгновенно, до загрузки global.css.
       Скрывает FOUC (прыжки шрифтов/layout) пока сайт готовится. -->
  <style>
    #preloader {
      position: fixed; inset: 0; z-index: 99999;
      background: #0A0712;
      display: flex; align-items: center; justify-content: center;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }
    #preloader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
    #preloader .pl-mark {
      width: 30px; height: 30px; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #B69CFF, #8B5CFF 55%, #0A0712 100%);
      box-shadow: 0 0 24px 4px rgba(139,92,255,0.45);
      animation: pl-pulse 1.1s ease-in-out infinite;
    }
    @keyframes pl-pulse {
      0%, 100% { transform: scale(0.85); opacity: 0.7; }
      50% { transform: scale(1.1); opacity: 1; }
    }
    /* контент проявляется плавно после снятия прелоадера */
    body.is-loading { overflow: hidden; }
    @media (prefers-reduced-motion: reduce) {
      #preloader { transition: none; }
      #preloader .pl-mark { animation: none; }
    }
  </style>
</head>
<body class="is-loading">
  <!-- Прелоадер: держит тёмный экран, пока грузятся шрифты + DOM. Снимается из скрипта. -->
  <div id="preloader" aria-hidden="true"><div class="pl-mark"></div></div>
  <!-- Глобальный космос со звёздами — фон на весь сайт -->
  <div class="cosmos" aria-hidden="true">
    <div class="cosmos__stars cosmos__stars--far"></div>
    <div class="cosmos__stars cosmos__stars--near"></div>
    <div class="cosmos__aurora cosmos__aurora--1"></div>
    <div class="cosmos__aurora cosmos__aurora--2"></div>
    <div class="cosmos__comet cosmos__comet--1"></div>
    <div class="cosmos__comet cosmos__comet--2"></div>
  </div>
  <div class="noise-overlay"></div>

  <!-- Custom cursor -->
  <div class="cursor" id="cursor" aria-hidden="true">
    <div class="cursor__dot"></div>
    <div class="cursor__ring"></div>
  </div>

  <slot />

  <YandexMetrika />

  <style is:global>
    .cursor {
      position: fixed;
      top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      mix-blend-mode: difference;
      transition: opacity 0.2s;
    }
    @media (hover: none) { .cursor { display: none; } }

    .cursor__dot {
      position: fixed;
      top: 0; left: 0;
      width: 6px; height: 6px;
      background: #fff;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: transform 0.08s linear, width 0.25s, height 0.25s;
    }
    .cursor__ring {
      position: fixed;
      top: 0; left: 0;
      width: 36px; height: 36px;
      border: 1.5px solid #fff;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: transform 0.2s cubic-bezier(.22,1,.36,1), width 0.3s, height 0.3s, border-color 0.3s;
    }
    .cursor.hover .cursor__dot { width: 0; height: 0; }
    .cursor.hover .cursor__ring {
      width: 60px; height: 60px;
      border-color: #fff;
      background: rgba(255,255,255,0.08);
    }
  </style>

  <script>
    import Lenis from 'lenis';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Прелоадер: снимаем, когда шрифты + DOM готовы (или по таймауту-фоллбэку).
    // Это убирает FOUC и «лаги» при загрузке — сайт проявляется плавно и сразу ровным.
    (() => {
      const preloader = document.getElementById('preloader');
      if (!preloader) return;
      let done = false;
      const reveal = () => {
        if (done) return;
        done = true;
        document.body.classList.remove('is-loading');
        preloader.classList.add('is-done');
        // полностью убираем из DOM после fade
        setTimeout(() => preloader.remove(), 700);
      };
      // ждём готовности шрифтов (главная причина прыжков текста) + полной загрузки
      const fontsReady = (document as any).fonts?.ready ?? Promise.resolve();
      Promise.all([
        fontsReady,
        new Promise((res) => {
          if (document.readyState === 'complete') res(null);
          else window.addEventListener('load', () => res(null), { once: true });
        }),
      ]).then(reveal);
      // фоллбэк: не держим экран дольше 2.5с, даже если что-то не догрузилось
      setTimeout(reveal, 2500);
    })();

    // Lenis — инерционный smooth-scroll (база 60fps-плавности).
    // Отключаем для prefers-reduced-motion.
    if (!reduceMotion) {
      const lenis = new Lenis({
        duration: 1.1,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
      lenis.on('scroll', ({ scroll }: { scroll: number }) => {
        document.documentElement.style.setProperty('--scroll-y', String(scroll));
      });
    }

    // Reveal on scroll — при reduced-motion элементы уже видимы через CSS, observer не нужен
    if (!reduceMotion) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => io.observe(el));
    }

    // Custom cursor
    const cursor = document.getElementById('cursor');
    const dot = cursor?.querySelector('.cursor__dot') as HTMLElement | null;
    const ring = cursor?.querySelector('.cursor__ring') as HTMLElement | null;

    if (cursor && dot && ring && window.matchMedia('(hover: hover)').matches) {
      let mx = 0, my = 0, rx = 0, ry = 0;
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        dot.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;
      });

      const raf = () => {
        rx += (mx - rx) * 0.18;
        ry += (my - ry) * 0.18;
        ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;
        requestAnimationFrame(raf);
      };
      raf();

      document.querySelectorAll('a, button, [data-hover]').forEach((el) => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
      });

      document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; });
      document.addEventListener('mouseenter', () => { cursor.style.opacity = '1'; });
    }

    // Magnetic-эффект: элементы [data-magnetic] притягиваются к курсору
    if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        const strength = parseFloat(el.dataset.magnetic || '0.3');
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          const mx = e.clientX - (r.left + r.width / 2);
          const my = e.clientY - (r.top + r.height / 2);
          el.style.transform = `translate(${mx * strength}px, ${my * strength}px)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = 'translate(0, 0)';
        });
      });
    }
  </script>
</body>
</html>

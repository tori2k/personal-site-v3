---
// Блок «Что я автоматизирую» — 6 карточек, видео играет при наведении (как у ТЕПЛЕЕ).
const items = [
  { v: 'auto-tg',      icon: '✈', title: 'Заявка → Telegram',  desc: 'Каждое обращение мгновенно прилетает в чат — ничего не теряется в формах.' },
  { v: 'auto-crm',     icon: '⊞', title: 'CRM / таблица лидов', desc: 'Лиды сами падают в таблицу со статусом, источником и данными.' },
  { v: 'auto-ai',      icon: '⚡', title: 'AI-дожим',           desc: 'Бот сам отвечает и доводит холодную заявку до записи.' },
  { v: 'auto-pay',     icon: '◎', title: 'Онлайн-оплата',      desc: 'Клиент платит прямо на сайте — деньги не ждут звонка.' },
  { v: 'auto-funnel',  icon: '⇥', title: 'Лид-воронка',        desc: 'Каждая заявка двигается по этапам — видно, кто на какой стадии.' },
  { v: 'auto-content', icon: '◳', title: 'Контент-завод',      desc: 'Поток коротких видео для соцсетей — на конвейере, без съёмок.' },
];
---
<section class="autos section-dark" id="automations">
  <div class="container-x">
    <div class="autos__head reveal">
      <div class="sec-tag">Автоматизации</div>
      <h2 class="display-h autos__title">Что я автоматизирую <em>под капотом.</em></h2>
      <p class="autos__lead">Не просто сайт — система, где заявка сама доходит до вас и не теряется. Наведите на карточку.</p>
    </div>

    <div class="autos__grid">
      {items.map((it) => (
        <article class="acard reveal" data-hover-video>
          <div class="acard__demo">
            <video class="acard__video" muted loop playsinline preload="none" poster={`/${it.v}-poster.jpg`}>
              <source src={`/${it.v}.mp4`} type="video/mp4" />
            </video>
          </div>
          <div class="acard__meta">
            <div class="acard__icon">{it.icon}</div>
            <h3 class="acard__title">{it.title}</h3>
            <p class="acard__desc">{it.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .autos { padding: 120px 0; }
  .autos__head { max-width: 780px; margin-bottom: 56px; }
  .autos__title { margin: 0 0 18px; }
  .autos__title em { font-style: italic; font-weight: 300; color: var(--color-accent); }
  .autos__lead { font-size: 16px; line-height: 1.6; color: var(--color-muted); max-width: 520px; margin: 0; }

  .autos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .acard {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(0,0,0,0.3), var(--glass-edge);
    transition: border-color 0.35s, box-shadow 0.35s, transform 0.35s cubic-bezier(.22,1,.36,1);
  }
  .acard:hover {
    border-color: rgba(139,92,255,0.4);
    box-shadow: 0 22px 56px rgba(0,0,0,0.4), 0 0 50px rgba(139,92,255,0.14), var(--glass-edge);
    transform: translateY(-4px);
  }

  .acard__demo {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: #0A0712;
  }
  .acard__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* статичный кадр приглушён, при наведении — оживает */
    filter: grayscale(0.5) brightness(0.66) contrast(1.05);
    transition: filter 0.45s ease, transform 0.6s cubic-bezier(.22,1,.36,1);
  }
  .acard:hover .acard__video { filter: none; transform: scale(1.03); }

  .acard__meta { padding: 22px 24px 26px; }
  .acard__icon { font-size: 18px; color: var(--color-accent); margin-bottom: 10px; line-height: 1; }
  .acard__title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 500; letter-spacing: -0.01em; color: var(--color-text);
    margin: 0 0 8px;
  }
  .acard__desc { font-size: 13px; line-height: 1.55; color: var(--color-muted); margin: 0; }

  @media (max-width: 1100px) {
    .autos__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .autos { padding: 72px 0; }
    .autos__grid { grid-template-columns: 1fr; }
    /* на тач — видео сразу видно (без hover), но без звука и по требованию */
    .acard__video { filter: none; }
  }
</style>

<script>
  // Видео играет только при наведении на свою карточку (не все сразу).
  const cards = document.querySelectorAll<HTMLElement>('.acard[data-hover-video]');
  const isTouch = window.matchMedia('(hover: none)').matches;
  cards.forEach((card) => {
    const v = card.querySelector<HTMLVideoElement>('video.acard__video');
    if (!v) return;
    if (isTouch) {
      // на тач-устройствах включаем по появлению в зоне видимости
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); });
      }, { threshold: 0.5 });
      io.observe(v);
      return;
    }
    card.addEventListener('mouseenter', () => { v.play().catch(() => {}); });
    card.addEventListener('mouseleave', () => { v.pause(); });
  });
</script>

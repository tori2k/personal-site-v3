---
import Arrow from './Arrow.astro';
const steps = [
  { label:'Задача', title:'Начнём с того, что вам нужно.', you:'Описываете задачу обычным сообщением. Готовое ТЗ не нужно.', me:'Уточняю задачу и вместе с вами определяю результат.', result:'Понятная задача', lines:['Что должно измениться','Кто будет пользоваться','Как поймём, что получилось'], note:'Сначала понимаем, что решаем.' },
  { label:'План', title:'Сначала договоримся о результате.', you:'Выбираете подход и согласуете состав работ.', me:'Предлагаю решение. Фиксируем объём, сроки и стоимость.', result:'План проекта', lines:['Состав работ','Этапы и сроки','Стоимость и границы'], note:'У проекта появляются ясные границы.' },
  { label:'Рабочая версия', title:'Пробуем будущий продукт в работе.', you:'Смотрите версию и даёте обратную связь.', me:'Собираю и показываю рабочую версию, проверяю и вношу согласованные правки.', result:'Рабочая версия', lines:['Интерфейс и сценарии','Интеграции в работе','Обратная связь и правки'], note:'Можно попробовать до запуска.' },
  { label:'Запуск', title:'Теперь проект работает на вас.', you:'Принимаете результат и получаете доступы.', me:'Проверяю сценарии, публикую проект и объясняю управление.', result:'Проект запущен', lines:['Основные сценарии проверены','Доступы переданы','Понятно, как пользоваться'], note:'Дальнейшее развитие обсуждаем отдельно.' },
];
---
<section class="journey" id="process" aria-labelledby="journey-title" data-journey>
  <div class="journey__heading"><h2 id="journey-title" data-reveal>От задачи<br /><span>до запуска.</span></h2><p>Ваш путь со мной. <br />Выберите этап — загляните вперёд.</p></div>
  <div class="journey-steps" role="tablist" aria-label="Этапы работы" data-journey-tabs>
    <div class="journey-line" aria-hidden="true"><span></span></div>
    {steps.map((step,index)=><button type="button" role="tab" id={`journey-tab-${index}`} aria-controls={`journey-panel-${index}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-journey-step={index}><span class="journey-step__number">0{index+1}</span><span>{step.label}</span></button>)}
  </div>
  <div class="journey-stage">
    <div class="journey-panels">
      {steps.map((step,index)=><div class="journey-panel" role="tabpanel" id={`journey-panel-${index}`} aria-labelledby={`journey-tab-${index}`} data-journey-panel hidden={index>0} tabindex="0"><h3>{step.title}</h3><dl><div><dt>От вас</dt><dd>{step.you}</dd></div><div><dt>От меня</dt><dd>{step.me}</dd></div></dl></div>)}
    </div>
    <div class="journey-delivery" aria-live="polite" aria-atomic="true">
      <div class="journey-sheet" data-journey-sheet>
        <div class="sheet-top"><span>Результат этапа</span><span data-journey-count>01 / 04</span></div>
        {steps.map((step,index)=><div class="sheet-content" data-journey-artifact hidden={index>0}><h4>{step.result}</h4><ul>{step.lines.map(line=><li><svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="1.5"/></svg><span>{line}</span></li>)}</ul></div>)}
        <div class="sheet-progress" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>
      <p class="journey-delivery__note" data-journey-note>{steps[0].note}</p>
    </div>
  </div>
  <div class="journey-bottom"><span>Вы участвуете в ключевых решениях на каждом этапе.</span><button type="button" data-journey-next>Следующий этап <Arrow size={20}/></button><a href="https://t.me/tori2k" target="_blank" rel="noopener" data-journey-contact hidden data-track="click_telegram">Начнём с вашей задачи <Arrow size={20}/></a></div>
  <noscript><p>Обсуждаем задачу → согласуем план, сроки и стоимость → собираем и проверяем рабочую версию → запускаем и передаём доступы.</p></noscript>
  <script is:inline type="application/json" data-journey-notes set:html={JSON.stringify(steps.map(step=>step.note)).replace(/</g,'\\u003c')} />
</section>
<style>
  .journey { width:var(--container); margin:0 auto; padding:0 0 95px; }
  .journey__heading { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; margin-bottom:36px; }.journey__heading h2 { font-size:clamp(40px,4.3vw,68px); letter-spacing:-.04em; line-height:1.06; font-weight:550; }.journey__heading h2 span { color:var(--accent); }.journey__heading p { font-size:14px; color:var(--muted); padding-bottom:5px; }
  .journey-steps { display:grid; grid-template-columns:repeat(4,1fr); position:relative; margin-bottom:30px; gap:18px; }.journey-steps button { position:relative; border:0; padding:16px 0; background:transparent; display:flex; align-items:center; gap:13px; text-align:left; font-size:16px; min-width:0; color:var(--muted); transition:color .25s; }.journey-step__number { display:grid; place-items:center; flex-shrink:0; width:38px; height:38px; border-radius:50%; background:var(--surface-2); font-size:12px; font-variant-numeric:tabular-nums; transition:background .3s,color .3s,transform .4s var(--ease); }.journey-steps button[aria-selected=true] { color:var(--text); }.journey-steps button[aria-selected=true] .journey-step__number { color:#fff; background:var(--accent); transform:scale(1.08); }.journey-steps button:hover { color:var(--accent); }
  .journey-line { position:absolute; bottom:0; height:2px; left:0; right:0; background:var(--line-soft); }.journey-line span { display:block; background:var(--accent); height:100%; width:25%; transform-origin:left; }
  .journey-stage { display:grid; grid-template-columns:1.15fr 1fr; gap:10%; align-items:center; min-height:300px; }.journey-panels { min-width:0; }.journey-panel h3 { font-size:clamp(28px,2.7vw,42px); line-height:1.15; letter-spacing:-.035em; font-weight:500; max-width:570px; }.journey-panel dl { margin:26px 0 0; display:grid; grid-template-columns:1fr 1fr; gap:28px; }.journey-panel dt { font-size:11px; color:var(--muted); margin-bottom:8px; }.journey-panel dd { margin:0; font-size:14px; line-height:1.55; }
  .journey-delivery { position:relative; padding:15px 10px 0; perspective:1000px; }.journey-sheet { position:relative; padding:25px 28px 22px; border-radius:14px; background:var(--surface); transform:rotate(-2deg); transform-origin:50% 80%; }.sheet-top { display:flex; align-items:center; justify-content:space-between; color:#51516b; font-size:11px; padding-bottom:18px; border-bottom:1px solid #bdbde8; }.sheet-top span:last-child { font-variant-numeric:tabular-nums; }.sheet-content h4 { margin:22px 0 16px; font-size:25px; line-height:1.15; letter-spacing:-.025em; font-weight:500; }.sheet-content ul { margin:0; padding:0; list-style:none; }.sheet-content li { display:flex; align-items:center; gap:10px; font-size:13px; padding:6px 0; }.sheet-content li svg { color:var(--accent); flex-shrink:0; }.sheet-progress { display:flex; gap:6px; margin-top:20px; }.sheet-progress i { display:block; height:3px; flex:1; background:#bbbbdf; transition:background .25s; }.sheet-progress i:first-child { background:var(--accent); }.journey-delivery__note { text-align:center; margin-top:22px; color:var(--muted); font-size:11px; }
  .journey-bottom { margin-top:26px; border-top:1px solid var(--line); padding-top:18px; display:flex; align-items:center; justify-content:space-between; gap:20px; font-size:12px; color:var(--muted); }.journey-bottom button,.journey-bottom a { display:inline-flex; align-items:center; gap:20px; padding:0; background:none; border:0; min-height:44px; color:var(--text); font-size:14px; }.journey-bottom [hidden] { display:none; }.journey-bottom svg { transition:transform .35s var(--ease); }.journey-bottom button:hover svg,.journey-bottom a:hover svg { transform:translate(4px,-4px); }
  @media(max-width:900px) { .journey-stage { gap:6%; grid-template-columns:1.1fr 1fr; }.journey-panel dl { grid-template-columns:1fr; gap:16px; }.journey-steps button { font-size:13px; gap:8px; }.journey-sheet { padding:20px; }.sheet-content h4 { font-size:21px; }.sheet-content li { font-size:12px; } }
  @media(max-width:600px) { .journey { padding-bottom:60px; }.journey__heading { display:block; margin-bottom:22px; }.journey__heading h2 { font-size:36px; }.journey__heading p { margin-top:14px; font-size:13px; }.journey__heading p br { display:none; }.journey-steps { gap:8px; margin-bottom:26px; }.journey-steps button { flex-direction:column; align-items:flex-start; gap:10px; font-size:10px; padding:8px 0 15px; }.journey-step__number { width:32px; height:32px; font-size:11px; }.journey-stage { grid-template-columns:1fr; gap:25px; }.journey-panels { min-height:212px; }.journey-panel h3 { font-size:29px; }.journey-panel dl { grid-template-columns:1fr 1fr; gap:20px; margin-top:22px; }.journey-panel dd { font-size:14px; }.journey-delivery { padding:0 6px; }.journey-sheet { padding:18px 22px; }.sheet-top { padding-bottom:10px; font-size:10px; }.sheet-progress { margin-top:10px; }.sheet-content h4 { margin:14px 0 10px; font-size:23px; }.sheet-content li { font-size:12px; padding:3px 0; }.journey-delivery__note { margin-top:14px; }.journey-bottom { align-items:flex-start; gap:12px; margin-top:22px; }.journey-bottom>span { max-width:160px; font-size:10px; }.journey-bottom button,.journey-bottom a { font-size:12px; gap:8px; min-height:38px; text-align:left; }.journey-bottom svg { width:18px; flex-shrink:0; } }
</style>

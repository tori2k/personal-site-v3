---
// Превью калькулятора на главной — короткий пример + CTA на /calculator/.
// Сам расчёт не дублируем, только демонстрируем результат.
---
<section class="calcp section-dark" id="calc-preview">
  <div class="container-x">
    <div class="calcp__grid">
      <div class="calcp__text reveal-left">
        <div class="sec-tag">Калькулятор потерь</div>
        <h2 class="display-h calcp__h2">Сколько денег уходит <em>после клика?</em></h2>
        <p class="calcp__sub">
          Заявка пришла — и зависла из-за формы, медленного ответа или отсутствия CRM.
          Деньги считаем прозрачно: заявки × потери × конверсия × чек.
        </p>
        <a href="/calculator" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          Открыть калькулятор
        </a>
      </div>

      <!-- Мини-превью результата -->
      <div class="calcp__card glass reveal-right">
        <div class="calcp__card-label">Пример расчёта</div>
        <div class="calcp__rows">
          <div class="calcp__row"><span>Заявок в месяц</span><b>80</b></div>
          <div class="calcp__row"><span>Средний чек</span><b>25 000 ₽</b></div>
          <div class="calcp__row"><span>Теряется до обработки</span><b class="calcp__bad">25%</b></div>
          <div class="calcp__row"><span>Из них могли купить</span><b>30%</b></div>
        </div>
        <div class="calcp__steps">
          <span>80 × 25% = 20 потерянных лидов</span>
          <span>20 × 30% = 6 возможных продаж</span>
        </div>
        <div class="calcp__result">
          <div class="calcp__result-label">Потери в месяц</div>
          <div class="calcp__result-val">150 000 ₽</div>
          <div class="calcp__result-year">1,8 млн ₽ в год</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .calcp { padding: 120px 0; }
  .calcp__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }

  .calcp__h2 { margin: 16px 0 18px; font-size: clamp(30px, 4vw, 56px); }
  .calcp__h2 em { color: var(--aurora-cyan); }
  .calcp__sub { font-size: 16px; color: var(--color-muted); line-height: 1.65; max-width: 460px; margin: 0 0 28px; }

  .calcp__card { padding: 28px 26px; border-radius: 18px; }
  .calcp__card-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 18px; }
  .calcp__rows { display: flex; flex-direction: column; gap: 12px; padding-bottom: 18px; border-bottom: 1px solid var(--color-border); }
  .calcp__row { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; color: var(--color-muted); }
  .calcp__row b { color: var(--color-text); font-weight: 500; }
  .calcp__bad { color: #ff8a8a !important; }
  .calcp__steps { display: flex; flex-direction: column; gap: 6px; padding: 14px 0; }
  .calcp__steps span { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--color-muted-2); line-height: 1.5; }
  .calcp__result { padding-top: 14px; border-top: 1px solid var(--color-border); }
  .calcp__result-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-muted); margin-bottom: 8px; }
  .calcp__result-val { font-family: 'Unbounded', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 500; color: #ff8a8a; line-height: 1; letter-spacing: -0.02em; }
  .calcp__result-year { font-size: 13px; color: var(--color-muted); margin-top: 8px; }

  @media (max-width: 900px) {
    .calcp { padding: 72px 0; }
    .calcp__grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 480px) {
    .calcp .btn { width: 100%; justify-content: center; }
  }
</style>

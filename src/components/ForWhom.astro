---
const tabs = [
  {
    id: 'lawyers',
    label: 'Юристам',
    pain: 'Клиент не понимает чем вы отличаетесь — выбирает по цене',
    built: 'Лендинг с оффером, кейсами практики, квизом и заявкой в Telegram',
    result: 'Клиент приходит уже квалифицированным, понимает вашу специализацию',
  },
  {
    id: 'experts',
    label: 'Экспертам',
    pain: 'Обращения теряются в директе и переписках, нет системы',
    built: 'Сайт-воронка: оффер → доверие → квиз → Telegram/CRM',
    result: 'Каждая заявка фиксируется и приходит туда, где вы реально работаете',
  },
  {
    id: 'schools',
    label: 'Онлайн-школам',
    pain: 'Заявка на пробный урок приходит через 5 разных каналов',
    built: 'Сайт с записью, оплатой и Telegram-уведомлением о каждой заявке',
    result: 'Запись на пробное занятие приходит в Telegram — ничего не теряется',
  },
  {
    id: 'business',
    label: 'Сервисному бизнесу',
    pain: 'Сайт есть, но заявок с него нет — люди уходят без действия',
    built: 'Реструктуризация оффера, квиз-квалификация, Telegram + таблица лидов',
    result: 'Сайт становится частью операционки, а не просто витриной',
  },
];
---
<section class="forwhom section-dark" id="forwhom">
  <div class="container-x">
    <div class="forwhom__head reveal">
      <div class="sec-tag">Для кого</div>
      <h2 class="display-h">Найдите <em>свой случай.</em></h2>
    </div>

    <div class="fw-tabs reveal">
      <!-- Tab buttons -->
      <div class="fw-tabs__nav" role="tablist">
        {tabs.map((t, i) => (
          <button
            class:list={['fw-tab-btn', i === 0 && 'is-active']}
            role="tab"
            aria-selected={i === 0}
            aria-controls={`fw-panel-${t.id}`}
            data-tab={t.id}
            type="button"
          >
            {t.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div class="fw-tabs__panels">
        {tabs.map((t, i) => (
          <div
            class:list={['fw-panel', i === 0 && 'is-active']}
            id={`fw-panel-${t.id}`}
            role="tabpanel"
            aria-hidden={i !== 0}
          >
            <div class="fw-panel__grid">
              <div class="fw-cell">
                <div class="fw-cell__label">Боль</div>
                <p class="fw-cell__text">{t.pain}</p>
              </div>
              <div class="fw-cell">
                <div class="fw-cell__label">Что собираем</div>
                <p class="fw-cell__text">{t.built}</p>
              </div>
              <div class="fw-cell fw-cell--result">
                <div class="fw-cell__label">Результат</div>
                <p class="fw-cell__text">{t.result}</p>
              </div>
            </div>
            <a href="/razbor" class="btn btn--filled fw-panel__cta" data-magnetic="0.3">
              <span class="btn__plus">(+)</span>
              Получить разбор
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .forwhom { padding: 120px 0; }
  .forwhom__head { max-width: 680px; margin-bottom: 48px; }

  /* Tabs nav */
  .fw-tabs__nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .fw-tab-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    padding: 9px 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.25s;
  }
  .fw-tab-btn:hover {
    border-color: var(--color-border-2);
    color: var(--color-text);
  }
  .fw-tab-btn.is-active {
    background: var(--aurora-cyan);
    border-color: var(--aurora-cyan);
    color: #06070D;
  }

  /* Panels */
  .fw-panel {
    display: none;
    animation: fw-fade 0.3s ease;
  }
  .fw-panel.is-active { display: block; }
  @keyframes fw-fade {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  .fw-panel__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
    margin-bottom: 28px;
  }

  .fw-cell {
    padding: 24px 22px;
    background: var(--glass-tint);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }
  .fw-cell--result {
    background: linear-gradient(135deg, rgba(95,198,255,0.08), transparent);
    border-color: rgba(95,198,255,0.25);
  }
  .fw-cell__label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 10px;
  }
  .fw-cell__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .fw-panel__cta { align-self: flex-start; }

  @media (max-width: 900px) {
    .forwhom { padding: 72px 0; }
    .fw-panel__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .fw-tab-btn { font-size: 11px; padding: 8px 14px; }
    .fw-cell { padding: 18px 16px; }
    .fw-panel__cta { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fw-panel { animation: none; }
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.fw-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.fw-panel');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab;
      btns.forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
      panels.forEach((p) => { p.classList.remove('is-active'); p.setAttribute('aria-hidden', 'true'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`fw-panel-${id}`);
      if (panel) { panel.classList.add('is-active'); panel.setAttribute('aria-hidden', 'false'); }
    });
  });
</script>

---
// Hero-визуал: если есть public/hero-video.mp4 — muted loop видео,
// иначе интерактивный dashboard-mockup (Telegram-заявка → CRM → Sheets → потери).
// Mockup собран на HTML/CSS в стиле сайта, без картинок и тяжёлых зависимостей.
import fs from 'node:fs';
import path from 'node:path';

const hasVideo = fs.existsSync(path.resolve('public/hero-video.mp4'));
---
<div class="hero-media" aria-hidden="true">
  {hasVideo ? (
    <video
      class="hero-media__video"
      autoplay muted loop playsinline
      poster="/og-image.jpg"
    >
      <source src="/hero-video.mp4" type="video/mp4" />
    </video>
  ) : (
    <div class="hm-dash glass">
      <!-- Шапка дашборда -->
      <div class="hm-dash__bar">
        <span class="hm-dot"></span><span class="hm-dot"></span><span class="hm-dot"></span>
        <span class="hm-dash__title">Система заявок</span>
        <span class="hm-dash__live"><span class="hm-live-dot"></span>online</span>
      </div>

      <!-- Telegram-заявка -->
      <div class="hm-tg">
        <div class="hm-tg__icon">✈</div>
        <div class="hm-tg__body">
          <div class="hm-tg__head">
            <span class="hm-tg__name">Новая заявка</span>
            <span class="hm-tg__time">сейчас</span>
          </div>
          <div class="hm-tg__row"><b>Ниша:</b> стоматология</div>
          <div class="hm-tg__row"><b>Источник:</b> реклама · квиз</div>
          <div class="hm-tg__row"><b>Контакт:</b> @client</div>
        </div>
      </div>

      <!-- Поток: квиз → TG → CRM -->
      <div class="hm-flow">
        <span class="hm-flow__node">квиз</span>
        <span class="hm-flow__arr">→</span>
        <span class="hm-flow__node hm-flow__node--tg">Telegram</span>
        <span class="hm-flow__arr">→</span>
        <span class="hm-flow__node hm-flow__node--crm">CRM</span>
      </div>

      <!-- Мини-CRM: строки лидов со статусами -->
      <div class="hm-crm">
        <div class="hm-crm__row">
          <span class="hm-crm__name">Анна К.</span>
          <span class="hm-crm__src">сайт</span>
          <span class="hm-status hm-status--new">новый</span>
        </div>
        <div class="hm-crm__row">
          <span class="hm-crm__name">Игорь П.</span>
          <span class="hm-crm__src">квиз</span>
          <span class="hm-status hm-status--work">в работе</span>
        </div>
        <div class="hm-crm__row">
          <span class="hm-crm__name">Мария В.</span>
          <span class="hm-crm__src">реклама</span>
          <span class="hm-status hm-status--won">продажа</span>
        </div>
      </div>

      <!-- Счётчик потерь -->
      <div class="hm-loss">
        <div class="hm-loss__label">Потери без системы / мес</div>
        <div class="hm-loss__val"><span id="hmLoss">0</span> ₽</div>
      </div>
    </div>
  )}
</div>

<style>
  .hero-media { width: 100%; }
  .hero-media__video {
    width: 100%; height: auto;
    border-radius: 18px;
    display: block;
    border: 1px solid var(--color-border);
  }

  /* ── Dashboard mockup ── */
  .hm-dash {
    padding: 16px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--glass-edge), 0 24px 60px rgba(0,0,0,0.35);
    animation: hm-float 6s ease-in-out infinite;
  }
  @keyframes hm-float {
    0%,100% { transform: translateY(0); }
    50%     { transform: translateY(-8px); }
  }

  .hm-dash__bar {
    display: flex; align-items: center; gap: 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }
  .hm-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-muted-2); }
  .hm-dot:nth-child(1) { background: #ff6b6b; }
  .hm-dot:nth-child(2) { background: #ffd166; }
  .hm-dot:nth-child(3) { background: #5fc6a0; }
  .hm-dash__title {
    margin-left: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1px; color: var(--color-muted);
  }
  .hm-dash__live {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 1px; text-transform: uppercase;
    color: var(--color-accent);
  }
  .hm-live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    animation: hm-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hm-pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* Telegram card */
  .hm-tg {
    display: flex; gap: 10px;
    padding: 12px;
    background: rgba(95,198,255,0.07);
    border: 1px solid rgba(95,198,255,0.22);
    border-radius: 12px;
    animation: hm-slide-in 0.6s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes hm-slide-in { from { opacity:0; transform: translateX(14px) } to { opacity:1; transform:none } }
  .hm-tg__icon {
    width: 30px; height: 30px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--color-accent); color: #06070D;
    border-radius: 8px; font-size: 15px;
  }
  .hm-tg__body { flex: 1; min-width: 0; }
  .hm-tg__head { display: flex; justify-content: space-between; margin-bottom: 5px; }
  .hm-tg__name { font-size: 12px; font-weight: 600; color: var(--color-text); }
  .hm-tg__time { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--color-muted-2); }
  .hm-tg__row { font-size: 11px; color: var(--color-muted); line-height: 1.6; }
  .hm-tg__row b { color: var(--color-text); font-weight: 500; }

  /* Flow line */
  .hm-flow {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 4px 0;
  }
  .hm-flow__node {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.5px;
    padding: 5px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
  }
  .hm-flow__node--tg { color: var(--color-accent); border-color: rgba(95,198,255,0.4); }
  .hm-flow__node--crm { color: var(--aurora-violet); border-color: rgba(162,128,255,0.4); }
  .hm-flow__arr { color: var(--color-muted-2); font-size: 12px; }

  /* Mini CRM */
  .hm-crm { display: flex; flex-direction: column; gap: 6px; }
  .hm-crm__row {
    display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center;
    padding: 9px 12px;
    background: rgba(244,246,251,0.03);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }
  .hm-crm__name { font-size: 12px; color: var(--color-text); }
  .hm-crm__src { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--color-muted-2); }
  .hm-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; letter-spacing: 0.5px; text-transform: uppercase;
    padding: 3px 8px; border-radius: 999px;
  }
  .hm-status--new  { color: #5fc6ff; background: rgba(95,198,255,0.12); }
  .hm-status--work { color: #ffd166; background: rgba(255,209,102,0.12); }
  .hm-status--won  { color: #5fc6a0; background: rgba(95,198,160,0.14); }

  /* Loss counter */
  .hm-loss {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px;
    background: linear-gradient(135deg, rgba(255,107,107,0.1), transparent);
    border: 1px solid rgba(255,107,107,0.25);
    border-radius: 12px;
  }
  .hm-loss__label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--color-muted); }
  .hm-loss__val { font-family: 'Unbounded', sans-serif; font-size: 18px; font-weight: 500; color: #ff8a8a; }

  @media (prefers-reduced-motion: reduce) {
    .hm-dash { animation: none; }
    .hm-tg { animation: none; }
    .hm-live-dot { animation: none; }
  }
</style>

<script>
  // Анимированный счётчик потерь (демо-число)
  const el = document.getElementById('hmLoss');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const target = 280000;
    let started = false;
    const run = () => {
      if (started) return; started = true;
      const dur = 1600, t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('ru-RU');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) run(); });
    }, { threshold: 0.4 });
    io.observe(el);
  } else if (el) {
    el.textContent = (280000).toLocaleString('ru-RU');
  }
</script>

---
// Аналитика: Яндекс Метрика + GA4, подключаются ТОЛЬКО если задан ID.
// Без ID скрипты не вставляются, а window.track() работает как безопасный no-op.
// ID берутся из env (PUBLIC_ префикс обязателен для клиента).
const YM_ID = import.meta.env.PUBLIC_YANDEX_METRIKA_ID || '';
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
---
{/* Яндекс Метрика — только при наличии ID */}
{YM_ID && (
  <script is:inline define:vars={{ YM_ID }}>
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
    ym(YM_ID, 'init', { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
  </script>
  <noscript><div><img src={`https://mc.yandex.ru/watch/${YM_ID}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>
)}

{/* Google Analytics 4 — только при наличии ID */}
{GA_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </>
)}

{/* Единый трекер событий: безопасен без подключённой аналитики */}
<script is:inline define:vars={{ YM_ID, GA_ID }}>
  // window.track(name, params) — шлёт цель в Метрику и событие в GA4.
  // Если аналитика не подключена — тихо ничего не делает.
  window.track = function (name, params) {
    try {
      if (YM_ID && typeof window.ym === 'function') window.ym(YM_ID, 'reachGoal', name, params || {});
      if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
    } catch (e) { /* no-op */ }
  };

  // Делегирование: любой элемент с data-track шлёт событие по клику.
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
    if (el) window.track(el.getAttribute('data-track'));
  }, { passive: true });
</script>

---
const items = [
  {
    q: 'Можно ли без нового сайта?',
    a: 'Да. Иногда достаточно переработать первый экран, добавить квиз или настроить приём заявок в Telegram. Начните с бесплатного разбора — скажу честно, нужен ли новый сайт.',
  },
  {
    q: 'Чем лендинг отличается от системы заявок?',
    a: 'Лендинг — это страница. Система заявок — лендинг + квиз + Telegram-бот + таблица лидов + аналитика. Лендинг объясняет, система — ещё и фиксирует каждое обращение.',
  },
  {
    q: 'Почему не конструктор?',
    a: 'Конструкторы дают шаблон, который все видели. Чистый код — это ваш оффер, ваш дизайн, ваша скорость. Lighthouse 95+, без ежемесячной подписки, исходники остаются у вас.',
  },
  {
    q: 'Что будет после заявки?',
    a: 'Я посмотрю ваш сайт или профиль, найду слабые места в пути заявки и напишу в Telegram с коротким разбором. Без звонков без предупреждения.',
  },
  {
    q: 'Можно ли начать с аудита?',
    a: 'Да, это и есть бесплатный разбор. Заполните форму на странице /razbor — разберу первый экран, оффер, CTA и путь заявки. Пришлю конкретный план из 3 шагов.',
  },
  {
    q: 'Сколько времени занимает запуск?',
    a: 'Экспресс-лендинг — 3–5 дней. Лендинг эксперта — 1–2 недели. Полная система — 3–5 недель. Срок считается от момента, когда у нас есть все материалы.',
  },
];
---
<section class="faq section-dark" id="faq">
  <div class="container-x">
    <div class="faq__inner">
      <div class="faq__head reveal-left">
        <div class="sec-tag">FAQ</div>
        <h2 class="display-h faq__title">Частые <em>вопросы.</em></h2>
      </div>

      <dl class="faq__list reveal-right">
        {items.map((item, i) => (
          <div class="faq__item">
            <details>
              <summary class="faq__q">
                <span class="faq__num">0{i + 1}</span>
                <span class="faq__q-text">{item.q}</span>
                <span class="faq__icon" aria-hidden="true">+</span>
              </summary>
              <dd class="faq__a">{item.a}</dd>
            </details>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .faq { padding: 120px 0; }

  .faq__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 64px;
    align-items: start;
  }

  .faq__head { position: sticky; top: 100px; }
  /* Заголовок в узкой колонке 280px — уменьшаем шрифт, чтобы не вылезал на вопросы */
  .faq__title {
    margin: 0;
    font-size: clamp(32px, 3.2vw, 48px);
    line-height: 1.0;
  }
  .faq__title em { color: var(--aurora-cyan); }

  .faq__list {
    display: flex;
    flex-direction: column;
  }

  .faq__item { border-bottom: 1px solid var(--color-border); }
  .faq__item:first-child { border-top: 1px solid var(--color-border); }

  .faq__q {
    display: grid;
    grid-template-columns: 32px 1fr 24px;
    align-items: center;
    gap: 12px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.2s;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover .faq__q-text { color: var(--color-accent); }

  .faq__num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--color-accent);
    opacity: 0.6;
  }
  .faq__q-text {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    transition: color 0.2s;
  }
  .faq__icon {
    font-size: 20px;
    color: var(--color-accent);
    justify-self: end;
    transition: transform 0.25s cubic-bezier(.22,1,.36,1);
    line-height: 1;
    font-family: 'JetBrains Mono', monospace;
  }
  details[open] .faq__icon { transform: rotate(45deg); }
  details[open] .faq__q-text { color: var(--color-accent); }

  .faq__a {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
    padding: 0 0 20px 44px;
    margin: 0;
  }

  @media (max-width: 900px) {
    .faq { padding: 72px 0; }
    .faq__inner { grid-template-columns: 1fr; gap: 36px; }
    .faq__head { position: static; }
    .faq__a { padding-left: 40px; }
  }
</style>

---
const items = [
  {
    q: 'Что я получу бесплатно до оплаты?',
    a: 'Короткий разбор: что продавать на первом экране, какие блоки нужны, где у конкурентов слабые места и какой формат сайта вам не переплачивать.',
  },
  {
    q: 'Я не программист. Смогу ли сам вести сайт?',
    a: 'Да. Стандартно подключаю Google Sheets как админку — тексты, цены, контент редактируются в таблице. Если хочется «как в Tilda» — подключу Decap CMS с веб-редактором.',
  },
  {
    q: 'Можно онлайн-оплаты и автоматизации?',
    a: 'Да. Подключаю Т-Кассу, ЮKassa, CloudPayments — деньги сразу на ваш счёт. Автоматизирую процессы: боты в Telegram, интеграции с CRM, уведомления о заявках, запись клиентов.',
  },
  {
    q: 'У меня уже есть сайт, хочу редизайн?',
    a: 'Посмотрим вместе. Перенос контента со старого сайта на новый обычно занимает 1–2 дня и входит в стоимость выбранного формата.',
  },
];
---
<section class="faq section-dark" id="faq">
  <div class="container-x">
    <div class="faq__grid">
      <div class="faq__head reveal-left">
        <div class="sec-tag">FAQ</div>
        <h2 class="display-h">
          Частые<br/>
          <em>вопросы</em>
        </h2>
        <p class="faq__text">
          Не нашли ответ? <a href="https://t.me/tori2k" target="_blank" rel="noopener">Напишите в Telegram</a> —
          отвечу за 15 минут в рабочее время.
        </p>
      </div>

      <div class="faq__list reveal-right">
        {items.map((i, idx) => (
          <details class="faq__item" style={`transition-delay: ${idx * 0.04}s`}>
            <summary class="faq__q">
              <span class="faq__q-n">{String(idx + 1).padStart(2, '0')}</span>
              <span class="faq__q-text">{i.q}</span>
              <span class="faq__q-sign" aria-hidden="true">(+)</span>
            </summary>
            <div class="faq__a">{i.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq { padding: 140px 0; }
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: start;
  }
  .faq__head { position: sticky; top: 120px; }
  .faq__text {
    font-size: 14px;
    color: var(--color-muted);
    margin: 24px 0 0;
    line-height: 1.6;
  }
  .faq__text a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-border);
    transition: background 0.3s;
  }
  .faq__item[open] .faq__q-sign {
    transform: rotate(45deg);
  }
  .faq__item[open] .faq__q-text { color: var(--color-accent); }

  .faq__q {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 24px 0;
    cursor: none;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q-n {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--color-muted-2);
  }
  .faq__q-text {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }
  .faq__q-sign {
    font-family: 'Unbounded', sans-serif;
    font-size: 18px;
    color: var(--color-accent);
    transition: transform 0.35s;
  }

  .faq__a {
    padding: 0 40px 24px 52px;
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 640px;
  }

  @media (max-width: 900px) {
    .faq { padding: 80px 0; }
    .faq__grid { grid-template-columns: 1fr; gap: 50px; }
    .faq__head { position: static; }
    .faq__a { padding: 0 0 24px 52px; }
  }
</style>

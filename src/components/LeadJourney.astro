---
const base = import.meta.env.BASE_URL;
// Путь заявки = стержень сайта. Каждый шаг — автоматизация с видео.
// Сайт показан как «точка входа» (вторично), всё остальное — автоматизации.
const steps = [
  { n: '01', kind: 'video', src: 'auto-content', title: 'Контент-завод',     desc: 'Короткие видео гонят трафик из соцсетей' },
  { n: '02', kind: 'video', src: 'auto-site',    title: 'Сайт — точка входа', desc: 'Лендинг объясняет ценность и ведёт к заявке', site: true },
  { n: '03', kind: 'video', src: 'auto-tg',      title: 'Заявка → Telegram',  desc: 'Обращение мгновенно прилетает в чат' },
  { n: '04', kind: 'video', src: 'auto-crm',     title: 'Лид в CRM / таблице', desc: 'Со статусом, источником и данными' },
  { n: '05', kind: 'video', src: 'auto-ai',      title: 'AI-дожим',           desc: 'Бот доводит холодных до записи' },
  { n: '06', kind: 'video', src: 'auto-pay',     title: 'Онлайн-оплата',      desc: 'Клиент платит прямо на сайте' },
  { n: '07', kind: 'video', src: 'auto-funnel',  title: 'Воронка / статусы',  desc: 'Видно, кто на какой стадии' },
];
---
<section class="journey section-dark" id="flow">
  <div class="journey__sticky">
    <div class="container-x journey__head">
      <div class="sec-tag">Путь заявки</div>
      <h2 class="display-h journey__title">Как лид <em>проходит</em> систему.</h2>
      <p class="journey__lead">От первого касания до оплаты — каждый шаг автоматизирован. Сайт здесь — точка входа в систему.</p>
      <div class="journey__hint" aria-hidden="true">скролльте <span>→</span></div>
    </div>

    <div class="journey__viewport">
      <div class="journey__track" id="journeyTrack">
        {steps.map((s, i) => (
          <>
            <article class:list={['jcard', s.site && 'jcard--site']}>
              <div class="jcard__media">
                {s.kind === 'video' ? (
                  <video class="jcard__video" muted loop playsinline preload="none" poster={`/${s.src}-poster.jpg`}>
                    <source src={`/${s.src}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <img class="jcard__img" src={`${base}screenshots/${s.src}`} alt={s.title} loading="lazy" decoding="async" />
                )}
                {s.site && <span class="jcard__tag">сайт</span>}
              </div>
              <div class="jcard__meta">
                <span class="jcard__n">{s.n}</span>
                <h3 class="jcard__title">{s.title}</h3>
                <p class="jcard__desc">{s.desc}</p>
              </div>
            </article>
            {i < steps.length - 1 && <div class="jconn" aria-hidden="true">→</div>}
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .journey { position: relative; height: 460vh; }
  .journey__sticky {
    position: sticky; top: 0;
    height: 100vh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center; gap: 36px;
  }
  .journey__head { width: 100%; }
  .journey__title { margin: 0; }
  .journey__lead { font-size: 16px; line-height: 1.6; color: var(--color-muted); max-width: 560px; margin: 16px 0 0; }
  .journey__hint {
    margin-top: 16px; font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--color-muted);
    display: inline-flex; gap: 8px; align-items: center;
  }
  .journey__hint span { color: var(--color-accent); animation: j-nudge 1.6s ease-in-out infinite; }
  @keyframes j-nudge { 0%,100%{transform:translateX(0)} 50%{transform:translateX(6px)} }

  .journey__viewport { width: 100%; overflow: hidden; }
  .journey__track {
    display: flex; align-items: stretch; gap: 0;
    padding: 0 max(24px, calc((100vw - 1280px) / 2 + 40px));
    will-change: transform;
  }

  .jcard {
    flex: 0 0 auto;
    width: clamp(300px, 30vw, 420px);
    display: flex; flex-direction: column;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 20px; overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.32), var(--glass-edge);
  }
  .jcard__media {
    position: relative; aspect-ratio: 16/10; overflow: hidden; background: #0A0712;
    border-bottom: 1px solid var(--color-border);
  }
  .jcard__video, .jcard__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .jcard__img { object-position: top center; }
  .jcard--site { border-color: rgba(139,92,255,0.35); }
  .jcard__tag {
    position: absolute; top: 12px; left: 12px;
    font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 4px 9px; border-radius: 999px;
    background: var(--color-accent); color: #0A0712; font-weight: 600;
  }
  .jcard__meta { padding: 22px 24px 26px; }
  .jcard__n { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; color: var(--color-accent); }
  .jcard__title {
    font-family: 'Unbounded', sans-serif; font-size: clamp(17px, 1.5vw, 22px); font-weight: 500;
    letter-spacing: -0.02em; color: var(--color-text); margin: 10px 0 8px;
  }
  .jcard__desc { font-size: 14px; line-height: 1.5; color: var(--color-muted); margin: 0; }

  .jconn {
    flex: 0 0 auto; align-self: center;
    width: 48px; text-align: center;
    color: var(--color-accent); opacity: 0.5; font-size: 20px;
  }

  /* Мобайл/планшет — без пиннинга: горизонтальный свайп */
  @media (max-width: 900px) {
    .journey { height: auto; }
    .journey__sticky { position: static; height: auto; padding: 80px 0; gap: 24px; }
    .journey__viewport { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
    .journey__track { transform: none !important; padding: 0 24px 16px; }
    .jcard { scroll-snap-align: start; width: 76vw; }
    .jconn { width: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey { height: auto; }
    .journey__sticky { position: static; height: auto; }
    .journey__track { transform: none !important; flex-wrap: wrap; }
    .journey__hint span { animation: none; }
  }
</style>

<script>
  const section = document.getElementById('flow');
  const track = document.getElementById('journeyTrack');
  const mq = window.matchMedia('(max-width: 900px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // горизонтальный пиннед-скролл (rAF — надёжно с Lenis)
  let lastX = -1;
  function update() {
    if (!section || !track) return;
    if (mq.matches || reduce.matches) { if (track.style.transform) track.style.transform = ''; return; }
    const rect = section.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    const total = section.offsetHeight - window.innerHeight;
    const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
    const maxX = Math.max(0, track.scrollWidth - window.innerWidth + 48);
    const x = Math.round(progress * maxX);
    if (x !== lastX) { track.style.transform = `translate3d(${-x}px,0,0)`; lastX = x; }
  }
  function loop() { update(); requestAnimationFrame(loop); }
  requestAnimationFrame(loop);
  window.addEventListener('resize', update);

  // видео играют по мере появления в кадре (по одному, не все сразу)
  const vids = document.querySelectorAll<HTMLVideoElement>('.jcard__video');
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    });
  }, { threshold: 0.55 });
  vids.forEach((v) => io.observe(v));
</script>

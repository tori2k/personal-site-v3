---
// Переиспользуемая SEO-посадочная под коммерческий запрос.
// Сохраняет тёмную эстетику сайта (.container-x, .display-h, .btn, .glass, .sec-tag).
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Format { name: string; price: string; desc: string; }
interface PainBlock { title: string; body: string; }
interface FaqQA { q: string; a: string; }

interface Props {
  eyebrow: string;
  h1: string;
  lead: string;
  intro: string[];          // содержательные параграфы (объём)
  forWhom: string[];
  pains: PainBlock[];
  includes: string[];
  formats: Format[];
  faq: FaqQA[];
  ctaText?: string;
}

const {
  eyebrow, h1, lead, intro, forWhom, pains, includes, formats, faq,
  ctaText = 'Получить бесплатный разбор',
} = Astro.props;
---
<Nav />
<main>
  <!-- Hero -->
  <section class="sl-hero section-dark">
    <div class="container-x">
      <div class="sl-hero__inner reveal">
        <div class="sec-tag">{eyebrow}</div>
        <h1 class="display-h sl-hero__h1">{h1}</h1>
        <p class="sl-hero__lead">{lead}</p>
        <a href="/razbor" class="btn btn--filled sl-hero__cta" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          {ctaText}
        </a>
      </div>
    </div>
  </section>

  <!-- Intro / польза -->
  <section class="sl-intro section-dark">
    <div class="container-x">
      <div class="sl-intro__inner reveal">
        {intro.map((p) => <p class="sl-intro__p" set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- Кому подходит -->
  <section class="sl-block section-dark">
    <div class="container-x">
      <div class="sl-block__head reveal">
        <div class="sec-tag">Кому подходит</div>
        <h2 class="display-h sl-block__h2">Для кого <em>эта страница.</em></h2>
      </div>
      <ul class="sl-chips reveal">
        {forWhom.map((w) => <li class="sl-chip">{w}</li>)}
      </ul>
    </div>
  </section>

  <!-- Какую боль закрывает -->
  <section class="sl-block section-dark">
    <div class="container-x">
      <div class="sl-block__head reveal">
        <div class="sec-tag">Боль</div>
        <h2 class="display-h sl-block__h2">Что <em>закрываем.</em></h2>
      </div>
      <div class="sl-pains reveal">
        {pains.map((p, i) => (
          <div class="sl-pain glass">
            <div class="sl-pain__n">0{i + 1}</div>
            <div class="sl-pain__title">{p.title}</div>
            <p class="sl-pain__body">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Что входит -->
  <section class="sl-block section-dark">
    <div class="container-x">
      <div class="sl-block__head reveal">
        <div class="sec-tag">Состав</div>
        <h2 class="display-h sl-block__h2">Что <em>входит.</em></h2>
      </div>
      <ul class="sl-includes reveal">
        {includes.map((inc) => (
          <li><span class="sl-check">(+)</span>{inc}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Форматы / цены -->
  <section class="sl-block section-dark">
    <div class="container-x">
      <div class="sl-block__head reveal">
        <div class="sec-tag">Форматы и цены</div>
        <h2 class="display-h sl-block__h2">Сколько <em>стоит.</em></h2>
      </div>
      <div class="sl-formats reveal">
        {formats.map((f) => (
          <div class="sl-format glass">
            <div class="sl-format__name">{f.name}</div>
            <div class="sl-format__price">{f.price}</div>
            <p class="sl-format__desc">{f.desc}</p>
          </div>
        ))}
      </div>
      <p class="sl-formats__note">
        Точную цену называю после <a href="/razbor">бесплатного разбора</a> — смотрю нишу,
        текущий вход и путь заявки. Вся линейка форматов — на странице
        <a href="/services">услуг</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sl-faq section-dark">
    <div class="container-x">
      <div class="sl-faq__head reveal">
        <div class="sec-tag">FAQ</div>
        <h2 class="display-h sl-faq__h2">Частые <em>вопросы.</em></h2>
      </div>
      <dl class="sl-faq__list reveal">
        {faq.map((item, i) => (
          <div class="sl-faq__item">
            <details>
              <summary class="sl-faq__q">
                <span class="sl-faq__num">0{i + 1}</span>
                <span class="sl-faq__q-text">{item.q}</span>
                <span class="sl-faq__icon" aria-hidden="true">+</span>
              </summary>
              <dd class="sl-faq__a">{item.a}</dd>
            </details>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Финальный CTA + перелинковка -->
  <section class="sl-final section-dark">
    <div class="container-x">
      <div class="sl-final__inner glass reveal">
        <h2 class="sl-final__h2">Начните с бесплатного разбора</h2>
        <p class="sl-final__sub">
          Покажу 3 места, где теряются заявки, и какой формат вам подходит.
          Без звонков — ответ в Telegram.
        </p>
        <a href="/razbor" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          {ctaText}
        </a>
        <div class="sl-final__links">
          <a href="/cases">Кейсы →</a>
          <a href="/services">Услуги →</a>
          <a href="/method">Метод →</a>
        </div>
      </div>
    </div>
  </section>
</main>
<Footer />

<style>
  .sl-hero { padding: 140px 0 60px; }
  .sl-hero__h1 { margin: 16px 0 20px; max-width: 16ch; }
  .sl-hero__lead {
    font-size: clamp(16px, 1.5vw, 20px);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 0 32px;
  }
  .sl-hero__cta { align-self: flex-start; }

  .sl-intro { padding: 40px 0 60px; }
  .sl-intro__inner { max-width: 760px; display: flex; flex-direction: column; gap: 18px; }
  .sl-intro__p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-muted);
    margin: 0;
  }
  .sl-intro__p :global(strong) { color: var(--color-text); font-weight: 500; }

  .sl-block { padding: 60px 0; }
  .sl-block__head { max-width: 680px; margin-bottom: 36px; }
  .sl-block__h2 { margin: 0; font-size: clamp(30px, 4vw, 56px); }
  .sl-block__h2 em { color: var(--aurora-cyan); }

  .sl-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .sl-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 12px 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    background: var(--glass-tint);
  }

  .sl-pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .sl-pain { padding: 28px 24px; border-radius: 16px; }
  .sl-pain__n {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.5px; color: var(--color-accent); opacity: 0.6; margin-bottom: 12px;
  }
  .sl-pain__title { font-family: 'Unbounded', sans-serif; font-size: 15px; font-weight: 500; color: var(--color-text); margin-bottom: 10px; }
  .sl-pain__body { font-size: 14px; line-height: 1.6; color: var(--color-muted); margin: 0; }

  .sl-includes {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    max-width: 860px;
  }
  .sl-includes li { display: flex; gap: 10px; font-size: 15px; line-height: 1.5; color: var(--color-text); }
  .sl-check { color: var(--color-accent); font-family: 'JetBrains Mono', monospace; font-size: 12px; flex-shrink: 0; }

  .sl-formats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .sl-format { padding: 28px 24px; border-radius: 16px; }
  .sl-format__name { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-accent); margin-bottom: 12px; }
  .sl-format__price { font-family: 'Unbounded', sans-serif; font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -0.02em; margin-bottom: 12px; }
  .sl-format__desc { font-size: 14px; line-height: 1.6; color: var(--color-muted); margin: 0; }
  .sl-formats__note { margin-top: 28px; font-size: 14px; color: var(--color-muted); line-height: 1.6; }
  .sl-formats__note a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }

  .sl-faq { padding: 60px 0; }
  .sl-faq__head { max-width: 680px; margin-bottom: 28px; }
  .sl-faq__h2 { margin: 0; font-size: clamp(30px, 4vw, 56px); }
  .sl-faq__h2 em { color: var(--aurora-cyan); }
  .sl-faq__list { max-width: 820px; }
  .sl-faq__item { border-bottom: 1px solid var(--color-border); }
  .sl-faq__item:first-child { border-top: 1px solid var(--color-border); }
  .sl-faq__q {
    display: grid; grid-template-columns: 32px 1fr 24px; align-items: center; gap: 12px;
    padding: 20px 0; cursor: pointer; list-style: none; user-select: none;
  }
  .sl-faq__q::-webkit-details-marker { display: none; }
  .sl-faq__num { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.5px; color: var(--color-accent); opacity: 0.6; }
  .sl-faq__q-text { font-size: 16px; font-weight: 500; color: var(--color-text); line-height: 1.4; transition: color 0.2s; }
  .sl-faq__q:hover .sl-faq__q-text { color: var(--color-accent); }
  .sl-faq__icon { font-size: 20px; color: var(--color-accent); justify-self: end; transition: transform 0.25s cubic-bezier(.22,1,.36,1); font-family: 'JetBrains Mono', monospace; line-height: 1; }
  details[open] .sl-faq__icon { transform: rotate(45deg); }
  details[open] .sl-faq__q-text { color: var(--color-accent); }
  .sl-faq__a { font-size: 15px; line-height: 1.7; color: var(--color-muted); padding: 0 0 20px 44px; margin: 0; }

  .sl-final { padding: 40px 0 120px; }
  .sl-final__inner { padding: 56px 48px; border-radius: 20px; text-align: center; }
  .sl-final__h2 { font-family: 'Unbounded', sans-serif; font-size: clamp(26px, 3vw, 40px); font-weight: 500; letter-spacing: -0.02em; margin: 0 0 16px; }
  .sl-final__sub { font-size: 16px; color: var(--color-muted); line-height: 1.6; max-width: 480px; margin: 0 auto 28px; }
  .sl-final__links { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  .sl-final__links a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--color-accent); text-decoration: none; }

  @media (max-width: 900px) {
    .sl-hero { padding: 110px 0 40px; }
    .sl-pains, .sl-formats { grid-template-columns: 1fr; }
    .sl-includes { grid-template-columns: 1fr; }
    .sl-final__inner { padding: 36px 24px; }
  }
  @media (max-width: 480px) {
    .sl-hero__cta { width: 100%; justify-content: center; }
    .sl-faq__a { padding-left: 40px; }
  }
</style>

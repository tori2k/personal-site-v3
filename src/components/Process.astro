---
const steps = [
  {
    n: '01',
    title: 'Разбор',
    time: 'бесплатно',
    desc: 'Смотрю нишу и конкурентов, говорю что нужно.',
    icon: 'search',
  },
  {
    n: '02',
    title: 'Структура',
    time: 'в тот же день',
    desc: 'Собираю оффер и скелет страницы.',
    icon: 'layout',
  },
  {
    n: '03',
    title: 'Сборка',
    time: '1–4 дня',
    desc: 'Живой сайт на тестовом домене с интеграциями.',
    icon: 'code',
  },
  {
    n: '04',
    title: 'Запуск',
    time: '30 мин',
    desc: 'Переношу на ваш домен, передаю исходники.',
    icon: 'rocket',
  },
];

const icons: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  rocket: '<path d="M5 13c0-3 2-7 7-9 5 2 7 6 7 9 0 2-1 4-3 5l-1-3-6 0-1 3c-2-1-3-3-3-5z"/><circle cx="12" cy="9" r="1.5"/>',
};
---
<section class="process section-dark" id="process">
  <div class="container-x">
    <div class="process__head reveal">
      <div class="sec-tag">Как работаю</div>
      <h2 class="display-h">
        Быстро,<br/>
        <em>без хаоса</em>
      </h2>
    </div>

    <div class="process__steps">
      {steps.map((s, i) => (
        <article class="pstep glass reveal" style={`transition-delay: ${i * 0.12}s`}>
          <div class="pstep__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
          </div>
          <div class="pstep__num">{s.n}</div>
          <div class="pstep__body">
            <div class="pstep__meta">
              <h3>{s.title}</h3>
              <span class="pstep__time">{s.time}</span>
            </div>
            <p>{s.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process { padding: 120px 0; }
  .process__head {
    max-width: 720px;
    margin-bottom: 56px;
  }
  /* Шаги — сетка glass-карт */
  .process__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .pstep {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 24px;
    border-radius: 16px;
    transition: transform 0.4s cubic-bezier(.22,1,.36,1), box-shadow 0.4s, border-color 0.4s;
  }
  .pstep:hover {
    transform: translateY(-6px);
    border-color: rgba(139,92,255,0.35);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3), 0 0 50px rgba(139,92,255,0.1), var(--glass-edge);
  }
  .pstep__icon {
    width: 44px; height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(139,92,255,0.1);
    border: 1px solid rgba(139,92,255,0.25);
    color: var(--aurora-cyan);
  }
  .pstep__icon svg { width: 22px; height: 22px; }
  .pstep__num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--color-muted-2);
    letter-spacing: 1px;
  }
  .pstep__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }
  .pstep__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pstep__meta h3 {
    font-family: 'Unbounded', sans-serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .pstep__time {
    align-self: flex-start;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--aurora-cyan);
    padding: 4px 10px;
    border: 1px solid rgba(139,92,255,0.25);
    border-radius: 999px;
  }
  .pstep__body p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .process { padding: 72px 0; }
    .process__steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .process__steps { grid-template-columns: 1fr; }
  }
</style>

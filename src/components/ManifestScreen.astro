---
// Блок-манифест (экран 2, как теплокарта у ТЕПЛЕЕ):
// амбиентное видео в фоне (screen-блендинг, перекрашено в фиолет, бесшовно тает в фон) + крупный манифест.
---
<section class="manifest section-dark" id="manifest">
  <div class="manifest__bg" aria-hidden="true">
    <video class="manifest__video" autoplay muted loop playsinline preload="metadata">
      <source src="/ambient.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="container-x manifest__inner">
    <p class="manifest__text reveal">
      Заявка не должна <em>умирать после клика.</em> Собираю систему,
      которая ловит каждый лид и доводит его до вас — в Telegram, в CRM, к продаже.
    </p>
  </div>
</section>

<style>
  .manifest {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .manifest__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .manifest__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: screen;
    opacity: 0.92;
    /* тёмно-фиолетовое свечение: приглушаем яркость + тянем оттенок в глубокий violet */
    filter: brightness(0.58) contrast(1.12) saturate(1.2) hue-rotate(-24deg);
    /* одна вертикальная маска — как в ТЕПЛЕЕ: гаснет в ноль сверху и снизу */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 80%, transparent 100%);
  }

  .manifest__inner {
    position: relative;
    z-index: 1;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22vh 0 24vh;
    text-align: center;
  }
  .manifest__text {
    max-width: 980px;
    font-family: 'Unbounded', sans-serif;
    font-weight: 400;
    font-size: clamp(22px, 3.4vw, 46px);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--color-text);
    /* мягкая подложка за текстом для читаемости */
    text-shadow: 0 2px 30px rgba(10,7,18,0.9), 0 0 60px rgba(10,7,18,0.8);
  }
  .manifest__text em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent);
    text-shadow: 0 0 50px rgba(139,92,255,0.5);
  }

  @media (max-width: 900px) {
    .manifest__inner { min-height: 64vh; padding: 16vh 0 18vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .manifest__video { display: none; }
    .manifest { background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(139,92,255,0.14), transparent 70%); }
  }
</style>

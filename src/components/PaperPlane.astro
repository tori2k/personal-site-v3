---
---
<div class="plane-layer" id="planeLayer" aria-hidden="true">
  <div id="planeSparks"></div>
  <div id="planeTrail"></div>
  <div class="plane-caption" id="planeCaption"></div>

  <div class="plane-craft" id="planeCraft">
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
      <path d="M46 24 L6 10 L24 24 Z" fill="#AEE2FF"/>
      <path d="M46 24 L6 38 L24 24 Z" fill="#5AA3DC"/>
      <path d="M24 24 L6 10 L9 24 Z" fill="#7CC3F0"/>
      <path d="M24 24 L6 38 L9 24 Z" fill="#3F8BC6"/>
      <path d="M46 24 L8 24" stroke="#EAF6FF" stroke-width="1" opacity="0.55" stroke-linecap="round"/>
    </svg>
  </div>
</div>

<style>
  .plane-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 500;
  }

  .plane-craft {
    position: absolute;
    top: 0; left: 0;
    --ps: 68px;
    width: var(--ps); height: var(--ps);
    margin: calc(var(--ps) / -2) 0 0 calc(var(--ps) / -2);
    pointer-events: none;
    will-change: transform, filter, opacity;
    transform-origin: 50% 50%;
  }
  .plane-craft svg { width: 100%; height: 100%; display: block; }

  @media (min-width: 1600px) { .plane-craft { --ps: 82px; } }
  @media (max-width: 1024px) { .plane-craft { --ps: 56px; } }
  @media (max-width: 700px)  { .plane-craft { --ps: 44px; } }
  @media (max-width: 440px)  { .plane-craft { --ps: 36px; } }

  /* Trail dots */
  .plane-trail-dot {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
  }

  /* Sparks */
  .plane-spark {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
  }

  /* Caption */
  .plane-caption {
    position: absolute;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(95, 198, 255, 0.75);
    pointer-events: none;
    opacity: 0;
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(95,198,255,0.4);
    transition: opacity 0.3s;
  }

  @media (max-width: 768px) {
    .plane-caption { display: none; }
  }
</style>

<script>
  const craft = document.getElementById('planeCraft') as HTMLElement | null;
  const sparksWrap = document.getElementById('planeSparks') as HTMLElement | null;
  const trailWrap = document.getElementById('planeTrail') as HTMLElement | null;
  const captionEl = document.getElementById('planeCaption') as HTMLElement | null;

  if (!craft || !sparksWrap || !trailWrap) { /* skip */ } else {

  const isMobile = window.innerWidth <= 768;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Контрольные точки маршрута ──────────────────────────────────────────
  // x,y в долях viewport; z: 0=задний, 1=передний; spark: взрыв искр
  type WP = {
    p: number; x: number; y: number; z: number;
    spark?: boolean; caption?: string;
  };

  const TRACK: WP[] = isMobile ? [
    // Упрощённая мобильная траектория
    { p: 0.00, x: 0.72, y: 0.38, z: 1.0 },
    { p: 0.25, x: 0.30, y: 0.50, z: 0.3 },
    { p: 0.50, x: 0.65, y: 0.48, z: 0.9 },
    { p: 0.75, x: 0.35, y: 0.52, z: 0.4 },
    { p: 1.00, x: 0.50, y: 0.55, z: 1.0 },
  ] : [
    // hero: старт справа
    { p: 0.00, x: 0.76, y: 0.40, z: 1.0,  caption: 'старт' },
    // approach: сайт
    { p: 0.10, x: 0.55, y: 0.50, z: 0.85, caption: 'сайт' },
    // forwhom: уходит за блок
    { p: 0.20, x: 0.22, y: 0.48, z: 0.25, spark: false },
    // flowblock: вылетает — квиз
    { p: 0.30, x: 0.72, y: 0.44, z: 0.95, spark: true, caption: 'квиз' },
    // portfolio: ныряет за кейс
    { p: 0.38, x: 0.18, y: 0.52, z: 0.20 },
    // portfolio: вылет из кейса
    { p: 0.46, x: 0.80, y: 0.46, z: 1.0,  spark: true, caption: 'Telegram' },
    // method: левая дуга
    { p: 0.55, x: 0.28, y: 0.50, z: 0.65, caption: 'метод' },
    // pricing: правая дуга — за блок
    { p: 0.65, x: 0.74, y: 0.48, z: 0.35, caption: 'пакет' },
    // faq: выныривает
    { p: 0.76, x: 0.30, y: 0.46, z: 0.80, spark: true },
    // final подлёт
    { p: 0.88, x: 0.62, y: 0.50, z: 0.90, caption: 'разбор' },
    // посадка
    { p: 1.00, x: 0.50, y: 0.54, z: 1.1,  spark: true, caption: 'заявка доставлена' },
  ];

  const N = TRACK.length;

  // ── Catmull-Rom ──────────────────────────────────────────────────────────
  function cr(p0: number, p1: number, p2: number, p3: number, t: number): number {
    const t2 = t * t, t3 = t2 * t;
    return 0.5 * ((2*p1) + (-p0+p2)*t + (2*p0-5*p1+4*p2-p3)*t2 + (-p0+3*p1-3*p2+p3)*t3);
  }

  function sampleAt(prog: number): { x: number; y: number; z: number } {
    const clamped = Math.max(0, Math.min(1, prog));
    let seg = N - 2;
    for (let i = 0; i < N - 1; i++) {
      if (clamped <= TRACK[i+1].p) { seg = i; break; }
    }
    const a = TRACK[seg], b = TRACK[seg+1];
    const t = (clamped - a.p) / Math.max(0.0001, b.p - a.p);
    const p0 = TRACK[Math.max(0, seg-1)];
    const p3 = TRACK[Math.min(N-1, seg+2)];
    return {
      x: cr(p0.x, a.x, b.x, p3.x, t),
      y: cr(p0.y, a.y, b.y, p3.y, t),
      z: cr(p0.z, a.z, b.z, p3.z, t),
    };
  }

  // ── DOM кэш ─────────────────────────────────────────────────────────────
  const startAnchor = document.getElementById('planeAnchor') as HTMLElement | null;
  const targetBtn   = document.getElementById('planeTarget') as HTMLElement | null;
  const flowSteps   = Array.from(document.querySelectorAll<HTMLElement>('.flow__step'));
  // flowblock section для определения прогресса
  const flowSection = document.getElementById('flow');

  // Пересчитываем позиции секций на resize/load
  let sectionsCache: { id: string; top: number; bottom: number }[] = [];
  function cacheSections() {
    const ids = ['hero','about','forwhom','flow','work','method','pricing','faq','contact'];
    const scrollY = window.scrollY;
    sectionsCache = ids.map(id => {
      const el = document.getElementById(id);
      if (!el) return { id, top: 0, bottom: 0 };
      const r = el.getBoundingClientRect();
      return { id, top: r.top + scrollY, bottom: r.bottom + scrollY };
    });
  }
  cacheSections();
  window.addEventListener('resize', cacheSections, { passive: true });

  // ── Trail пул ─────────────────────────────────────────────────────────
  const TRAIL_LEN = isMobile ? 5 : 10;
  const trailEls: HTMLElement[] = [];
  for (let i = 0; i < TRAIL_LEN; i++) {
    const d = document.createElement('div');
    d.className = 'plane-trail-dot';
    const sz = 3 + (TRAIL_LEN - i) * 0.4;
    d.style.cssText = `width:${sz}px;height:${sz}px;background:radial-gradient(circle,#BFE8FF,rgba(95,198,255,0.3) 60%,transparent)`;
    trailWrap.appendChild(d);
    trailEls.push(d);
  }
  // Буфер истории позиций для trail
  type Pos = { x: number; y: number; z: number };
  const trailHistory: Pos[] = Array(TRAIL_LEN).fill({ x: -999, y: -999, z: 0 });
  let trailHistIdx = 0;

  function updateTrail(cx: number, cy: number, cz: number) {
    trailHistory[trailHistIdx] = { x: cx, y: cy, z: cz };
    trailHistIdx = (trailHistIdx + 1) % TRAIL_LEN;

    for (let i = 0; i < TRAIL_LEN; i++) {
      const age = ((trailHistIdx - 1 - i + TRAIL_LEN) % TRAIL_LEN);
      const pos = trailHistory[(trailHistIdx - 1 - i + TRAIL_LEN) % TRAIL_LEN];
      const d = trailEls[i];
      const fade = (1 - age / TRAIL_LEN);
      const depthScale = 0.4 + pos.z * 0.6;
      const frontOpacity = pos.z > 0.5 ? 0.55 : 0.18;
      d.style.transform = `translate(${pos.x}px, ${pos.y}px) scale(${depthScale * (1 - age/TRAIL_LEN * 0.5)})`;
      d.style.opacity = String((fade * frontOpacity).toFixed(3));
    }
  }

  // ── Искры пул ──────────────────────────────────────────────────────────
  const SPARK_COUNT = isMobile ? 6 : 14;
  const sparkEls: HTMLElement[] = [];
  let sparkIdx = 0;
  const SPARK_COLORS = ['#7ccfff','#ffffff','#b9ecff','#AEE2FF'];
  for (let i = 0; i < SPARK_COUNT; i++) {
    const s = document.createElement('div');
    s.className = 'plane-spark';
    const sz = 2 + Math.random() * 3;
    s.style.cssText = `width:${sz}px;height:${sz}px;background:${SPARK_COLORS[i % SPARK_COLORS.length]}`;
    sparksWrap.appendChild(s);
    sparkEls.push(s);
  }

  // Псевдослучайное число детерминированное (не Math.random — не меняется между кадрами)
  function pseudo(n: number): number {
    const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
    return x - Math.floor(x);
  }

  function burstSparks(cx: number, cy: number, count: number, seed: number) {
    for (let i = 0; i < count; i++) {
      const s = sparkEls[sparkIdx % SPARK_COUNT];
      sparkIdx++;
      const angle = pseudo(seed + i * 0.37) * Math.PI * 2;
      const dist = 12 + pseudo(seed + i * 0.71) * 28;
      const tx = cx + Math.cos(angle) * dist;
      const ty = cy + Math.sin(angle) * dist;
      s.style.transition = 'none';
      s.style.transform = `translate(${cx}px, ${cy}px) scale(1)`;
      s.style.opacity = '0.9';
      requestAnimationFrame(() => {
        s.style.transition = `transform ${500 + pseudo(seed+i)*400}ms cubic-bezier(.22,1,.36,1), opacity ${600 + pseudo(seed+i*1.3)*300}ms ease-out`;
        s.style.transform = `translate(${tx}px, ${ty}px) scale(0.1)`;
        s.style.opacity = '0';
      });
    }
  }

  // ── Caption ──────────────────────────────────────────────────────────────
  let captionTimer = 0;
  function showCaption(text: string, x: number, y: number) {
    if (!captionEl || isMobile) return;
    captionEl.textContent = text;
    captionEl.style.left = `${x + 18}px`;
    captionEl.style.top  = `${y - 14}px`;
    captionEl.style.opacity = '1';
    clearTimeout(captionTimer);
    captionTimer = window.setTimeout(() => {
      if (captionEl) captionEl.style.opacity = '0';
    }, 900);
  }

  // ── Подсветка шагов FlowBlock ─────────────────────────────────────────
  let lastLitStep = -1;
  function lightFlowStep(idx: number) {
    if (idx === lastLitStep) return;
    flowSteps.forEach((s, i) => {
      if (i === idx) {
        s.style.borderColor = 'rgba(95,198,255,0.55)';
        s.style.boxShadow = '0 0 18px rgba(95,198,255,0.18)';
        s.style.transition = 'border-color 0.3s, box-shadow 0.3s';
      } else {
        s.style.borderColor = '';
        s.style.boxShadow = '';
      }
    });
    lastLitStep = idx;
  }

  // ── Подсветка кнопки при посадке ─────────────────────────────────────
  function glowBtn(intensity: number) {
    if (!targetBtn) return;
    if (intensity > 0) {
      targetBtn.style.boxShadow = `0 0 ${40*intensity}px rgba(95,198,255,${0.5*intensity}), 0 0 ${80*intensity}px rgba(95,198,255,${0.25*intensity})`;
    } else {
      targetBtn.style.boxShadow = '';
    }
  }

  // ── Основная функция позиции ──────────────────────────────────────────
  const START_END  = 0.07;
  const LAND_START = 0.90;

  function getPos(prog: number): { x: number; y: number; z: number } {
    const s = sampleAt(prog);
    let x = s.x * window.innerWidth;
    let y = s.y * window.innerHeight;
    let z = Math.max(0, Math.min(1.2, s.z));

    // Привязка к якорю старта
    const ac = startAnchor ? (() => {
      const r = startAnchor.getBoundingClientRect();
      return r.width ? { x: r.left + r.width/2, y: r.top + r.height/2 } : null;
    })() : null;
    if (prog < START_END && ac) {
      const k = prog / START_END;
      const e = k*k*(3-2*k);
      x = ac.x + (x - ac.x) * e;
      y = ac.y + (y - ac.y) * e;
    }

    // Мягкий подлёт к кнопке
    if (prog > LAND_START && targetBtn) {
      const r = targetBtn.getBoundingClientRect();
      const bx = r.left + r.width/2;
      const by = r.top + r.height/2;
      const k = (prog - LAND_START) / (1 - LAND_START);
      const e = k*k*(3-2*k);
      x = x + (bx - x) * e;
      y = y + (by - y) * e;
      z = z + (1.1 - z) * e * 0.7;
    }

    // Клампинг — не выходить за края
    const pad = isMobile ? 20 : 32;
    x = Math.max(pad, Math.min(window.innerWidth - pad, x));
    y = Math.max(pad, Math.min(window.innerHeight - pad, y));
    return { x, y, z };
  }

  // ── Состояние ────────────────────────────────────────────────────────
  let shown = 0, target = 0, prevShown = 0;
  let rafId = 0;
  let frame = 0;

  // Пороги для искр и капшнов — отслеживаем пересечение
  const sparkThresholds = TRACK
    .filter(wp => wp.spark)
    .map(wp => ({ p: wp.p, fired: false }));
  const captionThresholds = TRACK
    .filter(wp => wp.caption)
    .map(wp => ({ p: wp.p, caption: wp.caption!, fired: false, cooldown: 0 }));

  function checkThresholds(prev: number, cur: number, x: number, y: number) {
    sparkThresholds.forEach(t => {
      const crossed = (prev < t.p && cur >= t.p) || (prev > t.p && cur <= t.p);
      if (crossed) {
        burstSparks(x, y, isMobile ? 3 : 6, t.p * 100 + frame);
        t.fired = true;
      }
    });
    captionThresholds.forEach(t => {
      const crossed = Math.abs(cur - t.p) < 0.012 && frame > t.cooldown;
      if (crossed) {
        showCaption(t.caption, x, y);
        t.cooldown = frame + 60;
      }
    });
  }

  // Подсветка шагов FlowBlock по прогрессу
  function handleFlowHighlight(prog: number, cx: number, cy: number) {
    if (!flowSection || flowSteps.length === 0) return;
    const scrollY = window.scrollY;
    const fRect = flowSection.getBoundingClientRect();
    const fTop = fRect.top + scrollY;
    const fBot = fRect.bottom + scrollY;
    const inFlow = scrollY + window.innerHeight * 0.5 > fTop &&
                   scrollY + window.innerHeight * 0.5 < fBot;
    if (!inFlow) { lightFlowStep(-1); return; }
    const localP = (scrollY + window.innerHeight*0.5 - fTop) / Math.max(1, fBot - fTop);
    const idx = Math.min(flowSteps.length - 1, Math.floor(localP * flowSteps.length));
    lightFlowStep(idx);
  }

  // ── Главный render ────────────────────────────────────────────────────
  function render(prog: number) {
    frame++;
    const pos = getPos(prog);
    const posAhead = getPos(Math.min(1, prog + 0.014));
    const z = Math.max(0, Math.min(1.2, pos.z));

    // Скорость (для motion blur)
    const spd = Math.hypot(pos.x - getPos(Math.max(0, prog - 0.01)).x,
                           pos.y - getPos(Math.max(0, prog - 0.01)).y);
    const motionBlur = Math.min(1.8, spd * 0.08);

    // Угол по направлению
    const dx = posAhead.x - pos.x;
    const dy = posAhead.y - pos.y;
    let angle = Math.atan2(dy, dx) * 180 / Math.PI;
    // Плавный старт горизонтально
    if (prog < START_END) {
      const e = (prog / START_END) ** 2;
      angle = angle * e;
    }
    // Покачивание
    const wobble = (Math.sin(frame * 0.055) * 2.5 + Math.cos(frame * 0.083) * 1.1)
                   * Math.min(1, prog / START_END);
    const bank = Math.atan2(dy, Math.abs(dx) + 0.01) * 8; // лёгкий крен в виражах

    // Масштаб: спереди крупнее, сзади мельче
    const suck = prog > 0.97 ? ((prog - 0.97) / 0.03) ** 2 : 0;
    const depthScale = isMobile
      ? (0.70 + z * 0.30) * (1 - suck)
      : (0.55 + z * 0.60) * (1 - suck);

    // Opacity
    const opacity = z > 0.5
      ? (0.88 + z * 0.12) * (1 - suck)
      : (0.20 + z * 0.35) * (1 - suck);

    // Glow / drop-shadow
    const glowStr = z > 0.5
      ? `drop-shadow(0 3px ${8 + z*14}px rgba(95,198,255,${0.3 + z*0.35}))`
      : `drop-shadow(0 2px 6px rgba(95,198,255,0.12))`;
    const blurStr = motionBlur > 0.15 ? ` blur(${motionBlur.toFixed(2)}px)` : '';

    craft.style.transform = `translate(${pos.x}px,${pos.y}px) rotate(${angle + wobble}deg) rotateY(${bank}deg) scale(${depthScale})`;
    craft.style.filter = `${glowStr}${blurStr}`;
    craft.style.opacity = opacity.toFixed(3);

    // Trail
    updateTrail(pos.x, pos.y, z);

    // Проверка порогов
    checkThresholds(prevShown, prog, pos.x, pos.y);

    // Подсветка FlowBlock
    handleFlowHighlight(prog, pos.x, pos.y);

    // Glow кнопки при посадке
    if (prog > 0.88) {
      const k = Math.max(0, (prog - 0.88) / 0.12);
      glowBtn(k > 0.5 ? (1 - k) * 2 : k * 2);
    } else {
      glowBtn(0);
    }

    prevShown = prog;
  }

  // ── Цикл ─────────────────────────────────────────────────────────────
  if (reduceMotion) {
    // Статика у CTA
    const pos = getPos(1);
    craft.style.transform = `translate(${pos.x + 60}px,${pos.y - 20}px) rotate(-20deg) scale(0.6)`;
    craft.style.opacity = '0.4';
    craft.style.filter = 'drop-shadow(0 2px 6px rgba(95,198,255,0.2))';
  } else {
    const lerp = 0.10; // инерция прогресса
    let idleRaf = 0;

    const loop = () => {
      shown += (target - shown) * lerp;
      render(shown);
      if (Math.abs(target - shown) > 0.0002) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = 0;
      }
    };

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      target = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (!rafId) rafId = requestAnimationFrame(loop);
    };

    // Idle: покачивание без скролла
    const idleLoop = () => {
      if (!rafId && Math.abs(target - shown) < 0.0002) render(shown);
      idleRaf = requestAnimationFrame(idleLoop);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      cacheSections();
      onScroll();
    }, { passive: true });

    onScroll();
    idleRaf = requestAnimationFrame(idleLoop);
  }

  } // end if craft
</script>

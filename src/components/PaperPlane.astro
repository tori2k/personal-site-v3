---
---
<!--
  Бумажный самолётик — signature motion сайта.
  Символизирует маршрут заявки: контент → сайт → квиз → Telegram → CRM.
  S-образная траектория с пикированиями (y меняется на 25–40% vh).
  Глубина: scale + opacity + blur + glow.
  Без текстовых подписей.
-->
<div class="plane-layer" id="planeLayer" aria-hidden="true">
  <div id="planeSparks"></div>
  <div id="planeTrail"></div>

  <div class="plane-craft" id="planeCraft">
    <!--
      Самолётик вид сверху. Нос справа (x=46, y=24).
      Улучшенный SVG: градиент, внутренний объём, мягкая подсветка сгиба.
    -->
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Верхнее крыло: светлый градиент от носа к хвосту -->
        <linearGradient id="wingTop" x1="53" y1="14" x2="7" y2="28" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#D6F0FF"/>
          <stop offset="60%" stop-color="#AEE2FF"/>
          <stop offset="100%" stop-color="#7CC3F0" stop-opacity="0.7"/>
        </linearGradient>
        <!-- Нижнее крыло: тень -->
        <linearGradient id="wingBot" x1="53" y1="42" x2="7" y2="28" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#5AA3DC"/>
          <stop offset="100%" stop-color="#3A7AB8" stop-opacity="0.6"/>
        </linearGradient>
        <!-- Световой блик на носу -->
        <radialGradient id="noseTip" cx="0.85" cy="0.5" r="0.3">
          <stop offset="0%" stop-color="#EAFAFF" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#7CC3F0" stop-opacity="0"/>
        </radialGradient>
        <!-- Glow-filter для переднего плана -->
        <filter id="planeGlow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="blur"/>
          <feComposite in="blur" in2="SourceGraphic" operator="over"/>
        </filter>
      </defs>

      <!-- Верхнее крыло -->
      <path d="M53 28 L7 11 L28 28 Z" fill="url(#wingTop)"/>
      <!-- Нижнее крыло -->
      <path d="M53 28 L7 45 L28 28 Z" fill="url(#wingBot)"/>
      <!-- Верхняя фаска (объём у сгиба) -->
      <path d="M28 28 L7 11 L10.5 28 Z" fill="#A8D8F0" opacity="0.85"/>
      <!-- Нижняя фаска -->
      <path d="M28 28 L7 45 L10.5 28 Z" fill="#3A80C0" opacity="0.70"/>
      <!-- Центральный сгиб — светлый блик -->
      <path d="M53 28 L9.5 28" stroke="#EAF6FF" stroke-width="0.8" opacity="0.50" stroke-linecap="round"/>
      <!-- Световой акцент у носа -->
      <ellipse cx="46" cy="25" rx="5" ry="3" fill="url(#noseTip)" opacity="0.6" transform="rotate(-8 46 25)"/>
    </svg>
  </div>
</div>

<style>
  /* Слой поверх всего — z-index 500, backdrop-filter на .glass не мешает т.к.
     содержащий блок = фиксированный viewport (inset:0). */
  .plane-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 500;
  }

  .plane-craft {
    position: absolute;
    top: 0; left: 0;
    --ps: 64px;
    width: var(--ps); height: var(--ps);
    margin: calc(var(--ps) / -2) 0 0 calc(var(--ps) / -2);
    pointer-events: none;
    will-change: transform, filter, opacity;
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
  }
  .plane-craft svg { width: 100%; height: 100%; display: block; }

  @media (min-width: 1600px) { .plane-craft { --ps: 78px; } }
  @media (max-width: 1024px) { .plane-craft { --ps: 54px; } }
  @media (max-width: 700px)  { .plane-craft { --ps: 40px; } }
  @media (max-width: 440px)  { .plane-craft { --ps: 34px; } }

  .plane-trail-dot {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
    top: 0; left: 0;
  }

  .plane-spark {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
    top: 0; left: 0;
  }
</style>

<script>
  const craft     = document.getElementById('planeCraft')  as HTMLElement | null;
  const sparksEl  = document.getElementById('planeSparks') as HTMLElement | null;
  const trailEl   = document.getElementById('planeTrail')  as HTMLElement | null;

  if (!craft || !sparksEl || !trailEl) { /* guard */ } else {

  const isMobile    = () => window.innerWidth <= 768;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ══════════════════════════════════════════════════════════════════════
  //  ТРАЕКТОРИЯ
  //  x, y — доли вьюпорта (0..1). y МЕНЯЕТСЯ СИЛЬНО: S-образная кривая.
  //  z — глубина: 0 = задний план (мелко, тускло), 1 = передний (ярко, крупно)
  //  spark — короткий burst при пересечении точки
  // ══════════════════════════════════════════════════════════════════════
  type WP = { p: number; x: number; y: number; z: number; spark?: true };

  // Desktop: S-образная траектория с пикированиями на 25–40% vh
  const DESKTOP_TRACK: WP[] = [
    // Hero — старт справа вверху
    { p: 0.00, x: 0.78, y: 0.28, z: 1.00 },
    // Approach — пикирует вниз-влево
    { p: 0.10, x: 0.38, y: 0.68, z: 0.80 },
    // ForWhom — выныривает вправо-вверх
    { p: 0.20, x: 0.74, y: 0.30, z: 0.92 },
    // FlowBlock — ныряет влево вниз (за блоки)
    { p: 0.29, x: 0.16, y: 0.72, z: 0.20 },
    // Portfolio enter — вылет вправо вперёд (искры)
    { p: 0.38, x: 0.82, y: 0.32, z: 1.00, spark: true },
    // Portfolio behind — ныряет за карточку
    { p: 0.45, x: 0.22, y: 0.65, z: 0.15 },
    // Portfolio exit — вылет (искры)
    { p: 0.52, x: 0.76, y: 0.25, z: 1.00, spark: true },
    // Method — пикирует влево вниз
    { p: 0.61, x: 0.24, y: 0.70, z: 0.65 },
    // Pricing — вираж вправо вверх
    { p: 0.70, x: 0.78, y: 0.28, z: 0.88 },
    // FAQ — ныряет влево вниз
    { p: 0.79, x: 0.20, y: 0.66, z: 0.45 },
    // Final подлёт — вправо к центру вверх
    { p: 0.88, x: 0.65, y: 0.38, z: 0.95 },
    // Посадка (искры)
    { p: 1.00, x: 0.50, y: 0.52, z: 1.10, spark: true },
  ];

  // Mobile: упрощённая — только три волны, y меняется на 25%
  const MOBILE_TRACK: WP[] = [
    { p: 0.00, x: 0.72, y: 0.25, z: 0.90 },
    { p: 0.25, x: 0.25, y: 0.65, z: 0.35 },
    { p: 0.50, x: 0.68, y: 0.28, z: 0.85 },
    { p: 0.75, x: 0.28, y: 0.68, z: 0.40 },
    { p: 1.00, x: 0.50, y: 0.50, z: 1.00 },
  ];

  function getTrack(): WP[] { return isMobile() ? MOBILE_TRACK : DESKTOP_TRACK; }
  let TRACK = getTrack();

  // ══════════════════════════════════════════════════════════════════════
  //  CATMULL-ROM СПЛАЙН
  // ══════════════════════════════════════════════════════════════════════
  function cr(p0: number, p1: number, p2: number, p3: number, t: number): number {
    const t2 = t*t, t3 = t2*t;
    return 0.5*((2*p1)+(-p0+p2)*t+(2*p0-5*p1+4*p2-p3)*t2+(-p0+3*p1-3*p2+p3)*t3);
  }

  function sample(prog: number): { x: number; y: number; z: number } {
    const T  = TRACK;
    const N  = T.length;
    const c  = Math.max(0, Math.min(1, prog));
    let   seg = N - 2;
    for (let i = 0; i < N-1; i++) { if (c <= T[i+1].p) { seg = i; break; } }
    const a  = T[seg], b = T[seg+1];
    const t  = (c - a.p) / Math.max(1e-5, b.p - a.p);
    const p0 = T[Math.max(0,   seg-1)];
    const p3 = T[Math.min(N-1, seg+2)];
    return {
      x: cr(p0.x, a.x, b.x, p3.x, t),
      y: cr(p0.y, a.y, b.y, p3.y, t),
      z: cr(p0.z, a.z, b.z, p3.z, t),
    };
  }

  // ══════════════════════════════════════════════════════════════════════
  //  DOM-кэш
  // ══════════════════════════════════════════════════════════════════════
  const anchorEl  = document.getElementById('planeAnchor')  as HTMLElement | null;
  const targetBtn = document.getElementById('planeTarget')   as HTMLElement | null;

  const START_END  = 0.06;  // якорь старта
  const LAND_START = 0.88;  // начало мягкого подлёта к кнопке

  function getXY(prog: number): { x: number; y: number; z: number } {
    const s = sample(prog);
    let x = s.x * window.innerWidth;
    let y = s.y * window.innerHeight;
    let z = Math.max(0, Math.min(1.2, s.z));

    // Привязка к якорю старта
    if (prog < START_END && anchorEl) {
      const r = anchorEl.getBoundingClientRect();
      if (r.width) {
        const e = (prog / START_END) ** 2;
        x = (r.left + r.width/2)  + (x - (r.left + r.width/2))  * e;
        y = (r.top  + r.height/2) + (y - (r.top  + r.height/2)) * e;
      }
    }

    // Подлёт к кнопке
    if (prog > LAND_START && targetBtn) {
      const r = targetBtn.getBoundingClientRect();
      const bx = r.left + r.width/2, by = r.top + r.height/2;
      const k  = (prog - LAND_START) / (1 - LAND_START);
      const e  = k*k*(3-2*k);
      x = x + (bx - x) * e;
      y = y + (by - y) * e;
      z = z + (1.1 - z) * e * 0.8;
    }

    const pad = isMobile() ? 18 : 28;
    return {
      x: Math.max(pad, Math.min(window.innerWidth - pad, x)),
      y: Math.max(pad, Math.min(window.innerHeight - pad, y)),
      z,
    };
  }

  // ══════════════════════════════════════════════════════════════════════
  //  TRAIL — 12 фейдящих точек
  // ══════════════════════════════════════════════════════════════════════
  const TLEN = isMobile() ? 6 : 12;
  const tDots: HTMLElement[] = [];
  type TPos = { x: number; y: number; z: number };
  const tHist: TPos[] = Array.from({length: TLEN}, () => ({x:-999,y:-999,z:0}));
  let   tIdx  = 0;

  for (let i = 0; i < TLEN; i++) {
    const d  = document.createElement('div');
    d.className = 'plane-trail-dot';
    const sz = 2.5 + (TLEN - i) * 0.35;
    d.style.cssText = `width:${sz}px;height:${sz}px;` +
      `background:radial-gradient(circle,#C8E8FF,rgba(95,198,255,0.25) 55%,transparent);` +
      `margin:-${sz/2}px 0 0 -${sz/2}px`;
    trailEl.appendChild(d);
    tDots.push(d);
  }

  function tickTrail(cx: number, cy: number, cz: number) {
    tHist[tIdx] = { x: cx, y: cy, z: cz };
    tIdx = (tIdx + 1) % TLEN;
    for (let i = 0; i < TLEN; i++) {
      const age = (tIdx - 1 - i + TLEN) % TLEN;       // 0=новейший
      const pos = tHist[(tIdx - 1 - i + TLEN) % TLEN];
      const d   = tDots[i];
      const fade    = 1 - age / TLEN;
      const depth   = 0.3 + pos.z * 0.7;
      const maxOp   = pos.z > 0.5 ? 0.45 : 0.12;      // на заднем плане почти нет
      d.style.transform = `translate(${pos.x}px,${pos.y}px) scale(${depth*(1-age/TLEN*0.4)})`;
      d.style.opacity   = (fade * maxOp).toFixed(3);
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  //  ИСКРЫ — пул 16 элементов
  // ══════════════════════════════════════════════════════════════════════
  const SMAX = isMobile() ? 8 : 16;
  const sEls: HTMLElement[] = [];
  let   sIdx = 0;
  const SCOLS = ['#8ED8FF','#FFFFFF','#B9ECFF','#C4E8FF'];

  // Детерминированный pseudo-random
  function prng(n: number): number {
    const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
    return x - Math.floor(x);
  }

  for (let i = 0; i < SMAX; i++) {
    const s  = document.createElement('div');
    s.className = 'plane-spark';
    const sz = 1.5 + prng(i*7.3) * 3;
    s.style.cssText = `width:${sz}px;height:${sz}px;` +
      `background:${SCOLS[i % SCOLS.length]};` +
      `margin:-${sz/2}px 0 0 -${sz/2}px`;
    sparksEl.appendChild(s);
    sEls.push(s);
  }

  function burst(cx: number, cy: number, count: number, seed: number) {
    for (let i = 0; i < count; i++) {
      const s     = sEls[sIdx % SMAX]; sIdx++;
      const angle = prng(seed + i * 0.37) * Math.PI * 2;
      const dist  = 10 + prng(seed + i * 0.71) * 32;
      const tx    = cx + Math.cos(angle) * dist;
      const ty    = cy + Math.sin(angle) * dist;
      const dur   = 500 + prng(seed + i) * 400;
      s.style.cssText += `;transition:none;transform:translate(${cx}px,${cy}px) scale(1);opacity:0.9`;
      requestAnimationFrame(() => {
        s.style.transition = `transform ${dur}ms cubic-bezier(.2,.8,.4,1), opacity ${dur+100}ms ease-out`;
        s.style.transform  = `translate(${tx}px,${ty}px) scale(0.08)`;
        s.style.opacity    = '0';
      });
    }
  }

  // ══════════════════════════════════════════════════════════════════════
  //  ПОДСВЕТКА КНОПКИ
  // ══════════════════════════════════════════════════════════════════════
  function glowBtn(k: number) {
    if (!targetBtn) return;
    targetBtn.style.boxShadow = k > 0
      ? `0 0 ${36*k}px rgba(95,198,255,${0.45*k}),0 0 ${72*k}px rgba(95,198,255,${0.2*k})`
      : '';
  }

  // ══════════════════════════════════════════════════════════════════════
  //  ПОРОГИ (искры при пересечении прогресса)
  // ══════════════════════════════════════════════════════════════════════
  const thresholds = DESKTOP_TRACK
    .filter(wp => wp.spark)
    .map(wp => ({ p: wp.p, cooldown: 0 }));

  function checkSparks(prev: number, cur: number, x: number, y: number, fr: number) {
    thresholds.forEach(t => {
      if (fr < t.cooldown) return;
      const crossed = (prev < t.p && cur >= t.p) || (prev > t.p && cur <= t.p);
      if (crossed) {
        burst(x, y, isMobile() ? 4 : 7, t.p * 1000 + fr);
        t.cooldown = fr + 45;
      }
    });
  }

  // ══════════════════════════════════════════════════════════════════════
  //  RENDER
  // ══════════════════════════════════════════════════════════════════════
  let shown = 0, target = 0, prev = 0;
  let rafId = 0, fr = 0;

  function render(prog: number) {
    fr++;
    const pos   = getXY(prog);
    const fwd   = getXY(Math.min(1, prog + 0.013));
    const back  = getXY(Math.max(0, prog - 0.011));
    const z     = Math.max(0, Math.min(1.2, pos.z));

    // ── Угол: нос смотрит по направлению полёта ──
    const dx = fwd.x - pos.x;
    const dy = fwd.y - pos.y;
    let   angle = Math.atan2(dy, dx) * 180 / Math.PI;
    if (prog < START_END) angle *= (prog / START_END) ** 1.5;

    // Покачивание (живое парение)
    const wobble = Math.sin(fr * 0.052) * 2.8 + Math.cos(fr * 0.079) * 1.2;
    const damp   = Math.min(1, prog / START_END);

    // Крен в поворотах (bank angle — illusion depth)
    const curvature = Math.atan2(dy, Math.abs(dx) + 0.01);
    const bank = curvature * 10;

    // ── Масштаб по глубине ──
    // front (z≈1): scale ~1.1, back (z≈0): scale ~0.5 → ×2.2 разница
    const suck = prog > 0.97 ? ((prog - 0.97) / 0.03) ** 2 : 0;
    const scaleBase = isMobile() ? (0.65 + z * 0.35) : (0.48 + z * 0.62);
    const scale = scaleBase * (1 - suck);

    // ── Opacity: задний план сильно темнее ──
    const opacity = z > 0.5
      ? (0.85 + z * 0.15) * (1 - suck)
      : (0.18 + z * 0.34) * (1 - suck);

    // ── Motion blur по скорости ──
    const spd = Math.hypot(pos.x - back.x, pos.y - back.y);
    const blur = Math.min(2.2, spd * 0.07);

    // ── Glow: яркий спереди, слабый сзади ──
    const glowR = 6 + z * 16;
    const glowA = z > 0.5 ? 0.28 + z * 0.32 : 0.08;
    const glow  = `drop-shadow(0 ${2+z*3}px ${glowR}px rgba(95,198,255,${glowA.toFixed(2)}))`;
    const blurF = blur > 0.12 ? ` blur(${blur.toFixed(2)}px)` : '';

    craft.style.transform = [
      `translate(${pos.x}px,${pos.y}px)`,
      `rotate(${(angle + wobble * damp).toFixed(2)}deg)`,
      `rotateY(${bank.toFixed(1)}deg)`,
      `scale(${scale.toFixed(3)})`,
    ].join(' ');
    craft.style.filter  = glow + blurF;
    craft.style.opacity = opacity.toFixed(3);

    // Trail
    tickTrail(pos.x, pos.y, z);

    // Искры при пересечении порогов
    checkSparks(prev, prog, pos.x, pos.y, fr);

    // Glow кнопки при посадке
    if (prog > 0.88) {
      const k = (prog - 0.88) / 0.12;
      glowBtn(k < 0.6 ? k / 0.6 : (1 - k) / 0.4);
    } else {
      glowBtn(0);
    }

    prev = prog;
  }

  // ══════════════════════════════════════════════════════════════════════
  //  ЦИКЛ
  // ══════════════════════════════════════════════════════════════════════
  if (reduceMotion) {
    // Статика: самолётик у правого края экрана, небольшой, почти прозрачный
    craft.style.transform = `translate(${window.innerWidth * 0.82}px,${window.innerHeight * 0.3}px) rotate(-15deg) scale(0.55)`;
    craft.style.opacity   = '0.3';
    craft.style.filter    = 'drop-shadow(0 2px 6px rgba(95,198,255,0.15))';
  } else {
    const LERP = 0.09;  // инерция: чем меньше — тем плавнее (но медленнее догоняет)
    let idleRaf = 0;

    const loop = () => {
      shown += (target - shown) * LERP;
      render(shown);
      rafId = Math.abs(target - shown) > 0.0002 ? requestAnimationFrame(loop) : 0;
    };

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      target = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (!rafId) rafId = requestAnimationFrame(loop);
    };

    // Idle rAF: покачивание работает даже без скролла
    const idle = () => {
      if (!rafId && Math.abs(target - shown) < 0.0002) render(shown);
      idleRaf = requestAnimationFrame(idle);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      TRACK = getTrack();
      onScroll();
    }, { passive: true });

    onScroll();
    idleRaf = requestAnimationFrame(idle);
  }

  } // end guard
</script>

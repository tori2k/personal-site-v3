---
const base = import.meta.env.BASE_URL;

const templates = [
  { slug: 'aurora',       num: '01', title: 'Aurora · SaaS',     tag: 'Linear-level',  accent: '#5FC6FF', external: true,  href: 'https://tori2k.github.io/template-aurora/' },
  { slug: '01-premium',   num: '02', title: 'Премиум-минимал',   tag: 'serif · gold',  accent: '#D9B777', external: false },
  { slug: '02-dark-saas', num: '03', title: 'Тёмный SaaS',       tag: 'fin-tech',      accent: '#5FC6FF', external: false },
  { slug: '03-brutalism', num: '04', title: 'Брутализм',         tag: 'Awwwards',      accent: '#FF6EC7', external: false },
  { slug: '04-editorial', num: '05', title: 'Editorial',         tag: 'журнальный',    accent: '#A280FF', external: false },
  { slug: '05-y2k',       num: '06', title: 'Y2K',               tag: 'retro-future',  accent: '#7CFFB2', external: false },
];
---
<section class="tpl-show section-dark" id="templates">
  <div class="container-x">
    <div class="tpl-show__head reveal">
      <div class="sec-tag">Шаблоны</div>
      <h2 class="display-h">
        Шесть <em>направлений</em>
      </h2>
      <p class="tpl-show__lead">
        Выбираете стиль — беру за основу под ваш бренд. Каждый шаблон живой, можно открыть и потрогать.
      </p>
    </div>

    <div class="tpl-show__track">
      {templates.map((t, i) => (
        <a
          href={t.external ? t.href : `${base}templates/${t.slug}/`}
          target={t.external ? '_blank' : undefined}
          rel={t.external ? 'noopener' : undefined}
          class="tpl-card glass reveal"
          style={`--card-accent: ${t.accent}; transition-delay: ${i * 0.06}s`}
          data-hover
        >
          <div class="tpl-card__glow"></div>
          <div class="tpl-card__num">{t.num}</div>
          <div class="tpl-card__body">
            <div class="tpl-card__title">{t.title}</div>
            <div class="tpl-card__tag">{t.tag}</div>
          </div>
          <div class="tpl-card__arrow" aria-hidden="true">→</div>
        </a>
      ))}
    </div>

    <a href={`${base}templates/`} class="btn tpl-show__cta" data-hover>
      <span class="btn__plus">(+)</span>
      Смотреть все шаблоны
    </a>
  </div>
</section>

<style>
  .tpl-show { padding: 120px 0; }
  .tpl-show__head {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .tpl-show__head em { color: var(--aurora-cyan); }
  .tpl-show__lead {
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 18px 0 0;
    max-width: 540px;
  }

  /* Горизонтальная лента с scroll-snap (свайп на mobile, drag на desktop) */
  .tpl-show__track {
    display: grid;
    grid-template-columns: repeat(6, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .tpl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    padding: 24px;
    border-radius: 18px;
    text-decoration: none;
    color: var(--color-text);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(.22,1,.36,1), border-color 0.4s, box-shadow 0.4s;
  }
  .tpl-card:hover {
    transform: translateY(-8px);
    border-color: color-mix(in srgb, var(--card-accent) 50%, transparent);
    box-shadow: 0 24px 50px rgba(0,0,0,0.35),
                0 0 60px color-mix(in srgb, var(--card-accent) 18%, transparent),
                var(--glass-edge);
  }
  /* Цветной glow в углу — индивидуальность каждого стиля */
  .tpl-card__glow {
    position: absolute;
    top: -40%; right: -30%;
    width: 70%; height: 70%;
    border-radius: 50%;
    background: var(--card-accent);
    filter: blur(50px);
    opacity: 0.18;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .tpl-card:hover .tpl-card__glow { opacity: 0.35; }

  .tpl-card__num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--color-muted-2);
    letter-spacing: 1px;
    position: relative;
    z-index: 1;
  }
  .tpl-card__body { position: relative; z-index: 1; }
  .tpl-card__title {
    font-family: 'Unbounded', sans-serif;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .tpl-card__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--card-accent);
  }
  .tpl-card__arrow {
    position: absolute;
    bottom: 22px; right: 22px;
    font-size: 20px;
    color: var(--card-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s, transform 0.3s;
    z-index: 1;
  }
  .tpl-card:hover .tpl-card__arrow { opacity: 1; transform: translateX(0); }

  .tpl-show__cta { margin-top: 8px; }

  @media (max-width: 1100px) {
    .tpl-show__track {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: minmax(200px, 70%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
      scrollbar-width: none;
    }
    .tpl-show__track::-webkit-scrollbar { display: none; }
    .tpl-card { scroll-snap-align: start; }
  }
  @media (max-width: 700px) {
    .tpl-show { padding: 72px 0; }
    .tpl-show__track { grid-auto-columns: minmax(180px, 80%); }
  }
</style>

---
---
<section class="hero section-dark" id="hero">
  <div class="hero__cursor-glow" id="heroGlow"></div>
  <span id="planeAnchor" class="plane-anchor-spot" aria-hidden="true"></span>

  <div class="container-x hero__inner">
    <div class="hero__content">
      <div class="hero__badge">
        <span class="live-badge__dot"></span>
        Для экспертов, юристов и сервисного бизнеса
      </div>

      <h1 class="hero__title text-glow">
        <span class="hero__line">Сайты и AI-воронки</span>
        <span class="hero__line"><em>под заявки.</em></span>
      </h1>

      <p class="hero__sub">
        Собираю оффер, лендинг, квиз, Telegram-заявки, аналитику и CRM/таблицу,
        чтобы клиент понимал, почему выбрать вас,
        а вы не теряли обращения в переписках.
      </p>

      <div class="hero__actions">
        <a href="/razbor" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          Получить бесплатный разбор
        </a>
        <a href="/cases" class="btn">
          Посмотреть кейсы
        </a>
      </div>
    </div>

    <div class="hero__facts glass">
      <div class="hero__facts-label">Как это работает</div>
      <ul class="hero__pillars">
        <li class="pillar">
          <span class="pillar__num">01</span>
          <span class="pillar__text">Чистый код без конструкторов</span>
        </li>
        <li class="pillar">
          <span class="pillar__num">02</span>
          <span class="pillar__text">Первая версия за 3–5 дней</span>
        </li>
        <li class="pillar">
          <span class="pillar__num">03</span>
          <span class="pillar__text">Заявки приходят в Telegram</span>
        </li>
        <li class="pillar">
          <span class="pillar__num">04</span>
          <span class="pillar__text">Исходники остаются у вас</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Marquee -->
  <div class="hero__marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>AI-ВОРОНКИ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>КВИЗ И АНАЛИТИКА</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>AI-ВОРОНКИ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>КВИЗ И АНАЛИТИКА</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .plane-anchor-spot {
    position: absolute;
    top: 45%;
    right: 12%;
    width: 1px; height: 1px;
    pointer-events: none;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    padding: 116px 0 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero__cursor-glow {
    position: absolute;
    top: 0; left: 0;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,198,255,0.10) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1);
    z-index: 1;
    will-change: transform;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 48px;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 60px;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-muted);
    margin-bottom: 24px;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  /* Title */
  .hero__title {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(44px, 6.5vw, 104px);
    line-height: 0.97;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }
  .hero__line { display: block; }
  .hero__line em {
    font-style: italic;
    font-weight: 300;
    color: #8FD8FF;
    text-shadow:
      0 0 1px rgba(6,7,13,1),
      0 2px 24px rgba(6,7,13,0.95),
      0 0 50px rgba(95,198,255,0.4);
  }

  /* Sub */
  .hero__sub {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 36px;
    max-width: 520px;
  }

  /* Actions */
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Facts card */
  .hero__facts {
    padding: 28px 26px;
    border-radius: 18px;
    align-self: center;
  }
  .hero__facts-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
  }
  .hero__pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pillar {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .pillar__num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--color-accent);
    flex-shrink: 0;
    opacity: 0.7;
  }
  .pillar__text {
    font-size: 13px;
    color: var(--color-text);
    line-height: 1.4;
  }

  /* Marquee */
  .hero__marquee {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    position: relative;
    z-index: 2;
  }
  .marquee-track {
    display: inline-flex;
    gap: 32px;
    white-space: nowrap;
    animation: marquee 38s linear infinite;
    font-family: 'Unbounded', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .marquee-track span:nth-child(even) { color: var(--color-accent); font-weight: 300; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 1100px) {
    .hero__inner { grid-template-columns: 1fr 300px; gap: 32px; }
  }
  @media (max-width: 900px) {
    .hero { padding: 100px 0 0; min-height: auto; }
    .hero__inner { grid-template-columns: 1fr; gap: 32px; padding-bottom: 40px; }
    .hero__facts { max-width: 100%; }
    .marquee-track { font-size: 14px; gap: 20px; }
  }
  @media (max-height: 800px) {
    .hero { min-height: auto; }
    .hero__title { font-size: clamp(36px, 5.5vw, 80px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cursor-glow { display: none; }
    .marquee-track { animation: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const glow = document.getElementById('heroGlow');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (glow && hero && !reduceMotion) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      glow.style.transform = `translate(${e.clientX - rect.left}px, ${e.clientY - rect.top}px) translate(-50%, -50%)`;
    });
  }
</script>

---
<section class="hero section-dark">
  <!-- Aurora — источник света всей секции -->
  <div class="hero__aurora" aria-hidden="true"></div>
  <div class="hero__cursor-glow" id="heroGlow"></div>

  <div class="container-x hero__inner">
    <div class="hero__top">
      <span class="live-badge">
        <span class="live-badge__dot"></span>
        Беру 2 проекта в июнь
      </span>
      <div class="hero__meta">
        <span>(01)</span>
        <span class="hero__meta-sep">/</span>
        <span>лендинги · автоматизации</span>
      </div>
    </div>

    <h1 class="hero__title text-glow" id="heroTitle">
      <span class="hero__line hero__line--1">Разработка</span>
      <span class="hero__line hero__line--2"><em>лендингов</em></span>
      <span class="hero__line hero__line--3">и автоматизаций.</span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__sub glass">
        <p>
          Собираю сайты под заявки и системы, которые работают без вас:
          оплаты, заявки в Telegram, админка, интеграции.
          Чистый код, скорость, ваши исходники.
        </p>
      </div>

      <div class="hero__actions">
        <a href="https://t.me/tori2k" target="_blank" rel="noopener" class="btn btn--filled">
          <span class="btn__plus">(+)</span>
          Получить разбор
        </a>
        <a href="#work" class="btn">
          Посмотреть кейсы
        </a>
      </div>

      <div class="hero__metrics">
        <div class="metric">
          <div class="metric__n"><span id="m-projects">0</span><small>+</small></div>
          <div class="metric__l">запущенных сайтов</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-speed">0</span><small>д</small></div>
          <div class="metric__l">до первой версии</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-lh">0</span></div>
          <div class="metric__l">средний Lighthouse</div>
        </div>
        <div class="metric">
          <div class="metric__n">0<small>₽</small></div>
          <div class="metric__l">за хостинг</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="hero__marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
      <!-- дубль для seamless scroll -->
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 140px 0 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-bg);
  }

  /* ============ ДВИЖУЩИЙСЯ КОСМОС ============ */
  /* Три слоя звёзд разной глубины, медленный дрейф = ощущение «космос плывёт» */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: -50%;
    z-index: 0;
    pointer-events: none;
    background-repeat: repeat;
  }
  /* Дальние мелкие звёзды */
  .hero::before {
    background-image:
      radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 60% 70%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 80% 10%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 40% 80%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 90% 50%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 10% 60%, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 33% 15%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.5), transparent);
    background-size: 280px 280px;
    opacity: 0.5;
    animation: drift-far 120s linear infinite;
  }
  /* Ближние крупные звёзды с aurora-оттенком */
  .hero::after {
    background-image:
      radial-gradient(1.5px 1.5px at 15% 25%, rgba(95,198,255,0.9), transparent),
      radial-gradient(2px 2px at 55% 65%, rgba(255,255,255,0.95), transparent),
      radial-gradient(1.5px 1.5px at 85% 35%, rgba(162,128,255,0.8), transparent),
      radial-gradient(2px 2px at 35% 85%, rgba(255,255,255,0.9), transparent),
      radial-gradient(1.5px 1.5px at 75% 15%, rgba(95,198,255,0.7), transparent);
    background-size: 420px 420px;
    opacity: 0.7;
    animation: drift-near 80s linear infinite;
  }
  @keyframes drift-far {
    from { transform: translate(0, 0); }
    to   { transform: translate(-280px, -140px); }
  }
  @keyframes drift-near {
    from { transform: translate(0, 0); }
    to   { transform: translate(420px, 210px); }
  }

  /* Aurora — источник света сверху-справа */
  .hero__aurora {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(95,198,255,0.22) 0%,
      rgba(162,128,255,0.16) 35%,
      rgba(255,110,199,0.08) 55%,
      transparent 72%
    );
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
    animation: aurora-breathe 14s ease-in-out infinite;
    will-change: transform, opacity;
  }
  @keyframes aurora-breathe {
    0%, 100% { transform: scale(1) translate(0, 0); opacity: 0.9; }
    50%      { transform: scale(1.12) translate(-3%, 3%); opacity: 1; }
  }

  /* Cursor-reactive glow — теперь aurora-cyan (виден на тёмном) */
  .hero__cursor-glow {
    position: absolute;
    top: 0; left: 0;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,198,255,0.10) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1);
    z-index: 1;
    will-change: transform;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    flex: 1;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hero__meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .hero__meta-sep { margin: 0 8px; color: var(--color-accent); }

  /* Title — kinetic */
  .hero__title {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(48px, 10vw, 150px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 40px 0;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }
  .hero__line {
    display: block;
    will-change: transform;
  }
  .hero__line--2 {
    text-align: center;
  }
  .hero__line--2 em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent);
  }
  .hero__line--3 {
    text-align: right;
  }

  /* Bottom row */
  .hero__bottom {
    display: grid;
    grid-template-columns: 1.1fr auto;
    gap: 60px;
    align-items: end;
    padding-bottom: 60px;
  }
  .hero__sub {
    padding: 24px 28px;
    max-width: 560px;
  }
  .hero__sub p {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-self: end;
  }

  .hero__metrics {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }
  .metric { display: flex; flex-direction: column; gap: 6px; }
  .metric__n {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .metric__n small {
    font-size: 0.5em;
    color: var(--color-accent);
  }
  .metric__l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted-2);
    line-height: 1.4;
  }

  /* Marquee */
  .hero__marquee {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    position: relative;
    z-index: 2;
  }
  .marquee-track {
    display: inline-flex;
    gap: 32px;
    white-space: nowrap;
    animation: marquee 38s linear infinite;
    font-family: 'Unbounded', sans-serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .marquee-track span:nth-child(even) {
    color: var(--color-accent);
    font-weight: 300;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .hero { padding: 110px 0 0; }
    .hero__bottom { grid-template-columns: 1fr; gap: 28px; }
    .hero__actions { justify-self: start; }
    .hero__metrics { grid-template-columns: repeat(2, 1fr); }
    .marquee-track { font-size: 16px; gap: 20px; }
    .hero__sub { max-width: 100%; }
  }

  /* Останавливаем движение космоса для reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .hero::before,
    .hero::after,
    .hero__aurora { animation: none !important; }
  }
</style>

<script>
  // Cursor glow follow
  const glow = document.getElementById('heroGlow');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (glow && hero) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
    });
  }

  // Counter animation on load
  const counters: Array<{ id: string; to: number; duration: number }> = [
    { id: 'm-projects', to: 7, duration: 1200 },
    { id: 'm-speed',    to: 3, duration: 1200 },
    { id: 'm-lh',       to: 98, duration: 1600 },
  ];
  counters.forEach(({ id, to, duration }) => {
    const el = document.getElementById(id);
    if (!el) return;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(to * eased).toString();
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });

  // Scroll-driven scale of hero title (отключаем для reduced-motion)
  const title = document.getElementById('heroTitle');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (title && !reduceMotion) {
    const onScroll = () => {
      const y = window.scrollY;
      const scale = Math.max(0.85, 1 - y / 1800);
      const opacity = Math.max(0, 1 - y / 600);
      title.style.transform = `scale(${scale})`;
      title.style.opacity = String(opacity);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

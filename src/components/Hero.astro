---
---
<section class="hero section-dark" id="hero">
  <div class="hero__cursor-glow" id="heroGlow"></div>

  <div class="container-x hero__inner">
    <h1 class="hero__title text-glow">
      <span class="hero__line">Сайты и AI-воронки</span>
      <span class="hero__line"><em>для экспертов</em></span>
      <span class="hero__line">под зая<span id="planeAnchor">вки</span>.</span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__sub glass">
        <p>
          Собираю оффер, лендинг, квиз, Telegram-заявки, аналитику и автоматизации,
          чтобы клиент понимал, почему выбрать вас, а вы не теряли обращения в переписках.
        </p>
      </div>

      <div class="hero__actions">
        <a href="/razbor" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          Получить бесплатный разбор
        </a>
        <a href="#work" class="btn">
          Посмотреть кейсы
        </a>
      </div>

      <div class="hero__pillars">
        <div class="pillar">
          <span class="pillar__icon">◎</span>
          <span>Первая версия за 3–5 дней</span>
        </div>
        <div class="pillar">
          <span class="pillar__icon">◎</span>
          <span>Заявки приходят в Telegram</span>
        </div>
        <div class="pillar">
          <span class="pillar__icon">◎</span>
          <span>Исходники и код остаются у вас</span>
        </div>
      </div>

      <div class="hero__metrics">
        <div class="metric">
          <div class="metric__n"><span id="m-projects">0</span><small>+</small></div>
          <div class="metric__l">запущенных сайтов</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-speed">0</span><small>д</small></div>
          <div class="metric__l">до первой версии</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-lh">0</span></div>
          <div class="metric__l">средний Lighthouse</div>
        </div>
        <div class="metric">
          <div class="metric__n">0<small>₽</small></div>
          <div class="metric__l">за хостинг</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="hero__marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 116px 0 40px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  @media (max-height: 800px) {
    .hero { min-height: auto; padding: 100px 0 48px; }
    .hero__title { font-size: clamp(36px, 5.5vw, 80px); }
  }

  .hero__cursor-glow {
    position: absolute;
    top: 0; left: 0;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,198,255,0.10) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1);
    z-index: 1;
    will-change: transform;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    flex: 1;
    justify-content: center;
  }

  .hero__title {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(40px, 6.5vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }
  .hero__line { display: block; text-align: left; }
  .hero__line em {
    font-style: italic;
    font-weight: 300;
    color: #8FD8FF;
    text-shadow:
      0 0 1px rgba(6,7,13,1),
      0 2px 24px rgba(6,7,13,0.95),
      0 0 50px rgba(95,198,255,0.4);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: 1.1fr auto;
    gap: 40px;
    align-items: end;
    padding-bottom: 36px;
  }
  .hero__sub { padding: 24px 28px; max-width: 560px; }
  .hero__sub p {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-self: end; }

  .hero__pillars {
    grid-column: 1 / -1;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    padding-top: 20px;
  }
  .pillar {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--color-muted);
  }
  .pillar__icon {
    color: var(--color-accent);
    font-size: 14px;
    flex-shrink: 0;
  }

  .hero__metrics {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 28px;
    padding-bottom: 16px;
    border-top: 1px solid var(--color-border);
  }
  .metric { display: flex; flex-direction: column; gap: 6px; }
  .metric__n {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .metric__n small {
    font-size: 0.45em;
    color: var(--color-accent);
    align-self: flex-start;
    padding-top: 0.3em;
  }
  .metric__l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted-2);
    line-height: 1.4;
  }

  .hero__marquee {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    position: relative;
    z-index: 2;
  }
  .marquee-track {
    display: inline-flex;
    gap: 32px;
    white-space: nowrap;
    animation: marquee 38s linear infinite;
    font-family: 'Unbounded', sans-serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .marquee-track span:nth-child(even) { color: var(--color-accent); font-weight: 300; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .hero { padding: 110px 0 0; }
    .hero__bottom { grid-template-columns: 1fr; gap: 28px; }
    .hero__actions { justify-self: start; }
    .hero__metrics { grid-template-columns: repeat(2, 1fr); }
    .marquee-track { font-size: 16px; gap: 20px; }
    .hero__sub { max-width: 100%; }
    .hero__pillars { gap: 16px; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cursor-glow { display: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cursor glow follow
  const glow = document.getElementById('heroGlow');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (glow && hero && !reduceMotion) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      glow.style.transform = `translate(${e.clientX - rect.left}px, ${e.clientY - rect.top}px) translate(-50%, -50%)`;
    });
  }

  // Counter animation
  const counters: Array<{ id: string; to: number; duration: number }> = [
    { id: 'm-projects', to: 7, duration: 1200 },
    { id: 'm-speed',    to: 3, duration: 1200 },
    { id: 'm-lh',       to: 98, duration: 1600 },
  ];
  counters.forEach(({ id, to, duration }) => {
    const el = document.getElementById(id);
    if (!el) return;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(to * eased).toString();
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>

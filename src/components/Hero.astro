---
<section class="hero section-dark">
  <div class="hero__cursor-glow" id="heroGlow"></div>

  <!-- 3D стеклянная линза (three.js, lazy, fallback на CSS) -->
  <div class="hero__lens" aria-hidden="true">
    <canvas id="heroLensCanvas"></canvas>
    <div class="hero__lens-fallback"></div>
  </div>

  <div class="container-x hero__inner">
    <h1 class="hero__title text-glow" id="heroTitle">
      <span class="hero__line hero__line--1">Разработка</span>
      <span class="hero__line hero__line--2"><em>лендингов</em></span>
      <span class="hero__line hero__line--3">и автоматизаций.</span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__sub glass">
        <p>
          Собираю сайты под заявки и системы, которые работают без вас:
          оплаты, заявки в Telegram, админка, интеграции.
          Чистый код, скорость, ваши исходники.
        </p>
      </div>

      <div class="hero__actions">
        <a href="https://t.me/tori2k" target="_blank" rel="noopener" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          Получить разбор
        </a>
        <a href="#work" class="btn">
          Посмотреть кейсы
        </a>
      </div>

      <div class="hero__metrics">
        <div class="metric">
          <div class="metric__n"><span id="m-projects">0</span><small>+</small></div>
          <div class="metric__l">запущенных сайтов</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-speed">0</span><small>д</small></div>
          <div class="metric__l">до первой версии</div>
        </div>
        <div class="metric">
          <div class="metric__n"><span id="m-lh">0</span></div>
          <div class="metric__l">средний Lighthouse</div>
        </div>
        <div class="metric">
          <div class="metric__n">0<small>₽</small></div>
          <div class="metric__l">за хостинг</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="hero__marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
      <!-- дубль для seamless scroll -->
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>АВТОМАТИЗАЦИИ И БОТЫ</span><span>·</span>
      <span>ОНЛАЙН-ОПЛАТЫ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>СВОЙ ДОМЕН</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 116px 0 40px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  /* На невысоких экранах не запираем в 100vh — даём контенту течь */
  @media (max-height: 800px) {
    .hero {
      min-height: auto;
      padding: 100px 0 48px;
    }
    .hero__title { font-size: clamp(36px, 5.5vw, 80px); }
  }

  /* Космос и aurora теперь глобальные (в Layout) — здесь не дублируем */

  /* 3D стеклянная линза — в правом верхнем углу, не перекрывает заголовок */
  .hero__lens {
    position: absolute;
    top: 4%;
    right: -4%;
    width: min(34vw, 440px);
    height: min(34vw, 440px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.8;
  }
  .hero__lens canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  /* CSS-fallback: стеклянная сфера для mobile/reduced-motion/слабых */
  .hero__lens-fallback {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(255,255,255,0.25), transparent 40%),
      radial-gradient(circle at 65% 70%, rgba(95,198,255,0.35), transparent 55%),
      radial-gradient(circle at 50% 50%, rgba(162,128,255,0.25), rgba(6,7,13,0.1) 70%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow:
      inset 0 2px 20px rgba(255,255,255,0.15),
      inset 0 -10px 40px rgba(95,198,255,0.2),
      0 20px 60px rgba(95,198,255,0.15);
    opacity: 0;
    transition: opacity 0.6s;
  }
  /* Когда canvas пуст (3D не запущен) — показываем fallback */
  .hero__lens.fallback-active .hero__lens-fallback { opacity: 1; }

  /* Cursor-reactive glow — теперь aurora-cyan (виден на тёмном) */
  .hero__cursor-glow {
    position: absolute;
    top: 0; left: 0;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,198,255,0.10) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1);
    z-index: 1;
    will-change: transform;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    flex: 1;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hero__meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .hero__meta-sep { margin: 0 8px; color: var(--color-accent); }

  /* Title — kinetic */
  .hero__title {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(40px, 6.5vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }
  .hero__line {
    display: block;
    text-align: left;
    will-change: transform;
  }
  .hero__line--2 em {
    font-style: italic;
    font-weight: 300;
    /* Яркий cyan для контраста на тёмном космосе */
    color: #8FD8FF;
    /* Сильный тёмный контур + glow, чтобы текст читался поверх линзы/космоса */
    text-shadow:
      0 0 1px rgba(6,7,13,1),
      0 2px 24px rgba(6,7,13,0.95),
      0 0 50px rgba(95,198,255,0.4);
  }

  /* Bottom row */
  .hero__bottom {
    display: grid;
    grid-template-columns: 1.1fr auto;
    gap: 40px;
    align-items: end;
    padding-bottom: 36px;
  }
  .hero__sub {
    padding: 24px 28px;
    max-width: 560px;
  }
  .hero__sub p {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-self: end;
  }

  .hero__metrics {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-top: 28px;
    padding-bottom: 16px;
    border-top: 1px solid var(--color-border);
  }
  .metric { display: flex; flex-direction: column; gap: 6px; }
  .metric__n {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .metric__n small {
    font-size: 0.45em;
    color: var(--color-accent);
    margin-left: 2px;
    align-self: flex-start;
    padding-top: 0.3em;
  }
  .metric__l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted-2);
    line-height: 1.4;
  }

  /* Marquee */
  .hero__marquee {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    position: relative;
    z-index: 2;
  }
  .marquee-track {
    display: inline-flex;
    gap: 32px;
    white-space: nowrap;
    animation: marquee 38s linear infinite;
    font-family: 'Unbounded', sans-serif;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .marquee-track span:nth-child(even) {
    color: var(--color-accent);
    font-weight: 300;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .hero { padding: 110px 0 0; }
    .hero__bottom { grid-template-columns: 1fr; gap: 28px; }
    .hero__actions { justify-self: start; }
    .hero__metrics { grid-template-columns: repeat(2, 1fr); }
    .marquee-track { font-size: 16px; gap: 20px; }
    .hero__sub { max-width: 100%; }
    /* На мобайле линза мельче и не мешает тексту */
    .hero__lens {
      width: 70vw; height: 70vw;
      right: -10%; top: 18%;
      opacity: 0.5;
    }
  }

  /* Останавливаем движение космоса для reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .hero__cursor-glow { display: none; }
  }
</style>

<script>
  // 3D-линза: lazy-загрузка three.js только когда нужно
  const lensCanvas = document.getElementById('heroLensCanvas') as HTMLCanvasElement | null;
  const lensWrap = document.querySelector<HTMLElement>('.hero__lens');
  if (lensCanvas && lensWrap) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isLowEnd = (navigator.hardwareConcurrency || 4) < 4;
    const isTouch = window.matchMedia('(hover: none)').matches;
    if (reduceMotion || isLowEnd || isTouch) {
      // Сразу показываем CSS-fallback, three.js не грузим
      lensWrap.classList.add('fallback-active');
    } else {
      // Lazy-импорт three.js после первого кадра (не блокируем LCP)
      requestIdleCallback?.(() => {
        import('../scripts/heroLens').then(({ initHeroLens }) => {
          const cleanup = initHeroLens(lensCanvas);
          if (!cleanup) lensWrap.classList.add('fallback-active');
        }).catch(() => lensWrap.classList.add('fallback-active'));
      }) ?? import('../scripts/heroLens').then(({ initHeroLens }) => {
        initHeroLens(lensCanvas);
      });
    }
  }

  // Cursor glow follow
  const glow = document.getElementById('heroGlow');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (glow && hero) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
    });
  }

  // Counter animation on load
  const counters: Array<{ id: string; to: number; duration: number }> = [
    { id: 'm-projects', to: 7, duration: 1200 },
    { id: 'm-speed',    to: 3, duration: 1200 },
    { id: 'm-lh',       to: 98, duration: 1600 },
  ];
  counters.forEach(({ id, to, duration }) => {
    const el = document.getElementById(id);
    if (!el) return;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(to * eased).toString();
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });

  // Scroll-driven scale of hero title (отключаем для reduced-motion)
  const title = document.getElementById('heroTitle');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (title && !reduceMotion) {
    const onScroll = () => {
      const y = window.scrollY;
      const scale = Math.max(0.85, 1 - y / 1800);
      const opacity = Math.max(0, 1 - y / 600);
      title.style.transform = `scale(${scale})`;
      title.style.opacity = String(opacity);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

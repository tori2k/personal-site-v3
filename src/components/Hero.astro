---
import HeroMedia from './HeroMedia.astro';
---
<section class="hero section-dark" id="hero">
  <div class="hero__cursor-glow" id="heroGlow"></div>

  <div class="container-x hero__inner">
    <div class="hero__content">
      <div class="hero__badge">
        <span class="live-badge__dot"></span>
        Клиники, салоны, эксперты, малый бизнес
      </div>

      <h1 class="hero__title text-glow">
        <span class="hero__line">Собираю систему</span>
        <span class="hero__line"><em>заявок</em> после клика.</span>
      </h1>

      <p class="hero__sub">
        Сайт, квиз, Telegram-заявки, CRM/таблица и дожим —
        без хаоса в переписках и потерянных лидов.
      </p>

      <div class="hero__actions">
        <a href="/razbor" class="btn btn--filled" data-magnetic="0.4">
          <span class="btn__plus">(+)</span>
          Найти 3 точки слива
        </a>
        <a href="/calculator" class="btn">
          Посчитать потери
        </a>
      </div>

      <ul class="hero__chips">
        <li class="hero__chip"><span class="hero__chip-i">◎</span> Заявки в Telegram</li>
        <li class="hero__chip"><span class="hero__chip-i">◎</span> Лиды в CRM / таблице</li>
        <li class="hero__chip"><span class="hero__chip-i">◎</span> Запуск за 3–5 дней</li>
      </ul>
    </div>

    <div class="hero__visual">
      <HeroMedia />
    </div>
  </div>

  <!-- Marquee -->
  <div class="hero__marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>AI-ВОРОНКИ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>КВИЗ И АНАЛИТИКА</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
      <span>ЛЕНДИНГИ ПОД ЗАЯВКИ</span><span>·</span>
      <span>AI-ВОРОНКИ</span><span>·</span>
      <span>ЗАЯВКИ В TELEGRAM</span><span>·</span>
      <span>КВИЗ И АНАЛИТИКА</span><span>·</span>
      <span>ИНТЕГРАЦИИ И CRM</span><span>·</span>
      <span>ЧИСТЫЙ КОД БЕЗ TILDA</span><span>·</span>
      <span>ИСХОДНИКИ ВАШИ</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 116px 0 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero__cursor-glow {
    position: absolute;
    top: 0; left: 0;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,198,255,0.10) 0%, transparent 65%);
    filter: blur(40px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(.22,1,.36,1);
    z-index: 1;
    will-change: transform;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 48px;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 60px;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-muted);
    margin-bottom: 24px;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  /* Title */
  .hero__title {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(44px, 6.5vw, 104px);
    line-height: 0.97;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
  }
  .hero__line { display: block; }
  .hero__line em {
    font-style: italic;
    font-weight: 300;
    color: #8FD8FF;
    text-shadow:
      0 0 1px rgba(6,7,13,1),
      0 2px 24px rgba(6,7,13,0.95),
      0 0 50px rgba(95,198,255,0.4);
  }

  /* Sub */
  .hero__sub {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 36px;
    max-width: 520px;
  }

  /* Actions */
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  /* Proof-chips */
  .hero__chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }
  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--color-muted);
  }
  .hero__chip-i { color: var(--color-accent); font-size: 11px; }

  /* Visual (HeroMedia) */
  .hero__visual { align-self: center; width: 100%; }

  /* Marquee */
  .hero__marquee {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    position: relative;
    z-index: 2;
  }
  .marquee-track {
    display: inline-flex;
    gap: 32px;
    white-space: nowrap;
    animation: marquee 38s linear infinite;
    font-family: 'Unbounded', sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .marquee-track span:nth-child(even) { color: var(--color-accent); font-weight: 300; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 1100px) {
    .hero__inner { grid-template-columns: 1fr 340px; gap: 32px; }
  }
  @media (max-width: 900px) {
    .hero { padding: 100px 0 0; min-height: auto; }
    .hero__inner { grid-template-columns: 1fr; gap: 36px; padding-bottom: 40px; }
    .hero__visual { max-width: 440px; }
    .marquee-track { font-size: 14px; gap: 20px; }
  }
  @media (max-width: 480px) {
    .hero__inner { gap: 28px; padding-top: 28px; padding-bottom: 28px; }
    .hero__badge { font-size: 10px; padding: 5px 12px; }
    .hero__title { font-size: clamp(34px, 8.5vw, 50px); margin-bottom: 20px; }
    .hero__sub { font-size: 15px; margin-bottom: 24px; }
    .hero__actions { flex-direction: column; gap: 10px; }
    .hero__actions .btn { width: 100%; justify-content: center; }
    .hero__chips { gap: 8px 14px; }
    .marquee-track { font-size: 12px; gap: 16px; }
  }
  @media (max-height: 800px) {
    .hero { min-height: auto; }
    .hero__title { font-size: clamp(36px, 5.5vw, 80px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cursor-glow { display: none; }
    .marquee-track { animation: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const glow = document.getElementById('heroGlow');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (glow && hero && !reduceMotion) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      glow.style.transform = `translate(${e.clientX - rect.left}px, ${e.clientY - rect.top}px) translate(-50%, -50%)`;
    });
  }
</script>

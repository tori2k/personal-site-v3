---
const base = import.meta.env.BASE_URL;
---
<section class="approach section-dark" id="about">
  <div class="container-x">
    <div class="approach__grid">
      <!-- Левая колонка: фото в стеклянной рамке -->
      <div class="approach__left reveal-left">
        <div class="approach__photo glass" data-tilt>
          <img src={`${base}kirill.jpg`} alt="Кирилл Барыев" loading="lazy" />
          <div class="approach__photo-badge">
            <span class="live-badge__dot"></span>
            это я
          </div>
        </div>
      </div>

      <!-- Правая колонка: заголовок + числа + строки выгод -->
      <div class="approach__right reveal-right">
        <div class="sec-tag">Подход</div>
        <h2 class="display-h approach__title">
          Один инженер. <em>Весь стек.</em>
        </h2>
        <p class="approach__lead">
          Делаю сайты и автоматизации на чистом коде — без конструкторов,
          с измеримым результатом и исходниками, которые остаются у вас.
        </p>

        <!-- Числа в стеклянных капсулах (приборная панель) -->
        <div class="approach__stats">
          <div class="stat glass">
            <div class="stat__n"><span data-count="98">0</span></div>
            <div class="stat__l">Lighthouse</div>
          </div>
          <div class="stat glass">
            <div class="stat__n"><span data-count="7">0</span><small>+</small></div>
            <div class="stat__l">проектов</div>
          </div>
          <div class="stat glass">
            <div class="stat__n">&lt;1<small>с</small></div>
            <div class="stat__l">загрузка</div>
          </div>
        </div>

        <!-- 3 короткие выгоды -->
        <ul class="approach__benefits">
          <li><span class="approach__b-n">01</span> Чистый код без конструкторов и подписок</li>
          <li><span class="approach__b-n">02</span> Открывается за секунду на любом устройстве</li>
          <li><span class="approach__b-n">03</span> Исходники и ключ от репозитория — ваши</li>
        </ul>

        <!-- Стек одной строкой -->
        <div class="approach__stack">
          <span>Astro</span><span>TypeScript</span><span>Tailwind</span><span>React</span><span>Google Sheets</span><span>Т-Касса</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .approach { padding: 120px 0; }
  .approach__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 64px;
    align-items: center;
  }

  /* Фото в стеклянной рамке с 3D-наклоном */
  .approach__photo {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border-radius: 18px;
    padding: 8px;
    transform-style: preserve-3d;
    transition: transform 0.3s cubic-bezier(.22,1,.36,1);
  }
  .approach__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    filter: contrast(1.05) brightness(0.95);
  }
  .approach__photo-badge {
    position: absolute;
    bottom: 18px; left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: var(--aurora-cyan);
    color: #06070D;
    border-radius: 999px;
  }
  .approach__photo-badge .live-badge__dot { background: #06070D; box-shadow: none; }

  .approach__title { margin: 0 0 20px; }
  .approach__title em { color: var(--aurora-cyan); }
  .approach__lead {
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 36px;
    max-width: 520px;
  }

  /* Числа-капсулы */
  .approach__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }
  .stat {
    padding: 22px 20px;
    border-radius: 14px;
    text-align: left;
  }
  .stat__n {
    font-family: 'Unbounded', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    display: flex;
    align-items: baseline;
  }
  .stat__n small {
    font-size: 0.45em;
    color: var(--aurora-cyan);
    margin-left: 2px;
  }
  .stat__l {
    margin-top: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted-2);
  }

  /* Выгоды */
  .approach__benefits {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .approach__benefits li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.5;
  }
  .approach__b-n {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--aurora-cyan);
    flex-shrink: 0;
  }

  /* Стек одной строкой */
  .approach__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .approach__stack span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--color-muted);
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  @media (max-width: 900px) {
    .approach { padding: 72px 0; }
    .approach__grid { grid-template-columns: 1fr; gap: 40px; }
    .approach__stats { gap: 10px; }
    .stat { padding: 16px 14px; }
  }
</style>

<script>
  // Counter-roll для чисел при появлении (с учётом reduced-motion)
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.approach [data-count]');

  function rollCounter(el: HTMLElement) {
    const to = parseInt(el.dataset.count || '0', 10);
    if (reduceMotion) { el.textContent = String(to); return; }
    const dur = 1400;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(to * eased));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        rollCounter(e.target as HTMLElement);
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach((c) => io.observe(c));

  // Лёгкий 3D-наклон фото на курсор (desktop, не reduced-motion)
  if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
    const photo = document.querySelector<HTMLElement>('.approach__photo[data-tilt]');
    if (photo) {
      photo.addEventListener('mousemove', (e) => {
        const r = photo.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        photo.style.transform = `perspective(800px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg)`;
      });
      photo.addEventListener('mouseleave', () => {
        photo.style.transform = 'perspective(800px) rotateY(0) rotateX(0)';
      });
    }
  }
</script>

---
const base = import.meta.env.BASE_URL;

const cards = [
  {
    key: 'Оффер',
    desc: 'Формулируем услугу так, чтобы клиент понял ценность и следующий шаг',
  },
  {
    key: 'Заявка',
    desc: 'Форма или квиз отправляют обращение в Telegram/CRM',
  },
  {
    key: 'Система',
    desc: 'Сайт, таблица лидов, аналитика и follow-up работают вместе',
  },
];

const perks = [
  'Чистый код без конструкторов и подписок',
  'Первая версия за 3–5 дней',
  'Заявки приходят в Telegram',
  'Исходники остаются у вас',
];
---
<section class="approach section-dark" id="about">
  <div class="container-x">
    <div class="approach__grid">

      <!-- Левая колонка: фото -->
      <div class="approach__left reveal-left">
        <div class="approach__photo glass" data-tilt>
          <img src={`${base}kirill.jpg`} alt="Кирилл Барыев" loading="lazy" />
          <div class="approach__photo-badge">
            <span class="live-badge__dot"></span>
            это я
          </div>
        </div>

        <!-- Доверие под фото -->
        <div class="approach__trust glass">
          <div class="trust__label">Один инженер. <em>Весь стек.</em></div>
          <p class="trust__sub">
            Делаю сам — от структуры до деплоя. Без подрядчиков и передачи задач.
          </p>
        </div>
      </div>

      <!-- Правая колонка -->
      <div class="approach__right reveal-right">
        <div class="approach__badge">
          <span class="live-badge__dot"></span>
          Для экспертов, юристов и сервисного бизнеса
        </div>

        <h2 class="display-h approach__title">
          Сайты и AI-воронки <em>под заявки.</em>
        </h2>

        <p class="approach__lead">
          Оффер, лендинг, квиз, Telegram-заявки и CRM — собираю систему, где клиент
          понимает ценность, а вы не теряете обращения.
        </p>

        <!-- 3 карточки результата -->
        <div class="approach__cards">
          {cards.map((c) => (
            <div class="acard glass">
              <div class="acard__key">{c.key}</div>
              <div class="acard__desc">{c.desc}</div>
            </div>
          ))}
        </div>

        <!-- CTA -->
        <div class="approach__cta-row">
          <a href="/cases" class="btn" data-magnetic="0.4">
            <span class="btn__plus">(+)</span>
            Посмотреть кейсы
          </a>
        </div>

        <!-- Технические преимущества -->
        <ul class="approach__perks">
          {perks.map((p, i) => (
            <li>
              <span class="approach__perk-n">0{i + 1}</span>
              {p}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .approach { padding: 120px 0; }
  .approach__grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 64px;
    align-items: start;
  }

  /* ── Левая колонка ── */
  .approach__left {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 100px;
  }

  .approach__photo {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border-radius: 18px;
    padding: 8px;
    transform-style: preserve-3d;
    transition: transform 0.3s cubic-bezier(.22,1,.36,1);
  }
  .approach__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    filter: grayscale(0.6) contrast(1.05) brightness(0.82);
    transition: filter 0.5s ease;
  }
  .approach__photo:hover img { filter: grayscale(0) contrast(1.06) brightness(1); }
  .approach__photo-badge {
    position: absolute;
    bottom: 18px; left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: var(--aurora-cyan);
    color: #0A0712;
    border-radius: 999px;
  }
  .approach__photo-badge .live-badge__dot { background: #0A0712; box-shadow: none; }

  /* Блок доверия под фото */
  .approach__trust {
    padding: 20px 22px;
    border-radius: 14px;
  }
  .trust__label {
    font-family: 'Unbounded', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .trust__label em {
    font-style: italic;
    font-weight: 300;
    color: var(--aurora-cyan);
  }
  .trust__sub {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Правая колонка ── */
  .approach__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-muted);
    margin-bottom: 20px;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .approach__title { margin: 0 0 20px; }
  .approach__title em { color: var(--aurora-cyan); }

  .approach__lead {
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0 0 32px;
    max-width: 540px;
  }

  /* Карточки оффер/заявка/система */
  .approach__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }
  .acard {
    padding: 20px 18px;
    border-radius: 14px;
    transition: border-color 0.3s, transform 0.3s cubic-bezier(.22,1,.36,1);
  }
  .acard:hover {
    border-color: rgba(139,92,255,0.4);
    transform: translateY(-3px);
  }
  .acard__key {
    font-family: 'Unbounded', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--aurora-cyan);
    margin-bottom: 8px;
  }
  .acard__desc {
    font-size: 12px;
    color: var(--color-muted);
    line-height: 1.55;
  }

  /* CTA */
  .approach__cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  /* Технические преимущества */
  .approach__perks {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .approach__perks li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .approach__perk-n {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 1100px) {
    .approach__cards { grid-template-columns: 1fr 1fr; }
    .acard:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 900px) {
    .approach { padding: 72px 0; }
    .approach__grid { grid-template-columns: 1fr; gap: 40px; }
    .approach__left { position: static; }
    .approach__cards { grid-template-columns: 1fr; }
    .acard:last-child { grid-column: auto; }
  }
  @media (max-width: 480px) {
    .approach__cta-row { flex-direction: column; gap: 10px; }
    .approach__cta-row .btn { width: 100%; justify-content: center; }
    .approach__trust { padding: 16px 16px; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Лёгкий 3D-наклон фото на курсор (desktop)
  if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
    const photo = document.querySelector<HTMLElement>('.approach__photo[data-tilt]');
    if (photo) {
      photo.addEventListener('mousemove', (e) => {
        const r = photo.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        photo.style.transform = `perspective(800px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg)`;
      });
      photo.addEventListener('mouseleave', () => {
        photo.style.transform = 'perspective(800px) rotateY(0) rotateX(0)';
      });
    }
  }
</script>

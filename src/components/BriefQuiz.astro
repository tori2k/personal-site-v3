---
const SHEETS_WEBHOOK = 'https://script.google.com/macros/s/AKfycbyeXV7TI8klBfvtnrAMYKOLNi3jifjO9IhRnkLDBKd7UJ0_XJCG3BpVlXlxiuvv60QM/exec';

const questions = [
  {
    id: 'business', type: 'textarea',
    q: 'Чем занимается ваш бизнес и кто ваш клиент?',
    hint: 'В 2–3 предложениях: что продаёте, кому, чем отличаетесь от конкурентов.',
    placeholder: 'Например: я детский психолог, работаю с родителями подростков. Отличаюсь форматом «семейные системы»...',
  },
  {
    id: 'goal', type: 'select',
    q: 'Какая главная цель сайта?',
    opts: [
      'Получать заявки на консультации/услуги',
      'Продавать товары онлайн',
      'Записывать клиентов в календарь',
      'Просто визитка — показать что я есть',
      'Презентовать продукт / собрать инвесторов',
    ],
  },
  {
    id: 'likes', type: 'textarea',
    q: 'Пришлите 2–3 ссылки на сайты, которые вам нравятся',
    hint: 'Любая тематика. Просто ссылки + 1 строкой почему именно эти.',
    placeholder: 'https://...\nhttps://...',
  },
  {
    id: 'mood', type: 'multi',
    q: 'Какое настроение должен передавать сайт?',
    hint: 'Выберите 2–3 главных слова.',
    opts: [
      'Строгий / профессиональный',
      'Тёплый / дружелюбный',
      'Премиум / дорогой',
      'Современный / минималистичный',
      'Яркий / энергичный',
      'Спокойный / умиротворяющий',
      'Креативный / необычный',
      'Доверительный / надёжный',
    ],
  },
  {
    id: 'budget', type: 'select',
    q: 'Бюджет на проект',
    hint: 'Я не торгуюсь — но мне важно понять рамки, чтобы предложить подходящий пакет.',
    opts: [
      'до 25 000 ₽',
      '25 000 – 50 000 ₽',
      '50 000 – 100 000 ₽',
      '100 000 – 200 000 ₽',
      'свыше 200 000 ₽',
      'пока не определились — нужна консультация',
    ],
  },
  {
    id: 'deadline', type: 'select',
    q: 'Когда нужен результат?',
    opts: [
      'Срочно — в течение недели (доп. оплата за срочность)',
      'В течение 2 недель',
      'В течение месяца',
      'Гибко — выбираем срок под объём задач',
    ],
  },
];

const contact = [
  { id: 'name',     label: 'Как вас зовут',   type: 'text',  placeholder: 'Имя или Имя Фамилия', required: true  },
  { id: 'company',  label: 'Название бизнеса', type: 'text',  placeholder: 'Можно пропустить',    required: false },
  { id: 'phone',    label: 'Телефон',          type: 'tel',   placeholder: '+7 ___ ___-__-__',    required: true  },
  { id: 'tg',       label: 'Telegram',         type: 'text',  placeholder: '@username',           required: false },
  { id: 'email',    label: 'Email',            type: 'email', placeholder: 'you@example.com',     required: true  },
];
---
<section class="brief-quiz section-dark" id="brief">
  <div class="container-x">
    <div class="brief-quiz__head reveal">
      <span class="sec-tag">бриф</span>
      <h2 class="display-h">
        <em>6 вопросов</em><br/>
        о&nbsp;проекте.
      </h2>
      <p class="brief-quiz__lead">
        Двигайтесь по&nbsp;вопросам кнопкой &laquo;дальше&raquo; или с&nbsp;клавиатуры&nbsp;&mdash;
        стрелка вправо. Прогресс сохраняется в&nbsp;браузере: можно закрыть
        и&nbsp;вернуться позже.
      </p>
    </div>

    <div class="brief-quiz__frame reveal">
      <!-- progress -->
      <div class="brief-quiz__progress">
        <div class="brief-quiz__progress-info">
          <span class="font-mono brief-quiz__step-num">
            <span id="bq-current">1</span>
            <span class="brief-quiz__step-sep">/</span>
            <span>{questions.length + 1}</span>
          </span>
          <span class="brief-quiz__step-title font-display" id="bq-title">Бизнес</span>
        </div>
        <div class="brief-quiz__bar">
          <span id="bq-bar" style="width: 8%"></span>
        </div>
      </div>

      <!-- steps -->
      <form class="brief-quiz__form" id="bq-form" autocomplete="off">
        {questions.map((q, i) => (
          <div class="bq-step" data-step={i + 1} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class="bq-step__head">
              <span class="bq-step__index font-mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="bq-step__q font-display">{q.q}</h3>
            </div>
            {q.hint && <p class="bq-step__hint">{q.hint}</p>}

            {q.type === 'textarea' && (
              <textarea
                name={q.id}
                class="bq-input bq-input--area"
                placeholder={q.placeholder ?? ''}
                rows="5"
                required={!q.optional}
              ></textarea>
            )}

            {q.type === 'select' && (
              <div class="bq-opts">
                {q.opts.map((opt, j) => (
                  <label class="bq-opt">
                    <input type="radio" name={q.id} value={opt} required={!q.optional} />
                    <span class="bq-opt__key">{String.fromCharCode(65 + j)}</span>
                    <span class="bq-opt__text">{opt}</span>
                  </label>
                ))}
              </div>
            )}

            {q.type === 'multi' && (
              <div class="bq-opts bq-opts--multi">
                {q.opts.map((opt, j) => (
                  <label class="bq-opt">
                    <input type="checkbox" name={`${q.id}[]`} value={opt} />
                    <span class="bq-opt__key">{String.fromCharCode(65 + j)}</span>
                    <span class="bq-opt__text">{opt}</span>
                  </label>
                ))}
              </div>
            )}

            <div class="bq-step__nav">
              {i > 0 && <button type="button" class="bq-btn bq-btn--ghost" data-prev>← назад</button>}
              <button type="button" class="bq-btn bq-btn--primary" data-next>
                {i === questions.length - 1 ? 'к контактам →' : 'дальше →'}
              </button>
            </div>
          </div>
        ))}

        <!-- contacts step -->
        <div class="bq-step" data-step={questions.length + 1} aria-hidden="true">
          <div class="bq-step__head">
            <span class="bq-step__index font-mono">{String(questions.length + 1).padStart(2, '0')}</span>
            <h3 class="bq-step__q font-display">Контакты</h3>
          </div>
          <p class="bq-step__hint">
            Куда отправлять смету и&nbsp;связаться с&nbsp;вами. Данные нужны только
            для общения по&nbsp;вашему проекту, без рассылок.
          </p>
          <div class="bq-contacts">
            {contact.map((c) => (
              <label class="bq-field">
                <span class="bq-field__label">{c.label}{c.required && <em>*</em>}</span>
                <input
                  class="bq-input"
                  type={c.type}
                  name={c.id}
                  placeholder={c.placeholder}
                  required={c.required}
                />
              </label>
            ))}
            <label class="bq-consent">
              <input type="checkbox" name="consent" required />
              <span>
                Согласен на&nbsp;обработку персональных данных для связи по&nbsp;проекту.
                Свои данные я&nbsp;не&nbsp;передаю третьим лицам.
              </span>
            </label>
          </div>

          <div class="bq-step__nav">
            <button type="button" class="bq-btn bq-btn--ghost" data-prev>← назад</button>
            <button type="submit" class="bq-btn bq-btn--primary bq-btn--submit">
              отправить бриф →
            </button>
          </div>
        </div>

      </form>

      <!-- success (вне формы — чтобы не скрывался вместе с ней) -->
      <div class="bq-success" id="bq-success" hidden>
        <div class="bq-success__icon">✓</div>
        <h3 class="bq-success__title font-display">Заявка отправлена</h3>
        <p class="bq-success__text">
          Спасибо! Данные получены. Изучу детали и&nbsp;вернусь
          со&nbsp;сметой и&nbsp;вопросами в&nbsp;течение 24&nbsp;часов&nbsp;—
          на&nbsp;Telegram или email.
        </p>
        <a href="/" class="bq-btn bq-btn--ghost">← на главную</a>
      </div>

      <!-- error -->
      <div class="bq-error" id="bq-error" hidden>
        <p>
          Не&nbsp;удалось отправить бриф автоматически. Пожалуйста, напишите мне
          в&nbsp;<a href="https://t.me/kirillbaryev">Telegram</a> или
          на&nbsp;<a href="mailto:frm.scrtch.team@gmail.com">email</a>&nbsp;—
          я&nbsp;помогу вручную.
        </p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ SHEETS_WEBHOOK, total: questions.length + 1, titles: [...questions.map((q, i) => `${String(i + 1).padStart(2, '0')} · ${q.q.slice(0, 36)}`), 'Контакты'] }}>
  const steps = document.querySelectorAll('.bq-step');
  const bar = document.getElementById('bq-bar');
  const cur = document.getElementById('bq-current');
  const titleEl = document.getElementById('bq-title');
  const form = document.getElementById('bq-form');
  const okEl = document.getElementById('bq-success');
  const errEl = document.getElementById('bq-error');
  const STORAGE_KEY = 'kirill-brief-v1';
  let current = 1;

  function setActive(n) {
    current = Math.max(1, Math.min(total, n));
    steps.forEach((s) => {
      const step = Number(s.getAttribute('data-step'));
      s.setAttribute('aria-hidden', step === current ? 'false' : 'true');
      s.classList.toggle('is-active', step === current);
    });
    if (bar) bar.style.width = (current / total * 100) + '%';
    if (cur) cur.textContent = String(current);
    if (titleEl) titleEl.textContent = titles[current - 1] || '';
    // плавный скролл к началу секции, чтобы пользователь видел текущий вопрос
    document.querySelector('.brief-quiz__frame')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function validateStep(n) {
    const s = document.querySelector(`.bq-step[data-step="${n}"]`);
    if (!s) return true;
    const required = s.querySelectorAll('input[required], textarea[required]');
    for (const el of required) {
      if (el.type === 'radio') {
        const group = s.querySelectorAll(`input[name="${el.name}"]`);
        if (![...group].some((r) => r.checked)) {
          el.focus();
          el.closest('.bq-opts')?.classList.add('is-error');
          return false;
        }
      } else if (!el.value.trim()) {
        el.focus();
        el.classList.add('is-error');
        return false;
      }
    }
    return true;
  }

  function saveDraft() {
    try {
      const data = serialize();
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ step: current, data }));
    } catch (_) {}
  }

  function loadDraft() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const { step, data } = JSON.parse(raw);
      if (data) {
        for (const [k, v] of Object.entries(data)) {
          if (Array.isArray(v)) {
            v.forEach((val) => {
              const el = form.querySelector(`input[name="${k}[]"][value="${CSS.escape(val)}"]`);
              if (el) el.checked = true;
            });
          } else {
            const el = form.querySelector(`[name="${k}"]`);
            if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA')) {
              if (el.type === 'radio') {
                const radio = form.querySelector(`input[name="${k}"][value="${CSS.escape(v)}"]`);
                if (radio) radio.checked = true;
              } else {
                el.value = v;
              }
            }
          }
        }
      }
      if (step) setActive(step);
    } catch (_) {}
  }

  function serialize() {
    const fd = new FormData(form);
    const data = {};
    for (const [k, v] of fd.entries()) {
      if (k.endsWith('[]')) {
        const key = k.slice(0, -2);
        if (!data[key]) data[key] = [];
        data[key].push(v);
      } else {
        data[k] = v;
      }
    }
    return data;
  }

  document.querySelectorAll('[data-next]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!validateStep(current)) return;
      saveDraft();
      setActive(current + 1);
    });
  });
  document.querySelectorAll('[data-prev]').forEach((btn) => {
    btn.addEventListener('click', () => { saveDraft(); setActive(current - 1); });
  });

  // снять is-error при первом изменении
  form.addEventListener('input', (e) => {
    e.target.classList?.remove('is-error');
    e.target.closest('.bq-opts')?.classList.remove('is-error');
    saveDraft();
  });

  // стрелки на клавиатуре
  document.addEventListener('keydown', (e) => {
    if (e.target.matches('input, textarea, select')) return;
    if (e.key === 'ArrowRight' && current < total) {
      if (validateStep(current)) setActive(current + 1);
    }
    if (e.key === 'ArrowLeft' && current > 1) setActive(current - 1);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validateStep(current)) return;
    const submitBtn = form.querySelector('.bq-btn--submit');
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'отправка...'; }
    const data = serialize();
    data.submittedAt = new Date().toISOString();
    data.referrer = document.referrer || '';
    data.userAgent = navigator.userAgent;

    try {
      if (SHEETS_WEBHOOK && SHEETS_WEBHOOK.startsWith('http')) {
        await fetch(SHEETS_WEBHOOK, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(data),
        });
      }
      form.style.display = 'none';
      okEl.hidden = false;
      okEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      localStorage.removeItem(STORAGE_KEY);
    } catch (err) {
      console.error(err);
      errEl.hidden = false;
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'отправить бриф →'; }
    }
  });

  loadDraft();
  setActive(current);
</script>

<style>
  .brief-quiz { padding: 60px 0 100px; }
  .brief-quiz__head { max-width: 720px; margin-bottom: 36px; }
  .brief-quiz__head .display-h {
    margin-top: 18px;
    font-size: clamp(36px, 5.6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .brief-quiz__head .display-h em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-muted);
  }
  .brief-quiz__lead {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
    max-width: 540px;
  }

  .brief-quiz__frame {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .brief-quiz__progress {
    padding: 22px 26px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .brief-quiz__progress-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 14px;
  }
  .brief-quiz__step-num {
    font-size: 13px;
    color: var(--color-muted);
    letter-spacing: 1px;
  }
  .brief-quiz__step-num span:first-child { color: var(--color-text); font-weight: 600; }
  .brief-quiz__step-sep { margin: 0 4px; }
  .brief-quiz__step-title {
    font-size: 16px;
    color: var(--color-text);
    letter-spacing: -0.01em;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60%;
  }
  .brief-quiz__bar {
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  .brief-quiz__bar > span {
    display: block;
    height: 100%;
    background: var(--color-text);
    transition: width 0.5s cubic-bezier(.22,1,.36,1);
  }

  .brief-quiz__form { padding: 0; position: relative; min-height: 480px; }

  .bq-step {
    padding: 36px 28px 28px;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    inset: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .bq-step.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    position: relative;
    inset: auto;
  }

  .bq-step__head {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin-bottom: 12px;
  }
  .bq-step__index {
    font-size: 12px;
    color: var(--color-muted-2);
    letter-spacing: 1.5px;
  }
  .bq-step__q {
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .bq-step__hint {
    margin: 0 0 22px;
    color: var(--color-muted);
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 600px;
  }

  .bq-input {
    width: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 14px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: var(--color-text);
    transition: border-color 0.2s, background 0.2s;
  }
  .bq-input:focus {
    outline: none;
    border-color: var(--color-text);
    background: var(--color-bg-2);
  }
  .bq-input.is-error { border-color: #d04d4d; }
  .bq-input--area { min-height: 130px; resize: vertical; font-family: 'Inter', sans-serif; }
  .bq-input::placeholder { color: var(--color-muted-2); }

  .bq-opts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bq-opts.is-error .bq-opt { border-color: #d04d4d; }
  .bq-opt {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s ease;
    align-items: center;
  }
  .bq-opt:hover {
    border-color: var(--color-border-2);
    background: var(--color-bg-2);
  }
  .bq-opt input { display: none; }
  .bq-opt__key {
    width: 24px; height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-border-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--color-muted);
    background: var(--color-bg-2);
    transition: all 0.2s;
  }
  .bq-opt:has(input:checked) {
    border-color: var(--color-text);
    background: var(--color-bg-2);
  }
  .bq-opt:has(input:checked) .bq-opt__key {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .bq-opt__text { font-size: 14.5px; color: var(--color-text); }

  .bq-step__nav {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .bq-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border-radius: 6px;
    border: 1px solid var(--color-border-2);
    background: transparent;
    color: var(--color-text);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .bq-btn:hover { border-color: var(--color-text); }
  .bq-btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .bq-btn--primary:hover { background: var(--color-muted); border-color: var(--color-muted); }
  .bq-btn--ghost:hover { background: var(--color-bg-2); }
  .bq-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* contacts */
  .bq-contacts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .bq-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bq-field__label {
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.3px;
  }
  .bq-field__label em {
    color: #d04d4d;
    font-style: normal;
    margin-left: 2px;
  }
  .bq-consent {
    margin-top: 8px;
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.55;
    cursor: pointer;
  }
  .bq-consent input { margin-top: 3px; flex-shrink: 0; }

  /* success */
  .bq-success {
    padding: 60px 28px;
    text-align: center;
  }
  .bq-success__icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 600;
  }
  .bq-success__title {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }
  .bq-success__text {

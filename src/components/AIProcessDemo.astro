---
import Arrow from './Arrow.astro';
const chapters = ['Собирает информацию', 'Помнит контекст', 'Готовит результат', 'Отвечает команде'];
const questions = [
  { question:'Что решили по сайту?', answer:'Макет согласован. На первом экране — одна кнопка, заявки направляем в Telegram. Форму на первом запуске не используем.', sources:['Чат проекта','Память проекта'] },
  { question:'Кто делает мобильную версию?', answer:'На созвоне договорились: Кирилл собирает мобильную версию к пятнице. Система выделила это в предложение задачи.', sources:['Созвон','Предложение задачи'] },
  { question:'Почему на сайте нет формы?', answer:'В переписке решили пока убрать форму и вести заявки в Telegram. Это решение сохранено в контексте проекта.', sources:['Чат проекта','Память проекта'] },
];
---
<article class="ai-project" id="case-ai-project-manager" data-case="ai-project-manager">
  <div class="ai-project__intro"><div><h3>AI Project Manager</h3><span>AI-помощник для рабочей команды</span></div><p>Читает переписку и созвоны, помнит решения и предлагает задачи. Можно спросить о проекте — и получить ответ с источниками.</p></div>
  <div class="ai-film" data-ai-demo>
    <div class="film-heading"><div class="film-caption" role="status" aria-live="polite"><h4 data-film-title>Отвечает по контексту проекта.</h4><p data-film-description>Команда задаёт вопрос. AI находит ответ в переписке, созвонах и сохранённых решениях.</p></div><button class="film-play" type="button" data-film-play hidden><span>Смотреть историю</span><Arrow size={18}/></button></div>
    <nav class="film-chapters" aria-label="Как работает AI Project Manager" data-film-controls hidden>{chapters.map((chapter,index)=><button type="button" data-film-chapter={index} aria-pressed="false"><span class="chapter-number">0{index+1}</span><span>{chapter}</span><i aria-hidden="true"></i></button>)}</nav>
    <div class="film-screen">
      <section class="film-act film-input" data-film-act="0" aria-label="Переписка и созвон" hidden>
        <div class="source-paper source-chat" data-motion="chat"><div class="paper-head"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v12H9l-5 4V4Z" stroke="currentColor" stroke-width="1.5"/></svg><span>Чат проекта</span></div><p>Макет согласовали.<br/>На первом экране — <strong>одна кнопка.</strong></p><span class="paper-foot">Решение команды</span></div>
        <div class="source-paper source-call" data-motion="call"><div class="paper-head"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6m4-9v12m4-15v18m4-15v12m4-9v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Запись созвона</span></div><div class="voice-wave" aria-hidden="true">{Array.from({length:27},(_,i)=><i style={`--bar:${12+((i*17)%30)}px`}></i>)}</div><p data-motion="transcript">«Кирилл, собери <strong>мобильную версию к пятнице.</strong>»</p></div>
        <div class="source-paper source-reply" data-motion="reply"><div class="paper-head"><span>Уточнение в переписке</span><span class="source-dot"></span></div><p>Форму пока убираем.<br/>Заявки — <strong>в Telegram.</strong></p><span class="paper-foot">Тот же проект · новое решение</span></div>
        <span class="input-thread" aria-hidden="true" data-motion="thread"></span>
      </section>
      <section class="film-act film-memory" data-film-act="1" aria-label="Память проекта" hidden>
        <svg class="memory-routes" viewBox="0 0 1000 400" preserveAspectRatio="none" fill="none" aria-hidden="true"><path data-route d="M80 90C240 90 230 180 400 180M920 90C760 90 770 180 600 180M150 330C260 330 270 250 400 250"/><circle data-packet="0" cx="80" cy="90" r="6"/><circle data-packet="1" cx="920" cy="90" r="6"/><circle data-packet="2" cx="150" cy="330" r="6"/></svg>
        <span class="memory-source memory-source--chat" data-motion="memory-source">Переписка</span><span class="memory-source memory-source--call" data-motion="memory-source">Созвон</span><span class="memory-source memory-source--past" data-motion="memory-source">Прошлые решения</span>
        <div class="memory-stack"><span class="memory-layer" data-motion="layer" aria-hidden="true"></span><span class="memory-layer memory-layer--back" data-motion="layer" aria-hidden="true"></span><div class="memory-page" data-motion="memory-page"><div class="paper-head"><span>Память проекта</span><span>Новый сайт</span></div><h5>Всё связано.</h5><div class="memory-facts"><p data-motion="fact"><span>Дизайн</span><strong>Макет согласован. Одна кнопка.</strong></p><p data-motion="fact"><span>Заявки</span><strong>В Telegram, без формы.</strong></p><p data-motion="fact"><span>Следующий шаг</span><strong>Мобильная версия к пятнице.</strong></p></div><div class="memory-stamp" data-motion="stamp">Сообщения + созвон + история проекта</div></div></div>
      </section>
      <section class="film-act film-results" data-film-act="2" aria-label="Саммари и предложение задачи" hidden>
        <div class="result-summary" data-motion="summary"><div class="paper-head"><span>Саммари и решения</span><span>После созвона</span></div><h5>Вот о чём договорились.</h5><div class="summary-lines"><p data-motion="summary-line"><span>01</span>Макет сайта согласован.</p><p data-motion="summary-line"><span>02</span>На первом экране одна кнопка.</p><p data-motion="summary-line"><span>03</span>Все заявки идут в Telegram.</p></div><span class="summary-source">Источники: переписка и созвон</span></div>
        <div class="result-task" data-motion="task"><div class="paper-head"><span data-task-state>Предложение задачи</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8"/></svg></div><h5>Собрать мобильную версию</h5><dl><div data-motion="task-field"><dt>Ответственный</dt><dd>Кирилл</dd></div><div data-motion="task-field"><dt>Срок</dt><dd>Пятница</dd></div></dl><button type="button" class="task-confirm" data-task-confirm hidden><span>Подтвердить в демо</span><Arrow size={18}/></button><p class="task-note" data-task-note>Задача применяется после подтверждения человеком.</p></div>
      </section>
      <section class="film-act film-answer" data-film-act="3" aria-label="Ответ по источникам">
        <div class="question-bubble" data-motion="question"><span>Вы спрашиваете</span><p data-film-question>{questions[0].question}</p></div>
        <div class="answer-paper" data-motion="answer"><div class="paper-head"><span class="answer-mark" aria-hidden="true">AI</span><span>Project Manager</span><span class="answer-context">Помнит проект</span></div><p class="answer-copy" role="status" aria-live="polite" data-film-answer>{questions[0].answer}</p><div class="answer-sources"><span>Откуда ответ</span><noscript>Чат проекта · Память проекта</noscript><button type="button" data-answer-source="0" hidden>Чат проекта <Arrow size={13}/></button><button type="button" data-answer-source="1" hidden>Память проекта <Arrow size={13}/></button></div></div>
        <div class="question-choices" role="group" aria-label="Попробуйте спросить о проекте" data-film-controls hidden>{questions.map((_item,index)=><button type="button" data-film-ask={index} aria-pressed={index===0?'true':'false'}>{index===0?'Что решили?':index===1?'Кто делает?':'Почему без формы?'}</button>)}</div>
      </section>
    </div>
    <div class="film-footer"><p class="film-disclaimer">Сценарий на вымышленных данных. Показана логика системы, без доступа к рабочим чатам.</p></div>
    <script is:inline type="application/json" data-film-questions set:html={JSON.stringify(questions).replace(/</g,'\\u003c')}/>
  </div>
</article>
<style>
  .ai-project { border-top:1px solid var(--line); padding:38px 0 42px; }
  .ai-project__intro { display:grid; grid-template-columns:1fr 1fr; gap:9%; margin-bottom:30px; }.ai-project__intro h3 { font-size:clamp(28px,3vw,46px); font-weight:550; line-height:1.1; letter-spacing:-.035em; }.ai-project__intro span { display:block; color:var(--muted); font-size:12px; margin-top:12px; }.ai-project__intro p { font-size:18px; line-height:1.5; max-width:510px; }
  .ai-film { scroll-margin-top:24px; background:#dfdffd; border-radius:18px; overflow:hidden; isolation:isolate; }
  .film-heading { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:30px 34px 0; }.film-caption { flex:1; min-height:90px; }.film-caption h4 { font-size:clamp(24px,2.8vw,38px); letter-spacing:-.035em; line-height:1.12; font-weight:550; margin:0 0 12px; }.film-caption p { font-size:14px; line-height:1.5; color:#4b4b66; max-width:650px; }.film-play { display:inline-flex; align-items:center; justify-content:space-between; gap:16px; flex-shrink:0; min-width:164px; min-height:46px; padding:0 18px; border:0; border-radius:12px; background:var(--text); color:#fff; font-size:12px; }.film-play:hover { background:var(--accent); }.film-play:active { transform:scale(.97); }
  .film-screen { position:relative; height:405px; overflow:hidden; perspective:1100px; }.film-act { position:absolute; inset:0; }
  .paper-head { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:11px; color:#595970; margin-bottom:18px; }.paper-head svg { width:22px; height:22px; flex-shrink:0; }.paper-head svg+span { margin-right:auto; }.paper-foot { display:block; font-size:10px; color:#62627a; margin-top:20px; }.source-paper { position:absolute; width:31%; padding:24px; background:#fbfbff; border-radius:14px; box-shadow:0 20px 40px -26px #29245860; z-index:2; }.source-paper p { font-size:20px; line-height:1.45; letter-spacing:-.02em; }.source-paper strong { font-weight:500; color:#3439c1; }.source-chat { left:4%; top:28px; transform:rotate(-4deg); }.source-call { left:35%; top:100px; transform:rotate(3deg); z-index:3; background:#4951f8; color:#fff; }.source-call .paper-head { color:#e1e1ff; }.source-call strong { color:white; font-weight:650; }.source-reply { right:3%; top:50px; transform:rotate(-2deg); }.source-dot { width:7px; height:7px; border-radius:50%; background:#4951f8; }.voice-wave { height:44px; display:flex; align-items:center; gap:4px; margin:0 0 18px; }.voice-wave i { width:4px; height:var(--bar); background:#c4c7ff; border-radius:3px; transform-origin:center; }.input-thread { position:absolute; width:74%; height:120px; border:1px solid #aaaadd; border-radius:50%; left:13%; bottom:30px; transform:rotate(-7deg); }
  .memory-routes { position:absolute; inset:0; width:100%; height:100%; }.memory-routes path { stroke:#8c8ee0; stroke-width:1.5; }.memory-routes circle { fill:#4951f8; }.memory-source { position:absolute; z-index:3; background:#f6f6ff; border-radius:22px; padding:10px 16px; font-size:12px; box-shadow:0 12px 26px -18px #38306a66; }.memory-source--chat { left:5%; top:65px; }.memory-source--call { right:5%; top:65px; }.memory-source--past { left:8%; bottom:50px; }
  .memory-stack { position:absolute; width:440px; max-width:55%; top:35px; left:50%; transform:translateX(-50%); }.memory-layer { position:absolute; inset:0; border-radius:14px; background:#aaaaff; transform:rotate(-7deg) translate(-8px,7px); }.memory-layer--back { background:#c4c4f5; transform:rotate(6deg) translate(10px,13px); }.memory-page { position:relative; padding:24px 28px; border-radius:14px; background:#fbfbff; box-shadow:0 24px 50px -30px #29245880; }.memory-page h5 { font-size:35px; letter-spacing:-.035em; margin:0 0 20px; font-weight:550; line-height:1.1; }.memory-facts p { display:flex; flex-direction:column; gap:4px; margin-top:14px; }.memory-facts span { font-size:10px; color:#65657d; }.memory-facts strong { font-weight:500; font-size:15px; }.memory-stamp { font-size:10px; margin-top:20px; color:#3036b5; border-top:1px solid #dadaed; padding-top:14px; }
  .film-results { display:flex; align-items:center; justify-content:center; gap:24px; padding:30px 7%; }.result-summary,.result-task { width:48%; max-width:445px; padding:26px; border-radius:14px; box-shadow:0 22px 45px -28px #29245870; }.result-summary { background:#fbfbff; transform:rotate(-3deg); }.result-task { background:#4951f8; color:#fff; transform:rotate(2deg); }.result-task .paper-head { color:#e0e2ff; }.result-summary h5,.result-task h5 { font-size:27px; line-height:1.15; letter-spacing:-.025em; margin:0 0 24px; font-weight:550; }.summary-lines p { display:flex; gap:12px; font-size:14px; margin-top:15px; }.summary-lines p span { color:#777795; font-size:10px; padding-top:3px; }.summary-source { display:block; font-size:10px; margin-top:25px; color:#62627a; }.result-task dl { display:flex; gap:40px; margin:0 0 24px; }.result-task dt { font-size:10px; color:#e0e2ff; margin-bottom:5px; }.result-task dd { margin:0; font-size:17px; }.task-confirm { display:flex; align-items:center; justify-content:space-between; gap:15px; width:100%; min-height:44px; background:#fff; color:#242675; border:0; border-radius:10px; padding:0 15px; font-size:12px; }.task-confirm[aria-disabled=true] { opacity:1; background:#dbe0ff; color:#20245d; cursor:default; }.task-note { font-size:10px; color:#e0e2ff; margin-top:13px; min-height:29px; }.task-confirm:focus-visible { outline-color:#fff; }
  .film-answer { padding:20px 10% 16px; display:flex; flex-direction:column; justify-content:center; }.question-bubble { align-self:flex-end; border-radius:14px 14px 2px 14px; padding:14px 22px; background:#4951f8; color:#fff; margin-bottom:16px; max-width:80%; }.question-bubble>span { display:block; font-size:10px; color:#dddfff; margin-bottom:5px; }.question-bubble p { font-size:18px; letter-spacing:-.015em; }.answer-paper { width:85%; padding:22px 26px; background:#fbfbff; border-radius:14px 14px 14px 2px; box-shadow:0 20px 40px -28px #29245860; }.answer-paper .paper-head { justify-content:flex-start; margin-bottom:16px; }.answer-mark { display:grid; place-items:center; width:30px; height:30px; background:#e7e7ff; color:#3b40ca; font-size:12px; font-weight:650; border-radius:9px; }.answer-context { margin-left:auto; font-size:10px; color:#62627a; }.answer-copy { font-size:19px; line-height:1.5; letter-spacing:-.015em; min-height:86px; }.answer-sources { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-top:18px; font-size:10px; color:#62627a; }.answer-sources button { display:inline-flex; align-items:center; gap:7px; min-height:32px; padding:0 10px; border:0; border-radius:18px; background:#e6e6fc; color:#3036b5; font-size:10px; }.question-choices { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:8px; margin-top:18px; }.question-choices button { min-height:40px; border:1px solid #a7a7d2; border-radius:22px; padding:0 15px; background:transparent; font-size:11px; color:#37375d; transition:background .25s,color .25s; }.question-choices button[aria-pressed=true] { background:#10111a; color:#fff; border-color:#10111a; }
  .film-footer { padding:12px 34px 22px; }.film-chapters { padding:8px 34px 12px; display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }.film-chapters button { position:relative; min-height:52px; text-align:left; display:flex; align-items:center; gap:10px; padding:10px 0; border:0; background:none; font-size:12px; color:#595973; }.chapter-number { font-size:10px; font-variant-numeric:tabular-nums; }.film-chapters button::after { position:absolute; content:''; bottom:0; left:0; width:100%; height:2px; background:#b5b5dc; }.film-chapters button i { position:absolute; bottom:0; left:0; width:100%; height:2px; background:#4951f8; z-index:1; transform:scaleX(0); transform-origin:left; }.film-chapters button[aria-pressed=true] { color:#3036b5; font-weight:600; }.film-disclaimer { margin-top:18px; font-size:10px; line-height:1.5; color:#555570; }
  .film-act[hidden],.film-play[hidden],[data-film-controls][hidden],.task-confirm[hidden],[data-answer-source][hidden] { display:none; }
  @media(max-width:900px) { .film-heading { padding:24px 24px 0; }.film-caption { min-height:110px; }.film-caption h4 { font-size:28px; }.film-caption p { font-size:13px; }.film-screen { height:410px; }.source-paper { padding:20px; }.source-paper p { font-size:16px; }.source-chat { left:3%; }.source-call { top:140px; left:30%; width:39%; }.source-reply { right:3%; width:34%; }.memory-source { padding:8px 12px; font-size:10px; }.memory-stack { max-width:62%; }.memory-page { padding:22px; }.film-results { padding:25px 4%; gap:16px; }.result-summary,.result-task { padding:22px; }.result-summary h5,.result-task h5 { font-size:23px; }.summary-lines p { font-size:12px; }.result-task dl { gap:24px; }.film-answer { padding:20px 5%; }.answer-copy { font-size:17px; }.film-chapters { padding:8px 24px 12px; }.film-chapters button { font-size:11px; }.film-footer { padding:10px 24px 20px; } }
  @media(max-width:600px) { .ai-project { padding:28px 0 32px; }.ai-project__intro { grid-template-columns:1fr; gap:16px; margin-bottom:22px; }.ai-project__intro h3 { font-size:30px; }.ai-project__intro p { font-size:15px; }.film-heading { padding:22px 18px 0; display:grid; gap:12px; }.film-caption { min-height:110px; }.film-caption h4 { font-size:28px; max-width:300px; }.film-caption p { font-size:12px; }.film-play { justify-self:start; min-width:162px; }.film-screen { height:540px; }.source-paper { padding:17px 19px; width:76%; }.source-paper p { font-size:16px; }.source-paper .paper-head { margin-bottom:12px; font-size:10px; }.source-paper .paper-foot { margin-top:12px; font-size:9px; }.source-chat { left:6%; top:24px; transform:rotate(-4deg); }.source-call { left:auto; right:4%; top:165px; width:80%; }.source-reply { left:7%; right:auto; top:326px; width:76%; }.source-call p { font-size:15px; }.voice-wave { margin-bottom:10px; height:32px; gap:3px; }.voice-wave i { height:calc(var(--bar)*.75); width:3px; }.input-thread { left:15%; width:70%; top:70px; height:300px; transform:rotate(-14deg); }.memory-stack { max-width:none; width:78%; top:91px; }.memory-page { padding:21px; }.memory-page h5 { font-size:30px; margin-bottom:18px; }.memory-facts strong { font-size:13px; }.memory-stamp { font-size:9px; }.memory-source--chat { left:5%; top:27px; }.memory-source--call { right:5%; top:50px; }.memory-source--past { left:12%; bottom:22px; }.memory-routes { opacity:.6; }.film-results { display:block; padding:0; }.result-summary,.result-task { position:absolute; padding:18px; width:90%; max-width:none; }.result-summary { left:5%; top:22px; transform:rotate(-3deg); }.result-task { right:5%; top:245px; transform:rotate(2deg); }.result-summary .paper-head,.result-task .paper-head { margin-bottom:10px; font-size:9px; }.result-summary h5,.result-task h5 { font-size:21px; margin-bottom:13px; }.summary-lines p { font-size:11px; margin-top:9px; }.summary-source { margin-top:12px; font-size:8px; }.result-task dl { margin-bottom:14px; }.result-task dd { font-size:15px; }.task-note { font-size:9px; margin-top:10px; min-height:0; }.task-confirm { font-size:11px; }.film-answer { padding:22px 18px 8px; justify-content:flex-start; }.question-bubble { padding:12px 16px; max-width:96%; margin-bottom:14px; }.question-bubble p { font-size:15px; }.answer-paper { width:100%; padding:17px 18px; }.answer-paper .paper-head { gap:8px; font-size:10px; margin-bottom:12px; }.answer-context { font-size:8px; }.answer-copy { font-size:15px; min-height:113px; }.answer-sources { gap:6px; margin-top:12px; }.answer-sources>span { width:100%; font-size:9px; }.answer-sources button { font-size:9px; min-height:34px; padding:0 9px; }.question-choices { gap:6px; justify-content:flex-start; margin-top:14px; }.question-choices button { font-size:10px; padding:0 10px; min-height:36px; }.film-footer { padding:4px 18px 20px; }.film-chapters { gap:9px; padding:4px 18px 10px; }.film-chapters button { font-size:9px; flex-direction:column; align-items:flex-start; gap:6px; line-height:1.3; min-height:64px; }.chapter-number { font-size:9px; }.film-disclaimer { font-size:9px; margin-top:14px; } }
</style>

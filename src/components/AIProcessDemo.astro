---
import Arrow from './Arrow.astro';
const samples = [
  { title:'После созвона', label:'Фрагмент обсуждения', lead:'Соберём ', task:'прототип первого экрана', middle:'. Ответственный — ', owner:'Кирилл', tail:'. Результат — ', due:'в пятницу', ending:'.' },
  { title:'Из переписки', label:'Сообщение в рабочем чате', lead:'Для бота нужен ', task:'список вопросов для заявки', middle:'. Готовит ', owner:'Анна', tail:'. Ждём ', due:'в среду', ending:'.' },
];
---
<article class="ai-project" id="case-ai-project-manager" data-case="ai-project-manager">
  <div class="ai-project__intro"><div><h3>AI Project Manager</h3><span>Закрытая рабочая система</span></div><p>Из созвонов и переписки — в саммари, договорённости и задачи. С памятью о контексте проекта.</p></div>
  <div class="ai-demo" data-ai-demo>
    <div class="demo-toolbar"><p>Из разговора — <strong>в задачу.</strong></p><div class="demo-samples" role="group" aria-label="Пример для разбора" data-demo-controls hidden>{samples.map((sample,index)=><button type="button" data-demo-choice={index} aria-pressed={index===0?'true':'false'}>{sample.title}</button>)}</div></div>
    <p class="demo-note">Интерактивная схема на вымышленных данных.</p>
    {samples.map((sample,index)=><div class="demo-scene" data-demo-scene={index} hidden={index>0}>
      <div class="demo-message"><span class="demo-label">{sample.label}</span><p>{sample.lead}<mark data-source="task">{sample.task}</mark>{sample.middle}<mark data-source="owner">{sample.owner}</mark>{sample.tail}<mark data-source="due">{sample.due}</mark>{sample.ending}</p><span class="demo-message__tail" aria-hidden="true"></span></div>
      <div class="demo-route" aria-hidden="true"><svg viewBox="0 0 100 160" fill="none"><path class="demo-route__base" d="M0 80H28C50 80 50 30 70 30H100M28 80H100M28 80C50 80 50 130 70 130H100"/><path class="demo-route__signal" d="M0 80H28C50 80 50 30 70 30H100M28 80H100M28 80C50 80 50 130 70 130H100"/></svg></div>
      <div class="demo-output"><span class="demo-label">Черновик задачи</span><div class="demo-placeholder" aria-hidden="true"><span></span><span></span><span></span><p>Здесь появится разбор</p></div><dl class="demo-result"><div data-result="task"><dt>Что сделать</dt><dd>{sample.task}</dd></div><div data-result="owner"><dt>Кто отвечает</dt><dd>{sample.owner}</dd></div><div data-result="due"><dt>Когда</dt><dd>{sample.due}</dd></div></dl></div>
    </div>)}
    <div class="demo-timeline" data-demo-timeline hidden aria-hidden="true"><div class="demo-timeline__labels"><span data-demo-step>Обсуждение</span><span data-demo-step>Разбор</span><span data-demo-step>Задача</span></div><div class="demo-timeline__track"><span data-demo-progress></span></div></div>
    <div class="demo-footer"><p class="demo-status" data-demo-status role="status" aria-live="polite">Договорённость становится черновиком задачи для проверки.</p><button type="button" class="demo-run" data-demo-run hidden aria-pressed="false"><span>Проиграть</span><Arrow size={18}/></button></div>
  </div>
</article>
<style>
  .ai-project { border-top:1px solid var(--line); padding:38px 0 42px; }
  .ai-project__intro { display:grid; grid-template-columns:1fr 1fr; gap:9%; align-items:start; margin-bottom:30px; }.ai-project__intro h3 { font-size:clamp(28px,3vw,46px); font-weight:550; line-height:1.1; letter-spacing:-.035em; }.ai-project__intro span { display:block; color:var(--muted); font-size:12px; margin-top:12px; }.ai-project__intro p { font-size:18px; line-height:1.5; max-width:490px; }
  .ai-demo { position:relative; isolation:isolate; background:var(--surface); padding:30px 34px 24px; border-radius:16px; }
  .demo-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:12px; }.demo-toolbar>p { font-size:23px; letter-spacing:-.025em; }.demo-toolbar strong { font-weight:500; color:var(--accent); }
  .demo-samples { display:flex; gap:4px; padding:4px; border-radius:26px; background:#cfcff1; }.demo-samples[hidden] { display:none; }.demo-samples button { background:transparent; border:0; padding:0 16px; min-height:40px; border-radius:22px; font-size:12px; transition:background .25s,color .25s; }.demo-samples button[aria-pressed=true] { background:var(--text); color:#fff; }
  .demo-scene { display:grid; grid-template-columns:1fr 100px 1fr; align-items:stretch; position:relative; }.demo-scene[hidden] { display:none; }
  .demo-label { display:block; font-size:11px; color:var(--muted); margin-bottom:20px; }
  .demo-message { position:relative; background:var(--bg); padding:25px 28px 30px; border-radius:14px 14px 14px 2px; }.demo-message>p { font-size:clamp(16px,1.6vw,22px); line-height:1.55; letter-spacing:-.015em; }.demo-message mark { background:transparent; color:inherit; padding:2px 0; box-decoration-break:clone; -webkit-box-decoration-break:clone; transition:background .35s,color .35s; }.demo-message mark.is-found { background:#d8d8ff; color:#3036b5; }.demo-message__tail { position:absolute; bottom:-12px; left:0; width:16px; height:16px; background:var(--bg); clip-path:polygon(0 0,100% 0,0 100%); }
  .demo-route { align-self:center; }.demo-route svg { width:100%; display:block; }.demo-route path { stroke-width:1.5; }.demo-route__base { stroke:#b8b8e5; }.demo-route__signal { stroke:var(--accent); opacity:0; }
  .demo-output { position:relative; padding:25px 28px; background:#f9f9ff; border-radius:14px; min-height:250px; }
  .demo-result { margin:0; }.demo-result>div { padding-bottom:13px; }.demo-result>div+div { border-top:1px solid var(--line-soft); padding-top:11px; }.demo-result>div:last-child { padding-bottom:0; }.demo-result dt { font-size:10px; color:var(--muted); margin-bottom:5px; }.demo-result dd { margin:0; font-size:16px; line-height:1.35; }.demo-result>div:first-child dd { font-size:20px; letter-spacing:-.02em; }
  .demo-placeholder { display:none; position:absolute; inset:65px 28px 25px; }.demo-placeholder>span { display:block; height:10px; border-radius:5px; background:#e0e0ef; width:85%; margin-bottom:12px; }.demo-placeholder>span:nth-child(2) { width:65%; }.demo-placeholder>span:nth-child(3) { width:45%; }.demo-placeholder p { color:var(--muted); font-size:13px; margin-top:28px; }
  .ai-demo.is-ready .demo-placeholder { display:block; }
  .demo-timeline { margin-top:26px; }.demo-timeline[hidden] { display:none; }.demo-timeline__labels { display:flex; justify-content:space-between; font-size:11px; color:#565672; margin-bottom:10px; }.demo-timeline__labels .is-active { color:#3036b5; }.demo-timeline__track { height:2px; background:#b8b8e5; }.demo-timeline__track span { display:block; height:100%; background:var(--accent); transform:scaleX(0); transform-origin:left; }
  .ai-demo :global([data-demo-flight]) { position:absolute; top:0; left:0; z-index:3; pointer-events:none; padding:7px 12px; border-radius:8px; background:var(--accent); color:#fff; font-size:12px; line-height:1.4; max-width:min(220px,calc(100% - 40px)); box-shadow:0 12px 24px -14px #2c287060; }
  .ai-demo.is-reduced .demo-run { display:none; }
  .demo-footer { margin-top:16px; display:flex; align-items:center; justify-content:space-between; gap:22px; }.demo-run { display:inline-flex; align-items:center; justify-content:center; gap:20px; min-height:44px; padding:0 18px; border:0; border-radius:12px; color:#fff; background:var(--text); font-size:12px; white-space:nowrap; transition:background .25s,transform .3s var(--ease); }.demo-run[hidden] { display:none; }.demo-run:hover { background:var(--accent); }.demo-run:active { transform:scale(.97); }.demo-run[aria-disabled=true] { cursor:progress; background:#55556b; }.demo-run svg { transition:transform .4s var(--ease); }.demo-run:hover svg { transform:translate(3px,-3px); }.demo-status { font-size:12px; max-width:360px; color:#4e4e68; }.demo-note { margin:0 0 22px; font-size:11px; color:#51516b; }
  @media(max-width:900px) { .demo-toolbar { align-items:flex-start; flex-direction:column; gap:16px; }.demo-scene { grid-template-columns:1fr 50px 1fr; }.demo-message,.demo-output { padding:22px; }.demo-result>div:first-child dd { font-size:18px; } }
  @media(max-width:600px) { .ai-project { padding:28px 0 32px; }.ai-project__intro { grid-template-columns:1fr; gap:18px; margin-bottom:22px; }.ai-project__intro h3 { font-size:30px; }.ai-project__intro p { font-size:15px; }.ai-demo { padding:22px 18px 18px; display:flex; flex-direction:column; }.demo-toolbar { margin-bottom:12px; }.demo-toolbar>p { font-size:21px; }.demo-samples { width:100%; }.demo-samples button { flex:1; padding:0 10px; }.demo-scene { order:3; grid-template-columns:1fr; gap:22px; }.demo-route { display:none; }.demo-message { padding:18px 20px; }.demo-message>p { font-size:16px; }.demo-label { margin-bottom:12px; }.demo-output { padding:18px 20px; min-height:226px; }.demo-placeholder { inset:54px 20px 20px; }.demo-result>div:first-child dd { font-size:18px; }.demo-result>div { padding-bottom:10px; }.demo-result>div+div { padding-top:8px; }.demo-timeline { order:1; margin:0 0 12px; }.demo-footer { order:2; gap:12px; margin:0 0 20px; }.demo-status { flex:1; min-height:48px; font-size:11px; line-height:1.45; }.demo-run { gap:8px; padding:0 12px; min-width:126px; }.demo-note { order:0; font-size:11px; margin:0 0 16px; } }
</style>

---
import Arrow from './Arrow.astro';
const samples = [
  { title:'После созвона', label:'Фрагмент обсуждения', lead:'Соберём ', task:'прототип первого экрана', middle:'. Ответственный — ', owner:'Кирилл', tail:'. Результат — ', due:'в пятницу', ending:'.' },
  { title:'Из переписки', label:'Сообщение в рабочем чате', lead:'Для бота нужен ', task:'список вопросов для заявки', middle:'. Готовит ', owner:'Анна', tail:'. Ждём ', due:'в среду', ending:'.' },
];
const steps = ['Сообщение', 'Задача', 'Кто и когда', 'Результат'];
---
<article class="ai-project" id="case-ai-project-manager" data-case="ai-project-manager">
  <div class="ai-project__intro"><div><h3>AI Project Manager</h3><span>Закрытая рабочая система</span></div><p>Из созвонов и переписки — в саммари, договорённости и задачи. С памятью о контексте проекта.</p></div>
  <div class="ai-demo" data-ai-demo>
    <div class="demo-toolbar"><p>Из разговора — <strong>в задачу.</strong></p><div class="demo-samples" role="group" aria-label="Пример для разбора" data-demo-controls hidden>{samples.map((sample,index)=><button type="button" data-demo-choice={index} aria-pressed={index===0?'true':'false'}>{sample.title}</button>)}</div></div>
    <p class="demo-note">Демонстрация на вымышленных данных. <span data-demo-controls hidden>Каждый шаг можно выбрать вручную.</span></p>
    <div class="demo-steps" role="group" aria-label="Шаги разбора AI" data-demo-controls hidden>{steps.map((step,index)=><button type="button" data-demo-step={index} aria-pressed="false"><span aria-hidden="true">0{index+1}</span>{step}</button>)}</div>
    <div class="demo-narration">
      <div class="demo-explanation" role="status" aria-live="polite" aria-atomic="true"><h4 data-demo-title>Черновик готов к проверке</h4><p data-demo-status>Задача, ответственный и срок собраны из сообщения. Человек проверяет детали.</p></div>
      <button type="button" class="demo-run" data-demo-run hidden><span>Смотреть разбор</span><Arrow size={18}/></button>
    </div>
    {samples.map((sample,index)=><div class="demo-scene" data-demo-scene={index} hidden={index>0}>
      <div class="demo-message"><span class="demo-label">На входе · {sample.label.toLowerCase()}</span><p>{sample.lead}<mark data-source="task">{sample.task}</mark>{sample.middle}<mark data-source="owner">{sample.owner}</mark>{sample.tail}<mark data-source="due">{sample.due}</mark>{sample.ending}</p><span class="demo-message__tail" aria-hidden="true"></span></div>
      <div class="demo-route" aria-hidden="true"><svg viewBox="0 0 72 160" fill="none"><path class="demo-route__base" d="M0 80H20C36 80 36 30 48 30H72M20 80H72M20 80C36 80 36 130 48 130H72"/><path class="demo-route__signal" d="M0 80H20C36 80 36 30 48 30H72M20 80H72M20 80C36 80 36 130 48 130H72"/></svg></div>
      <div class="demo-output"><div class="demo-output__heading"><span class="demo-label">На выходе · черновик задачи</span><span class="demo-ready" data-demo-ready>Проверить</span></div><dl class="demo-result">{[{key:'task', label:'Что сделать', value:sample.task}, {key:'owner', label:'Кто отвечает', value:sample.owner}, {key:'due', label:'Когда', value:sample.due}].map(field=><div data-result={field.key}><dt>{field.label}</dt><dd><span class="demo-value">{field.value}</span><span class="demo-await" aria-hidden="true">Ещё не определено</span></dd></div>)}</dl></div>
    </div>)}
  </div>
</article>
<style>
  .ai-project { border-top:1px solid var(--line); padding:38px 0 42px; }
  .ai-project__intro { display:grid; grid-template-columns:1fr 1fr; gap:9%; align-items:start; margin-bottom:30px; }.ai-project__intro h3 { font-size:clamp(28px,3vw,46px); font-weight:550; line-height:1.1; letter-spacing:-.035em; }.ai-project__intro span { display:block; color:var(--muted); font-size:12px; margin-top:12px; }.ai-project__intro p { font-size:18px; line-height:1.5; max-width:490px; }
  .ai-demo { position:relative; isolation:isolate; background:var(--surface); padding:28px 34px 30px; border-radius:16px; }
  .demo-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:12px; }.demo-toolbar>p { font-size:23px; letter-spacing:-.025em; }.demo-toolbar strong { font-weight:500; color:var(--accent); }
  .demo-samples { display:flex; gap:4px; padding:4px; border-radius:26px; background:#cfcff1; }.demo-samples button { background:transparent; border:0; padding:0 16px; min-height:40px; border-radius:22px; font-size:12px; transition:background .25s,color .25s; }.demo-samples button[aria-pressed=true] { background:var(--text); color:#fff; }
  .demo-note { margin:0 0 20px; font-size:11px; color:#51516b; line-height:1.5; }
  .demo-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:22px; }.demo-steps button { text-align:left; display:flex; align-items:center; gap:10px; padding:8px 0; min-height:44px; background:none; border:0; border-bottom:2px solid #b8b8e5; color:#51516b; font-size:12px; transition:border-color .25s,color .25s; }.demo-steps button span { font-size:10px; font-variant-numeric:tabular-nums; }.demo-steps button[aria-pressed=true] { color:#3036b5; border-color:var(--accent); font-weight:600; }.demo-steps button:hover { color:var(--text); border-color:var(--text); }
  .demo-narration { display:flex; align-items:center; justify-content:space-between; gap:24px; margin-bottom:22px; }.demo-explanation { flex:1; min-height:74px; }.demo-explanation h4 { margin:0 0 7px; font-size:20px; font-weight:550; letter-spacing:-.02em; line-height:1.2; }.demo-explanation p { margin:0; font-size:13px; line-height:1.5; color:#4e4e68; max-width:660px; }
  .demo-run { display:inline-flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; min-width:168px; padding:0 18px; border:0; border-radius:12px; color:#fff; background:var(--text); font-size:12px; white-space:nowrap; transition:background .25s,transform .3s var(--ease); }.demo-run:hover { background:var(--accent); }.demo-run:active { transform:scale(.97); }.demo-run svg { transition:transform .4s var(--ease); }.demo-run:hover svg { transform:translate(3px,-3px); }
  .demo-scene { display:grid; grid-template-columns:1fr 72px 1fr; align-items:stretch; position:relative; }
  .demo-label { display:block; font-size:11px; color:#565672; margin-bottom:18px; }
  .demo-message { position:relative; background:var(--bg); padding:24px 26px; border-radius:14px 14px 14px 2px; }.demo-message>p { font-size:clamp(16px,1.6vw,22px); line-height:1.55; letter-spacing:-.015em; }.demo-message mark { background:transparent; color:inherit; padding:2px 0; box-decoration-break:clone; -webkit-box-decoration-break:clone; transition:background .4s,color .4s; }.demo-message mark.is-found { background:#d8d8ff; color:#3036b5; }.demo-message__tail { position:absolute; bottom:-12px; left:0; width:16px; height:16px; background:var(--bg); clip-path:polygon(0 0,100% 0,0 100%); }
  .demo-route { align-self:center; }.demo-route svg { width:100%; display:block; }.demo-route path { stroke-width:1.5; }.demo-route__base { stroke:#b8b8e5; }.demo-route__signal { stroke:var(--accent); opacity:0; }
  .demo-output { padding:24px 26px; background:#f9f9ff; border-radius:14px; }.demo-output__heading { display:flex; justify-content:space-between; align-items:start; gap:10px; }.demo-ready { color:#3036b5; font-size:10px; }
  .demo-result { margin:0; }.demo-result>div { padding:0 0 12px; }.demo-result>div+div { border-top:1px solid var(--line-soft); padding-top:10px; }.demo-result>div:last-child { padding-bottom:0; }.demo-result dt { font-size:10px; color:#565672; margin-bottom:5px; }.demo-result dd { display:grid; margin:0; font-size:16px; line-height:1.35; }.demo-result dd>span { grid-area:1/1; }.demo-result>div:first-child .demo-value { font-size:20px; letter-spacing:-.02em; }.demo-await { visibility:hidden; color:#666680; font-size:13px; align-self:center; }.ai-demo.is-ready [data-result]:not(.is-filled) .demo-value { visibility:hidden; }.ai-demo.is-ready [data-result]:not(.is-filled) .demo-await { visibility:visible; }.ai-demo.is-ready .demo-ready { visibility:hidden; }.ai-demo.is-complete .demo-ready { visibility:visible; }
  .demo-samples[hidden],.demo-steps[hidden],.demo-scene[hidden],.demo-run[hidden] { display:none; }
  @media(max-width:900px) { .demo-toolbar { align-items:flex-start; flex-direction:column; gap:14px; }.demo-scene { grid-template-columns:1fr 40px 1fr; }.demo-message,.demo-output { padding:20px; }.demo-narration { gap:16px; }.demo-explanation { min-height:100px; }.demo-result>div:first-child .demo-value { font-size:18px; } }
  @media(max-width:600px) { .ai-project { padding:28px 0 32px; }.ai-project__intro { grid-template-columns:1fr; gap:18px; margin-bottom:22px; }.ai-project__intro h3 { font-size:30px; }.ai-project__intro p { font-size:15px; }.ai-demo { padding:20px 18px 22px; }.demo-toolbar>p { font-size:21px; }.demo-samples { width:100%; }.demo-samples button { flex:1; padding:0 10px; }.demo-note { font-size:10px; margin-bottom:12px; }.demo-steps { gap:8px; margin-bottom:16px; }.demo-steps button { flex-direction:column; gap:5px; align-items:flex-start; font-size:10px; white-space:nowrap; }.demo-narration { display:grid; grid-template-columns:1fr; gap:12px; margin-bottom:18px; }.demo-explanation { min-height:98px; }.demo-explanation h4 { font-size:18px; }.demo-explanation p { font-size:12px; }.demo-run { justify-self:start; }.demo-scene { grid-template-columns:1fr; gap:22px; }.demo-route { display:none; }.demo-message,.demo-output { padding:16px 18px; }.demo-message>p { font-size:15px; }.demo-label { margin-bottom:12px; font-size:10px; }.demo-result>div { padding-bottom:8px; }.demo-result>div+div { padding-top:7px; }.demo-result>div:first-child .demo-value { font-size:17px; }.demo-result dd { font-size:15px; } }
</style>

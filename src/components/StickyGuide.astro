---
// Ненавязчивый floating-CTA на PDF-гайд. Появляется после скролла за hero,
// прячется у футера. Можно закрыть (запоминается на сессию).
---
<a href="/anti-sliv-zayavok" class="sticky-guide" id="stickyGuide" aria-label="Получить PDF-гайд бесплатно">
  <span class="sticky-guide__ic">PDF</span>
  <span class="sticky-guide__txt">Получить PDF</span>
  <button class="sticky-guide__x" id="stickyGuideX" aria-label="Скрыть" type="button">×</button>
</a>

<style>
  .sticky-guide {
    position: fixed;
    right: 20px; bottom: 20px;
    z-index: 60;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 11px 14px;
    background: rgba(8,16,32,0.9);
    border: 1px solid rgba(95,198,255,0.4);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4), 0 0 24px rgba(95,198,255,0.12);
    text-decoration: none;
    opacity: 0; transform: translateY(16px); pointer-events: none;
    transition: opacity 0.35s, transform 0.35s;
  }
  .sticky-guide.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .sticky-guide:hover { border-color: rgba(95,198,255,0.7); }

  .sticky-guide__ic {
    font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.5px;
    padding: 4px 8px; border-radius: 999px;
    background: var(--color-accent); color: #06070D;
  }
  .sticky-guide__txt {
    font-family: 'Unbounded', sans-serif; font-size: 12px; font-weight: 500;
    letter-spacing: 0.5px; color: var(--color-text);
  }
  .sticky-guide__x {
    background: none; border: none; color: var(--color-muted-2); cursor: pointer;
    font-size: 16px; line-height: 1; padding: 0 2px; transition: color 0.2s;
  }
  .sticky-guide__x:hover { color: var(--color-text); }

  @media (max-width: 480px) {
    .sticky-guide { right: 12px; bottom: 12px; padding: 10px 12px; }
    .sticky-guide__txt { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-guide { transition: opacity 0.2s; transform: none; }
  }
</style>

<script>
  const el = document.getElementById('stickyGuide');
  const x = document.getElementById('stickyGuideX');
  if (el && x) {
    let dismissed = sessionStorage.getItem('guideDismissed') === '1';
    const onScroll = () => {
      if (dismissed) { el.classList.remove('is-visible'); return; }
      // показываем после 700px и прячем у самого низа (футер)
      const y = window.scrollY;
      const nearBottom = window.innerHeight + y > document.documentElement.scrollHeight - 320;
      el.classList.toggle('is-visible', y > 700 && !nearBottom);
    };
    x.addEventListener('click', (e) => {
      e.preventDefault();
      dismissed = true;
      sessionStorage.setItem('guideDismissed', '1');
      el.classList.remove('is-visible');
    });
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

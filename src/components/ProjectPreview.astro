---
import type { StudioCase } from '../data/cases';
interface Props { project: StudioCase; eager?: boolean; cropBottom?: number; }
const { project, eager=false, cropBottom=0 }=Astro.props;
const shot=project.screenshots[0];
---
<div class="preview" data-preview>
  <div class:list={['preview__image', {'preview__image--cropped':cropBottom>0}]} style={cropBottom ? `aspect-ratio:${shot.width}/${shot.height-cropBottom}` : undefined}>
    <img class="preview__toned" src={shot.src} width={shot.width} height={shot.height} alt={shot.alt} loading={eager?'eager':'lazy'} decoding="async" fetchpriority={eager?'high':'auto'} />
    <img class="preview__original" src={shot.src} width={shot.width} height={shot.height} alt="" aria-hidden="true" loading="eager" decoding="async" />
  </div>
  <button class="preview__switch" type="button" data-color-toggle aria-pressed="false" aria-label={`Показать оригинальные цвета: ${project.title}`}>
    <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor"/></svg>
    <span>В цвете</span>
  </button>
</div>
<style>
  .preview { position:relative; border-radius:14px; box-shadow:var(--preview-shadow); isolation:isolate; background:#cbcafa; }
  .preview__image { position:relative; border-radius:inherit; overflow:hidden; }
  .preview__image--cropped .preview__toned { position:absolute; inset:0; }
  img { width:100%; height:auto; }.preview__toned { filter:grayscale(1) contrast(.65) brightness(1.25); mix-blend-mode:multiply; }
  .preview__original { position:absolute; inset:0; opacity:0; clip-path:circle(0% at 60% 50%); transition:clip-path .9s var(--ease),opacity .55s; }
  .preview.is-color .preview__original,.preview:has(:focus-visible) .preview__original { opacity:1; clip-path:circle(150% at 60% 50%); }
  .preview__switch { position:absolute; right:14px; bottom:14px; display:flex; gap:8px; align-items:center; min-height:40px; padding:0 14px; border:1px solid #ffffffa0; border-radius:25px; background:#f5f4fff0; color:#28273e; font-size:12px; font-weight:500; box-shadow:0 5px 16px #25203b18; transition:transform .4s var(--ease),background .4s; }
  @supports(backdrop-filter:blur(12px)) { .preview__switch { background:#f5f4ffbe; backdrop-filter:blur(12px) saturate(1.3); -webkit-backdrop-filter:blur(12px) saturate(1.3); } }
  .preview__switch:hover { transform:scale(1.04); background:#fff; }
  @media(hover:hover) { .preview:hover .preview__original { opacity:1; clip-path:circle(150% at 60% 50%); } }
  @media(prefers-reduced-motion:reduce) { .preview__original { clip-path:none; } }
</style>

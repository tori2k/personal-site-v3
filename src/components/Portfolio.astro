---
const base = import.meta.env.BASE_URL;

const featured = [
  {
    slug: 'manifik',
    img: 'manifik.jpg',
    title: 'Manifik',
    niche: 'Школа вокала',
    url: 'https://manifik-school.ru',
    status: 'В продакшене',
    task: 'Школе нужен был сайт, через который родители находят педагогов и сразу записываются и оплачивают занятие — без звонков и переписок.',
    built: 'Многостраничный сайт: каталог педагогов и направлений, онлайн-оплата, форма записи, интеграции.',
    points: [
      'Запись на пробный урок приходит в Telegram — администратор видит заявку сразу',
      'Оплата занятий и абонементов прямо на сайте — деньги не ждут звонка',
      'Цены и расписание редактируются без разработчика',
      'Путь от «нашёл» до «записался» — три клика',
    ],
    automated: 'Заявка → Telegram-уведомление → запись в таблицу со статусом',
  },
  {
    slug: 'znamya-truda',
    img: 'znamya-truda.jpg',
    title: 'ФК «Знамя Труда»',
    niche: 'Футбольный клуб · Орехово-Зуево',
    url: 'https://fczt1909.ru',
    status: 'Запущен',
    task: 'Старейший действующий клуб России жил в соцсетях. Нужен был официальный сайт, где болельщик за 10 секунд найдёт матч, состав и новости.',
    built: 'Многостраничник: расписание, новости, история клуба, команда, партнёры.',
    points: [
      'Пользователь быстрее понимает, куда нажать — навигация выстроена под сценарий болельщика',
      'Контент редактируется без программиста — редактор клуба сам публикует новости',
      'Страница партнёров превращает присутствие в структурированное предложение',
      'Сайт стал официальным источником информации вместо разрозненных пабликов',
    ],
    automated: 'Публикация новостей через CMS без участия разработчика',
  },
];

---
<section class="work section-dark" id="work">
  <div class="container-x">
    <div class="work__head reveal">
      <div class="sec-tag">Кейсы</div>
      <h2 class="display-h work__title">
        Как работает <em>система.</em>
      </h2>
      <div class="work__head-row">
        <p class="work__lead">
          Не просто «сделал сайт» — а как заявка теперь проходит путь.
        </p>
        <a href="/cases" class="btn work__all-link">
          Все кейсы →
        </a>
      </div>
    </div>

    <div class="featured">
      {featured.map((f, i) => (
        <article class:list={['fcard', 'reveal']} style={`transition-delay: ${i * 0.1}s`}>
          <a href={f.url} target="_blank" rel="noopener" class="fcard__media">
            <img
              src={`${base}screenshots/${f.img}`}
              alt={f.title}
              loading="eager"
              decoding="async"
            />
            <span class="fcard__status">{f.status}</span>
          </a>
          <div class="fcard__body">
            <div class="fcard__niche">{f.niche}</div>
            <h3 class="fcard__title">{f.title}</h3>
            <div class="fcard__task-label">Задача</div>
            <p class="fcard__lede">{f.task}</p>
            <div class="fcard__task-label">Что собрано</div>
            <p class="fcard__built">{f.built}</p>
            <ul class="fcard__points">
              {f.points.map((p) => (
                <li>
                  <span class="fcard__check">(+)</span>
                  {p}
                </li>
              ))}
            </ul>
            <div class="fcard__automated">
              <span class="fcard__auto-label">Автоматизировано:</span> {f.automated}
            </div>
            <a href={f.url} target="_blank" rel="noopener" class="btn btn--filled fcard__cta">
              <span class="btn__plus">(+)</span>
              Открыть сайт
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Diptych: concept piece -->
    <article class="diptych reveal">
      <div class="diptych__head">
        <div class="diptych__tag">Концепт · спекулятивная работа</div>
        <h3 class="diptych__title">
          Собрал концепт сайта для&nbsp;<em>ЧТИВО ДОМА</em>
        </h3>
        <p class="diptych__lede">
          В&nbsp;апреле был в&nbsp;ЧТИВО ДОМЕ у&nbsp;Сергея Минаева. Место зацепило&nbsp;— вдохновился и&nbsp;собрал сайт-визитку в&nbsp;их&nbsp;фирменной стилистике. Это не&nbsp;заказ и&nbsp;не&nbsp;предложение, просто упражнение в&nbsp;рамках места, которое понравилось.
        </p>
      </div>

      <div class="diptych__media">
        <div class="diptych__half diptych__half--photo">
          <img src={`${base}screenshots/chtivo-minaev.jpg`} alt="Кирилл Барыев с Сергеем Минаевым в ЧТИВО ДОМЕ" loading="lazy" decoding="async" />
          <span class="diptych__label diptych__label--left">Кинозал · 18.04.2026</span>
        </div>
        <a href="https://tori2k.github.io/chtivo-dom-concept/" target="_blank" rel="noopener" class="diptych__half diptych__half--site">
          <img src={`${base}screenshots/chtivo-dom.jpg`} alt="Скриншот концепт-сайта ЧТИВО ДОМ" loading="lazy" decoding="async" />
          <span class="diptych__label diptych__label--right">Концепт-сайт</span>
          <span class="diptych__open">
            Открыть концепт
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </span>
        </a>
      </div>
    </article>

  </div>
</section>

<style>
  .work { padding: 140px 0; }
  .work__head {
    max-width: 860px;
    margin-bottom: 60px;
  }
  .work__title { margin: 0 0 20px; }
  .work__head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .work__lead {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 460px;
    margin: 0;
  }
  .work__all-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  /* Featured — два флагмана */
  .featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 100px;
  }
  .fcard {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 0;
    background: var(--glass-tint);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 8px 24px rgba(0,0,0,0.25),
      var(--glass-edge);
    transition: border-color 0.4s, box-shadow 0.4s, transform 0.4s cubic-bezier(.22,1,.36,1);
  }
  .fcard:hover {
    border-color: rgba(95,198,255,0.4);
    box-shadow:
      0 20px 50px rgba(0,0,0,0.35),
      0 0 60px rgba(95,198,255,0.12),
      var(--glass-edge);
    transform: translateY(-4px);
  }

  .fcard__media {
    position: relative;
    overflow: hidden;
    min-height: 380px;
    display: block;
  }
  .fcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s cubic-bezier(.22,1,.36,1);
  }
  .fcard:hover .fcard__media img { transform: scale(1.03); }

  .fcard__status {
    position: absolute;
    top: 20px;
    left: 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 6px 12px;
    background: rgba(6,7,13,0.7);
    border: 1px solid rgba(244,246,251,0.18);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .fcard__body {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
  }
  .fcard__niche {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }
  .fcard__title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(28px, 2.8vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 18px;
    color: var(--color-text);
  }
  .fcard__task-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 6px;
  }
  .fcard__lede {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 0 18px;
  }
  .fcard__built {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 18px;
  }
  .fcard__automated {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 24px;
    padding: 10px 14px;
    background: rgba(95,198,255,0.06);
    border-left: 2px solid rgba(95,198,255,0.4);
    border-radius: 0 8px 8px 0;
  }
  .fcard__auto-label {
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .fcard__points {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fcard__points li {
    display: flex;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .fcard__check {
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    flex-shrink: 0;
  }
  .fcard__cta { align-self: flex-start; margin-top: auto; }

  /* Diptych — концепт-кейс с фото и скриншотом */
  .diptych {
    margin: 0 0 100px;
    padding-top: 60px;
    border-top: 1px solid var(--color-border);
  }
  .diptych__head {
    max-width: 780px;
    margin-bottom: 40px;
  }
  .diptych__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }
  .diptych__title {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    color: var(--color-text);
  }
  .diptych__title em {
    font-style: italic;
    color: var(--color-muted);
    font-weight: 300;
  }
  .diptych__lede {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
    max-width: 640px;
  }

  .diptych__media {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 16px;
  }
  .diptych__half {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-surface);
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .diptych__half img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 1s cubic-bezier(.22,1,.36,1);
  }
  .diptych__half--site {
    aspect-ratio: auto;
    min-height: 100%;
  }
  .diptych__half--site img {
    object-position: top center;
  }
  .diptych__half--site:hover img { transform: scale(1.03); }

  .diptych__label {
    position: absolute;
    top: 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 12px;
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 999px;
  }
  .diptych__label--left { left: 18px; }
  .diptych__label--right {
    left: 18px;
    background: #A22E1F;
    color: #f5f1e8;
  }
  .diptych__open {
    position: absolute;
    bottom: 18px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 999px;
    transition: gap 0.3s, background 0.3s;
  }
  .diptych__half--site:hover .diptych__open {
    background: var(--color-text);
    color: var(--color-bg);
    gap: 12px;
  }

  @media (max-width: 900px) {
    .diptych__media { grid-template-columns: 1fr; }
    .diptych__half, .diptych__half--site {
      aspect-ratio: 4/5;
      min-height: auto;
    }
  }

  @media (max-width: 1000px) {
    .fcard { grid-template-columns: 1fr; }
    .fcard__media { min-height: 260px; }
  }
  @media (max-width: 600px) {
    .work { padding: 80px 0; }
    .fcard__body { padding: 28px 22px; }
    .featured { margin-bottom: 60px; }
  }
</style>

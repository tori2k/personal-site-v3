---
const tiers = [
  {
    name: 'Экспресс-лендинг',
    tag: 'под заявку',
    price: 'от 49 000 ₽',
    time: '3–5 дней',
    lead: 'Одна услуга, быстрый запуск, заявка в Telegram',
    includes: [
      'Оффер, услуги, доверие, контакты',
      'Заявки в Telegram',
      'Адаптив, домен, чистый код',
      'Исходники у вас',
      'Неделя правок после запуска',
    ],
    excludes: ['Квиз и аналитика', 'CRM и автоматизации'],
    result: 'Человек понимает ценность и отправляет заявку',
  },
  {
    name: 'Лендинг эксперта',
    tag: 'под заявки',
    price: '75 000–95 000 ₽',
    time: '1–2 недели',
    lead: 'Оффер, доверие, кейсы, FAQ, аналитика',
    includes: [
      'Всё из «Экспресс-лендинга»',
      'Кейсы, цены, FAQ, этапы',
      'Квиз для квалификации заявок',
      'Метрика + Google Analytics',
      'SEO-разметка',
    ],
    excludes: ['CRM и автоматизации'],
    result: 'Клиент квалифицируется квизом — к вам идут целевые',
    featured: true,
  },
  {
    name: 'Система заявок',
    tag: 'сайт + Telegram + CRM',
    price: '120 000–300 000 ₽',
    time: '2–5 недель',
    lead: 'Сайт, квиз, Telegram, CRM/таблица, автоматизации',
    includes: [
      'Всё из «Лендинга эксперта»',
      'Telegram-бот с уведомлениями',
      'Таблица лидов или CRM',
      'Онлайн-оплаты',
      'Автоматизации и интеграции',
    ],
    excludes: [],
    result: 'Сайт становится частью операционки — ничего не теряется',
    premium: true,
  },
];
---
<section class="pricing section-dark" id="pricing">
  <div class="container-x">
    <div class="pricing__head reveal">
      <div class="sec-tag">Продукты</div>
      <h2 class="display-h">
        Выберите <em>формат.</em>
      </h2>
      <p class="pricing__lead">
        Не сайт как цель, а система заявок как результат.
        Первый разбор бесплатный.
      </p>
    </div>

    <div class="pricing__grid">
      {tiers.map((t, i) => (
        <article
          class:list={['tier', t.featured && 'tier--featured', t.premium && 'tier--premium', 'reveal']}
          style={`transition-delay: ${i * 0.08}s`}
        >
          <div class="tier__head">
            <div class="tier__name">{t.name}</div>
            <div class="tier__tag">{t.tag}</div>
          </div>

          <div class="tier__price-row">
            <div class="tier__price">{t.price}</div>
            <div class="tier__time">{t.time}</div>
          </div>

          <p class="tier__lead">{t.lead}</p>

          <div class="tier__result">
            <span class="tier__result-label">Результат</span>
            {t.result}
          </div>

          <!-- Раскрытие состава -->
          <details class="tier__details">
            <summary class="tier__summary">
              <span>Что входит</span>
              <span class="tier__summary-icon">+</span>
            </summary>
            <ul class="tier__includes">
              {t.includes.map((inc) => (
                <li>
                  <span class="tier__check">(+)</span>
                  {inc}
                </li>
              ))}
            </ul>
            {t.excludes.length > 0 && (
              <ul class="tier__excludes">
                {t.excludes.map((exc) => (
                  <li>
                    <span class="tier__minus">(–)</span>
                    {exc}
                  </li>
                ))}
              </ul>
            )}
          </details>

          <a href="https://t.me/tori2k" target="_blank" rel="noopener" class="btn tier__cta">
            <span class="btn__plus">(+)</span>
            Написать в Telegram
          </a>
        </article>
      ))}
    </div>

    <div class="pricing__note reveal">
      <span>⊕</span>
      Не уверены, что нужно? —
      <a href="https://t.me/tori2k" target="_blank" rel="noopener">напишите в Telegram</a>, разберёмся вместе.
    </div>
  </div>
</section>

<style>
  .pricing { padding: 120px 0; }
  .pricing__head { max-width: 680px; margin-bottom: 52px; }
  .pricing__lead {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 20px 0 0;
    max-width: 460px;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .tier {
    padding: 30px 26px;
    background: var(--glass-tint);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    gap: 0;
    box-shadow: var(--glass-edge);
    transition: border-color 0.35s, transform 0.35s cubic-bezier(.22,1,.36,1);
  }
  .tier:hover {
    border-color: rgba(95,198,255,0.35);
    transform: translateY(-4px);
  }
  .tier--featured {
    background: linear-gradient(180deg, rgba(95,198,255,0.09), rgba(95,198,255,0.02)), var(--glass-tint);
    border-color: rgba(95,198,255,0.4);
    box-shadow: 0 0 60px rgba(95,198,255,0.1), var(--glass-edge);
  }
  .tier--premium {
    position: relative;
    background: linear-gradient(180deg, rgba(162,128,255,0.08), transparent), var(--glass-tint);
    border-color: rgba(162,128,255,0.4);
  }
  .tier--premium::before {
    content: '★ aurora';
    position: absolute;
    top: -10px; left: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #08061a;
    background: linear-gradient(120deg, #5fc6ff, #a280ff, #ff6ec7);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .tier__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .tier__name {
    font-family: 'Unbounded', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--color-accent);
  }
  .tier__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-muted);
  }

  .tier__price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }
  .tier__price {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tier__time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tier__lead {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0 0 16px;
  }

  .tier__result {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-muted);
    padding: 12px 14px;
    background: rgba(95,198,255,0.06);
    border-left: 2px solid rgba(95,198,255,0.4);
    border-radius: 0 8px 8px 0;
    margin-bottom: 16px;
  }
  .tier__result-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  /* Details / accordion */
  .tier__details {
    margin-bottom: 20px;
    border-top: 1px solid var(--color-border);
    padding-top: 14px;
  }
  .tier__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
    padding: 4px 0;
    transition: color 0.2s;
  }
  .tier__summary::-webkit-details-marker { display: none; }
  .tier__summary:hover { color: var(--color-text); }
  .tier__summary-icon {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    color: var(--color-accent);
    transition: transform 0.25s;
    line-height: 1;
  }
  .tier__details[open] .tier__summary-icon { transform: rotate(45deg); }

  .tier__includes, .tier__excludes {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tier__includes li, .tier__excludes li {
    display: flex;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .tier__includes li { color: var(--color-text); }
  .tier__excludes li { color: var(--color-muted-2); }
  .tier__excludes { margin-top: 8px; }
  .tier__check { color: var(--color-accent); font-family: 'JetBrains Mono', monospace; font-size: 11px; flex-shrink: 0; }
  .tier__minus { color: var(--color-muted-2); font-family: 'JetBrains Mono', monospace; font-size: 11px; flex-shrink: 0; }

  .tier__cta { align-self: flex-start; margin-top: auto; }

  .pricing__note {
    text-align: center;
    margin-top: 44px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .pricing__note span { color: var(--color-accent); margin-right: 6px; }
  .pricing__note a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; }

  @media (max-width: 1000px) {
    .pricing__grid { grid-template-columns: 1fr; max-width: 520px; }
  }
  @media (max-width: 900px) {
    .pricing { padding: 72px 0; }
    .pricing__grid { max-width: 100%; }
  }
</style>

---
const tiers = [
  {
    name: 'Экспресс-лендинг под заявку',
    tag: 'Быстрый старт',
    audience: 'Эксперт, консультант, частная практика, мастер',
    price: '49 000 ₽',
    time: '3–5 дней',
    desc: 'Одна страница, которая объясняет оффер и собирает заявки в Telegram. Для тех, кто хочет быстро выйти в рекламу.',
    includes: [
      'Оффер, услуги, доверие, контакты',
      'Заявки приходят в Telegram',
      'Адаптив, домен, чистый код',
      'Исходники остаются у вас',
      'Неделя правок после запуска',
    ],
    excludes: ['Квиз и аналитика', 'Автоматизации и CRM'],
    result: 'Человек понимает, что вы делаете, и отправляет заявку',
  },
  {
    name: 'Лендинг эксперта под заявки',
    tag: 'Основной выбор',
    audience: 'Юрист, адвокат, консультант, онлайн-школа, студия',
    price: '75 000–95 000 ₽',
    time: '1–2 недели',
    desc: 'Продающий сайт с кейсами, ценами, FAQ, квизом и аналитикой. Для эксперта, которого клиент выбирает внимательно.',
    includes: [
      'Всё из «Экспресс-лендинга»',
      'Кейсы, цены, FAQ, этапы работы',
      'Квиз для квалификации заявок',
      'SEO: разметка, мета, sitemap',
      'Метрика + Google Analytics',
    ],
    excludes: ['CRM и автоматизации', 'Telegram-бот'],
    result: 'Клиент понимает, почему выбрать вас, квиз фильтрует нецелевые обращения',
    featured: true,
  },
  {
    name: 'Сайт + Telegram-заявки + аналитика',
    tag: 'Система заявок',
    audience: 'Агентство, сервис, студия с потоком заявок',
    price: '120 000–160 000 ₽',
    time: '2–3 недели',
    desc: 'Многостраничник с квизом, Telegram-ботом под заявки и аналитикой источников. Каждая заявка трекается и не теряется.',
    includes: [
      'Всё из «Лендинга эксперта»',
      'Telegram-бот: принимает, форматирует, уведомляет',
      'Несколько страниц + Admin-панель',
      'UTM-аналитика: откуда пришла каждая заявка',
      'Google Sheets или Notion как лёгкий CRM',
    ],
    excludes: ['Полноценная CRM-интеграция', 'Онлайн-оплаты'],
    result: 'Заявки идут в Telegram, вы видите источники и не теряете ни одну',
  },
  {
    name: 'Сайт + бот + CRM + автоматизации',
    tag: 'Под ключ',
    audience: 'Школа, клиника, франшиза, сервисный бизнес с операционкой',
    price: '180 000–300 000 ₽',
    time: '3–5 недель',
    desc: 'Полная система: сайт, Telegram-бот, CRM-интеграция, онлайн-оплаты, автоматизации. Сайт становится частью операционки.',
    includes: [
      'Всё из «Сайта + Telegram»',
      'Интеграция с CRM (AmoCRM / Bitrix24)',
      'Онлайн-оплаты (ЮKassa / Т-Касса)',
      'Автоматизации: статусы, напоминания, воронки',
      'Кастомный дизайн под бренд',
    ],
    excludes: [],
    result: 'Сайт, бот и CRM работают как одна система — без ручного труда',
    premium: true,
  },
];
---
<section class="pricing section-dark" id="pricing">
  <div class="container-x">
    <div class="pricing__head reveal">
      <div class="sec-tag">Цены</div>
      <h2 class="display-h">
        Не сайт, а <em>система</em><br/>
        заявок.
      </h2>
      <p class="pricing__lead">
        Первый разбор бесплатный: смотрю нишу, текущую страницу и путь заявки,
        потом называю точную цену и срок до начала работы.
      </p>
    </div>

    <div class="pricing__grid">
      {tiers.map((t, i) => (
        <article class:list={['tier', t.featured && 'tier--featured', t.premium && 'tier--premium', 'reveal']} style={`transition-delay: ${i * 0.08}s`}>
          <div class="tier__head">
            <div class="tier__name">{t.name}</div>
            <div class="tier__tag">{t.tag}</div>
          </div>
          <div class="tier__price-row">
            <div class="tier__price">{t.price}</div>
            <div class="tier__time">{t.time}</div>
          </div>
          <p class="tier__desc">{t.desc}</p>
          <div class="tier__audience">
            <span class="tier__audience-label">Кому подходит:</span> {t.audience}
          </div>
          <ul class="tier__includes">
            {t.includes.map((inc) => (
              <li>
                <span class="tier__check">(+)</span>
                {inc}
              </li>
            ))}
          </ul>
          {t.excludes && t.excludes.length > 0 && (
            <ul class="tier__excludes">
              {t.excludes.map((exc) => (
                <li>
                  <span class="tier__minus">(–)</span>
                  {exc}
                </li>
              ))}
            </ul>
          )}
          <div class="tier__result">
            <span class="tier__result-label">Результат:</span> {t.result}
          </div>
          <a href="/razbor" class="btn tier__cta">
            <span class="btn__plus">(+)</span>
            Получить оценку
          </a>
        </article>
      ))}
    </div>

    <div class="pricing__note reveal">
      <span>⊕</span>
      Можно начать без оплаты: напишите —
      <a href="https://t.me/tori2k" target="_blank" rel="noopener">разберу вашу нишу и скажу, какой пакет нужен</a>.
    </div>
  </div>
</section>

<style>
  .pricing { padding: 140px 0; }
  .pricing__head {
    max-width: 780px;
    margin-bottom: 60px;
  }
  .pricing__lead {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 24px 0 0;
    max-width: 520px;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .pricing__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1200px) {
    .pricing__grid { grid-template-columns: repeat(4, 1fr); gap: 14px; }
  }

  .tier {
    padding: 32px 26px;
    background: var(--glass-tint);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--glass-edge);
    transition: all 0.4s cubic-bezier(.22,1,.36,1);
  }
  .tier:hover {
    border-color: rgba(95,198,255,0.4);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3), 0 0 50px rgba(95,198,255,0.1), var(--glass-edge);
  }
  .tier--featured {
    background:
      linear-gradient(180deg, rgba(95,198,255,0.1), rgba(95,198,255,0.02)),
      var(--glass-tint);
    border-color: rgba(95,198,255,0.45);
    box-shadow: 0 30px 60px rgba(0,0,0,0.3), 0 0 60px rgba(95,198,255,0.12), var(--glass-edge);
  }
  .tier--premium {
    position: relative;
    background:
      linear-gradient(180deg, rgba(95,198,255,0.1), rgba(162,128,255,0.06)),
      var(--glass-tint);
    border-color: rgba(162,128,255,0.5);
  }
  .tier--premium::before {
    content: '★ aurora';
    position: absolute;
    top: -10px;
    left: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #08061a;
    background: linear-gradient(120deg, #5fc6ff 0%, #a280ff 50%, #ff6ec7 100%);
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(95, 198, 255, 0.35);
  }
  .tier--premium:hover {
    border-color: rgba(95, 198, 255, 0.75);
    box-shadow: 0 30px 60px rgba(95, 198, 255, 0.18);
  }

  .tier__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .tier__name {
    font-family: 'Unbounded', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1.35;
  }
  .tier__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--color-muted);
  }

  .tier__price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }
  .tier__price {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(18px, 2vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tier__time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tier__desc {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .tier__audience {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-muted-2);
    margin: 0 0 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .tier__audience-label {
    color: var(--color-muted);
  }

  .tier__includes {
    list-style: none;
    padding: 0;
    margin: 0 0 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tier__includes li {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text);
    line-height: 1.5;
  }
  .tier__check {
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    flex-shrink: 0;
  }

  .tier__excludes {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tier__excludes li {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: var(--color-muted-2);
    line-height: 1.5;
  }
  .tier__minus {
    color: var(--color-muted-2);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    flex-shrink: 0;
  }

  .tier__result {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: auto 0 22px;
    padding: 12px 14px;
    background: rgba(95,198,255,0.06);
    border-left: 2px solid rgba(95,198,255,0.4);
    border-radius: 0 8px 8px 0;
  }
  .tier__result-label {
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .tier__cta { align-self: flex-start; }

  .pricing__note {
    text-align: center;
    margin-top: 50px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .pricing__note span {
    color: var(--color-accent);
    margin-right: 6px;
  }
  .pricing__note a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 900px) {
    .pricing { padding: 80px 0; }
    .pricing__grid { grid-template-columns: 1fr; }
  }
</style>

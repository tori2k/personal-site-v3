---
const tiers = [
  {
    name: 'Старт',
    tag: 'Проверить нишу',
    audience: 'Психолог, репетитор, коуч, мастер, консультант',
    price: '25 000 ₽',
    time: '2–3 дня',
    desc: 'Одна страница для заявки: оффер, услуги, доверие, контакты. Подходит, когда нужно быстро выйти в рекламу или закрепить ссылку в профиле.',
    includes: [
      'Структура и тексты по вашим материалам',
      'Заявки приходят в Telegram',
      'Свой домен (например, ваше-имя.ru)',
      'Адаптивная вёрстка (мобильный + десктоп)',
      'Неделя правок после запуска',
    ],
  },
  {
    name: 'Лендинг+',
    tag: 'Основной выбор',
    audience: 'Салон, студия, агентство, частная практика',
    price: '45 000 ₽',
    time: '1–2 недели',
    desc: 'Продающий сайт с кейсами, ценами, FAQ и аналитикой. Для бизнеса, где клиент выбирает внимательно и сравнивает несколько вариантов.',
    includes: [
      'Всё из «Старта»',
      'Больше секций: кейсы, цены, FAQ, этапы',
      'Квиз-опросник для квалификации заявок',
      'SEO: разметка, мета-теги, sitemap, OG',
      'Яндекс.Метрика + Google Analytics',
      'Заявки собираются в одну таблицу',
    ],
    featured: true,
  },
  {
    name: 'Система',
    tag: 'Для школ и сервисов',
    audience: 'Школа танцев, курсы, клуб, интернет-магазин',
    price: 'от 100 000 ₽',
    time: '2–4 недели',
    desc: 'Несколько страниц, онлайн-оплаты, записи, таблицы, админка. Для проектов, где сайт уже должен быть частью продаж и операционки.',
    includes: [
      'Всё из «Лендинга+»',
      'Несколько страниц с разным содержимым',
      'Админка: вы сами меняете тексты, цены, фото',
      'Приём оплат картой онлайн (ЮKassa / CloudPayments)',
      'Запись клиентов с уведомлениями',
      'Другие интеграции под ваши задачи',
    ],
  },
  {
    name: 'Premium',
    tag: 'Эксклюзив',
    audience: 'Бренд, IT-продукт, фин-тех, агентство, авторская студия',
    price: 'от 200 000 ₽',
    time: '3–6 недель',
    desc: 'Сайт уровня Linear/Vercel: кастомный дизайн, продвинутые анимации (Framer Motion + GSAP), индивидуальные иллюстрации и моушн. Для тех, кто хочет «как у больших».',
    includes: [
      'Всё из «Системы»',
      'Эксклюзивный дизайн под бренд (не из шаблонов)',
      'Сложные интерактивные анимации и scroll-сторителлинг',
      'Кастомные SVG-иллюстрации и моушн-элементы',
      '2 раунда правок на каждом этапе',
      'Месяц приоритетной поддержки после запуска',
    ],
    premium: true,
  },
];
---
<section class="pricing section-dark" id="pricing">
  <div class="container-x">
    <div class="pricing__head reveal">
      <div class="sec-tag">Цены</div>
      <h2 class="display-h">
        Сколько <em>стоит</em><br/>
        запуск.
      </h2>
      <p class="pricing__lead">
        Первый разбор бесплатный: смотрю нишу, текущую страницу и конкурентов,
        потом называю точную цену и срок до начала работы.
      </p>
    </div>

    <div class="pricing__grid">
      {tiers.map((t, i) => (
        <article class:list={['tier', t.featured && 'tier--featured', t.premium && 'tier--premium', 'reveal']} style={`transition-delay: ${i * 0.1}s`}>
          <div class="tier__head">
            <div class="tier__name">{t.name}</div>
            <div class="tier__tag">{t.tag}</div>
          </div>
          <div class="tier__price-row">
            <div class="tier__price">{t.price}</div>
            <div class="tier__time">{t.time}</div>
          </div>
          <p class="tier__desc">{t.desc}</p>
          <div class="tier__audience">Например: {t.audience}</div>
          <ul class="tier__includes">
            {t.includes.map((inc) => (
              <li>
                <span class="tier__check">(+)</span>
                {inc}
              </li>
            ))}
          </ul>
          <a href="https://t.me/tori2k" target="_blank" rel="noopener" class="btn tier__cta">
            <span class="btn__plus">(+)</span>
            Получить оценку
          </a>
        </article>
      ))}
    </div>

    <div class="pricing__note reveal">
      <span>⊕</span>
      Можно начать без оплаты: напишите —
      <a href="https://t.me/tori2k" target="_blank" rel="noopener">разберу вашу нишу и скажу, какой сайт нужен</a>.
    </div>
  </div>
</section>

<style>
  .pricing { padding: 140px 0; }
  .pricing__head {
    max-width: 780px;
    margin-bottom: 60px;
  }
  .pricing__lead {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 24px 0 0;
    max-width: 520px;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .pricing__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) {
    .pricing__grid { grid-template-columns: repeat(4, 1fr); gap: 14px; }
  }

  .tier {
    padding: 36px 30px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(.22,1,.36,1);
  }
  .tier:hover {
    border-color: var(--color-accent);
    transform: translateY(-6px);
  }
  .tier--featured {
    background: linear-gradient(180deg, rgba(17,17,17,0.04), rgba(17,17,17,0));
    border-color: var(--color-accent);
    box-shadow: 0 30px 60px rgba(17,17,17,0.10);
  }
  .tier--premium {
    position: relative;
    background:
      linear-gradient(180deg, rgba(95, 198, 255, 0.07), rgba(162, 128, 255, 0.04)),
      var(--color-surface);
    border-color: rgba(95, 198, 255, 0.45);
  }
  .tier--premium::before {
    content: '★ aurora';
    position: absolute;
    top: -10px;
    left: 22px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #08061a;
    background: linear-gradient(120deg, #5fc6ff 0%, #a280ff 50%, #ff6ec7 100%);
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(95, 198, 255, 0.35);
  }
  .tier--premium:hover {
    border-color: rgba(95, 198, 255, 0.75);
    box-shadow: 0 30px 60px rgba(95, 198, 255, 0.18);
  }

  .tier__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .tier__name {
    font-family: 'Unbounded', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .tier__tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--color-muted);
  }

  .tier__price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .tier__price {
    font-family: 'Unbounded', sans-serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tier__time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .tier__desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 14px;
  }
  .tier__audience {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-muted-2);
    margin: 0 0 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }
  .tier__includes {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tier__includes li {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    color: var(--color-text);
    line-height: 1.5;
  }
  .tier__check {
    color: var(--color-accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    flex-shrink: 0;
  }

  .tier__cta { align-self: flex-start; }

  .pricing__note {
    text-align: center;
    margin-top: 50px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .pricing__note span {
    color: var(--color-accent);
    margin-right: 6px;
  }
  .pricing__note a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 900px) {
    .pricing { padding: 80px 0; }
    .pricing__grid { grid-template-columns: 1fr; }
  }
</style>
